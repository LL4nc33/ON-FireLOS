+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.widget;
+
+import android.app.Activity;
+import android.content.res.Resources;
+import android.content.res.TypedArray;
+import android.graphics.Color;
+import android.support.v7.widget.RecyclerView;
+import android.text.TextUtils;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toolbar;
+
+import com.android.settings.R;
+
+/**
+ * The large title of the pages below the home screen (docs/DESIGN.md). The page's header - the
+ * title and, when the page has one, its main switch - lies over the list, which starts below it.
+ * As the list scrolls, the header moves up with it until the title is gone and only the switch
+ * is left at the top; the title fades on the way and the bar's own small title fades in.
+ *
+ * A header of the page's own above its list (a pinned header) joins the page header under the
+ * switch. Without a settings list the page keeps the plain bar: no large title, the content
+ * below the switch.
+ */
+public final class PageTitleController extends RecyclerView.OnScrollListener
+        implements View.OnLayoutChangeListener {
+    private final Activity mActivity;
+    private final View mHeader;
+    private final TextView mTitle;
+    private final View mSwitch;
+    private final View mContent;
+    private int mInset;
+    private RecyclerView mList;
+    private View mPinnedHeader;
+    private int mListPaddingTop;
+    private boolean mApplyPosted;
+    private Toolbar mToolbar;
+    private int mToolbarTitleColor;
+    private int mToolbarTitleAlpha = -1;
+
+    /** Sets a page up, at first without a list. */
+    public static void install(Activity activity) {
+        final View header = activity.findViewById(R.id.onfirelos_page_header);
+        if (header == null) return;
+        final PageTitleController controller = new PageTitleController(activity, header);
+        header.setTag(R.id.onfirelos_page_header, controller);
+        header.addOnLayoutChangeListener(controller);
+        controller.setTitle(activity.getTitle());
+    }
+
+    /** The list of the page's settings fragment, under the large title. */
+    public static void attach(Activity activity, RecyclerView list, View pinnedHeader) {
+        final PageTitleController controller = get(activity);
+        if (controller == null || list == null) return;
+        controller.setList(list, pinnedHeader);
+    }
+
+    /** The fragment's list is going; the page falls back to the plain bar. */
+    public static void detach(Activity activity, RecyclerView list) {
+        final PageTitleController controller = get(activity);
+        if (controller == null || list == null || controller.mList != list) return;
+        controller.setList(null, null);
+    }
+
+    public static void setTitle(Activity activity, CharSequence title) {
+        final PageTitleController controller = get(activity);
+        if (controller != null) controller.setTitle(title);
+    }
+
+    private static PageTitleController get(Activity activity) {
+        // Not before the window has its views: a page restored after turning sets its title
+        // while the activity is still being created, and a lookup then would build the
+        // window's own action bar, a second bar above Settings' tool bar.
+        if (activity == null || activity.getWindow() == null
+                || activity.getWindow().peekDecorView() == null) {
+            return null;
+        }
+        final View header = activity.findViewById(R.id.onfirelos_page_header);
+        return header == null ? null
+                : (PageTitleController) header.getTag(R.id.onfirelos_page_header);
+    }
+
+    private PageTitleController(Activity activity, View header) {
+        mActivity = activity;
+        mHeader = header;
+        mTitle = header.findViewById(R.id.onfirelos_page_title);
+        mSwitch = header.findViewById(R.id.switch_bar);
+        mContent = activity.findViewById(R.id.main_content);
+        layoutColumn();
+        // The header lies over the list; above it whatever elevation the list has.
+        mHeader.setOutlineProvider(null);
+        // It takes the taps that land on it: the rows passing under it are hidden.
+        mHeader.setClickable(true);
+        mHeader.setTranslationZ(activity.getResources().getDisplayMetrics().density * 16);
+    }
+
+    /**
+     * The device turned. Wi-Fi and some other pages keep their activity then, and their views
+     * the sizes of the old orientation: the column is set again, the list's too.
+     */
+    public static void onConfigurationChanged(Activity activity) {
+        final PageTitleController controller = get(activity);
+        if (controller == null) return;
+        // A page at its top stays there: the list keeps its items where they were, and
+        // with the taller title of portrait they would stand half under it.
+        final boolean atTop = controller.isLarge() && controller.mHeader.getTranslationY() == 0;
+        controller.layoutColumn();
+        final View container = activity.findViewById(android.R.id.list_container);
+        if (container != null) {
+            final int margin = activity.getResources()
+                    .getDimensionPixelSize(R.dimen.settings_side_margin);
+            container.setPaddingRelative(margin, container.getPaddingTop(), margin,
+                    container.getPaddingBottom());
+        }
+        controller.apply();
+        if (atTop && controller.mList != null) {
+            controller.mList.scrollToPosition(0);
+        }
+    }
+
+    /** Title, switch and the page's own header in the cards' column, at this orientation's size. */
+    private void layoutColumn() {
+        final Resources res = mActivity.getResources();
+        mInset = res.getDimensionPixelSize(R.dimen.settings_side_margin)
+                + res.getDimensionPixelSize(R.dimen.onfirelos_card_margin);
+        mTitle.getLayoutParams().height =
+                res.getDimensionPixelSize(R.dimen.onfirelos_large_title_height);
+        for (View v : new View[] { mTitle, mSwitch, mPinnedHeader }) {
+            if (v == null) continue;
+            final ViewGroup.MarginLayoutParams lp =
+                    (ViewGroup.MarginLayoutParams) v.getLayoutParams();
+            lp.setMarginStart(mInset);
+            lp.setMarginEnd(mInset);
+            v.setLayoutParams(lp);
+        }
+    }
+
+    private void setTitle(CharSequence title) {
+        if (!TextUtils.equals(mTitle.getText(), title)) {
+            mTitle.setText(title);
+        }
+        apply();
+    }
+
+    private void setList(RecyclerView list, View pinnedHeader) {
+        if (mList != null) {
+            mList.removeOnScrollListener(this);
+            mList.removeOnLayoutChangeListener(this);
+            mList.setPadding(mList.getPaddingLeft(), mListPaddingTop, mList.getPaddingRight(),
+                    mList.getPaddingBottom());
+            offsetBesideList(mList, 0);
+        }
+        if (mPinnedHeader != null && mPinnedHeader.getParent() == mHeader) {
+            ((ViewGroup) mHeader).removeView(mPinnedHeader);
+        }
+        mList = list;
+        mPinnedHeader = list == null ? null : pinnedHeader;
+        if (mPinnedHeader != null) {
+            // The page's own header above its list (Wi-Fi's scan progress, a filter spinner)
+            // moves into the page header under the switch, in the cards' column, and stays at
+            // the top with it. The page keeps its reference to the view.
+            final ViewGroup parent = (ViewGroup) mPinnedHeader.getParent();
+            if (parent != null) {
+                parent.removeView(mPinnedHeader);
+            }
+            final LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            lp.setMarginStart(mInset);
+            lp.setMarginEnd(mInset);
+            ((ViewGroup) mHeader).addView(mPinnedHeader, lp);
+        }
+        if (list != null) {
+            mListPaddingTop = list.getPaddingTop();
+            // Items pass under the header, which hides them, instead of being cut off
+            // where the list's padding begins.
+            list.setClipToPadding(false);
+            list.addOnScrollListener(this);
+            list.addOnLayoutChangeListener(this);
+        }
+        apply();
+    }
+
+    private boolean isLarge() {
+        return mList != null && !TextUtils.isEmpty(mTitle.getText()) && !hasOwnContent();
+    }
+
+    /**
+     * A page that lays its own content beside the settings list (the languages page its
+     * reorderable list) keeps the plain bar: that content does not scroll with the list and
+     * would stay under the large title.
+     */
+    private boolean hasOwnContent() {
+        if (!(mList.getParent() instanceof View)
+                || !(((View) mList.getParent()).getParent() instanceof ViewGroup)) {
+            return false;
+        }
+        final ViewGroup root = (ViewGroup) ((View) mList.getParent()).getParent();
+        for (int i = 0; i < root.getChildCount(); i++) {
+            final View child = root.getChildAt(i);
+            final int id = child.getId();
+            if (child.getVisibility() == View.VISIBLE && id != android.R.id.list_container
+                    && id != android.R.id.empty && id != R.id.button_bar
+                    && id != R.id.pinned_header) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * The header's height as it is about to be: known before its layout, so that a list
+     * restored with its items (after a rotation) lays them out below it at once.
+     */
+    private int headerHeight(boolean large) {
+        int height = 0;
+        if (large) {
+            height += mTitle.getLayoutParams().height;
+        }
+        if (mSwitch.getVisibility() != View.GONE) {
+            final ViewGroup.MarginLayoutParams lp =
+                    (ViewGroup.MarginLayoutParams) mSwitch.getLayoutParams();
+            height += lp.height + lp.topMargin + lp.bottomMargin;
+        }
+        if (mPinnedHeader != null && mPinnedHeader.getVisibility() != View.GONE) {
+            height += mPinnedHeader.getHeight();
+        }
+        return height;
+    }
+
+    /** Title, content and list placed for the header; then the scroll position. */
+    private void apply() {
+        final boolean large = isLarge();
+        final int visibility = large ? View.VISIBLE : View.GONE;
+        if (mTitle.getVisibility() != visibility) {
+            mTitle.setVisibility(visibility);
+        }
+        final int height = headerHeight(large);
+        if (mContent != null) {
+            final ViewGroup.MarginLayoutParams lp =
+                    (ViewGroup.MarginLayoutParams) mContent.getLayoutParams();
+            final int top = large ? 0 : height;
+            if (lp.topMargin != top) {
+                lp.topMargin = top;
+                mContent.setLayoutParams(lp);
+            }
+        }
+        if (mList != null) {
+            final int paddingTop = mListPaddingTop + (large ? height : 0);
+            if (mList.getPaddingTop() != paddingTop) {
+                mList.setPadding(mList.getPaddingLeft(), paddingTop, mList.getPaddingRight(),
+                        mList.getPaddingBottom());
+            }
+            offsetBesideList(mList, large ? height : 0);
+        }
+        update(large);
+    }
+
+    /**
+     * What a page shows instead of its list - instructions while a feature is off (screen
+     * pinning), an empty notice, the loading spinner - lies where the list begins, under the
+     * header: it moves down below it.
+     */
+    private static void offsetBesideList(RecyclerView list, int offset) {
+        if (!(list.getParent() instanceof ViewGroup)) return;
+        final ViewGroup container = (ViewGroup) list.getParent();
+        for (int i = 0; i < container.getChildCount(); i++) {
+            final View child = container.getChildAt(i);
+            if (child != list && child.getTranslationY() != offset) {
+                child.setTranslationY(offset);
+            }
+        }
+        if (container.getParent() instanceof ViewGroup) {
+            final View empty = ((ViewGroup) container.getParent()).findViewById(android.R.id.empty);
+            if (empty != null && empty.getParent() != container && empty.getTranslationY() != offset) {
+                empty.setTranslationY(offset);
+            }
+        }
+    }
+
+    @Override
+    public void onLayoutChange(View v, int left, int top, int right, int bottom,
+            int oldLeft, int oldTop, int oldRight, int oldBottom) {
+        // The switch came or went, a pinned header was shown, the list was laid out. Padding
+        // and margins are changed right after this layout pass, not from within it (that
+        // would ask for a layout while one runs); the header follows the list at once.
+        if (!mApplyPosted) {
+            mApplyPosted = true;
+            mHeader.post(() -> {
+                mApplyPosted = false;
+                apply();
+            });
+        }
+        update(isLarge());
+    }
+
+    @Override
+    public void onScrolled(RecyclerView recyclerView, int dx, int dy) {
+        update(isLarge());
+    }
+
+    private void update(boolean large) {
+        if (!large) {
+            mHeader.setTranslationY(0);
+            setToolbarTitleAlpha(1f);
+            return;
+        }
+        final int range = mTitle.getLayoutParams().height;
+        // Not scrolled while the list is still empty; scrolled all the way once the first item
+        // is out of view; in between exactly measured.
+        int scrolled = 0;
+        if (mList.getChildCount() > 0) {
+            scrolled = range;
+            // The first item by position: a row animating away may still be child 0.
+            View first = null;
+            for (int i = 0; i < mList.getChildCount(); i++) {
+                final View child = mList.getChildAt(i);
+                if (mList.getChildAdapterPosition(child) == 0) {
+                    first = child;
+                    break;
+                }
+            }
+            if (first != null) {
+                final RecyclerView.LayoutParams params =
+                        (RecyclerView.LayoutParams) first.getLayoutParams();
+                scrolled = mList.getPaddingTop()
+                        - (mList.getLayoutManager().getDecoratedTop(first) - params.topMargin);
+            }
+        }
+        final int shift = Math.max(0, Math.min(scrolled, range));
+        final float fraction = range == 0 ? 0f : (float) shift / range;
+        mHeader.setTranslationY(-shift);
+        mTitle.setAlpha(1f - fraction);
+        // The small title only once the large one is mostly gone, so the two never stand
+        // half faded one above the other.
+        setToolbarTitleAlpha(Math.max(0f, (fraction - 0.6f) / 0.4f));
+    }
+
+    /** The bar's own title - the window's action bar - faded in as the large one goes. */
+    private void setToolbarTitleAlpha(float fraction) {
+        if (mToolbar == null) {
+            // Settings' own tool bar; the window's action bar where a page has none.
+            View bar = mActivity.findViewById(R.id.action_bar);
+            if (!(bar instanceof Toolbar)) {
+                final int id = Resources.getSystem().getIdentifier("action_bar", "id", "android");
+                bar = id == 0 ? null : mActivity.getWindow().getDecorView().findViewById(id);
+            }
+            if (!(bar instanceof Toolbar)) return;
+            mToolbar = (Toolbar) bar;
+            final TypedArray a = mToolbar.getContext().obtainStyledAttributes(
+                    new int[] { android.R.attr.textColorPrimary });
+            mToolbarTitleColor = a.getColor(0, Color.BLACK);
+            a.recycle();
+        }
+        final int alpha = Math.round(Color.alpha(mToolbarTitleColor) * fraction);
+        if (alpha == mToolbarTitleAlpha) return;
+        mToolbarTitleAlpha = alpha;
+        mToolbar.setTitleTextColor((mToolbarTitleColor & 0x00ffffff) | (alpha << 24));
+    }
+}
