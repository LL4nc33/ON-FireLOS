+package com.android.settings.widget;
+
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.support.v7.preference.Preference;
+import android.support.v7.preference.PreferenceViewHolder;
+import android.util.AttributeSet;
+import android.view.LayoutInflater;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+/**
+ * ON-FireLOS: a card at the end of a page with the pages that belong to it, for whoever came
+ * here looking for something nearby. Each page's links by the preference's key.
+ */
+public class RelatedLinksPreference extends Preference {
+
+    public RelatedLinksPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.onfirelos_related_links);
+        setSelectable(false);
+    }
+
+    private static final class Link {
+        final int title;
+        final Intent intent;
+
+        Link(int title, Intent intent) {
+            this.title = title;
+            this.intent = intent;
+        }
+    }
+
+    // A page of Settings itself, by its activity.
+    private static Link page(int title, String activity) {
+        return new Link(title, new Intent().setClassName("com.android.settings",
+                "com.android.settings.Settings$" + activity));
+    }
+
+    private Link[] links() {
+        switch (String.valueOf(getKey())) {
+            case "onfirelos_related_display":
+                return new Link[] {
+                    page(R.string.accessibility_settings, "AccessibilitySettingsActivity"),
+                    page(R.string.power_usage_summary_title, "PowerUsageSummaryActivity"),
+                    page(R.string.security_settings_title, "SecurityDashboardActivity"),
+                };
+            case "onfirelos_related_sound":
+                return new Link[] {
+                    page(R.string.app_and_notification_dashboard_title,
+                            "AppAndNotificationDashboardActivity"),
+                    page(R.string.connected_devices_dashboard_title,
+                            "ConnectedDeviceDashboardActivity"),
+                    page(R.string.accessibility_settings, "AccessibilitySettingsActivity"),
+                };
+            case "onfirelos_related_battery":
+                return new Link[] {
+                    page(R.string.display_settings, "DisplaySettingsActivity"),
+                    page(R.string.app_and_notification_dashboard_title,
+                            "AppAndNotificationDashboardActivity"),
+                    page(R.string.network_dashboard_title, "NetworkDashboardActivity"),
+                };
+            case "onfirelos_related_network":
+                return new Link[] {
+                    page(R.string.connected_devices_dashboard_title,
+                            "ConnectedDeviceDashboardActivity"),
+                    page(R.string.security_settings_title, "SecurityDashboardActivity"),
+                    page(R.string.power_usage_summary_title, "PowerUsageSummaryActivity"),
+                };
+            case "onfirelos_related_security":
+                return new Link[] {
+                    page(R.string.account_dashboard_title, "AccountDashboardActivity"),
+                    page(R.string.app_and_notification_dashboard_title,
+                            "AppAndNotificationDashboardActivity"),
+                    page(R.string.header_category_system, "SystemDashboardActivity"),
+                };
+            case "onfirelos_related_system":
+                return new Link[] {
+                    page(R.string.storage_settings, "StorageDashboardActivity"),
+                    page(R.string.power_usage_summary_title, "PowerUsageSummaryActivity"),
+                    page(R.string.about_settings, "DeviceInfoSettingsActivity"),
+                };
+            default:
+                return new Link[0];
+        }
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        final LinearLayout box = (LinearLayout) holder.findViewById(R.id.onfirelos_related_links);
+        box.removeAllViews();
+        final LayoutInflater inflater = LayoutInflater.from(getContext());
+        for (Link link : links()) {
+            final Intent intent = link.intent;
+            if (intent.resolveActivity(getContext().getPackageManager()) == null) {
+                continue;
+            }
+            final TextView view = (TextView) inflater.inflate(
+                    R.layout.onfirelos_related_link, box, false);
+            view.setText(link.title);
+            view.setOnClickListener(v -> {
+                try {
+                    getContext().startActivity(intent);
+                } catch (ActivityNotFoundException e) {
+                    // Gone since the page was shown.
+                }
+            });
+            box.addView(view);
+        }
+    }
+}
