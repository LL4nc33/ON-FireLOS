+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.display;
+
+import static com.android.settingslib.display.BrightnessUtils.GAMMA_SPACE_MAX;
+import static com.android.settingslib.display.BrightnessUtils.convertGammaToLinear;
+import static com.android.settingslib.display.BrightnessUtils.convertLinearToGamma;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.database.ContentObserver;
+import android.hardware.display.DisplayManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.provider.Settings;
+import android.support.v7.preference.Preference;
+import android.support.v7.preference.PreferenceViewHolder;
+import android.util.AttributeSet;
+import android.widget.SeekBar;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+import java.text.NumberFormat;
+
+/**
+ * ON-FireLOS: brightness on the Display page itself, instead of an entry that opened the
+ * brightness dialog. As the quick settings slider does: the screen follows the finger at once
+ * (a temporary brightness), the setting is written when the finger lifts; automatic brightness
+ * takes the same setting as its starting point. The level is shown in percent, as before.
+ */
+public class BrightnessSliderPreference extends Preference
+        implements SeekBar.OnSeekBarChangeListener {
+    private final ContentResolver mResolver;
+    private final DisplayManager mDisplayManager;
+    private final int mMin;
+    private final int mMax;
+    private boolean mTracking;
+    private TextView mValue;
+
+    private final ContentObserver mObserver = new ContentObserver(new Handler(Looper.getMainLooper())) {
+        @Override
+        public void onChange(boolean selfChange) {
+            if (!mTracking) {
+                notifyChanged();
+            }
+        }
+    };
+
+    public BrightnessSliderPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.onfirelos_brightness_slider);
+        setSelectable(false);
+        mResolver = context.getContentResolver();
+        mDisplayManager = context.getSystemService(DisplayManager.class);
+        final PowerManager power = context.getSystemService(PowerManager.class);
+        mMin = power.getMinimumScreenBrightnessSetting();
+        mMax = power.getMaximumScreenBrightnessSetting();
+        if (context.getSystemService(UserManager.class)
+                .hasUserRestriction(UserManager.DISALLOW_CONFIG_BRIGHTNESS)) {
+            setEnabled(false);
+        }
+    }
+
+    @Override
+    public void onAttached() {
+        super.onAttached();
+        mResolver.registerContentObserver(
+                Settings.System.getUriFor(Settings.System.SCREEN_BRIGHTNESS), false, mObserver);
+    }
+
+    @Override
+    public void onDetached() {
+        mResolver.unregisterContentObserver(mObserver);
+        super.onDetached();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        final SeekBar slider = (SeekBar) holder.findViewById(R.id.onfirelos_brightness_seekbar);
+        mValue = (TextView) holder.findViewById(R.id.onfirelos_brightness_value);
+        slider.setOnSeekBarChangeListener(null);
+        slider.setMax(GAMMA_SPACE_MAX);
+        if (!mTracking) {
+            slider.setProgress(convertLinearToGamma(Settings.System.getIntForUser(mResolver,
+                    Settings.System.SCREEN_BRIGHTNESS, mMax, UserHandle.USER_CURRENT), mMin, mMax));
+        }
+        slider.setEnabled(isEnabled());
+        slider.setContentDescription(getTitle());
+        slider.setOnSeekBarChangeListener(this);
+        showLevel(slider.getProgress());
+    }
+
+    private void showLevel(int gamma) {
+        if (mValue != null) {
+            mValue.setText(NumberFormat.getPercentInstance().format(
+                    (double) gamma / GAMMA_SPACE_MAX));
+        }
+    }
+
+    @Override
+    public void onProgressChanged(SeekBar slider, int progress, boolean fromUser) {
+        showLevel(progress);
+        if (fromUser) {
+            mDisplayManager.setTemporaryBrightness(convertGammaToLinear(progress, mMin, mMax));
+        }
+    }
+
+    @Override
+    public void onStartTrackingTouch(SeekBar slider) {
+        mTracking = true;
+    }
+
+    @Override
+    public void onStopTrackingTouch(SeekBar slider) {
+        mTracking = false;
+        Settings.System.putIntForUser(mResolver, Settings.System.SCREEN_BRIGHTNESS,
+                convertGammaToLinear(slider.getProgress(), mMin, mMax), UserHandle.USER_CURRENT);
+    }
+}
