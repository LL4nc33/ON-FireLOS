+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.widget;
+
+import android.content.res.Resources;
+import android.support.v7.widget.RecyclerView;
+import android.view.View;
+
+import com.android.settings.R;
+
+/**
+ * The home screen's large title (docs/DESIGN.md). The header - title and search bar - lies over
+ * the list, which starts below it; as the list scrolls, the header moves up with it until the
+ * title is gone and the search bar is at the top, and the title fades on the way.
+ */
+public final class LargeTitleController extends RecyclerView.OnScrollListener
+        implements View.OnLayoutChangeListener {
+    private final View mHeader;
+    private final View mTitle;
+    private final RecyclerView mList;
+    private final int mListPaddingTop;
+
+    /** Does nothing where the layout has no header (the screens below the home screen). */
+    public static void attach(View header, RecyclerView list) {
+        if (header == null || list == null) return;
+        final LargeTitleController controller = new LargeTitleController(header, list);
+        // The list must start below the header before its first layout: a list restored
+        // with its items (after a rotation) lays them out at once, and items placed at the
+        // old top stay there, under the header. The header's height is known beforehand;
+        // its layout only confirms it.
+        final Resources res = list.getResources();
+        controller.setHeaderHeight(res.getDimensionPixelSize(R.dimen.onfirelos_large_title_height)
+                + res.getDimensionPixelSize(R.dimen.search_bar_height)
+                + 2 * res.getDimensionPixelSize(R.dimen.search_bar_margin));
+        header.addOnLayoutChangeListener(controller);
+        list.addOnScrollListener(controller);
+    }
+
+    private LargeTitleController(View header, RecyclerView list) {
+        mHeader = header;
+        mTitle = header.findViewById(R.id.onfirelos_large_title);
+        mList = list;
+        mListPaddingTop = list.getPaddingTop();
+    }
+
+    @Override
+    public void onLayoutChange(View v, int left, int top, int right, int bottom,
+            int oldLeft, int oldTop, int oldRight, int oldBottom) {
+        // A changed height moves the list right after this layout pass, not from within it.
+        final int height = bottom - top;
+        if (mList.getPaddingTop() != mListPaddingTop + height) {
+            mList.post(() -> setHeaderHeight(height));
+        } else {
+            update();
+        }
+    }
+
+    /**
+     * The list starts below the whole header; when that changes, it lays itself out again and
+     * reports a scroll of 0, which places the header. Returns whether it changed.
+     */
+    private boolean setHeaderHeight(int height) {
+        final int paddingTop = mListPaddingTop + height;
+        if (mList.getPaddingTop() == paddingTop) return false;
+        mList.setPadding(mList.getPaddingLeft(), paddingTop, mList.getPaddingRight(),
+                mList.getPaddingBottom());
+        return true;
+    }
+
+    @Override
+    public void onScrolled(RecyclerView recyclerView, int dx, int dy) {
+        update();
+    }
+
+    private void update() {
+        final int range = mTitle.getHeight();
+        // Scrolled far enough when the first item is out of view, exactly measured before.
+        int scrolled = range;
+        // The first item by position: a row animating away may still be child 0.
+        View first = null;
+        for (int i = 0; i < mList.getChildCount() && first == null; i++) {
+            if (mList.getChildAdapterPosition(mList.getChildAt(i)) == 0) {
+                first = mList.getChildAt(i);
+            }
+        }
+        if (first != null) {
+            final RecyclerView.LayoutParams params =
+                    (RecyclerView.LayoutParams) first.getLayoutParams();
+            scrolled = mList.getPaddingTop()
+                    - (mList.getLayoutManager().getDecoratedTop(first) - params.topMargin);
+        }
+        final int shift = Math.max(0, Math.min(scrolled, range));
+        mHeader.setTranslationY(-shift);
+        mTitle.setAlpha(range == 0 ? 1f : 1f - (float) shift / range);
+    }
+}
