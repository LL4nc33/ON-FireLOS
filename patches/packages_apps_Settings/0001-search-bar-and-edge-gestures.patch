+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Battery protection: charge only to 80 %. For a tablet that stays plugged in
+ * (a wall dashboard, a media player), where a battery kept full wears out and
+ * can swell. Init hands the property to the charger driver.
+ */
+public class BatteryProtectionPreferenceController extends TogglePreferenceController {
+    private static final String PROPERTY = "persist.sys.charge_limit";
+    private static final String LIMIT = "80";
+
+    public BatteryProtectionPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        String limit = SystemProperties.get(PROPERTY, "0");
+        return !limit.isEmpty() && !"0".equals(limit);
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        SystemProperties.set(PROPERTY, isChecked ? LIMIT : "0");
+        return true;
+    }
+}
