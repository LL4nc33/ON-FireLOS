+package com.android.settings.display;
+
+import android.content.Context;
+import android.content.res.TypedArray;
+import android.graphics.drawable.GradientDrawable;
+import android.support.v7.preference.Preference;
+import android.support.v7.preference.PreferenceViewHolder;
+import android.util.AttributeSet;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.RadioButton;
+import android.widget.TextView;
+
+import com.android.settings.R;
+
+import lineageos.providers.LineageSettings;
+import lineageos.style.StyleInterface;
+
+/**
+ * ON-FireLOS: the system's look - light, dark, or following the time of day - picked on three
+ * small pictures of a page in that look. It is LineageOS' global style setting, which the dark
+ * mode tile in quick settings switches too; the style page next to it keeps the accent colours.
+ */
+public class StylePickerPreference extends Preference {
+    private static final int AUTO = StyleInterface.STYLE_GLOBAL_AUTO_DAYTIME;
+    private static final int LIGHT = StyleInterface.STYLE_GLOBAL_LIGHT;
+    private static final int DARK = StyleInterface.STYLE_GLOBAL_DARK;
+
+    public StylePickerPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.onfirelos_style_picker);
+        setSelectable(false);
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        final int current = LineageSettings.System.getInt(getContext().getContentResolver(),
+                LineageSettings.System.BERRY_GLOBAL_STYLE,
+                StyleInterface.STYLE_GLOBAL_AUTO_WALLPAPER);
+        bind(holder.findViewById(R.id.onfirelos_style_light), LIGHT, current);
+        bind(holder.findViewById(R.id.onfirelos_style_dark), DARK, current);
+        bind(holder.findViewById(R.id.onfirelos_style_auto), AUTO, current);
+    }
+
+    // Automatic covers both automatic settings (by wallpaper, the default, and by time of day);
+    // picking it from the wallpaper one moves it to the time of day.
+    private void bind(View option, int style, int current) {
+        final boolean selected = style == AUTO ? current != LIGHT && current != DARK
+                : current == style;
+        final ViewGroup group = (ViewGroup) option;
+        final View preview = group.getChildAt(0);
+        final TextView label = (TextView) group.getChildAt(1);
+        final RadioButton radio = (RadioButton) group.getChildAt(2);
+        radio.setChecked(selected);
+        option.setContentDescription(label.getText());
+        option.setSelected(selected);
+        // The picked look ringed in the accent.
+        if (selected) {
+            final TypedArray a = getContext().obtainStyledAttributes(
+                    new int[] { android.R.attr.colorAccent });
+            final GradientDrawable ring = new GradientDrawable();
+            final float density = getContext().getResources().getDisplayMetrics().density;
+            ring.setCornerRadius(13 * density);
+            ring.setStroke(Math.round(2 * density), a.getColor(0, 0));
+            a.recycle();
+            preview.setBackground(ring);
+        } else {
+            preview.setBackground(null);
+        }
+        option.setOnClickListener(v -> {
+            if (current != style) {
+                LineageSettings.System.putInt(getContext().getContentResolver(),
+                        LineageSettings.System.BERRY_GLOBAL_STYLE, style);
+                // Picked here, the style is the system's own again: the style settings would
+                // otherwise still name an app that set it before as managing it.
+                LineageSettings.System.putString(getContext().getContentResolver(),
+                        LineageSettings.System.BERRY_MANAGED_BY_APP, "");
+                notifyChanged();
+            }
+        });
+    }
+}
