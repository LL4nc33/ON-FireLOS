+package com.android.settings.gestures;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Edge gestures (SystemUI EdgeGestures): back, forward and app switching by
+ * swiping in from the screen edges. Always available - which also makes the
+ * Gestures page show up on a device without any of Android's own gestures.
+ */
+public class EdgeGesturePreferenceController extends TogglePreferenceController {
+    static final String SETTING = "onfirelos_edge_gestures";
+
+    public EdgeGesturePreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(), SETTING, 1) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(), SETTING, isChecked ? 1 : 0);
+    }
+}
