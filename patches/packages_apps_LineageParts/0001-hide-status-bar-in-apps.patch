+
+package org.lineageos.lineageparts.widget;
+
+import android.content.Context;
+import android.content.res.TypedArray;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Outline;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.support.v7.preference.Preference;
+import android.support.v7.preference.PreferenceCategory;
+import android.support.v7.preference.PreferenceGroupAdapter;
+import android.support.v7.widget.RecyclerView;
+import android.view.View;
+import android.view.ViewOutlineProvider;
+
+import java.util.WeakHashMap;
+
+/**
+ * ON-FireLOS: lays a preference list on rounded cards (docs/DESIGN.md), as in Settings - one
+ * card for each run of items between category titles. The cards are painted behind the items,
+ * so their layouts, ripples and click areas stay as they are; only the first and last item of a
+ * card are clipped to its corners, so that a ripple does not spill over them.
+ */
+public class CardGroupDecoration extends RecyclerView.ItemDecoration {
+
+    private static final int TYPE_CARD = 0;
+    private static final int TYPE_HEADER = 1;
+    private static final int TYPE_OTHER = 2;
+
+    // The card corners an item carries; NOT_ON_CARD for the items beside the cards.
+    private static final int NOT_ON_CARD = -1;
+    private static final int CORNER_TOP = 1;
+    private static final int CORNER_BOTTOM = 2;
+
+    private final float mDensity;
+    private final int mGap;
+    private final int mRadius;
+    private final int mColor;
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final ViewOutlineProvider[] mOutlines = {
+            null,
+            new CornerOutline(CORNER_TOP),
+            new CornerOutline(CORNER_BOTTOM),
+            new CornerOutline(CORNER_TOP | CORNER_BOTTOM)};
+    // What an item had before it was clipped to a card corner.
+    private final WeakHashMap<View, Saved> mSaved = new WeakHashMap<>();
+
+    private RecyclerView mParent;
+    private RecyclerView.Adapter<?> mAdapter;
+    private int mWidth = -1;
+
+    // The gaps depend on the neighbours, and RecyclerView does not recompute the offsets of the
+    // items next to an insertion or removal; so every structural change recomputes them all.
+    private final RecyclerView.AdapterDataObserver mObserver =
+            new RecyclerView.AdapterDataObserver() {
+                @Override
+                public void onChanged() {
+                    invalidate();
+                }
+
+                @Override
+                public void onItemRangeInserted(int positionStart, int itemCount) {
+                    invalidate();
+                }
+
+                @Override
+                public void onItemRangeRemoved(int positionStart, int itemCount) {
+                    invalidate();
+                }
+
+                @Override
+                public void onItemRangeMoved(int fromPosition, int toPosition, int itemCount) {
+                    invalidate();
+                }
+            };
+
+    public CardGroupDecoration(Context context) {
+        final float density = context.getResources().getDisplayMetrics().density;
+        mDensity = density;
+        mGap = Math.round(16 * density);
+        mRadius = Math.round(20 * density);
+        final TypedArray a = context.obtainStyledAttributes(
+                new int[] { android.R.attr.colorBackgroundFloating });
+        mColor = a.getColor(0, Color.WHITE);
+        a.recycle();
+        mPaint.setColor(mColor);
+        // The line: the text colour faintly over the card, in either mode.
+        final TypedArray line = context.obtainStyledAttributes(
+                new int[] { android.R.attr.textColorPrimary });
+        mLineColor = blend(mColor, line.getColor(0, Color.BLACK), 0.1f);
+        line.recycle();
+        mLinePaint.setColor(mLineColor);
+        mLineInset = Math.round(20 * context.getResources().getDisplayMetrics().density);
+    }
+
+    @Override
+    public void getItemOffsets(Rect outRect, View view, RecyclerView parent,
+            RecyclerView.State state) {
+        watch(parent);
+        // Every item is indented, so that the category titles stay in line with the items - by
+        // the list's width, as Settings' column on a tablet.
+        final float width = parent.getWidth() / mDensity;
+        final int margin = Math.round((width >= 1100 ? 160 : width >= 760 ? 80 : 16) * mDensity);
+        outRect.set(margin, 0, margin, 0);
+        final int position = parent.getChildAdapterPosition(view);
+        if (position == RecyclerView.NO_POSITION || type(position) != TYPE_CARD) {
+            return;
+        }
+        // A category title keeps its own distance to the card below it.
+        final int previous = type(position - 1);
+        if (previous != TYPE_CARD && previous != TYPE_HEADER) {
+            outRect.top = mGap;
+        }
+        if (type(position + 1) != TYPE_CARD) {
+            outRect.bottom = mGap;
+        }
+    }
+
+    @Override
+    public void onDraw(Canvas c, RecyclerView parent, RecyclerView.State state) {
+        watch(parent);
+        if (parent.getWidth() != mWidth) {
+            if (mWidth >= 0) {
+                parent.post(parent::invalidateItemDecorations);
+            }
+            mWidth = parent.getWidth();
+        }
+        final int count = parent.getChildCount();
+        for (int i = 0; i < count; i++) {
+            final View child = parent.getChildAt(i);
+            final int corners = corners(parent.getChildAdapterPosition(child));
+            if (corners != NOT_ON_CARD) {
+                drawCard(c, child, corners);
+                if (mLines && (corners & CORNER_BOTTOM) == 0) {
+                    drawLine(c, child);
+                }
+            }
+            clip(child, corners);
+        }
+    }
+
+    // ON-FireLOS: a fine line between two items of a card, inset from its edges.
+    private final Paint mLinePaint = new Paint();
+    private int mLineColor;
+    private int mLineInset;
+    private boolean mLines = true;
+
+    private void drawLine(Canvas c, View child) {
+        final float left = child.getLeft() + child.getTranslationX() + mLineInset;
+        final float right = child.getRight() + child.getTranslationX() - mLineInset;
+        final float bottom = child.getBottom() + child.getTranslationY();
+        mLinePaint.setAlpha(Math.round(Color.alpha(mLineColor) * child.getAlpha()));
+        c.drawRect(left, bottom - 1, right, bottom, mLinePaint);
+    }
+
+    private static int blend(int base, int over, float fraction) {
+        return Color.rgb(
+                Math.round(Color.red(base) * (1 - fraction) + Color.red(over) * fraction),
+                Math.round(Color.green(base) * (1 - fraction) + Color.green(over) * fraction),
+                Math.round(Color.blue(base) * (1 - fraction) + Color.blue(over) * fraction));
+    }
+
+    private int corners(int position) {
+        if (position == RecyclerView.NO_POSITION || type(position) != TYPE_CARD) {
+            return NOT_ON_CARD;
+        }
+        int corners = 0;
+        if (type(position - 1) != TYPE_CARD) {
+            corners |= CORNER_TOP;
+        }
+        if (type(position + 1) != TYPE_CARD) {
+            corners |= CORNER_BOTTOM;
+        }
+        return corners;
+    }
+
+    private int type(int position) {
+        final RecyclerView.Adapter<?> adapter = mAdapter;
+        if (!(adapter instanceof PreferenceGroupAdapter) || position < 0
+                || position >= adapter.getItemCount()) {
+            return TYPE_OTHER;
+        }
+        final Preference preference = ((PreferenceGroupAdapter) adapter).getItem(position);
+        if (preference instanceof PreferenceCategory) {
+            return TYPE_HEADER;
+        }
+        return preference == null ? TYPE_OTHER : TYPE_CARD;
+    }
+
+    // The item's slice of its card. The rectangle reaches past the item's edges that are no
+    // card corners and is clipped there, so only the corners the item carries are round.
+    private void drawCard(Canvas c, View child, int corners) {
+        final float left = child.getLeft() + child.getTranslationX();
+        final float top = child.getTop() + child.getTranslationY();
+        final float right = child.getRight() + child.getTranslationX();
+        final float bottom = child.getBottom() + child.getTranslationY();
+        mRect.set(left, (corners & CORNER_TOP) != 0 ? top : top - mRadius, right,
+                (corners & CORNER_BOTTOM) != 0 ? bottom : bottom + mRadius);
+        mPaint.setAlpha(Math.round(Color.alpha(mColor) * child.getAlpha()));
+        c.save();
+        c.clipRect(left, top, right, bottom);
+        c.drawRoundRect(mRect, mRadius, mRadius, mPaint);
+        c.restore();
+    }
+
+    // Clips the first and last item of a card to its corners; items in the middle of a card or
+    // beside the cards get back the outline they had, also when a recycled view moves there.
+    private void clip(View child, int corners) {
+        Saved saved = mSaved.get(child);
+        if (corners <= 0) {
+            if (saved != null) {
+                child.setOutlineProvider(saved.mProvider);
+                child.setClipToOutline(saved.mClip);
+                mSaved.remove(child);
+            }
+            return;
+        }
+        if (saved == null) {
+            saved = new Saved(child.getOutlineProvider(), child.getClipToOutline());
+            mSaved.put(child, saved);
+        } else if (saved.mCorners == corners) {
+            return;
+        }
+        saved.mCorners = corners;
+        child.setOutlineProvider(mOutlines[corners]);
+        child.setClipToOutline(true);
+    }
+
+    private void watch(RecyclerView parent) {
+        mParent = parent;
+        final RecyclerView.Adapter<?> adapter = parent.getAdapter();
+        if (adapter == mAdapter) {
+            return;
+        }
+        if (mAdapter != null) {
+            mAdapter.unregisterAdapterDataObserver(mObserver);
+        }
+        mAdapter = adapter;
+        if (adapter != null) {
+            adapter.registerAdapterDataObserver(mObserver);
+        }
+    }
+
+    private void invalidate() {
+        final RecyclerView parent = mParent;
+        if (parent == null) {
+            return;
+        }
+        if (parent.isComputingLayout()) {
+            parent.post(parent::invalidateItemDecorations);
+        } else {
+            parent.invalidateItemDecorations();
+        }
+    }
+
+    private static final class Saved {
+        final ViewOutlineProvider mProvider;
+        final boolean mClip;
+        int mCorners;
+
+        Saved(ViewOutlineProvider provider, boolean clip) {
+            mProvider = provider;
+            mClip = clip;
+        }
+    }
+
+    // A round rectangle that reaches past the edges without a card corner.
+    private final class CornerOutline extends ViewOutlineProvider {
+        private final int mCorners;
+
+        CornerOutline(int corners) {
+            mCorners = corners;
+        }
+
+        @Override
+        public void getOutline(View view, Outline outline) {
+            final int top = (mCorners & CORNER_TOP) != 0 ? 0 : -mRadius;
+            final int bottom = view.getHeight() + ((mCorners & CORNER_BOTTOM) != 0 ? 0 : mRadius);
+            outline.setRoundRect(0, top, view.getWidth(), bottom, mRadius);
+        }
+    }
+}
