+    }
+
+    /** Tokens of the immersive.status filter, e.g. [apps, com.x, -com.y]. */
+    private List<String> statusTokens() {
+        List<String> tokens = new ArrayList<>();
+        for (String part : policyParts()) {
+            if (part.startsWith(STATUS_FILTER + "=")) {
+                for (String token : part.substring(STATUS_FILTER.length() + 1).split(",")) {
+                    if (!token.trim().isEmpty()) {
+                        tokens.add(token.trim());
+                    }
+                }
+            }
+        }
+        return tokens;
+    }
