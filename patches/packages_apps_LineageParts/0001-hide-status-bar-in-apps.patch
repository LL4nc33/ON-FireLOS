diff --git a/src/org/lineageos/lineageparts/widget/CardGroupDecoration.java b/src/org/lineageos/lineageparts/widget/CardGroupDecoration.java
new file mode 100644
index 0000000..4aa32dc
--- /dev/null
+++ b/src/org/lineageos/lineageparts/widget/CardGroupDecoration.java
@@ -0,0 +1,301 @@
+/*
