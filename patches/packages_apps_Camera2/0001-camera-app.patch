+    // ON-FireLOS: the navigation bar's button for the camera. Only the system
+    // may send these (STATUS_BAR); the mode list goes the way of a menu key.
+    private static final String ACTION_MODE_LIST = "org.lineageos.camera.action.MODE_LIST";
+    private static final String ACTION_MODE_OPTIONS =
+            "org.lineageos.camera.action.MODE_OPTIONS";
+    private boolean mNavBarReceiverRegistered;
+    private final BroadcastReceiver mNavBarReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (mPaused || mFilmstripVisible || mCameraAppUI == null) {
+                return;
+            }
+            if (ACTION_MODE_LIST.equals(intent.getAction())) {
+                onKeyUp(KeyEvent.KEYCODE_MENU,
+                        new KeyEvent(KeyEvent.ACTION_UP, KeyEvent.KEYCODE_MENU));
+            } else if (ACTION_MODE_OPTIONS.equals(intent.getAction())) {
+                mCameraAppUI.toggleModeOptions();
+            }
+        }
+    };
