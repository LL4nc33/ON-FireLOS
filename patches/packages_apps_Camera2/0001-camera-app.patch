diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 6595990..58731fa 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -152,11 +152,20 @@
             android:configChanges="keyboardHidden|orientation|screenSize">
         </activity>
 
-        <receiver android:name="com.android.camera.DisableCameraReceiver">
-            <intent-filter>
-                <action android:name="android.intent.action.BOOT_COMPLETED" />
-            </intent-filter>
-        </receiver>
+        <!-- DisableCameraReceiver removed.
+
+             It ran once at boot, counted the cameras with
+             Camera.getNumberOfCameras() and, if there were none, permanently
+             disabled the launcher icon com.android.camera.CameraLauncher -
+             then itself, so it never ran again. The source has no way to
+             switch it back on.
+
+             On suez the camera reported zero before the HAL fix. Consequence:
+             the app was installed and fully working, but no longer had an icon
+             in the app list, and no reboot could cure that. The state lives
+             in /data and survives even a flash without a wipe.
+
+             suez has two cameras. The receiver can only do harm here. -->
     </application>
 
 </manifest>
