diff --git a/src/com/android/documentsui/dirlist/LargeTitleDecoration.java b/src/com/android/documentsui/dirlist/LargeTitleDecoration.java
new file mode 100644
index 0000000..400c245
--- /dev/null
+++ b/src/com/android/documentsui/dirlist/LargeTitleDecoration.java
@@ -0,0 +1,129 @@
+/*
+ * Copyright (C) 2026 The ON-FireLOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.documentsui.dirlist;
+
+import android.content.res.Resources;
+import android.content.res.TypedArray;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.support.v7.widget.GridLayoutManager;
+import android.support.v7.widget.RecyclerView;
+import android.text.TextPaint;
+import android.text.TextUtils;
+import android.view.View;
+import android.widget.Toolbar;
+
+import com.android.documentsui.BaseActivity;
+import com.android.documentsui.R;
+
+/**
+ * The large title above a root's top level (docs/DESIGN.md). The first row of the grid moves
+ * down to make room and the title is drawn above it, so it scrolls away with the content; the
+ * tool bar's title, which says the same, fades in as it goes.
+ */
+final class LargeTitleDecoration extends RecyclerView.ItemDecoration {
+    private final BaseActivity mActivity;
+    private final TextPaint mPaint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final int mHeight;
+    private final int mPaddingStart;
+    private final int mPaddingBottom;
+    private final int mToolbarTitleColor;
+    private int mToolbarTitleAlpha = -1;
+
+    LargeTitleDecoration(BaseActivity activity) {
+        mActivity = activity;
+        final Resources res = activity.getResources();
+        mHeight = res.getDimensionPixelSize(R.dimen.onfirelos_large_title_height);
+        mPaddingStart = res.getDimensionPixelSize(R.dimen.onfirelos_large_title_padding_start);
+        mPaddingBottom = res.getDimensionPixelSize(R.dimen.onfirelos_large_title_padding_bottom);
+        mPaint.setTextSize(res.getDimension(R.dimen.onfirelos_large_title_text_size));
+        final TypedArray a = activity.obtainStyledAttributes(
+                new int[] { android.R.attr.textColorPrimary });
+        mPaint.setColor(a.getColor(0, Color.BLACK));
+        a.recycle();
+        final Toolbar toolbar = activity.findViewById(R.id.toolbar);
+        final TypedArray t = (toolbar != null ? toolbar.getContext() : activity)
+                .obtainStyledAttributes(new int[] { android.R.attr.textColorPrimary });
+        mToolbarTitleColor = t.getColor(0, Color.BLACK);
+        t.recycle();
+    }
+
+    @Override
+    public void getItemOffsets(Rect outRect, View view, RecyclerView parent,
+            RecyclerView.State state) {
+        if (isFirstRow(parent, parent.getChildAdapterPosition(view))) {
+            outRect.top = mHeight;
+        }
+    }
+
+    @Override
+    public void onDraw(Canvas c, RecyclerView parent, RecyclerView.State state) {
+        View first = null;
+        for (int i = 0; i < parent.getChildCount() && first == null; i++) {
+            final View child = parent.getChildAt(i);
+            if (isFirstRow(parent, parent.getChildAdapterPosition(child))) {
+                first = child;
+            }
+        }
+        if (first == null) {
+            // Scrolled away (or nothing to show yet): only the tool bar's title.
+            setToolbarTitleAlpha(1f);
+            return;
+        }
+        final int top = parent.getLayoutManager().getDecoratedTop(first)
+                + Math.round(first.getTranslationY());
+        setToolbarTitleAlpha(Math.max(0f, Math.min(1f,
+                (parent.getPaddingTop() - top) / (float) mHeight)));
+
+        final CharSequence title = mActivity.getCurrentRoot().title;
+        if (TextUtils.isEmpty(title)) return;
+        final boolean rtl = parent.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL;
+        final int start = parent.getPaddingStart() + mPaddingStart;
+        final int width = parent.getWidth() - start - parent.getPaddingEnd() - mPaddingStart;
+        final CharSequence text = TextUtils.ellipsize(title, mPaint, width,
+                TextUtils.TruncateAt.END);
+        final float x = rtl ? parent.getWidth() - start - mPaint.measureText(text, 0, text.length())
+                : start;
+        final float y = top + mHeight - mPaddingBottom - mPaint.descent();
+        c.drawText(text, 0, text.length(), x, y, mPaint);
+    }
+
+    /** The tool bar's own title back at full strength, when the list goes. */
+    void release() {
+        setToolbarTitleAlpha(1f);
+    }
+
+    private static boolean isFirstRow(RecyclerView parent, int position) {
+        if (position == RecyclerView.NO_POSITION) return false;
+        final RecyclerView.LayoutManager layout = parent.getLayoutManager();
+        if (layout instanceof GridLayoutManager) {
+            final GridLayoutManager grid = (GridLayoutManager) layout;
+            return grid.getSpanSizeLookup().getSpanGroupIndex(position, grid.getSpanCount()) == 0;
+        }
+        return position == 0;
+    }
+
+    private void setToolbarTitleAlpha(float fraction) {
+        final int alpha = Math.round(Color.alpha(mToolbarTitleColor) * fraction);
+        if (alpha == mToolbarTitleAlpha) return;
+        final Toolbar toolbar = mActivity.findViewById(R.id.toolbar);
+        if (toolbar == null) return;
+        mToolbarTitleAlpha = alpha;
+        toolbar.setTitleTextColor((mToolbarTitleColor & 0x00ffffff) | (alpha << 24));
+    }
+}
