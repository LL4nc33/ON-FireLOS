--- /dev/null
+++ b/res/values-night/onfirelos_colors.xml
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 ON-FireLOS, Apache-2.0. The design tokens of
+     docs/DESIGN.md for the calculator, dark. -->
+<resources>
+    <color name="onfirelos_background">#1A1C18</color>
+    <color name="onfirelos_surface">#24271F</color>
+    <!-- The advanced pad: set apart by tone, not by the accent. -->
+    <color name="onfirelos_surface_variant">#2F332B</color>
+    <color name="onfirelos_text">#E4E6DD</color>
+    <!-- Preview result and the exponent while scrolling: the old alphas
+         (42 % and 25 %) on the text colour. -->
+    <color name="onfirelos_text_result">#6CE4E6DD</color>
+    <color name="onfirelos_text_exponent">#40E4E6DD</color>
+    <color name="onfirelos_accent">#8AA366</color>
+    <!-- Pressed and selected (INV, DEG) on the advanced pad. -->
+    <color name="onfirelos_ripple_soft">#1FFFFFFF</color>
+</resources>
