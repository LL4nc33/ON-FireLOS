diff --git a/build/tasks/bacon.mk b/build/tasks/bacon.mk
index f018440..7339aab 100644
--- a/build/tasks/bacon.mk
+++ b/build/tasks/bacon.mk
@@ -16,7 +16,14 @@
 # -----------------------------------------------------------------
 # Lineage OTA update package
 
-LINEAGE_TARGET_PACKAGE := $(PRODUCT_OUT)/lineage-$(LINEAGE_VERSION).zip
+# ON-FireLOS instead of lineage in the file name.
+#
+# LineageOS explicitly asks in its trademark policy not to ship modified
+# builds under its name. This is one: own camera stack, own kernel with
+# unlocked clock steps, f2fs, ZRAM. So the name has to change, not out of
+# vanity, but because it is correct. The base remains LineageOS 16.0 and
+# is named as such.
+LINEAGE_TARGET_PACKAGE := $(PRODUCT_OUT)/ON-FireLOS-$(LINEAGE_VERSION).zip
 
 .PHONY: bacon
 bacon: $(INTERNAL_OTA_PACKAGE_TARGET)
