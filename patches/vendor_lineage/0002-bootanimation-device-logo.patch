 TARGET_GENERATED_BOOTANIMATION := $(TARGET_OUT_INTERMEDIATES)/BOOTANIMATION/bootanimation.zip
-$(TARGET_GENERATED_BOOTANIMATION):
+# ON-FireLOS: rebuild when the generator, the source frames or the device's
+# logo or words change - without inputs the zip was made once and never again.
+BOOTANIMATION_INPUTS :=     vendor/lineage/bootanimation/generate-bootanimation.sh     vendor/lineage/bootanimation/bootanimation.tar     vendor/lineage/bootanimation/desc.txt     $(wildcard device/*/$(TARGET_DEVICE)/bootanimation/*.png)     $(wildcard device/*/$(TARGET_DEVICE)/bootanimation/text/*)
+$(TARGET_GENERATED_BOOTANIMATION): $(BOOTANIMATION_INPUTS)
 	@echo "Building bootanimation"
