diff --git a/overlay/packages/apps/Recorder/app/src/main/res/values/colors.xml b/overlay/packages/apps/Recorder/app/src/main/res/values/colors.xml
new file mode 100644
index 0000000..b8c55a7
--- /dev/null
+++ b/overlay/packages/apps/Recorder/app/src/main/res/values/colors.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: the app's own accent replaced by the system's. colorAccent
+     points at the framework accent and follows Settings > Display > Style >
+     Accent colour (dark green by default). The two halves - screen and
+     sound - keep two fixed shades from the logo so they still tell apart:
+     dark green and olive instead of teal and orange. They are identity
+     colours, not the accent: the Lineage accent overlays set the light and
+     dark accent to one and the same colour, which would make both alike. -->
+<resources>
+    <color name="colorAccent">@*android:color/accent_device_default_light</color>
+    <color name="screen">#2E521D</color>
+    <color name="sound">#8AA366</color>
+
+    <!-- ON-FireLOS: titles and small icons on the coloured halves. -->
+    <color name="on_card">#DEFFFFFF</color>
+    <!-- ON-FireLOS: colours the recording notification (its Stop action);
+         upstream #f8f8f8 left that action almost invisible. The app has no
+         action bar, so colorPrimary shows nowhere else. -->
+    <color name="colorPrimary">@*android:color/accent_device_default_light</color>
+</resources>
