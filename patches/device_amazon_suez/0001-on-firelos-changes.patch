+    <color name="accent_blue">#2E521D</color>
+    <color name="date_text_color_unread">#2E521D</color>
+    <color name="conversation_item_blue_background_color">#E2E8D9</color>
+    <color name="snack_bar_action_text_color">#8AA366</color>
+    <color name="text_color_undo">#8AA366</color>
+    <color name="account_item_selected_text_color">#2E521D</color>
+    <color name="swipe_to_refresh_text_color">#2E521D</color>
+    <color name="swipe_refresh_color2">#2E521D</color>
+    <color name="swipe_refresh_color3">#2E521D</color>
+    <color name="swipe_refresh_color4">#2E521D</color>
+    <color name="material_deep_teal_200">#8AA366</color>
