+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: the app's own accent replaced by the system's. The values
+     point at the framework accent, so they follow Settings > Display >
+     Style > Accent colour; with none chosen that is the logo's dark green on
+     light backgrounds and for large coloured areas, olive on dark ones.
+     In light mode the status bar takes the darker accent_device_default_700;
+     values-night has the dark variant. -->
+<resources>
+    <color name="colorPrimary">@*android:color/accent_device_default_light</color>
+    <color name="colorPrimaryDark">@*android:color/accent_device_default_700</color>
+    <color name="colorAccent">@*android:color/accent_device_default_light</color>
+</resources>
