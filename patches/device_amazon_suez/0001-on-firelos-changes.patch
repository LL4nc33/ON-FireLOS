diff --git a/patches/hardware/interfaces/0004-sensors-poll-again-instead-of-failing.patch b/patches/hardware/interfaces/0004-sensors-poll-again-instead-of-failing.patch
new file mode 100644
index 0000000..44c1930
--- /dev/null
+++ b/patches/hardware/interfaces/0004-sensors-poll-again-instead-of-failing.patch
@@ -0,0 +1,46 @@
+From: ON-FireLOS
+Subject: [PATCH] sensors: poll again instead of failing
+
+SensorService aborts system_server on any poll error; MediaTek's module
+returns one on signals (ANR stack traces) and long stalls (GPU reset).
+---
+diff --git a/sensors/1.0/default/Sensors.cpp b/sensors/1.0/default/Sensors.cpp
+--- a/sensors/1.0/default/Sensors.cpp
++++ b/sensors/1.0/default/Sensors.cpp
+@@ -21,6 +21,7 @@
+ #include <android-base/logging.h>
+ 
+ #include <sys/stat.h>
++#include <unistd.h>
+ 
+ namespace android {
+ namespace hardware {
+@@ -188,9 +189,25 @@
+         } else {
+             int bufferSize = maxCount <= kPollMaxBufferSize ? maxCount : kPollMaxBufferSize;
+             data.reset(new sensors_event_t[bufferSize]);
+-            err = mSensorDevice->poll(
+-                    reinterpret_cast<sensors_poll_device_t *>(mSensorDevice),
+-                    data.get(), bufferSize);
++            // SensorService aborts system_server on any error from here.
++            // MediaTek's module returns one when a signal interrupts it -
++            // every ANR sends SIGQUIT for stack traces - or when the system
++            // stalls for seconds (a GPU reset). Poll again instead.
++            int failures = 0;
++            for (;;) {
++                err = mSensorDevice->poll(
++                        reinterpret_cast<sensors_poll_device_t *>(mSensorDevice),
++                        data.get(), bufferSize);
++                if (err >= 0) {
++                    break;
++                }
++                if (err != -EINTR) {
++                    if (failures++ % 100 == 0) {
++                        LOG(ERROR) << "poll() failed: " << err << ", polling again";
++                    }
++                    usleep(failures < 50 ? 20000 : 500000);
++                }
++            }
+         }
+     }
+ 
