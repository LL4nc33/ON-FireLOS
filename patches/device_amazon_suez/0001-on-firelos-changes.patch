diff --git a/BoardConfig.mk b/BoardConfig.mk
index 0134616..57eb32d 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -1,4 +1,26 @@
 DEVICE := device/amazon/suez
+DEVICE_PATH := $(DEVICE)
+#
+# The SELinux blocks further down use $(DEVICE_PATH), but only $(DEVICE)
+# was set. All BOARD_SEPOLICY_DIRS therefore expanded to absolute paths
+# from / and were silently dropped by system/sepolicy/Android.mk via
+# $(wildcard) - 422 files with 16804 lines of device policy, without a
+# single error message. The built root/sepolicy contained 0 MTK
+# rules.
+#
+# With the variable set the policy compiles - that took three fixes,
+# which stay in the tree:
+#   sepolicy-mtk/basic/non_plat/file.te        debugfs_wakeup_sources duplicated
+#   sepolicy-mtk/basic/non_plat/hostapd.te     domain has another name in Pie
+#   .../meta_tst.te, .../storagemanagerd.te    vold_socket no longer exists
+#
+# After that, 79 violated AOSP neverallow rules remained, for example
+#   allow untrusted_app vtservice:file { read open }
+# MTK's policy comes from Android 8 and grants things that Pie forbids.
+# Every single one was a decision between "the device needs this" and
+# "MTK legacy" and has been cross-checked on the device. The device now
+# boots in enforcing mode (androidboot.selinux further down); each
+# remaining denial is handled in sepolicy/onfirelos.te.
 KERNEL := kernel/amazon/suez
 VENDOR := vendor/amazon/suez
 
@@ -19,13 +41,24 @@ TARGET_BOOTLOADER_BOARD_NAME := suez
 TARGET_ARCH := arm64
 TARGET_ARCH_VARIANT := armv8-a
 TARGET_CPU_ABI := arm64-v8a
-TARGET_CPU_VARIANT := generic
+# Not "generic": with that, all native code gets no -mcpu and is
+# scheduled for an unspecific ARMv8. build/soong/cc/config/
+# arm64_device.go knows no cortex-a72; for big.LITTLE cortex-a53 is the
+# intended choice - the same file even maps cortex-a73 to it, because
+# the small in-order core is the more sensitive of the two.
+#
+# Nothing changes for ART: instruction_set_features_arm64.cc treats
+# "generic" like cortex-a53 anyway.
+TARGET_CPU_VARIANT := cortex-a53
 
 TARGET_2ND_ARCH := arm
 TARGET_2ND_ARCH_VARIANT := armv7-a-neon
 TARGET_2ND_CPU_ABI := armeabi-v7a
 TARGET_2ND_CPU_ABI2 := armeabi
-TARGET_2ND_CPU_VARIANT := cortex-a15
+# cortex-a15 was wrong here: the CPU is A53/A72. soong knows no
+# cortex-a72, and for big.LITTLE cortex-a53 is the intended choice -
+# same reasoning as for TARGET_CPU_VARIANT above.
+TARGET_2ND_CPU_VARIANT := cortex-a53
 
 TARGET_CPU_ABI_LIST := arm64-v8a,armeabi-v7a,armeabi
 TARGET_CPU_ABI_LIST_64_BIT := arm64-v8a
@@ -43,7 +76,31 @@ TARGET_KERNEL_ARCH := arm64
 TARGET_KERNEL_CONFIG := suez_defconfig
 BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2
 BOARD_KERNEL_CMDLINE += lcm=0-nt51021_wuxga_dsi_vdo
-BOARD_KERNEL_CMDLINE += androidboot.selinux=permissive
+# ON-FireLOS: enforcing instead of permissive.
+#
+# That only became possible once the device policy was built at all - it
+# was silently dropped because of an undefined $(DEVICE_PATH), see
+# above. After that, 79 violated neverallow rules had to be worked through
+# and five services labelled that ran as init without a domain of their own.
+#
+# The bootloader in turn appends androidboot.selinux=enforcing; for
+# ro.* properties the first assignment wins, and that is this one.
+# For testing at runtime: setenforce 0.
+# The last obstacle was not the policy but the lack of visibility:
+# kernel/Makefile had -DCONFIG_DISABLE_AUDIT hard-wired, so the
+# NETLINK_AUDIT socket was never created and not a single kernel denial
+# was logged. Only hits from user space were visible - a seemingly clean
+# log with dozens of invisible denials per boot.
+#
+# After removing that flag the hits could be worked through in eight
+# rounds: from the wrongly labelled graphics subchannel (which crippled
+# the camera in enforcing mode) through unlabelled battery, LED and
+# network nodes to five more services that ran as init without a domain
+# of their own.
+BOARD_KERNEL_CMDLINE += androidboot.selinux=enforcing
+# ON-FireLOS: the kernel has only a 16 KB log buffer (LOG_BUF_SHIFT=14); at
+# 22 s after boot everything earlier has already been overwritten.
+BOARD_KERNEL_CMDLINE += log_buf_len=256K
 BOARD_KERNEL_IMAGE_NAME := Image.gz-dtb
 TARGET_KERNEL_SOURCE := $(KERNEL)
 TARGET_KERNEL_CROSS_COMPILE_PREFIX := $(shell pwd)/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/bin/aarch64-linux-android-
@@ -102,7 +159,29 @@ USE_OPENGL_RENDERER := true
 # Use SurfaceFlinger HWC 2On1 Adaptor
 TARGET_USES_HWC2 := true
 TARGET_USES_HWC2ON1ADAPTER := true
-SF_START_GRAPHICS_ALLOCATOR_SERVICE := true
+# SF_START_GRAPHICS_ALLOCATOR_SERVICE deliberately NOT set.
+#
+# When set, configstore is built with -DSTART_GRAPHICS_ALLOCATOR_SERVICE,
+# whereupon main_surfaceflinger.cpp loads the graphics allocator into its
+# own process via registerPassthroughServiceImplementation<IAllocator>()
+# and registers it with hwservicemanager itself. That was the only
+# remaining SELinux denial in the entire boot:
+#   avc: denied { add } for interface=...graphics.allocator::IAllocator
+#   scontext=u:r:surfaceflinger:s0
+#   tcontext=u:object_r:hal_graphics_allocator_hwservice:s0
+# It cannot be allowed in AOSP: only hal_graphics_allocator_server may
+# register, and surfaceflinger is coredomain.
+#
+# The flag is meant for devices that have no standalone allocator
+# service. This one has one: hidl.mk ships
+# android.hardware.graphics.allocator@2.0-service, the vendor
+# manifest declares IAllocator as hwbinder, and the service runs
+# as vendor.gralloc-2-0 in hal_graphics_allocator_default. Both
+# registered, SurfaceFlinger won the race.
+#
+# Caution: the check in configstore is ifneq(...,) - any non-empty
+# value switches it on, "false" included. The line has to be
+# absent, not false.
 TARGET_RUNNING_WITHOUT_SYNC_FRAMEWORK := true
 
 # System's VSYNC phase offsets in nanoseconds
@@ -166,5 +245,19 @@ BOARD_PLAT_PRIVATE_SEPOLICY_DIR += \
 # Disable API check
 WITHOUT_CHECK_API := true
 
-# Use dlmalloc instead of jemalloc
-MALLOC_SVELTE := true
+# MALLOC_SVELTE deliberately NOT set.
+#
+# According to external/jemalloc/Android.bp the setting means: a single
+# arena and no thread cache (JEMALLOC_TCACHE stays undefined).
+# Every memory allocation in the system then takes the same lock. It is
+# meant for devices with very little memory; this one has 1.8 GiB.
+#
+# The comment that used to be here ("dlmalloc instead of jemalloc") was
+# wrong - it is jemalloc in both cases.
+# MALLOC_SVELTE := true
+
+# ON-FireLOS: the bundled apps this ROM reworks carry it in their version
+# name, after their own number (app-versions.py): "ON-FireLOS 1.01 (20261108)".
+# ONFIRELOS_VERSION is the release number, counted up per release.
+ONFIRELOS_VERSION := 1.15
+ONFIRELOS_APP_VERSION := ON-FireLOS $(ONFIRELOS_VERSION) ($(shell date +%Y%m%d))
diff --git a/bluetooth/libbt-vendor/mtk.c b/bluetooth/libbt-vendor/mtk.c
index eaf233b..f60137e 100644
--- a/bluetooth/libbt-vendor/mtk.c
+++ b/bluetooth/libbt-vendor/mtk.c
@@ -41,6 +41,9 @@
 #include <sys/ioctl.h>
 #include <error.h>
 #include <cutils/properties.h>
+#include <ctype.h>
+#include <string.h>
+#include <unistd.h>
 
 /* use nvram */
 #include "CFG_BT_File.h"
@@ -208,6 +211,36 @@ static int bt_read_nvram(unsigned char *pucNvRamData)
     return 0;
 }
 
+/* ON-FireLOS: Amazon keeps each tablet's own Bluetooth address in its idme
+ * area as twelve hex digits; Fire OS's library read it from there. This
+ * source only knows the NVRAM file, which holds MediaTek's placeholder
+ * 00:00:46:66:30:01 - the same address on every tablet. */
+static void idme_get_bt_mac_addr(unsigned char *addr)
+{
+    char buf[13] = {0};
+    unsigned char mac[6];
+    int fd, i;
+
+    fd = open("/proc/idme/bt_mac_addr", O_RDONLY);
+    if (fd < 0)
+        return;
+    i = read(fd, buf, 12);
+    close(fd);
+    if (i != 12)
+        return;
+    for (i = 0; i < 12; i++) {
+        if (!isxdigit((unsigned char)buf[i]))
+            return;
+    }
+    for (i = 0; i < 6; i++) {
+        char hex[3] = { buf[2 * i], buf[2 * i + 1], 0 };
+        mac[i] = (unsigned char)strtoul(hex, NULL, 16);
+    }
+    if (is_memzero(mac, sizeof(mac)))
+        return;
+    memcpy(addr, mac, sizeof(mac));
+}
+
 /* MTK specific chip initialize process */
 int mtk_fw_cfg(void)
 {
@@ -269,6 +302,9 @@ int mtk_fw_cfg(void)
         }
     }
 
+    /* addr[6] is the first member of ap_nvram_btradio_struct */
+    idme_get_bt_mac_addr(ucNvRamData);
+
     LOG_WAN("[BDAddr %02x-%02x-%02x-%02x-%02x-%02x][Voice %02x %02x][Codec %02x %02x %02x %02x] \
             [Radio %02x %02x %02x %02x %02x %02x][Sleep %02x %02x %02x %02x %02x %02x %02x][BtFTR %02x %02x] \
             [TxPWOffset %02x %02x %02x][CoexAdjust %02x %02x %02x %02x %02x %02x] \
