+    <color name="date_text_color_unread">#8AA366</color>
+    <color name="account_item_selected_text_color">#8AA366</color>
+    <color name="swipe_to_refresh_text_color">#8AA366</color>
+    <color name="text_color_draft_red">#8AA366</color>
+    <color name="notification_icon_color">#8AA366</color>
+    <color name="edge_effect_color">#8AA366</color>
+    <color name="compose_button_background_color">#2E521D</color>
+    <color name="compose_button_pressed_background_color">#213B15</color>
+    <color name="compose_button_tint">#33FFFFFF</color>
+    <!-- text -->
+    <color name="text_color_black">#DEFFFFFF</color>
+    <color name="text_color_grey">#B3FFFFFF</color>
+    <color name="gray_text_color">#B3FFFFFF</color>
+    <color name="dark_gray_text_color">#B3FFFFFF</color>
+    <color name="text_color_medium_grey">#8AFFFFFF</color>
+    <color name="text_color_hint_grey">#8AFFFFFF</color>
+    <color name="text_color_disabled">#8AFFFFFF</color>
+    <color name="attachment_name_color">#DEFFFFFF</color>
+    <!-- list, drawer, compose surfaces -->
+    <color name="list_background_color">#1A1C18</color>
+    <color name="conversation_list_background_color">#1A1C18</color>
+    <color name="conversation_item_grey_background_color">#2F332B</color>
+    <color name="conversation_item_grey_pressed_color">#505050</color>
+    <color name="conversation_item_grey_ripple_color">#33FFFFFF</color>
+    <color name="conversation_item_blue_background_color">#4B5240</color>
+    <color name="swiped_bg_color">#2F332B</color>
+    <color name="drawer_item_activated_background_color">#1FFFFFFF</color>
+    <color name="mini_drawer_activated_background_color">#2F332B</color>
+    <color name="divider_color">#1FFFFFFF</color>
+    <color name="holo_light_background_color">#1A1C18</color>
+    <color name="vacation_responder_window_background">#1A1C18</color>
+    <color name="search_banner_bg">#2F332B</color>
+    <color name="tip_teaser_bg">#2F332B</color>
+    <!-- reading pane, search bar, folder chips: stay light (see above) -->
+    <color name="conversation_view_text_color_dark">#24271F</color>
+    <color name="conversation_view_text_color_light">#757575</color>
+    <color name="conversation_view_text_color_link_blue">#2E521D</color>
+    <color name="conversation_view_border_color">#e5e5e5</color>
+    <color name="attachment_tile_subtitle_color">#949494</color>
+    <color name="default_folder_foreground_color">#777777</color>
+    <color name="search_query_text">#24271F</color>
+    <color name="search_query_hint_text">#757575</color>
+    <color name="search_suggestion_item_text">#757575</color>
+    <!-- account setup (Email) -->
+    <color name="account_setup_headline_color">#DEFFFFFF</color>
+    <color name="account_setup_info_text_color">#DEFFFFFF</color>
+    <color name="account_setup_label_large_text_color">#DEFFFFFF</color>
+    <color name="account_setup_divider_color">#1FFFFFFF</color>
+    <color name="account_setup_xlarge_background_color">#1A1C18</color>
+    <color name="account_setup_button_bar_background">#2F332B</color>
+    <color name="text_secondary_color">#B3FFFFFF</color>
+    <color name="email_confirmation_color">#B3FFFFFF</color>
