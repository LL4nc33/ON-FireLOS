+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: the app's own accent replaced by the system's. The values
+     point at the framework accent, so they follow Settings > Display >
+     Style > Accent colour; with none chosen that is the logo's dark green on
+     light backgrounds and for large coloured areas, olive on dark ones.
+     The suw_* colours belong to the setup wizard library
+     (frameworks/opt/setupwizard), linked in as a static library: a device
+     overlay on the library's own res path is not applied to static
+     libraries, but the app's resources override the library's, so they are
+     replaced here. Used by the Glif screens (PIN, pattern, password, lock
+     screen notifications, encryption). The *_light/_dark pairs belong to
+     the light and dark Glif themes; glif_v3 is used by the light V3 theme. -->
+<resources>
+    <color name="suw_color_accent_glif_light">@*android:color/accent_device_default_light</color>
+    <color name="suw_color_accent_glif_dark">@*android:color/accent_device_default_dark</color>
+    <color name="suw_color_accent_glif_v3">@*android:color/accent_device_default_light</color>
+    <color name="suw_color_accent_light">@*android:color/accent_device_default_light</color>
+    <color name="suw_color_accent_dark">@*android:color/accent_device_default_dark</color>
+    <color name="suw_link_color_light">@*android:color/accent_device_default_light</color>
+    <color name="suw_link_color_dark">@*android:color/accent_device_default_dark</color>
+    <color name="suw_progress_bar_color_light">@*android:color/accent_device_default_light</color>
+    <color name="suw_progress_bar_color_dark">@*android:color/accent_device_default_dark</color>
+</resources>
diff --git a/overlay/packages/apps/PackageInstaller/res/values-night/themes.xml b/overlay/packages/apps/PackageInstaller/res/values-night/themes.xml
