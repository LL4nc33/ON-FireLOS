@@ -0,0 +1,24 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: the app's own accent replaced by the system's, taken from the
+     logo - dark green on light backgrounds and for large coloured areas,
+     olive on dark ones. Fixed values: the app is built against the public
+     SDK (LOCAL_SDK_VERSION := current), which cannot reference the private
+     framework accent, so it does not follow another accent chosen under
+     Settings > Display > Style.
+     section_header_text_color and search_shortcut_icon_color point at
+     dialtacts_theme_color in the app and follow it. swipe_refresh_color1 is
+     already green and stays. material_deep_teal_200/500 are AppCompat's
+     fallback accent (launch screen). -->
+<resources>
+    <!-- ON-FireLOS design: primary_color is only the tool bar (and the status
+         bar above it), flat on the background; the accent is
+         dialtacts_theme_color. -->
+    <color name="primary_color">@color/onfirelos_background</color>
+    <color name="primary_color_dark">@color/onfirelos_background</color>
+    <color name="dialtacts_theme_color">#2E521D</color>
+    <color name="swipe_refresh_color2">#2E521D</color>
+    <color name="swipe_refresh_color3">#2E521D</color>
+    <color name="swipe_refresh_color4">#2E521D</color>
+    <color name="material_deep_teal_200">#8AA366</color>
+    <color name="material_deep_teal_500">#2E521D</color>
+</resources>
