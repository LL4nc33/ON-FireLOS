+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: the app's own accent replaced by the system's, taken from the
+     logo - dark green on light backgrounds and for large coloured areas,
+     olive on dark ones. Fixed values: the app is built against the public
+     SDK (LOCAL_SDK_VERSION := current), which cannot reference the private
+     framework accent, so it does not follow another accent chosen under
+     Settings > Display > Style.
+     Most names come from UnifiedEmail, whose res dir Email builds in.
+     Snack bar and undo texts sit on a dark bar and take the olive; the
+     unread-conversation background is a pale green tint instead of the
+     pale blue. material_deep_teal_200/500 are AppCompat's fallback accent
+     (photo viewer). -->
+<resources>
+    <!-- bars: flat on the list, the status bar too (ON-FireLOS design);
+         what also used primary_color keeps the accent. The selection bar and
+         its status bar on the surface variant. -->
+    <color name="primary_color">@color/list_background_color</color>
+    <color name="primary_dark_color">@color/list_background_color</color>
+    <color name="compose_button_background_color">#2E521D</color>
