diff --git a/sepolicy/genfs_contexts b/sepolicy/genfs_contexts
new file mode 100644
index 0000000..a5e6fcb
--- /dev/null
+++ b/sepolicy/genfs_contexts
@@ -0,0 +1,41 @@
+# The battery nodes were completely unlabelled - everything just
+# "sysfs". AOSP explicitly says in public/hal_health.te: "Vendors should
+# mark sysfs_batteryinfo on all files read by health HAL service." This
+# device tree never did that, so the health HAL was denied when reading
+# .../power_supply/battery/present.
+# Deliberately only from power_supply down: labelling the whole
+# battery_common level made cameraserver run into denials while walking
+# /sys/devices (it searches the tree, but is not interested in the
+# battery). The health HAL only needs power_supply and below anyway.
+genfscon sysfs /devices/mediatek,battery_common/power_supply u:object_r:sysfs_batteryinfo:s0
+
+# The backlight was unlabelled. AOSP has the type sysfs_leds including
+# rules in public/hal_light.te for exactly that - this device tree just
+# never set it.
+genfscon sysfs /devices/soc/11011000.i2c/i2c-11/11-002c/leds u:object_r:sysfs_leds:s0
+
+# The same for the network nodes of the Wi-Fi chip: netd has long been
+# allowed to write sysfs_net (public/netd.te), but wlan0 only carried
+# "sysfs", so setting the MTU was denied.
+genfscon sysfs /devices/soc/11260000.sdio/mmc_host/mmc2/mmc2:0001/mmc2:0001:1/net u:object_r:sysfs_net:s0
+
+# MediaTek's boot profile and the free memory threshold set by the
+# vendor.
+genfscon proc /bootprof u:object_r:proc_bootprof:s0
+genfscon proc /sys/vm/min_free_kbytes u:object_r:proc_min_free_kbytes:s0
+
+# AOSP only labels /class/net as sysfs_net. The real nodes behind it
+# under /devices/virtual/net stayed "sysfs".
+genfscon sysfs /devices/virtual/net u:object_r:sysfs_net:s0
+
+# AOSP has proc_dirty for /sys/vm/dirty_* - only dirty_writeback_centisecs
+# is missing there, and that is exactly what this device's init.rc sets.
+genfscon proc /sys/vm/dirty_writeback_centisecs u:object_r:proc_dirty:s0
+
+genfscon proc /wdk u:object_r:proc_wdk:s0
+
+genfscon proc /hps u:object_r:proc_hps:s0
+genfscon proc /idme u:object_r:proc_idme:s0
+genfscon sysfs /module/pvrsrvkm/parameters/gpu_loading u:object_r:sysfs_gpu_loading:s0
+genfscon sysfs /devices/platform/mtk_disp_mgr.0/rgb u:object_r:sysfs_livedisplay:s0
+genfscon sysfs /autok u:object_r:sysfs_autok:s0
diff --git a/sepolicy/onfirelos.te b/sepolicy/onfirelos.te
new file mode 100644
index 0000000..1ecc0bf
--- /dev/null
+++ b/sepolicy/onfirelos.te
@@ -0,0 +1,515 @@
+# ==========================================================================
+# ON-FireLOS: services that ran in the init domain without a label of
+# their own.
+#
+# Found on the device: five processes carried u:r:init:s0. That is the
+# worst possible case - init may do anything, and a service that ends up
+# there inherits that. Causes:
+#
+#   android.hardware.drm@1.1-service.clearkey
+#       AOSP's system/sepolicy/vendor/file_contexts only labels
+#       "android\.hardware\.drm@1\.0-service". Our binary is called 1.1 and
+#       ends in .clearkey, so it does not match the expression.
+#   vendor.lineage.livedisplay@2.0-service-mediatek
+#       vendor/lineage/sepolicy/ does not exist in this tree at all.
+#   6620_launcher
+#       MediaTek only labels /vendor/bin/wmt_launcher; on this device the
+#       same program is called 6620_launcher.
+#   autokd, audiofix
+#       Have no domain anywhere.
+#
+# The rules here are deliberately tight. What is really needed shows up in
+# permissive mode as "avc: denied" messages.
+# ==========================================================================
+
+# --- LineageOS LiveDisplay ------------------------------------------------
+type hal_lineage_livedisplay_default, domain;
+type hal_lineage_livedisplay_default_exec, exec_type, file_type, vendor_file_type;
+init_daemon_domain(hal_lineage_livedisplay_default)
+hal_server_domain(hal_lineage_livedisplay_default, hal_lineage_livedisplay)
+
+# Colour calibration: a single node, mtk_disp_mgr.0/rgb (from the strings
+# of the service). Previously here: read and write on all of /sys.
+allow hal_lineage_livedisplay_default sysfs_livedisplay:file rw_file_perms;
+
+# --- MediaTek's boot helper for Wi-Fi/Bluetooth ---------------------------
+# Same program as wmt_launcher, just named differently.
+allow mtk_wmt_launcher self:capability { net_admin };
+
+# --- autokd: Wi-Fi calibration -------------------------------------------
+type autokd, domain;
+type autokd_exec, exec_type, file_type, vendor_file_type;
+init_daemon_domain(autokd)
+allow autokd autokd_data_file:dir rw_dir_perms;
+allow autokd autokd_data_file:file create_file_perms;
+# Only /sys/autok/* (from the strings of the program); previously all of /sys.
+allow autokd sysfs_autok:dir r_dir_perms;
+allow autokd sysfs_autok:file rw_file_perms;
+
+# --- audiofix: switches speaker and headphone amplifier ------------------
+# Started once at boot, then waits for headphone plug events (uevents) and
+# sets the amplifier switches in the mixer. It opens the mixer through the
+# audio group (init.mt8173.rc), not by overriding file permissions.
+type audiofix, domain;
+type audiofix_exec, exec_type, file_type;
+init_daemon_domain(audiofix)
+# Only reads the headphone switch /sys/class/switch/h2w/state
+# (audiofix.c); previously read and write on all of /sys.
+allow audiofix sysfs_switch:dir r_dir_perms;
+allow audiofix sysfs_switch:file r_file_perms;
+allow audiofix sysfs_switch:lnk_file read;
+allow audiofix audio_device:chr_file rw_file_perms;
+allow audiofix audio_device:dir r_dir_perms;
+
+# ==========================================================================
+# Service registrations that were only logged in permissive mode
+# ==========================================================================
+
+# guiext-server could no longer register since the relabelling -
+# before, it ran as init and was allowed everything.
+allow guiext-server guiext-server_service:service_manager add;
+allow guiext-server servicemanager:binder call;
+# Without this rule guiext-server waits forever for SurfaceFlinger, and with
+# it the MediaTek video decoder, which registers its buffers via guiext:
+# hardware video playback froze on the first frame everywhere
+# (browser, gallery, every app using MediaCodec).
+allow guiext-server surfaceflinger_service:service_manager find;
+
+# MediaTek's audio HAL registers a signal processing service of its own.
+# Nobody may register anything on the catch-all type default_android_vndservice
+# (domain.te:519) - so the service gets a type of its own, see
+# vndservice_contexts.
+type audiosignalprocessor_service, vndservice_manager_type;
+allow hal_audio_default audiosignalprocessor_service:service_manager add;
+
+# surfaceflinger and the graphics allocator: DELIBERATELY NO RULE.
+# AOSP only allows the allocator itself to register this service
+# (hal_graphics_allocator.te:4). The denial came up because the HAL ran in
+# passthrough mode inside the surfaceflinger process. That is AOSP's
+# design decision - working around it would be wrong.
+
+# Memory usage query from Settings.
+allow priv_app hal_memtrack_hwservice:hwservice_manager find;
+
+# The graphics composer tries to set debug.hwc.dump_level at startup.
+# AOSP forbids vendor HALs write access to debug_prop, and rightly
+# so - debug properties can be used to switch behaviour. The property is
+# pure debugging, the failure has no consequences. So do not grant it,
+# just silence the message.
+dontaudit hal_graphics_composer_default debug_prop:property_service set;
+
+# surfaceflinger and the graphics allocator: see above, no rule. Three
+# ways of letting it register anyway failed earlier and stay here as a
+# warning: dontaudit only silences the message (no display, system_server
+# hangs in WaitForDisplay); hal_server_domain forbids surfaceflinger from
+# executing programs (hal_neverallows.te:54); the attribute alone violates
+# attributes:278. In enforcing mode the device now boots without any of
+# them - the standalone allocator service runs in its own domain.
+
+# ==========================================================================
+# setprop from the init scripts
+#
+# init.mt8173.rc and init.mt8173.usb.rc set properties via
+# "exec /system/bin/setprop <name> <value>". The executed process ends up
+# in the toolbox domain and may not set anything there - in enforcing mode
+# the USB product ID, the ffs compatibility and the TCP buffer sizes would
+# otherwise stay unset.
+#
+# The obvious route, switching these lines to init's built-in setprop, was
+# tried and reverted again - see the comment header in init.mt8173.rc. The
+# reason given there first (cameraserver gets in between) did not hold up
+# under scrutiny; the camera was missing because the boot did not complete
+# in enforcing mode at all.
+#
+# So instead exactly what the scripts need is allowed.
+# toolbox is only ever started from init here.
+allow toolbox ffs_prop:property_service set;
+type usb_pid_prop, property_type;
+allow toolbox usb_pid_prop:property_service set;
+allow toolbox system_prop:property_service set;
+
+# ==========================================================================
+# Findings from the first boot with working audit logging
+#
+# Until this point -DCONFIG_DISABLE_AUDIT was hard-wired in kernel/Makefile.
+# Because of that the kernel never created the NETLINK_AUDIT socket, logd
+# did not start its audit thread, and NO kernel denial was ever logged.
+# Only denials from user space (hwservicemanager, init property service),
+# which log themselves, were visible - a seemingly clean log with 79
+# invisible hits per boot.
+# ==========================================================================
+
+# --- PowerVR's gralloc subchannel -----------------------------------------
+# The subchannel is a pipe that the graphics allocator creates and hands to
+# the client process via hwbinder. It therefore carries the allocator's
+# label.
+#
+# As long as SF_START_GRAPHICS_ALLOCATOR_SERVICE was set, the allocator ran
+# inside SurfaceFlinger, the pipe was labelled surfaceflinger, and appdomain
+# has long been allowed to use its pipes. With the standalone service it is
+# labelled hal_graphics_allocator_default - and there was no rule for that.
+#
+# Consequence in enforcing mode: gralloc_subchannel_set_buffer_format
+# fails, the buffer gets no format, dequeueBuffer fails,
+# eglMakeCurrent returns EGL_BAD_ALLOC - and the camera reports
+# "Can't connect to the camera".
+#
+# AOSP explicitly allows apps to use the allocator: in app_neverallows.te
+# hal_graphics_allocator_server is exempt from the binder restriction, with
+# the reasoning that the same operations are also offered via
+# SurfaceFlinger.
+allow hal_graphics_allocator_client hal_graphics_allocator_default:fifo_file
+    { read write getattr };
+
+# --- audiofix: uevent socket ----------------------------------------------
+# The script listens for device events. Own domain, own socket.
+allow audiofix self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
+
+# --- memtrack: ION statistics ---------------------------------------------
+# The memtrack HAL reports graphics memory and on MediaTek reads it from
+# /sys/kernel/debug/ion/heaps/ion_mm_heap. Without this, Settings shows no
+# graphics share under Memory. Read only.
+allow hal_memtrack_default debugfs_ion_mm_heap:dir search;
+allow hal_memtrack_default debugfs_ion_mm_heap:file r_file_perms;
+
+# --- memtrack: calls from privileged apps ---------------------------------
+# android.os.Debug.getMemoryInfo() calls the HAL directly via libmemtrack -
+# AOSP intends it to work this way. The hwservice lookup was already
+# allowed here, the actual call was missing.
+binder_call(priv_app, hal_memtrack_default)
+
+# --- PowerVR blobs probe debugfs from app processes -----------------------
+# gralloc.mt8173.img.so looks for /sys/kernel/debug/ion and .../gpu_img in
+# every client process. AOSP forbids apps access to debugfs, and rightly
+# so. The probe has no consequences - it was blocked all along, just
+# invisibly, and everything worked. So it is deliberately only silenced
+# here and NOT allowed.
+
+# --- Amazon's kernel thread update_securetime -----------------------------
+# Writes /data/SecureTD. Instead of giving the kernel domain blanket access
+# to system_data_file, the file gets a type of its own.
+allow kernel securetd_data_file:file rw_file_perms;
+
+# ==========================================================================
+# Second round: the complete boot, visible for the first time
+# ==========================================================================
+
+# --- system_server --------------------------------------------------------
+# The MediaTek sensor stack runs in-process, not behind a HAL.
+allow system_server hwmsensor_device:chr_file r_file_perms;
+
+# system_server tries to map code from /data/dalvik-cache as executable
+# (LineageSettingsProvider, Telecom). AOSP explicitly forbids that - twice
+# even, in system_server.te:854 and domain.te:446: code in system_server
+# is meant to come from /system/framework, not from the writable cache.
+# So the restriction is correct and stays; only the message is silenced.
+dontaudit system_server dalvikcache_data_file:file execute;
+
+# --- vendor_init: MediaTek's mount points and /proc nodes ----------------
+allow vendor_init rootfs:dir { create write add_name setattr };
+allow vendor_init tmpfs:dir { write add_name };
+allow vendor_init proc_bootprof:file w_file_perms;
+allow vendor_init proc_min_free_kbytes:file w_file_perms;
+allow vendor_init proc_abi:file w_file_perms;
+
+# --- init -----------------------------------------------------------------
+allow init mnt_media_rw_file:dir mounton;
+dontaudit init shell_data_file:lnk_file getattr;   # known AOSP bug
+
+# --- toolbox --------------------------------------------------------------
+# Creating /dev/wmtWifi has been dropped - see init.mt8173.rc. AOSP
+# denies the toolbox domain CAP_MKNOD via neverallow, and the node is
+# created via uevent anyway.
+# What remains: setprop from init calls.
+allow toolbox property_socket:sock_file write;
+allow toolbox init:unix_stream_socket connectto;
+
+# --- Amazon's provisioning tools ------------------------------------------
+# amzn_drmprov_check and amzn_dha_hmac used to run in the init domain
+# and were thus allowed everything. Both are oneshot and only talk to the
+# TrustZone.
+type amzn_prov, domain;
+type amzn_prov_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(amzn_prov)
+allow amzn_prov tee_device:chr_file rw_file_perms;
+
+# --- kernel ---------------------------------------------------------------
+allow kernel tmpfs:dir search;
+
+# The kernel thread mtk_wmtd sporadically requests CAP_DAC_OVERRIDE and
+# CAP_DAC_READ_SEARCH. Neither can be granted: AOSP restricts them via
+# neverallow to a list that does not contain the kernel domain.
+#
+# Really without consequences here, and proven rather than assumed: the
+# function test shows /dev/wmtdetect, /dev/stpwmt, /dev/wmtWifi and
+# /dev/stpbt present, Wi-Fi with an address, Bluetooth switched on and no
+# crash. So the combo chip comes up completely.
+dontaudit kernel self:capability { dac_override dac_read_search };
+
+# --- SafetyNet probes the device ------------------------------------------
+# com.google.android.gms.unstable reads /proc/interrupts, /proc/modules,
+# /dev, /sys/block and the USB state. That is fingerprinting, AOSP
+# blocks it on purpose. So it is NOT allowed here, only silenced - it
+# was blocked all along and nothing suffered from it.
+dontaudit priv_app proc_interrupts:file { open read getattr };
+dontaudit priv_app proc_modules:file { open read getattr };
+dontaudit priv_app device:dir { open read };
+dontaudit priv_app sysfs:dir { open read };
+dontaudit priv_app sysfs_android_usb:file { open read getattr };
+dontaudit priv_app sysfs_net:file { open read };
+
+# --- harmless -------------------------------------------------------------
+dontaudit webview_zygote zygote:unix_dgram_socket write;
+
+# ==========================================================================
+# Third round
+# ==========================================================================
+
+# amzn_drmprov_check talks to kisd over an abstract socket.
+allow amzn_prov kisd:unix_stream_socket connectto;
+
+# The audio HAL reads its calibration from /data/nvram (FILE_VER,
+# Audio_Hd_Record_Scene_Table). Read only.
+allow hal_audio_default nvram_data_file:dir r_dir_perms;
+allow hal_audio_default nvram_data_file:file r_file_perms;
+
+# The init.rc sets owner and permissions on /data/nvram, /data/gps_mnl
+# and /data/vendor/wv.
+allow vendor_init { system_data_file nvram_data_file drm_data_file }:dir setattr;
+
+# write /proc/sys/vm/dirty_writeback_centisecs 300
+allow vendor_init proc_dirty:file w_file_perms;
+
+# chown/chmod on /sys/class/android_usb/android0/f_mass_storage/lun/file -
+# USB mass storage mode is not used on this device.
+dontaudit init sysfs:file setattr;
+
+# ==========================================================================
+# Fourth round
+# ==========================================================================
+
+# amzn_drmprov_check sets ro.amzn_dha.hmac.
+allow amzn_prov property_socket:sock_file write;
+allow amzn_prov init:unix_stream_socket connectto;
+type amzn_prop, property_type;
+allow amzn_prov amzn_prop:property_service set;
+
+# nvram_daemon starts a shell script that calls toybox.
+allow nvram_daemon toolbox_exec:file { getattr open read execute execute_no_trans };
+
+# More directories on which the init.rc sets permissions.
+allow vendor_init {
+    dhcp_data_file gps_data_file key_install_data_file
+    nfc_socket radvd_data_file wide_dhcpv6_data_file
+}:dir setattr;
+
+# write /proc/wdk "0 20 30" - MediaTek's watchdog node.
+allow vendor_init proc_wdk:file w_file_perms;
+
+# kisd and wmt_loader request CAP_DAC_OVERRIDE. It cannot be granted -
+# AOSP restricts it via neverallow to a list that only knows types from
+# the public policy.
+#
+# For wmt_loader it was NOT without consequences: the service runs as root
+# in group root, but /dev/wmtdetect belongs to system:system with 0660.
+# Without the capability it could not reach the node, and so the whole
+# combo chip did not come up - no Wi-Fi, no Bluetooth. Solved via the group
+# in init.mt8173.rc, just as AOSP itself recommends at that place.
+#
+# (An earlier version claimed here that both manage without it. That was
+# measured in permissive mode, where capabilities are granted anyway
+# AND where they are not even logged, because the kernel first checks
+# them via ns_capable_noaudit().)
+dontaudit kisd self:capability dac_override;
+
+# --- pvrsrvctl ------------------------------------------------------------
+# PowerVR's startup tool ran in the init domain and was thus allowed everything.
+type pvrsrvctl, domain;
+type pvrsrvctl_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(pvrsrvctl)
+allow pvrsrvctl gpu_device:chr_file rw_file_perms;
+
+# ==========================================================================
+# Fifth round
+# ==========================================================================
+
+# amzn_dha_hmac starts a shell.
+allow amzn_prov shell_exec:file { getattr open read execute execute_no_trans };
+
+# Both Amazon tools requested CAP_DAC_OVERRIDE because /dev/trustzone
+# belongs to system:drmrpc with 0660 and the service ran as root in group
+# system - neither owner nor group. The capability cannot be granted
+# here: AOSP restricts dac_override via neverallow to the list in
+# domain.te, and only types from the public policy may be there, no
+# device domain.
+#
+# So it is solved the way AOSP recommends at that same place -
+# via the group: the init.rc now additionally gives both services
+# drmrpc, so the group permissions apply.
+#
+# (An earlier version of this file claimed the tools manage without
+# dac_override. That was measured in permissive mode, where the
+# capability is granted anyway - in enforcing mode both services ended
+# with status 255.)
+dontaudit amzn_prov self:capability dac_override;
+
+# The init.rc creates /data/mcube (sensor calibration) and sets permissions
+# on /data/sensor.
+allow vendor_init system_data_file:dir { write add_name create };
+allow vendor_init sensor_data_file:dir setattr;
+
+# The allocator itself also probes debugfs - same place in the PowerVR
+# blob as in the app processes, equally without consequences.
+
+# ==========================================================================
+# Sixth round
+# ==========================================================================
+
+# The init.rc creates a number of /data directories and sets permissions
+# on them. AOSP gives vendor_init setattr only on fs_type, not on
+# /data types - such lines are not really meant to be in a vendor rc.
+# The directories for missing hardware (GPS, NFC) have been
+# removed; the rest is allowed specifically here.
+allow vendor_init {
+    nvram_data_file drm_data_file dhcp_data_file wide_dhcpv6_data_file
+    key_install_data_file radvd_data_file sensor_data_file system_data_file
+    ppp_data_file mobicore_data_file apk_data_file
+}:dir { create getattr open read search setattr write add_name };
+
+# write /proc/hps/down_times - the core hotplug delay. Raising it from 10
+# to 60 shortens a cold start out of idle by about 150 ms, while the cores
+# still go offline at real idle and with the screen off.
+allow vendor_init proc_hps:file w_file_perms;
+
+# amzn_dha_hmac reads the serial number from Amazon's idme area.
+allow amzn_prov proc_idme:file r_file_perms;
+allow amzn_prov proc_idme:dir r_dir_perms;
+
+# The graphics composer talks to the TrustZone (protected paths).
+allow hal_graphics_composer_default tee_device:chr_file rw_file_perms;
+
+# SurfaceFlinger also probes the PowerVR debugfs location.
+
+# --- msensord -------------------------------------------------------------
+# MediaTek's sensor helper ran in the init domain.
+type msensord, domain;
+type msensord_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(msensord)
+
+# ==========================================================================
+# Seventh round
+# ==========================================================================
+
+# --- fix-symlinks.sh ------------------------------------------------------
+# Cleans up the by-name symlinks of the partitions that amonet swaps
+# (boot <-> boot_x, recovery <-> recovery_x). Used to run in u:r:su:s0.
+type fixsymlinks, domain;
+allow init fixsymlinks:process { transition siginh rlimitinh };
+dontaudit init fixsymlinks:process noatsecure;
+allow fixsymlinks shell_exec:file { entrypoint getattr open read execute };
+allow fixsymlinks { vendor_file system_file }:file { getattr open read execute };
+allow fixsymlinks toolbox_exec:file { getattr open read execute execute_no_trans };
+allow fixsymlinks block_device:dir { getattr open read search write add_name remove_name };
+allow fixsymlinks block_device:lnk_file { getattr read create unlink };
+allow fixsymlinks devpts:chr_file { read write };
+allow fixsymlinks null_device:chr_file { read write };
+
+# nvram_daemon also starts a shell script.
+allow nvram_daemon shell_exec:file { getattr open read execute execute_no_trans };
+
+# /data/.tp - MediaTek's thermal management.
+allow vendor_init thermal_manager_data_file:dir { create getattr open read search setattr write add_name };
+
+# PowerVR's debugfs probing, this time from the startup tool.
+
+# ==========================================================================
+# Eighth round
+# ==========================================================================
+
+# --- PowerVR's debugfs probing, once and for all ---------------------------
+# gralloc.mt8173.img.so looks for /sys/kernel/debug/ion and .../gpu_img in
+# EVERY process that loads it - apps, system_server, SurfaceFlinger,
+# boot animation, composer, allocator, pvrsrvctl. AOSP forbids debugfs
+# outside a few domains, and rightly so. The probe has no consequences: it
+# was blocked all along by the disabled audit path, without anything
+# suffering. So it is only silenced here, not allowed - and
+# centrally instead of per domain.
+dontaudit domain debugfs_ion:dir search;
+dontaudit domain debugfs_gpu_img:dir search;
+
+# --- fix-symlinks.sh ------------------------------------------------------
+# readlink -f walks the path from the root.
+allow fixsymlinks { rootfs device }:dir r_dir_perms;
+
+# --- Bluetooth HAL reads the tablet's own address from the idme area ------
+allow mtk_hal_bluetooth proc_idme:dir r_dir_perms;
+allow mtk_hal_bluetooth proc_idme:file r_file_perms;
+
+# --- Audio HAL reads the serial number from Amazon's idme area -------------
+allow hal_audio_default proc_idme:dir r_dir_perms;
+allow hal_audio_default proc_idme:file r_file_perms;
+
+# --- nvram_daemon looks for the NVRAM partition via sysfs ------------------
+allow nvram_daemon sysfs:file getattr;
+
+# --- thermal_manager --------------------------------------------------------
+# Requests CAP_DAC_OVERRIDE, manages without - thermal control has run
+# without it all along (throttling at 90 degrees demonstrably kicks in).
+dontaudit thermal_manager self:capability dac_override;
+
+# --- Bluetooth HAL reads its calibration from NVRAM ------------------------
+allow mtk_hal_bluetooth nvram_data_file:dir r_dir_perms;
+allow mtk_hal_bluetooth nvram_data_file:file r_file_perms;
+
+# ==========================================================================
+# Ninth round - first enforcing boot
+#
+# Important: capability checks do NOT show up in the log in permissive
+# mode. The kernel first checks them via ns_capable_noaudit(); in
+# permissive mode the capability is granted and the logging branch is
+# never reached. So they only become visible on the first enforcing
+# boot.
+# ==========================================================================
+
+# pvrsrvctl sets up the PowerVR driver and needs CAP_SYS_ADMIN for that.
+# In the init domain it had it; with its own domain it had to be granted
+# - without it the display stayed off and the boot hung at 27 services.
+allow pvrsrvctl self:capability sys_admin;
+
+# The sensor HAL searches /dev/input.
+allow mtk_hal_sensors input_device:dir search;
+
+# The init.rc creates /data/vendor/wifi including subdirectories.
+allow vendor_init wifi_data_file:dir
+    { create getattr open read search setattr write add_name };
+
+# The four new domains ran permissive for one pass to collect their
+# remaining capability requests in one go. Result: apart from
+# CAP_SYS_ADMIN for pvrsrvctl none of them needed anything. So they are
+# enforcing again.
+
+# --- ART updates .vdex in the Dalvik cache --------------------------------
+# system_server opens the .vdex of the apps running in it for writing, to
+# record the verification result (SettingsProvider, Telecom, LineageParts,
+# FusedLocation). AOSP forbids write access to dalvikcache_data_file
+# except for init, installd and dex2oat (domain.te:1055) - ART cleanly
+# falls back to read-only. That is the case on every Android 9 device.
+dontaudit system_server dalvikcache_data_file:file write;
+
+# Power save mode: power.mt8173 keeps the second big core above
+# MediaTek's hotplug limit (/proc/hps/num_limit_power_serv).
+allow hal_power_default proc_hps:dir search;
+allow hal_power_default proc_hps:file rw_file_perms;
+# Clock boost on app start: minimum frequency of both clusters (scaling_min_freq).
+allow hal_power_default sysfs_devices_system_cpu:file w_file_perms;
+
+# Usage widget in the launcher (priv_app, so only preinstalled
+# privileged apps): CPU times from /proc/stat and the GPU load. For
+# untrusted apps /proc/stat stays blocked
+# (app_neverallows.te).
+allow priv_app proc_stat:file r_file_perms;
+allow priv_app sysfs_gpu_loading:file r_file_perms;
+
+# MediaTek's camera 3A looks at the battery level, for flash limiting.
+# suez has no flash: the access is not needed and is not logged.
+dontaudit cameraserver sysfs_batteryinfo:dir search;
