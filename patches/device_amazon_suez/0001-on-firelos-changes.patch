diff --git a/overlay/packages/apps/Calendar/res/values-night/colors.xml b/overlay/packages/apps/Calendar/res/values-night/colors.xml
new file mode 100644
index 0000000..9d95adb
--- /dev/null
+++ b/overlay/packages/apps/Calendar/res/values-night/colors.xml
@@ -0,0 +1,81 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: Calendar follows dark mode. Most of these colours are read
+     with getColor() by the Java-drawn month, week, day and agenda views
+     (DayView, MonthWeekEventsView, SimpleWeekView, AgendaAdapter); the rest
+     are layout backgrounds and text. The design's dark tones (docs/DESIGN.md): #1A1C18
+     content, #24271F for the hour column and past days, #2F332B for today
+     and raised surfaces; light text; #1FFFFFFF grid lines.
+     Left as they are on purpose: event chips and their white text, the
+     selection/pressed blues, the widget (appwidget_*) colours and the alert
+     dialog colours (already on a dark Holo dialog). The side panel's light
+     nine-patches (mini month card, calendar list rows) have drawable-night /
+     layout-night replacements. month_dna_conflict_time_color is cached in a
+     static field, so it only follows a mode switch after the app restarts. -->
+<resources>
+    <!-- window and day/week view -->
+    <color name="background_color">#1A1C18</color>
+    <color name="calendar_future_bg_color">#1A1C18</color>
+    <color name="calendar_hour_background">#24271F</color>
+    <color name="day_past_background_color">#24271F</color>
+    <color name="calendar_date_banner_background">#24271F</color>
+    <color name="calendar_date_banner_text_color">#B3FFFFFF</color>
+    <color name="calendar_hour_label">#B3FFFFFF</color>
+    <color name="calendar_ampm_label">#8AFFFFFF</color>
+    <color name="calendar_grid_line_inner_horizontal_color">#1FFFFFFF</color>
+    <color name="calendar_grid_line_inner_vertical_color">#1FFFFFFF</color>
+    <color name="week_saturday">#80FFFFFF</color>
+    <color name="week_sunday">#80FFFFFF</color>
+    <!-- action bar texts (date range, view switcher) -->
+    <color name="calendar_date_range_color">#B3FFFFFF</color>
+    <color name="calendar_view_switch_menu_text_color">#DEFFFFFF</color>
+    <color name="calendar_view_switch_menu_text_color_light">#B3FFFFFF</color>
+    <!-- month view and mini month -->
+    <color name="month_bgcolor">#1A1C18</color>
+    <color name="month_other_bgcolor">#24271F</color>
+    <color name="month_today_bgcolor">#2F332B</color>
+    <color name="month_selected_week_bgcolor">#2F332B</color>
+    <color name="month_grid_lines">#1FFFFFFF</color>
+    <color name="month_day_number">#DEFFFFFF</color>
+    <color name="month_today_number">#DEFFFFFF</color>
+    <color name="month_mini_day_number">#DEFFFFFF</color>
+    <color name="month_day_number_other">#8AFFFFFF</color>
+    <color name="month_other_month_day_number">#8AFFFFFF</color>
+    <color name="month_week_num_color">#8AFFFFFF</color>
+    <color name="month_day_names_color">#8AFFFFFF</color>
+    <color name="month_saturday">#80FFFFFF</color>
+    <color name="month_sunday">#80FFFFFF</color>
+    <color name="month_event_color">#DEFFFFFF</color>
+    <color name="month_event_extra_color">#B3FFFFFF</color>
+    <color name="month_event_other_color">#B3FFFFFF</color>
+    <color name="month_event_extra_other_color">#4CFFFFFF</color>
+    <color name="month_dna_conflict_time_color">#DEFFFFFF</color>
+    <color name="mini_month_today_outline_color">#DEFFFFFF</color>
+    <!-- agenda -->
+    <color name="agenda_general_background_color">#1A1C18</color>
+    <color name="agenda_day_bar_background_color">#2F332B</color>
+    <color name="agenda_day_item_text_color">#B3FFFFFF</color>
+    <color name="agenda_item_standard_color">#DEFFFFFF</color>
+    <color name="agenda_item_declined_color">#66FFFFFF</color>
+    <color name="agenda_item_where_text_color">#B3FFFFFF</color>
+    <color name="agenda_item_where_declined_text_color">#66FFFFFF</color>
+    <color name="agenda_list_separator_color">#1FFFFFFF</color>
+    <color name="agenda_past_present_separator_color">#8AFFFFFF</color>
+    <!-- event info, create and edit event -->
+    <color name="event_info_organizer_color">#B3FFFFFF</color>
+    <color name="event_info_description_color">#B3FFFFFF</color>
+    <color name="event_info_body_color">#B3FFFFFF</color>
+    <color name="event_info_label_color">#8AFFFFFF</color>
+    <color name="calendar_owner_text_color">#B3FFFFFF</color>
+    <color name="create_event_date_color">#DEFFFFFF</color>
+    <color name="create_event_more_details_color">#B3FFFFFF</color>
+    <color name="create_event_divider_color">#1FFFFFFF</color>
+    <color name="edit_event_separator">#1FFFFFFF</color>
+    <!-- recurrence picker -->
+    <color name="recurrence_picker_background">#1A1C18</color>
+    <color name="recurrence_bubble_text_normal">#B3FFFFFF</color>
+    <!-- calendar list in the side panel -->
+    <color name="calendar_visible">#DEFFFFFF</color>
+    <color name="calendar_hidden">#8AFFFFFF</color>
+    <color name="calendar_secondary_visible">#B3FFFFFF</color>
+    <color name="calendar_secondary_hidden">#8AFFFFFF</color>
+</resources>
diff --git a/overlay/packages/apps/Calendar/res/values-night/styles.xml b/overlay/packages/apps/Calendar/res/values-night/styles.xml
new file mode 100644
index 0000000..d4ddd6e
--- /dev/null
+++ b/overlay/packages/apps/Calendar/res/values-night/styles.xml
@@ -0,0 +1,68 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: Calendar follows dark mode. Copies of the upstream styles
+     from res/values/styles.xml with the same items and the dark Holo
+     parents. CalendarActionBarStyle gains one item, the bar background,
+     flat on the window background (Holo's dark solid bar is near black);
+     CalendarTheme.WithActionBar gains the status bar colour. The edit-event text
+     appearances get light text instead of #333/#777/#000. Settings and the
+     calendar selection screens are themed Theme.Holo.Light directly in the
+     manifest and stay light. -->
+<resources>
+    <style name="CalendarTheme" parent="android:Theme.Holo">
+        <item name="android:windowContentOverlay">@null</item>
+    </style>
+
+    <style name="CalendarTheme.WithActionBar" parent="android:Theme.Holo">
+        <item name="android:windowNoTitle">false</item>
+        <item name="android:windowActionBar">true</item>
+        <item name="android:windowBackground">@color/background_color</item>
+        <item name="android:actionBarStyle">@style/CalendarActionBarStyle</item>
+        <!-- ON-FireLOS: no Holo shadow under the bar; the status bar in the
+             bar's colour (Holo leaves it black), dark icons in light mode. -->
+        <item name="android:windowContentOverlay">@null</item>
+        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
+        <item name="android:statusBarColor">@color/background_color</item>
+        <item name="android:windowLightStatusBar">false</item>
+        <item name="android:navigationBarColor">@color/background_color</item>
+        <item name="android:windowLightNavigationBar">false</item>
+        <item name="android:endYear">2036</item>
+        <item name="android:startYear">1970</item>
+    </style>
+
+    <style name="CalendarActionBarStyle" parent="android:style/Widget.Holo.ActionBar.Solid">
+        <item name="android:displayOptions">showCustom</item>
+        <item name="android:background">@color/background_color</item>
+    </style>
+
+    <style name="EditEventCustomActionButton" parent="android:style/Widget.Holo.ActionButton">
+        <item name="android:layout_height">match_parent</item>
+        <item name="android:layout_width">0dp</item>
+        <item name="android:layout_weight">1</item>
+        <item name="android:focusable">true</item>
+        <item name="android:orientation">horizontal</item>
+    </style>
+
+    <style name="TextAppearance.EditEvent_Button" parent="TextAppearance.EditEvent_Label">
+        <item name="android:textColor">#B3FFFFFF</item>
+    </style>
+
+    <style name="TextAppearance.Recurrence_Button" parent="TextAppearance.EditEvent_Label">
+        <item name="android:textColor">#DEFFFFFF</item>
+    </style>
+
+    <style name="TextAppearance.EditEvent">
+        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
+        <item name="android:textSize">18sp</item>
+        <item name="android:textColor">#DEFFFFFF</item>
+    </style>
+
+    <style name="TextAppearance.EditEvent_Spinner" parent="android:style/Widget.Holo.Spinner">
+        <item name="android:textSize">18sp</item>
