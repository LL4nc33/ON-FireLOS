+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: dark mode - the Cancel/Done icons are dark grey
+     holo_light bitmaps; on the dark action bar they are tinted light. Copy
+     of upstream layout/edit_event_custom_actionbar.xml with android:tint
+     added. -->
