diff --git a/overlay/packages/apps/Contacts/res/values-night/colors.xml b/overlay/packages/apps/Contacts/res/values-night/colors.xml
new file mode 100644
index 0000000..366d34d
--- /dev/null
+++ b/overlay/packages/apps/Contacts/res/values-night/colors.xml
@@ -0,0 +1,71 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: Contacts follows dark mode. Surfaces from the design
+     tokens (onfirelos_colors.xml: #1A1C18 content and flat bars, #24271F
+     cards and drawer), light text, olive accent.
+     Fixed values: the app is built against the public SDK
+     (LOCAL_SDK_VERSION := current) and cannot reference the private
+     framework accent.
+     primary_color is both the tool bar (set from Java in PeopleActivity and
+     MaterialColorMapUtils) and the accent; here it becomes the flat bar and
+     the accent moves to dialtacts_theme_color, which the night themes and
+     text styles in styles.xml use instead. The former leftovers that kept
+     primary_color as a foreground ("Add contacts" text, search back arrow,
+     selected drawer icon) now use dialtacts_theme_color in the app itself.
+     dialtacts_secondary_text_color is also the fill of the drawer's "new"
+     badge (white text); that badge is only shown for the assistant entry.
+     alert_background (sync-off banner) stays light because its text is a
+     hard-coded black. ic_add_contact_shortcut_background is a launcher icon
+     and stays. -->
+<resources>
+    <!-- bars: flat on the background, status bar included -->
+    <color name="primary_color">@color/onfirelos_background</color>
+    <color name="primary_color_dark">@color/onfirelos_background</color>
+    <color name="group_primary_color">@color/onfirelos_background</color>
+    <color name="group_primary_color_dark">@color/onfirelos_background</color>
+    <color name="contextual_selection_bar_color">@color/onfirelos_background</color>
+    <color name="contextual_selection_bar_status_bar_color">@color/onfirelos_background</color>
+    <color name="actionbar_color_grey_solid">#B3FFFFFF</color>
+    <color name="actionbar_text_color_black">#DEFFFFFF</color>
+    <color name="actionbar_icon_color_grey">#B3FFFFFF</color>
+    <color name="navigation_bar_bg">#000000</color>
+    <color name="navigation_bar_divider">#1FFFFFFF</color>
+    <!-- search box in the tool bar -->
+    <color name="searchbox_background_color">@color/onfirelos_surface_variant</color>
+    <color name="searchbox_text_color">#DEFFFFFF</color>
