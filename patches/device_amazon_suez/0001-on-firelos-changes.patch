diff --git a/device.mk b/device.mk
index 85bcaab..b9cd145 100644
--- a/device.mk
+++ b/device.mk
@@ -4,6 +4,13 @@ VENDOR := vendor/amazon/suez
 # Device overlay
 DEVICE_PACKAGE_OVERLAYS += $(DEVICE)/overlay
 
+# Accent and dark mode for the prebuilt Google apps (static runtime
+# resource overlays in rro/, installed to /vendor/overlay)
+PRODUCT_PACKAGES += \
+    OnFireLosAccentGms \
+    OnFireLosAccentSetupWizard \
+    OnFireLosNightPackageInstaller
+
 $(call inherit-product, $(SRC_TARGET_DIR)/product/languages_full.mk)
 
 # Device uses high-density artwork where available
@@ -104,7 +111,9 @@ PRODUCT_COPY_FILES += \
     $(DEVICE)/media/media_codecs_performance.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_codecs_performance.xml \
     $(DEVICE)/media/media_codecs_mediatek_audio.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_codecs_mediatek_audio.xml \
     $(DEVICE)/media/media_codecs_mediatek_video.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_codecs_mediatek_video.xml \
-    $(DEVICE)/media/media_profiles.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_profiles.xml \
+    $(DEVICE)/media/media_profiles.xml:$(TARGET_COPY_OUT_VENDOR)/etc/media_profiles_V1_0.xml \
+    $(DEVICE)/libskia_stub/libskia-32.so:$(TARGET_COPY_OUT_VENDOR)/lib/libskia.so \
+    $(DEVICE)/libskia_stub/libskia-64.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libskia.so \
     $(DEVICE)/media/mtk_omx_core.cfg:system/etc/mtk_omx_core.cfg
 
 PRODUCT_COPY_FILES += \
@@ -170,10 +179,75 @@ PRODUCT_COPY_FILES += \
     $(DEVICE)/seccomp/mediaextractor-seccomp.policy:$(TARGET_COPY_OUT_VENDOR)/etc/seccomp_policy/mediaextractor.policy
 
 # call dalvik heap config
-$(call inherit-product, frameworks/native/build/tablet-7in-hdpi-1024-dalvik-heap.mk)
+$(call inherit-product, frameworks/native/build/tablet-10in-xhdpi-2048-dalvik-heap.mk)
 
 # call hwui memory config
 $(call inherit-product-if-exists, frameworks/native/build/phone-xxhdpi-2048-hwui-memory.mk)
 
 # Get non-open-source specific aspects
 $(call inherit-product-if-exists, $(VENDOR)/suez-vendor.mk)
+
+# Camera app
+#
+# It stays with AOSP's Camera2, which comes in via generic_no_telephony.mk.
+#
+# Snap (packages/apps/Snap) was briefly added as well, because it shows the
+# switch between front and rear camera permanently, whereas Camera2 hides
+# it behind a three-dot menu that closes again after a few
+# seconds.
+#
+# On the device a more serious bug showed up: Snap's shutter button is cut
+# off at the bottom by the navigation bar. The cause is
+# PhotoUI.java:299 - there Snap gets the screen size with
+#
+#     mActivity.getWindowManager().getDefaultDisplay().getRealSize(size);
+#
+# getRealSize() returns the full panel size INCLUDING the navigation
+# bar. So on suez Snap calculates with 1920 instead of the 1848 usable
+# pixels and places its control bar 72 pixels too low. The same pattern
+# is in VideoUI, WideAnglePanoramaUI, FocusOverlayManager and ZoomRenderer.
+#
+# The hidden switch is annoying, a half-covered shutter button is
+# unusable. Hence Camera2.
+
+# Own name in the system.
+#
+# ro.lineage.version stays untouched - the backup tool backuptool.sh
+# relies on it when flashing, and the Settings app displays it.
+# On top of that come own properties and an own display ID, so that
+# "About tablet" and the boot log say ON-FireLOS and not the
+# name of a project that cannot vouch for this build.
+PRODUCT_PROPERTY_OVERRIDES += \
+    ro.onfirelos.device=suez \
+    ro.onfirelos.maintainer=OidaNice
+
+# System updates: the list of builds comes with each GitHub release
+# (scripts/make-ota-json.sh); "latest" always names the newest one.
+PRODUCT_PROPERTY_OVERRIDES += \
+    lineage.updater.uri=https://github.com/LL4nc33/ON-FireLOS/releases/latest/download/{device}.json
+
+# Game controllers released after Android 9: AOSP 14's key layouts, so their
+# buttons land where games expect them (see keylayout/README).
+PRODUCT_COPY_FILES +=     $(foreach f,$(notdir $(wildcard device/amazon/suez/keylayout/*.kl)),device/amazon/suez/keylayout/$(f):$(TARGET_COPY_OUT_SYSTEM)/usr/keylayout/$(f))
+
+# Charger screen while switched off: battery animation with the charge level
+PRODUCT_COPY_FILES += device/amazon/suez/charger/animation.txt:root/res/values/charger/animation.txt
+PRODUCT_COPY_FILES += device/amazon/suez/charger/font.png:root/res/images/charger/font.png
+
+# TWRP leaves /cache/recovery unlabeled.
+PRODUCT_COPY_FILES += device/amazon/suez/rootdir/etc/onfirelos-cache.rc:$(TARGET_COPY_OUT_SYSTEM)/etc/init/onfirelos-cache.rc
+PRODUCT_COPY_FILES += device/amazon/suez/rootdir/etc/onfirelos-webview.rc:$(TARGET_COPY_OUT_SYSTEM)/etc/init/onfirelos-webview.rc
+PRODUCT_COPY_FILES += device/amazon/suez/rootdir/etc/onfirelos-webview.sh:$(TARGET_COPY_OUT_SYSTEM)/etc/onfirelos-webview.sh
+PRODUCT_COPY_FILES += device/amazon/suez/rootdir/etc/onfirelos-stores.rc:$(TARGET_COPY_OUT_SYSTEM)/etc/init/onfirelos-stores.rc
+PRODUCT_COPY_FILES += device/amazon/suez/rootdir/etc/onfirelos-stores.sh:$(TARGET_COPY_OUT_SYSTEM)/etc/onfirelos-stores.sh
+
+# ON-FireLOS: the assistant ON-FireAI (onfireai/, scripts/onfireai-into-tree.sh).
+ifneq ($(wildcard packages/apps/ONFireAI/Android.mk),)
+PRODUCT_PACKAGES += ONFireAI
+endif
+
+# ON-FireLOS: apps in place of Google's (prebuilt-apps/, scripts/fetch-store-apps.sh).
+PRODUCT_PACKAGES += \
+    AuroraStore \
+    Droidify \
+    ESpeak
