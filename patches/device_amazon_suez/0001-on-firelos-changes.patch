diff --git a/rro/OnFireLosAccentSetupWizard/Android.mk b/rro/OnFireLosAccentSetupWizard/Android.mk
new file mode 100644
index 0000000..dd5f162
--- /dev/null
+++ b/rro/OnFireLosAccentSetupWizard/Android.mk
@@ -0,0 +1,14 @@
+# ON-FireLOS: static runtime resource overlay that gives the prebuilt
+# com.google.android.setupwizard the system accent. No LOCAL_RRO_THEME, so it lands
+# directly in /vendor/overlay, the only directory PackageManagerService
+# scans for overlays at boot. Built against the platform (no SDK version) so
+# its values can reference the private framework accent colours.
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+
+LOCAL_PACKAGE_NAME := OnFireLosAccentSetupWizard
+LOCAL_CERTIFICATE := platform
+LOCAL_PRIVATE_PLATFORM_APIS := true
+LOCAL_RESOURCE_DIR := $(LOCAL_PATH)/res
+
+include $(BUILD_RRO_PACKAGE)
