@@ -3,7 +3,32 @@
 # The filesystem that contains the filesystem checker binary (typically /system) cannot
 # specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
 
-/dev/block/platform/mtk-msdc.0/by-name/userdata   /data        ext4   noatime,nosuid,nodev,noauto_da_alloc    wait,check,encryptable=/dev/block/platform/mtk-msdc.0/by-name/metadata
+# /data on f2fs instead of ext4.
+#
+# f2fs is designed for flash storage: it writes log-structured instead of
+# overwriting blocks in fixed places. On eMMC with its sluggish random
+# write rate that is the difference you notice when apps and game saves
+# load.
+#
+# discard returns freed blocks to the controller, flush_merge
+# merges write barriers, the three inline_ options put small
+# files, attributes and directory entries into the inode instead of
+# separate blocks - exactly the pattern of an Android data partition.
+#
+# nobarrier would be faster still and is deliberately left off: this project
+# has already lost files to a power failure once.
+#
+# formattable makes fs_mgr create the partition itself with make_f2fs on
+# first boot if mounting fails - so the recovery does not need to
+# support f2fs.
+# ON-FireLOS: no fsck on /data. Android 9's fsck.f2fs does not match this
+# 3.18 kernel's f2fs: it found quota, nat_bits and SIT types to fix on every
+# boot - things the kernel neither writes nor reads - and checked all 27 GB
+# for 9 s each time. The kernel recovers fsynced data on mount by itself.
+# inline_dentry is unknown to this kernel and made it reject the whole
+# option string, so flush_merge and inline_xattr never took effect either.
+# inline_data is left out: in 3.18 it was new and still being fixed.
+/dev/block/platform/mtk-msdc.0/by-name/userdata   /data        f2fs   noatime,nosuid,nodev,discard,inline_xattr,flush_merge    wait,formattable,encryptable=/dev/block/platform/mtk-msdc.0/by-name/metadata
 /dev/block/platform/mtk-msdc.0/by-name/cache      /cache       ext4   noatime,nosuid,nodev,noauto_da_alloc    wait,check
 
 
@@ -18,3 +43,8 @@
 /dev/block/platform/mtk-msdc.0/by-name/recovery      /recovery       emmc  defaults defaults
 /dev/block/platform/mtk-msdc.0/by-name/tee1          /tee1           emmc  defaults defaults
 /dev/block/platform/mtk-msdc.0/by-name/tee2          /tee2           emmc  defaults defaults
+
+# ZRAM: compressed swap in RAM.
+# With 1.77 GiB the most effective single change - Android heaps typically
+# compress 2.5:1 to 3:1, so 512 MB of ZRAM hold about 1.5 GB.
+/dev/block/zram0    none    swap    defaults    zramsize=1073741824,max_comp_streams=4
