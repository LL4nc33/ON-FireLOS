+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: Email follows dark mode. Most names come from UnifiedEmail,
+     whose res dir Email builds in; this overlay dir has the highest
+     precedence for both. The design's dark tones (docs/DESIGN.md) (#1A1C18 lists
+     and, flat on them, the bars; #2F332B raised), light text, olive accent. Fixed values:
+     the app is built against the public SDK.
+     The reading pane stays light on purpose: message bodies are HTML in a
+     WebView with a white page and black text, and its header, footer and
+     border views have hard-coded white backgrounds. The colours it shares
+     with the list (text_color_black/grey, gray_text_color, accent_blue,
+     text_color_hint_grey) are therefore pinned to their light values under
+     their reading-pane names below. The search bar and its suggestion list
+     also have hard-coded white backgrounds (layout and Java), so their text
+     colours stay dark. primary_color is the tool bar and lies flat on the list; the
+     compose button, the draft label and the notification accent, which
+     also used it, keep a colour of their own. -->
+<resources>
+    <!-- bars: flat on the list colour, the status bar too (ON-FireLOS
+         design); the selection bar below stays raised. -->
+    <color name="primary_color">@color/list_background_color</color>
+    <color name="primary_dark_color">@color/list_background_color</color>
+    <color name="action_mode_background">#2F332B</color>
+    <color name="action_mode_statusbar_color">#2F332B</color>
+    <color name="onfirelos_bar_icon">#E4E6DD</color>
+    <!-- accent on dark surfaces -->
