+++ b/system.prop
@@ -1,5 +1,3 @@
-dalvik.vm.heapgrowthlimit=128m
-dalvik.vm.heapsize=256m
 debug.hwui.renderer=opengl
 debug.hwui.use_partial_updates=false
 debug.sf.disable_backpressure=1
@@ -10,6 +8,9 @@ persist.sys.display.clearMotion=1
 qemu.hw.mainkeys=0
 ro.audio.monitorRotation=true
 ro.audio.silent=0
+# ON-FireLOS: media plays on the speaker and into the remote submix while ON-FireAI
+# records it (echo reference for the wake word; frameworks/av audio policy patch).
+persist.audio.submix_tee=true
 ro.board.platform=mt8173
 ro.camera.sound.forced=0
 ro.carrier=wifi-only
@@ -27,3 +28,38 @@ service.wcn.coredump.mode=2
 service.wcn.driver.ready=no
 wifi.direct.interface=p2p0
 wifi.interface=wlan0
+
+# --- Performance ---
+
+# On the camera log volume: with the preview running the stack writes
+# about 500 lines per second. The sixteen switches that the blobs read
+# for this have no effect - measured against each other, "not set" gave
+# 2416/2673 lines and "set to 0" 3331/2889, so identical. The built-in
+# default is already the quiet one, it only gets louder upwards
+# (value 3). That is why they are no longer listed
+# here.
+
+# None of the 106 system apps ships compiled; 88 are at "quicken",
+# SystemUI even at "verify", so it runs in the interpreter. Measured, a
+# compiled app starts about 20 percent faster (Calculator 523 -> 413 ms,
+# Clock 800 -> 680 ms, two rounds each).
+#
+# Deliberately not precompiled at build time: that would bloat /system by
+# several hundred MB, and only about 380 MB are left there. Instead,
+# Android's own background job takes care of it, which runs anyway when
+# the device is idle and charging. The result goes to /data.
+#
+# install stays at speed-profile so that installations stay quick.
+pm.dexopt.bg-dexopt=speed
+
+# One user is enough. Takes precedence over config_multiuserMaximumUsers,
+# which two overlays set here with different values (device 5, LineageOS 4,
+# LineageOS wins). This removes "Multiple users" from Settings and the
+# user switcher from Quick Settings.
+fw.max_users=1
+
+# Video recording: the camera HAL from Fire OS 5 stores a gralloc pointer
+# of its own process in metadata buffers. Since Android 8 the encoder runs
+# in a different process and gets nothing usable from that. So
+# CameraSource takes real YUV data in shared memory.
+ro.camera.recording.yuv_only=true
diff --git a/tools/patch_camera_client.py b/tools/patch_camera_client.py
index 0c2a4fb..7c7ec1e 100644
--- a/tools/patch_camera_client.py
+++ b/tools/patch_camera_client.py
@@ -1,39 +1,119 @@
 #!/usr/bin/env python3
+"""Two-byte patch to libcam.client.so - independent of the blob version.
+
+Upstream (device/amazon/suez/tools/patch_camera_client.py) checks the whole file
+via SHA256 and aborts if it does not match. That is too strict: the blobs of
+different Fire OS versions differ in .dynsym/.dynstr/.rodata, while the code
+at the patch location is identical.
+
+Measured on two variants of the same library (both 202072 bytes):
+
+    Fire OS 5.3.6.4    d800c453...   \
+    ROM variant        eb6c15f3...    > .text only differs in 0x221D8-0x26C4D
+    Upstream expects   d0431fad...   /
+
+The target function _ZN7android15NSDisplayClient12StreamImgBufC1E... is at
+0x1D514 (620 bytes) and is identical byte for byte between the variants.
+
+So instead of a file hash this script checks three things:
+
+  1. the target function exists and is where the patch expects it
+  2. the patch offset lies within this function
+  3. exactly the expected bytes are at this offset
+
+Only then is anything written. If the bytes have already been replaced, the
+script ends quietly - the call is idempotent.
+"""
 
 import hashlib
+import struct
 import sys
 from pathlib import Path
 
-OFFSET = 0x1D58A
-ORIGINAL = bytes.fromhex("f5 f7")
-REPLACEMENT = bytes.fromhex("5c e0")
-ORIGINAL_SHA256 = "d0431fadd4f8d01aefc6961a5e147050823baa15a0236d1e9707a25b1e129f1f"
-PATCHED_SHA256 = "afe837dc8edbc46953685d8b23caf72d68083b6ab74a7787a6be1c18d99722c2"
+OFFSET      = 0x1D58A
+ORIGINAL    = bytes.fromhex("f5f7")      # BLX sp<ANativeWindowBuffer>::operator=
+REPLACEMENT = bytes.fromhex("5ce0")      # B   - the call is skipped
+FUNC        = "_ZN7android15NSDisplayClient12StreamImgBufC1ERKNS_2spIKNS0_7ImgInfoEEEiPvPPK13native_handleix"
+
+
+def symbols(data):
+    """Returns {name: (vaddr_without_thumb_bit, size)} from .symtab and .dynsym."""
+    if data[:4] != b"\x7fELF" or data[4] != 1:
+        raise SystemExit("not a 32-bit ELF file")
+    e_shoff, = struct.unpack_from("<I", data, 0x20)
+    shentsize, shnum, shstrndx = struct.unpack_from("<HHH", data, 0x2E)
 
+    secs = []
+    for i in range(shnum):
