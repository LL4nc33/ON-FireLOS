diff --git a/overlay/frameworks/base/core/res/res/values-night/colors.xml b/overlay/frameworks/base/core/res/res/values-night/colors.xml
new file mode 100644
index 0000000..dc06423
--- /dev/null
+++ b/overlay/frameworks/base/core/res/res/values-night/colors.xml
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: notifications follow dark mode. The text colours are picked
+     from the background (NotificationColorUtil), so they turn light by
+     themselves. -->
+<resources>
+    <!-- On the design's surface tone, the action row on its variant. -->
+    <color name="notification_material_background_color">#ff24271F</color>
+    <color name="notification_action_list">#ff2F332B</color>
+    <!-- App name and small icon in the notification header: olive on the dark
+         card; values has the dark green for the white one. -->
+    <color name="system_notification_accent_color">@color/accent_device_default_dark</color>
+    <!-- Several DeviceDefault themes (Settings dialogs among them) take the
+         light accent even when the dark overlay is on, which put dark green
+         buttons on dark grey. At night the light accent is the dark one; a
+         picked accent still applies, its overlay resolves the reference. -->
+    <color name="accent_device_default_light">@color/accent_device_default_dark</color>
+</resources>
diff --git a/overlay/frameworks/base/core/res/res/values/colors.xml b/overlay/frameworks/base/core/res/res/values/colors.xml
new file mode 100644
index 0000000..383ce2d
--- /dev/null
+++ b/overlay/frameworks/base/core/res/res/values/colors.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: framework colours outside the accent_device_default_* set
+     that still carried a foreign accent. They point at the accent, so a
+     colour chosen under Settings > Display > Style applies here too (the
+     Lineage accent overlays also replace system_notification_accent_color
+     directly).
+     - system_notification_accent_color: blue-grey of the system's own
+       notifications (USB, input method, device policy).
+     - material_deep_teal_300: unused teal of the Material palette, kept in
+       line so nothing teal remains.
+     - material_deep_teal_100: pressed background of the full-screen
+       keyboard's action button in the dark theme. A pale tint cannot be a
+       reference, so it is a fixed light olive. -->
+<resources>
+    <color name="system_notification_accent_color">@color/accent_device_default_light</color>
+    <color name="material_deep_teal_300">@color/accent_device_default_dark</color>
+    <color name="material_deep_teal_100">#C5D1B2</color>
+</resources>
