+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: the app's own accent replaced by the system's. The values
+     point at the framework accent, so they follow Settings > Display >
+     Style > Accent colour; with none chosen that is the logo's dark green on
+     light backgrounds and for large coloured areas, olive on dark ones.
+     primary_dark (status bar) and the search field on the tablet toolbar
+     take the darker accent_device_default_700. text_handle and
+     text_highlight sit on the green toolbar and so take the olive shade in
+     both modes; the launcher shortcut icons are drawn on a fixed light
+     tile. item_doc_background_selected keeps its 30 % alpha and therefore
+     cannot be a reference. item_root_icon is a colour state list that
+     points at root_activated_color. material_deep_teal_200/500 are
+     AppCompat's fallback accent for themes that set no colorAccent. -->
+<resources>
+    <color name="tool_bar_color">@*android:color/accent_device_default_light</color>
+    <color name="accent">@*android:color/accent_device_default_light</color>
+    <color name="primary_dark">@*android:color/accent_device_default_700</color>
+    <color name="root_activated_color">@*android:color/accent_device_default_light</color>
+    <color name="item_grid_tint">@*android:color/accent_device_default_light</color>
+    <color name="shortcut_foreground">@*android:color/accent_device_default_light</color>
+    <color name="item_doc_background_selected">#4D2E521D</color>
+    <color name="text_handle">@*android:color/accent_device_default_dark</color>
+    <color name="text_highlight">@*android:color/accent_device_default_dark</color>
+    <color name="material_deep_teal_200">@*android:color/accent_device_default_dark</color>
+    <color name="material_deep_teal_500">@*android:color/accent_device_default_light</color>
+</resources>
