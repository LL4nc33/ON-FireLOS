diff --git a/overlay/packages/apps/Email/res/values-night/styles.xml b/overlay/packages/apps/Email/res/values-night/styles.xml
new file mode 100644
index 0000000..1b041ec
--- /dev/null
+++ b/overlay/packages/apps/Email/res/values-night/styles.xml
@@ -0,0 +1,60 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: Email follows dark mode. Copies of UnifiedEmail's
+     themes.xml/styles.xml entries with the same items and dark parents
+     (Theme.AppCompat, Theme.AppCompat.NoActionBar). Changed values: the
+     tool-bar popup theme is the dark ThemeOverlay.AppCompat instead of the
+     light one; compose's hard-coded white window becomes list_background_color
+     (#1A1C18 at night; windowBackground only takes a reference) and the
+     compose area #2F332B. -->
+<resources xmlns:tools="http://schemas.android.com/tools">
+    <style name="UnifiedEmailTheme.Appcompat" parent="@style/Theme.AppCompat">
+        <item name="actionModeBackground">@color/action_mode_background</item>
+        <item name="colorPrimary">@color/primary_color</item>
+        <item name="colorPrimaryDark">@color/primary_dark_color</item>
+        <item name="colorAccent">@color/accent_blue</item>
+        <item name="android:colorEdgeEffect">@color/edge_effect_color</item>
+        <item name="homeAsUpIndicator">@drawable/onfirelos_bar_arrow_back</item>
+        <item name="actionBarTheme">@style/OnfirelosBarTheme</item>
+    </style>
+
+    <style name="UnifiedEmailTheme.Appcompat.Toolbar" parent="@style/Theme.AppCompat.NoActionBar">
+        <item name="actionBarPopupTheme">@style/ThemeOverlay.AppCompat</item>
+        <item name="actionModeBackground">@color/action_mode_background</item>
+        <item name="colorPrimary">@color/primary_color</item>
+        <item name="colorPrimaryDark">@color/primary_dark_color</item>
+        <item name="colorAccent">@color/accent_blue</item>
+        <item name="android:colorEdgeEffect">@color/edge_effect_color</item>
+        <item name="homeAsUpIndicator">@drawable/onfirelos_bar_arrow_back</item>
+        <item name="actionBarTheme">@style/OnfirelosBarTheme</item>
+        <item name="windowActionModeOverlay">true</item>
+        <!-- Tell SystemUI that our activity window will draw the background for the status bar. -->
+        <item name="android:windowDrawsSystemBarBackgrounds" tools:ignore="NewApi">true</item>
+        <!-- Set the status bar to fully transparent. We’ll draw it ourselves since we want to draw other content over it. -->
+        <item name="android:statusBarColor" tools:ignore="NewApi">@color/mail_activity_status_bar_color</item>
+    </style>
+
+    <style name="ComposeTheme" parent="@style/UnifiedEmailTheme.Appcompat">
+        <item name="android:colorBackground">@color/list_background_color</item>
+        <item name="android:colorBackgroundCacheHint">@color/list_background_color</item>
+        <item name="android:dropDownListViewStyle">@style/ComposeDropdownListViewStyle</item>
+        <item name="android:windowBackground">@color/list_background_color</item>
+    </style>
+
+    <style name="ComposeDropdownListViewStyle" parent="@style/Widget.AppCompat.ListView.DropDown">
+        <item name="android:divider">@null</item>
+        <item name="android:dividerHeight">0dp</item>
+    </style>
+
+    <style name="AbstractComposeArea">
+        <item name="android:layout_width">match_parent</item>
+        <item name="android:layout_height">match_parent</item>
+        <item name="android:layout_gravity">center_horizontal</item>
+        <item name="android:animateLayoutChanges">true</item>
+        <item name="android:background">#2F332B</item>
+    </style>
+    <!-- The bars' theme at night (UnifiedEmail values/onfirelos_bar.xml). -->
+    <style name="OnfirelosBarTheme" parent="ThemeOverlay.AppCompat.Dark">
+        <item name="colorControlNormal">@color/onfirelos_bar_icon</item>
+        <item name="android:textColorPrimary">@color/onfirelos_bar_icon</item>
+    </style>
+</resources>
