new file mode 100644
index 0000000..e4b36ea
--- /dev/null
+++ b/overlay/frameworks/base/packages/SystemUI/res/values/config.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Tablet adjustments for the system UI.
+
+  Android 9 no longer has a tablet UI of its own - Google dropped it years
+  before. What remains are defaults that come from phones and simply
+  waste space on a width of 800 dp.
+-->
+<resources>
+    <!-- Three tiles per row is the phone default. With 800 dp of usable
+         width five fit comfortably, without the labels wrapping. -->
+    <integer name="quick_settings_num_columns">5</integer>
+
+    <!-- Correspondingly more tiles in the collapsed row. -->
+    <integer name="quick_qs_panel_max_columns">6</integer>
+</resources>
