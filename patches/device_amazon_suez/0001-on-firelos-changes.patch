      for different hardware and product builds. -->
 <resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
 
+    <!-- Two-button gesture navigation on by default.
+         Android 9 only knows this mode - arrow on the left, pill in the middle,
+         overview by swiping up. Full edge gestures only came with
+         Android 10. On a 10-inch tablet three fixed buttons are
+         wasted space, and TrebuchetQuickStep is part of this build
+         anyway (TouchInteractionService answers QUICKSTEP_SERVICE).
+         AOSP sets the value to false; LineageOS in its common overlay only
+         unlocks the visibility of the setting
+         (config_swipe_up_gesture_setting_available), not the default.
+         Can be switched off under System -> Advanced -> Gestures. -->
+    <bool name="config_swipe_up_gesture_default">true</bool>
+
+    <!-- Let the lock screen rotate.
+         AOSP switches this off ("Disable lockscreen rotation by default"),
+         because the default comes from phones. On a 10-inch tablet that is
+         mostly held in landscape, a lock screen that stubbornly stays in
+         portrait is simply wrong - you have to rotate the device to unlock
+         it and then back again. -->
+    <bool name="config_enableLockScreenRotation">true</bool>
+
     <!-- This device does not allow sms service. -->
     <bool name="config_sms_capable">false</bool>
 
@@ -123,4 +143,19 @@
         <item>225</item>    <!-- 10000-11999 -->
         <item>255</item>    <!-- 12000-19417 (max value of light sensor) -->
