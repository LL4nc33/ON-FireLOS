+            android:layout_height="match_parent">
+
+            <View android:id="@+id/event_bg"
+                android:layout_width="match_parent"
+                android:layout_height="match_parent"
+                android:layout_gravity="center_horizontal|top"
+                android:background="#FF424242"/>
+
+            <LinearLayout
+                android:id="@+id/two_pane"
+                android:orientation="vertical"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:paddingTop="28dip"
+                android:paddingLeft="@dimen/edit_event_view_padding_left"
+                android:paddingRight="@dimen/edit_event_view_padding_right"
+                android:layout_gravity="center_horizontal|top">
+
+                <include
+                    layout="@layout/edit_event_1"
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content" />
+
+            </LinearLayout>
+
+            <View android:id="@+id/color_chip"
+                android:layout_width="50dip"
+                android:layout_height="50dip"
+                android:layout_gravity="left|top"/>
+        </FrameLayout>
+    </ScrollView>
+</LinearLayout>
