diff --git a/rootdir/etc/onfirelos-stores.rc b/rootdir/etc/onfirelos-stores.rc
new file mode 100644
index 0000000..849293a
--- /dev/null
+++ b/rootdir/etc/onfirelos-stores.rc
@@ -0,0 +1,14 @@
+# ON-FireLOS: the app stores the ROM ships in place of Google's (Droid-ify,
+# Aurora Store) may install apps from the first start on, without the "install
+# unknown apps" question - installing is what they are there for. A oneshot
+# shell service, as for the WebView flags: setting an app op needs the shell's
+# rights, not init's.
+service onfirelos_stores /system/bin/sh /system/etc/onfirelos-stores.sh
+    user shell
+    group shell
+    seclabel u:r:shell:s0
+    oneshot
+    disabled
+
+on property:sys.boot_completed=1
+    start onfirelos_stores
diff --git a/rootdir/etc/onfirelos-stores.sh b/rootdir/etc/onfirelos-stores.sh
new file mode 100755
index 0000000..42a5c28
--- /dev/null
+++ b/rootdir/etc/onfirelos-stores.sh
@@ -0,0 +1,10 @@
+#!/system/bin/sh
+# ON-FireLOS: allows the bundled app stores to install apps (see
+# onfirelos-stores.rc). Once per installation - the mark lies in /data, which a
+# new installation clears - so that the user's own "not allowed" later stays.
+MARK=/data/local/tmp/.onfirelos-stores
+[ -e "$MARK" ] && exit 0
+for p in com.aurora.store com.looker.droidify; do
+    cmd appops set "$p" REQUEST_INSTALL_PACKAGES allow || exit 1
+done
+touch "$MARK"
diff --git a/rootdir/etc/onfirelos-webview.rc b/rootdir/etc/onfirelos-webview.rc
new file mode 100644
index 0000000..b9c9ab6
--- /dev/null
+++ b/rootdir/etc/onfirelos-webview.rc
@@ -0,0 +1,16 @@
+# ON-FireLOS: startup flags for the system WebView. Chromium keeps the 2D
+# canvas of web pages in software on this PowerVR driver; a page drawing a
+# full-screen canvas with blur filters then holds its main thread at 100 % and
+# nothing else on it runs. --ignore-gpu-blocklist puts the canvas on the GPU;
+# --disable-gpu-rasterization keeps page rasterization on the CPU, where it
+# was. The WebView reads these from /data/local/tmp (debuggable builds only),
+# which init may not write: a oneshot shell service does, as the console does.
+service onfirelos_webview /system/bin/sh /system/etc/onfirelos-webview.sh
+    user shell
+    group shell
+    seclabel u:r:shell:s0
+    oneshot
+    disabled
+
+on post-fs-data
+    start onfirelos_webview
diff --git a/rootdir/etc/onfirelos-webview.sh b/rootdir/etc/onfirelos-webview.sh
new file mode 100755
index 0000000..b2f2f47
--- /dev/null
+++ b/rootdir/etc/onfirelos-webview.sh
@@ -0,0 +1,4 @@
+#!/system/bin/sh
+# ON-FireLOS: writes the WebView's startup flags (see onfirelos-webview.rc).
+umask 022
+echo "_ --ignore-gpu-blocklist --disable-gpu-rasterization" > /data/local/tmp/webview-command-line
diff --git a/rro/OnFireLosAccentGms/Android.mk b/rro/OnFireLosAccentGms/Android.mk
new file mode 100644
