--- /dev/null
+++ b/overlay/packages/apps/Camera2/res/values/colors.xml
@@ -0,0 +1,19 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: the app's own accent replaced by the system's. The values
+     point at the framework accent, so they follow Settings > Display >
+     Style > Accent colour; with none chosen that is the logo's dark green on
+     light backgrounds and for large coloured areas, olive on dark ones.
+     The camera UI is always dark: text and outlines on it take the olive
+     shade, coloured surfaces (dialog background, shutter button in photo
+     mode, settings cling, button text on the white cling button) the dark
+     green. The other modes keep their own colours. -->
+<resources>
+    <color name="main_color_global">@*android:color/accent_device_default_light</color>
+    <color name="camera_mode_color">@*android:color/accent_device_default_light</color>
+    <color name="settings_cling_color">@*android:color/accent_device_default_light</color>
+    <color name="blue_button_text_color">@*android:color/accent_device_default_light</color>
+    <color name="dialog_button_color">@*android:color/accent_device_default_dark</color>
+    <color name="popup_title_color">@*android:color/accent_device_default_dark</color>
+    <color name="mode_selection_border">@*android:color/accent_device_default_dark</color>
+    <color name="review_control_pressed_color">@*android:color/accent_device_default_dark</color>
+</resources>
