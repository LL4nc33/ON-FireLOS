+++ b/overlay/packages/apps/Calendar/res/layout-sw600dp-night/edit_event.xml
@@ -0,0 +1,67 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: dark edit-event screen (tablet). Copy of upstream
