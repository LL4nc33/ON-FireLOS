diff --git a/overlay/frameworks/base/core/res/res/values/onfirelos_design.xml b/overlay/frameworks/base/core/res/res/values/onfirelos_design.xml
new file mode 100644
index 0000000..751ccd1
--- /dev/null
+++ b/overlay/frameworks/base/core/res/res/values/onfirelos_design.xml
@@ -0,0 +1,26 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 ON-FireLOS, Apache-2.0. The system layer of
+     docs/DESIGN.md: surfaces tinted with the accent rather than plain grey,
+     one dark tone for every app, rounded shapes, flat bars. -->
+<resources>
+    <!-- Background: windows, lists, and the bars that lie on them. -->
+    <color name="background_material_light">#F6F8F3</color>
+    <color name="background_material_dark">#1A1C18</color>
+    <!-- Surface: what floats - dialogs, menus, cards. -->
+    <color name="background_floating_material_light">#FFFFFF</color>
+    <color name="background_floating_material_dark">#24271F</color>
+    <!-- Dark bars and the status bar above them on the background, flat. -->
+    <color name="primary_material_dark">#1A1C18</color>
+    <color name="primary_dark_material_dark">#1A1C18</color>
+
+    <!-- The action row of a notification on the surface variant. -->
+    <color name="notification_action_list">#ffE8ECE3</color>
+
+    <dimen name="config_dialogCornerRadius">28dp</dimen>
+    <!-- The same for apps on the plain Material themes, which read this one. -->
+    <dimen name="dialog_corner_radius">28dp</dimen>
+    <!-- Buttons are 36-48 dp high: fully round. -->
+    <dimen name="config_buttonCornerRadius">24dp</dimen>
+    <!-- Bars share the background: no shadow under them. -->
+    <dimen name="action_bar_elevation_material">0dp</dimen>
+</resources>
