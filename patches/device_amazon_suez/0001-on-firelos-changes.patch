+// Loaded by android.hardware.power@1.0-impl in place of power.default:
+// hw_get_module tries power.<ro.hardware> first.
+cc_library_shared {
+    name: "power.mt8173",
+    relative_install_path: "hw",
+    proprietary: true,
+    srcs: ["power.c"],
+    cflags: ["-Wall", "-Werror"],
+    header_libs: ["libhardware_headers"],
+    shared_libs: ["liblog"],
+}
diff --git a/power/power.c b/power/power.c
new file mode 100644
index 0000000..75e4308
--- /dev/null
+++ b/power/power.c
@@ -0,0 +1,287 @@
+/*
+ * Copyright (C) 2026 The ON-FireLOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * Power HAL for the MT8173.
+ *
+ * MediaTek's hotplug controller switches cores on only once load has built
+ * up - too late for the first frames of a touch or an app start, which then
+ * run on the two small cores. Android announces both: INTERACTION with every
+ * touch, LAUNCH around every app start. The generic power.default ignored
+ * them; here they raise the controller's floor of online cores for a moment.
+ *
+ * An app start also gets the clock: until it has drawn, both clusters run at
+ * the top of their regular tables. The governor otherwise counts the waits
+ * on storage as idle and clocks down in the middle of a start. Measured with
+ * the page cache dropped: the browser starts in 1615 instead of 1874 ms, the
+ * gallery in 538 instead of 661 ms.
+ *
+ * Battery saver works the other way round: it keeps the second big core
+ * (Cortex-A72) offline. Both are core counts, not clock limits -
+ * scaling_max_freq falls back to the table each time the controller brings a
+ * cluster back, the core counts hold.
+ */
+
+#define LOG_TAG "power.mt8173"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <hardware/hardware.h>
+#include <hardware/power.h>
+#include <log/log.h>
+
+#define UNUSED __attribute__((unused))
+
+/* "little big": the most cores of each cluster the controller may use... */
+#define HPS_LIMIT "/proc/hps/num_limit_power_serv"
+#define LIMIT_NORMAL "2 2"
+#define LIMIT_SAVER "2 1"
+
+/* ...and the fewest it keeps online. */
+#define HPS_BASE "/proc/hps/num_base_perf_serv"
+#define BASE_IDLE "1 0"
+#define BASE_TOUCH "2 1"
+#define BASE_LAUNCH "2 2"
+
+/* A touch keeps one big core up this long; an app start at most this long. */
+#define TOUCH_MS 1000
+#define LAUNCH_MS 3000
+
+/* Clock floor during an app start: the top of each regular table. The big
+ * cluster loses its limits whenever the hotplug controller takes it offline,
+ * and comes online only after the boost asked for it - so the floor is set
+ * again every few milliseconds while the start lasts. */
+#define LITTLE_MIN "/sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq"
+#define BIG_MIN "/sys/devices/system/cpu/cpu2/cpufreq/scaling_min_freq"
+#define LITTLE_TOP "1404000"
+#define BIG_TOP "1807000"
+#define CLOCK_FLOOR "507000"
+#define REAPPLY_MS 50
+
+static pthread_mutex_t sLock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t sWake;
+static struct timespec sBoostEnd;   /* CLOCK_MONOTONIC; zero: no boost */
+static const char *sBase = BASE_IDLE;
+static int sSaver;
+static int sClockBoost;
+
+static void write_file(const char *path, const char *value) {
+    int fd = open(path, O_WRONLY | O_CLOEXEC);
+    if (fd < 0) {
+        ALOGE("open %s: %s", path, strerror(errno));
+        return;
+    }
+    if (write(fd, value, strlen(value)) < 0) {
+        ALOGE("write %s: %s", path, strerror(errno));
+    }
+    close(fd);
+}
+
+/* Like write_file, but silent: the big cluster's files vanish while it is
+ * offline, and that is expected. */
+static void write_quiet(const char *path, const char *value) {
+    int fd = open(path, O_WRONLY | O_CLOEXEC);
+    if (fd >= 0) {
+        if (write(fd, value, strlen(value)) < 0) {
+            ALOGE("write %s: %s", path, strerror(errno));
+        }
+        close(fd);
+    }
+}
+
+static void set_clocks_locked(int boost) {
+    sClockBoost = boost;
+    write_quiet(LITTLE_MIN, boost ? LITTLE_TOP : CLOCK_FLOOR);
+    write_quiet(BIG_MIN, boost ? BIG_TOP : CLOCK_FLOOR);
+}
+
+static void set_base_locked(const char *base) {
+    if (strcmp(base, sBase) != 0) {
+        sBase = base;
+        write_file(HPS_BASE, base);
+    }
+}
+
+/* Raises the floor until now + ms; a later end wins, a stronger floor stays. */
+static int sHaveThread; /* without the timer thread nothing may be raised */
+
+static void boost(const char *base, int ms) {
+    if (!sHaveThread) {
+        return;
+    }
+    struct timespec end;
+    clock_gettime(CLOCK_MONOTONIC, &end);
+    end.tv_sec += ms / 1000;
+    end.tv_nsec += (ms % 1000) * 1000000L;
+    if (end.tv_nsec >= 1000000000L) {
+        end.tv_sec++;
+        end.tv_nsec -= 1000000000L;
+    }
+    pthread_mutex_lock(&sLock);
+    if (!sSaver) {
+        if (strcmp(sBase, BASE_LAUNCH) != 0 || strcmp(base, BASE_LAUNCH) == 0) {
+            set_base_locked(base);
+        }
+        if (strcmp(base, BASE_LAUNCH) == 0) {
+            set_clocks_locked(1);
+        }
+        if (end.tv_sec > sBoostEnd.tv_sec
+                || (end.tv_sec == sBoostEnd.tv_sec && end.tv_nsec > sBoostEnd.tv_nsec)) {
+            sBoostEnd = end;
+        }
+        pthread_cond_signal(&sWake);
+    }
+    pthread_mutex_unlock(&sLock);
+}
+
+static void end_boost_locked(void) {
+    sBoostEnd.tv_sec = 0;
+    sBoostEnd.tv_nsec = 0;
+    set_base_locked(BASE_IDLE);
+    if (sClockBoost) {
+        set_clocks_locked(0);
+    }
+}
+
+/* Drops the floor again once the last boost has run out. */
+static void *boost_thread(void *arg UNUSED) {
+    pthread_mutex_lock(&sLock);
+    for (;;) {
+        if (sBoostEnd.tv_sec == 0) {
+            pthread_cond_wait(&sWake, &sLock);
+            continue;
+        }
+        struct timespec end = sBoostEnd;
+        struct timespec wake = end;
+        if (sClockBoost) {
+            /* Wake early to set the big cluster's floor again. */
+            struct timespec soon;
+            clock_gettime(CLOCK_MONOTONIC, &soon);
+            soon.tv_nsec += REAPPLY_MS * 1000000L;
+            if (soon.tv_nsec >= 1000000000L) {
+                soon.tv_sec++;
+                soon.tv_nsec -= 1000000000L;
+            }
+            if (soon.tv_sec < wake.tv_sec
+                    || (soon.tv_sec == wake.tv_sec && soon.tv_nsec < wake.tv_nsec)) {
+                wake = soon;
+            }
+        }
+        if (pthread_cond_timedwait(&sWake, &sLock, &wake) == ETIMEDOUT) {
+            if (sBoostEnd.tv_sec == end.tv_sec && sBoostEnd.tv_nsec == end.tv_nsec) {
+                struct timespec now;
+                clock_gettime(CLOCK_MONOTONIC, &now);
+                if (now.tv_sec > end.tv_sec
+                        || (now.tv_sec == end.tv_sec && now.tv_nsec >= end.tv_nsec)) {
+                    end_boost_locked();
+                    continue;
+                }
+            }
+            if (sClockBoost) {
+                write_quiet(BIG_MIN, BIG_TOP);
+            }
+        }
+    }
+    return NULL;
+}
+
+static void power_init(struct power_module *module UNUSED) {
+    static int sInitialized;
+    if (sInitialized) {
+        return;
+    }
+    sInitialized = 1;
+
+    pthread_condattr_t attr;
+    pthread_condattr_init(&attr);
+    pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
+    pthread_cond_init(&sWake, &attr);
+    pthread_condattr_destroy(&attr);
+
+    pthread_t thread;
+    if (pthread_create(&thread, NULL, boost_thread, NULL) == 0) {
+        pthread_detach(thread);
+        sHaveThread = 1;
+    } else {
+        ALOGE("no boost thread");
+    }
+}
+
+static void power_set_interactive(struct power_module *module UNUSED, int on UNUSED) {
+}
+
+static void power_hint(struct power_module *module UNUSED, power_hint_t hint, void *data) {
+    switch (hint) {
+    case POWER_HINT_INTERACTION:
+        boost(BASE_TOUCH, TOUCH_MS);
+        break;
+    case POWER_HINT_LAUNCH:
+        /* data is non-NULL when a start begins, NULL once it is drawn. */
+        if (data) {
+            boost(BASE_LAUNCH, LAUNCH_MS);
+        } else {
+            /* Back to the touch floor and the normal clock; the timer lowers
+             * the floor when due. */
+            pthread_mutex_lock(&sLock);
+            if (strcmp(sBase, BASE_LAUNCH) == 0) {
+                set_base_locked(BASE_TOUCH);
+            }
+            if (sClockBoost) {
+                set_clocks_locked(0);
+            }
+            pthread_mutex_unlock(&sLock);
+        }
+        break;
+    case POWER_HINT_LOW_POWER:
+        /* data is non-NULL while battery saver is on. */
+        ALOGI("battery saver %s", data ? "on" : "off");
+        pthread_mutex_lock(&sLock);
+        sSaver = data != NULL;
+        if (sSaver) {
+            end_boost_locked();
+        }
+        write_file(HPS_LIMIT, sSaver ? LIMIT_SAVER : LIMIT_NORMAL);
+        pthread_mutex_unlock(&sLock);
+        break;
+    default:
+        break;
+    }
+}
+
+static struct hw_module_methods_t power_module_methods = {
+    .open = NULL,
+};
+
+struct power_module HAL_MODULE_INFO_SYM = {
+    .common = {
+        .tag = HARDWARE_MODULE_TAG,
+        .module_api_version = POWER_MODULE_API_VERSION_0_2,
+        .hal_api_version = HARDWARE_HAL_API_VERSION,
+        .id = POWER_HARDWARE_MODULE_ID,
+        .name = "MT8173 Power HAL",
+        .author = "The ON-FireLOS Project",
+        .methods = &power_module_methods,
+    },
+
+    .init = power_init,
+    .setInteractive = power_set_interactive,
+    .powerHint = power_hint,
+};
diff --git a/prebuilt-apps/Android.mk b/prebuilt-apps/Android.mk
new file mode 100644
index 0000000..9657a66
--- /dev/null
+++ b/prebuilt-apps/Android.mk
@@ -0,0 +1,47 @@
+# ON-FireLOS: the apps shipped in place of Google's (scripts/fetch-store-apps.sh
+# puts the APKs here): Droid-ify, Aurora Store, eSpeak. Droid-ify and Aurora
+# keep their native libraries uncompressed, so they are installed unchanged
+# with F-Droid's signature and Droid-ify can update them; not dexpreopted,
+# which would change the APK. eSpeak compresses its library; an app in /system
+# cannot unpack its own, and the build's uncompressing invalidates F-Droid's
+# signature - so eSpeak is signed with the ROM's key and updated with the ROM.
+LOCAL_PATH := $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := Droidify
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_SRC_FILES := Droidify/Droidify.apk
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_DEX_PREOPT := false
+LOCAL_PREBUILT_JNI_LIBS_arm64 := \
+    @lib/arm64-v8a/libandroidx.graphics.path.so \
+    @lib/arm64-v8a/libdatastore_shared_counter.so \
+    @lib/arm64-v8a/libimage_processing_util_jni.so \
+    @lib/arm64-v8a/libsurface_util_jni.so
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := AuroraStore
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_SRC_FILES := AuroraStore/AuroraStore.apk
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_DEX_PREOPT := false
+LOCAL_PREBUILT_JNI_LIBS_arm64 := \
+    @lib/arm64-v8a/libandroidx.graphics.path.so
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := ESpeak
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_SRC_FILES := ESpeak/ESpeak.apk
+LOCAL_CERTIFICATE := $(DEFAULT_SYSTEM_DEV_CERTIFICATE)
+LOCAL_DEX_PREOPT := false
+LOCAL_PREBUILT_JNI_LIBS_arm64 := \
+    @lib/arm64-v8a/libttsespeak.so
+include $(BUILD_PREBUILT)
