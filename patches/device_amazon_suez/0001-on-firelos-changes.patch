+    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
+    <!-- AOSP's 1 of 255 is meant for OLED; on this LCD it is barely visible. -->
+    <integer name="config_screenBrightnessDoze">24</integer>
+    <!-- ON-FireLOS: the clock's standby screen shows notification icons
+         (deskclock-standby.py). -->
+    <string name="config_defaultListenerAccessPackages" translatable="false">com.android.deskclock</string>
 </resources>
