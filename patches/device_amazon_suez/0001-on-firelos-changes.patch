--- /dev/null
+++ b/overlay/packages/apps/PackageInstaller/res/values-night/themes.xml
@@ -0,0 +1,26 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- ON-FireLOS: the permission prompt, install/uninstall screens and alerts
+     follow dark mode. Same items as upstream, dark parents; the layouts take
+     their colours from the theme (colorBackground, textColorPrimary). The
+     *.FilterTouches styles inherit from these by name and stay untouched. -->
+<resources>
+    <style name="GrantPermissions"
+           parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
+        <item name="*android:windowFixedHeightMajor">100%</item>
+        <item name="*android:windowFixedHeightMinor">100%</item>
+        <item name="android:windowBackground">@android:color/transparent</item>
+    </style>
+
+    <style name="DialogWhenLarge"
+            parent="@android:style/Theme.DeviceDefault.NoActionBar">
+        <item name="android:textAppearanceMedium">@style/MediumText</item>
+        <item name="android:textAppearanceSmall">@style/SmallText</item>
+        <item name="android:titleTextStyle">@style/TitleText</item>
+        <item name="android:filterTouchesWhenObscured">true</item>
+    </style>
+
+    <style name="AlertDialogActivity"
+            parent="@android:style/Theme.DeviceDefault.Panel">
+        <item name="android:backgroundDimEnabled">true</item>
+    </style>
+</resources>
