diff --git a/seccomp/mediacodec-seccomp.policy b/seccomp/mediacodec-seccomp.policy
index 0514022..546762d 100644
--- a/seccomp/mediacodec-seccomp.policy
+++ b/seccomp/mediacodec-seccomp.policy
@@ -64,3 +64,8 @@ munlock: 1
 setsockopt: 1
 setrlimit: 1
 sysinfo: 1
+
+# PowerVR gralloc (gralloc.mt8173.img.so) calls tee() when an encoder reads
+# frames from a surface - screen recording with the software H.264 encoder.
+# Without it seccomp aborted the whole codec service.
+tee: 1
diff --git a/sensor/Sensors.cpp b/sensor/Sensors.cpp
index 3e5d1e6..30d6e4e 100644
--- a/sensor/Sensors.cpp
+++ b/sensor/Sensors.cpp
@@ -198,9 +198,16 @@ Return<void> Sensors::poll(int32_t maxCount, poll_cb _hidl_cb) {
         } else {
             int bufferSize = maxCount <= kPollMaxBufferSize ? maxCount : kPollMaxBufferSize;
             data.reset(new sensors_event_t[bufferSize]);
-            err = mSensorDevice->poll(
-                reinterpret_cast<sensors_poll_device_t *>(mSensorDevice),
-                data.get(), bufferSize);
+            // ON-FireLOS: MediaTek's module returns -EINTR when a signal
+            // interrupts its poll(). This library also runs inside
+            // system_server, and every ANR sends it SIGQUIT for the stack
+            // traces; passed on as an error, SensorService aborted and took
+            // the whole system with it. Poll again instead.
+            do {
+                err = mSensorDevice->poll(
+                    reinterpret_cast<sensors_poll_device_t *>(mSensorDevice),
+                    data.get(), bufferSize);
+            } while (err == -EINTR);
         }
     }
 
