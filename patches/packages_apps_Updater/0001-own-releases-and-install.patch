+package org.lineageos.updater.misc;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * ON-FireLOS: what the update list says about a release beyond the AOSP fields - its own
+ * name ("1.02") and its notes - by download id. Filled while the list is read (Utils).
+ */
+public final class ReleaseInfo {
+
+    public static final class Entry {
+        public final String name;
+        public final String changelog;
+
+        Entry(String name, String changelog) {
+            this.name = name;
+            this.changelog = changelog;
+        }
+    }
+
+    private static final Map<String, Entry> sEntries = new HashMap<>();
+
+    private ReleaseInfo() {
+    }
+
+    static synchronized void put(String downloadId, String name, String changelog) {
+        sEntries.put(downloadId, new Entry(name == null ? "" : name.trim(),
+                changelog == null ? "" : changelog.trim()));
+    }
+
+    public static synchronized Entry get(String downloadId) {
+        return sEntries.get(downloadId);
+    }
+}
