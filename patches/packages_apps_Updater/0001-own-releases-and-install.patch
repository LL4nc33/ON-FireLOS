+import java.util.regex.Pattern;
+
+/**
+ * ON-FireLOS: every release of the project with its date and notes, newest first, the one
+ * installed marked. From GitHub's public list of releases of the repository whose update
+ * list this tablet reads (lineage.updater.uri).
+ */
+public class HistoryActivity extends AppCompatActivity {
+
+    private static final int MAX_BYTES = 2 * 1024 * 1024;
+
+    private ViewGroup mList;
+    private View mProgress;
+    private View mError;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.onfirelos_history);
+        final Toolbar toolbar = findViewById(R.id.toolbar);
+        setSupportActionBar(toolbar);
+        getSupportActionBar().setDisplayShowTitleEnabled(false);
+        getSupportActionBar().setDisplayHomeAsUpEnabled(true);
+        mList = findViewById(R.id.onfirelos_history_list);
+        mProgress = findViewById(R.id.onfirelos_history_progress);
+        mError = findViewById(R.id.onfirelos_history_error);
+        load();
+    }
+
+    @Override
+    public boolean onSupportNavigateUp() {
+        finish();
+        return true;
+    }
+
+    private void load() {
+        final String url = releasesUrl();
+        new Thread(() -> {
+            String json = null;
+            if (url != null) {
+                try {
+                    json = fetch(url);
+                } catch (IOException e) {
+                    // Shown as the error below.
+                }
+            }
+            final String result = json;
+            runOnUiThread(() -> {
+                if (!isFinishing() && !isDestroyed()) {
+                    show(result);
+                }
+            });
+        }).start();
+    }
+
+    /** github.com/<owner>/<repo>/... in the update list's address gives the API's list. */
+    static String releasesUrl() {
+        final Matcher m = Pattern.compile("github\\.com/([^/]+)/([^/]+)/")
+                .matcher(SystemProperties.get(Constants.PROP_UPDATER_URI, ""));
+        return m.find() ? "https://api.github.com/repos/" + m.group(1) + "/" + m.group(2)
+                + "/releases?per_page=30" : null;
+    }
+
+    private static String fetch(String address) throws IOException {
+        final HttpURLConnection conn = (HttpURLConnection) new URL(address).openConnection();
+        try {
+            conn.setConnectTimeout(10000);
+            conn.setReadTimeout(10000);
+            conn.setRequestProperty("Accept", "application/vnd.github+json");
+            conn.setRequestProperty("User-Agent", "ON-FireLOS-Updater");
+            if (conn.getResponseCode() != 200) {
+                throw new IOException("HTTP " + conn.getResponseCode());
+            }
+            try (InputStream in = conn.getInputStream()) {
+                final ByteArrayOutputStream out = new ByteArrayOutputStream();
+                final byte[] buf = new byte[8192];
+                int n;
+                while ((n = in.read(buf)) > 0) {
+                    out.write(buf, 0, n);
+                    if (out.size() > MAX_BYTES) {
+                        throw new IOException("too large");
+                    }
+                }
+                return out.toString("UTF-8");
+            }
+        } finally {
+            conn.disconnect();
+        }
+    }
+
+    private void show(String json) {
+        mProgress.setVisibility(View.GONE);
+        final JSONArray releases;
+        try {
+            releases = json == null ? null : new JSONArray(json);
+        } catch (JSONException e) {
+            mError.setVisibility(View.VISIBLE);
+            return;
+        }
+        if (releases == null || releases.length() == 0) {
+            mError.setVisibility(View.VISIBLE);
+            return;
+        }
+        // GitHub lists by when the tag was made; newest published first instead.
+        final List<JSONObject> sorted = new ArrayList<>();
+        for (int i = 0; i < releases.length(); i++) {
+            final JSONObject release = releases.optJSONObject(i);
+            if (release != null && !release.optBoolean("draft")) {
+                sorted.add(release);
+            }
+        }
+        sorted.sort((a, b) -> b.optString("published_at").compareTo(a.optString("published_at")));
+        // The installed release (or the newest, on another build) open on a card of its own;
+        // the ones around it as rows that open with a tap, in one card each side.
+        final String installed = installedVersion();
+        int active = 0;
+        for (int i = 0; i < sorted.size(); i++) {
+            if (isInstalled(sorted.get(i), installed)) {
+                active = i;
+                break;
+            }
+        }
+        final LayoutInflater inflater = LayoutInflater.from(this);
+        ViewGroup rows = null;
+        for (int i = 0; i < sorted.size(); i++) {
+            final JSONObject release = sorted.get(i);
+            final ViewGroup parent;
+            if (i == active || rows == null) {
+                parent = card(inflater);
+                rows = i == active ? null : parent;
+            } else {
+                parent = rows;
+                inflater.inflate(R.layout.onfirelos_history_divider, parent, true);
+            }
+            final View item = inflater.inflate(R.layout.onfirelos_history_item, parent, false);
+            ((TextView) item.findViewById(R.id.onfirelos_history_name)).setText(name(release));
+            ((TextView) item.findViewById(R.id.onfirelos_history_date)).setText(
+                    date(release.optString("published_at")));
+            final TextView notes = item.findViewById(R.id.onfirelos_history_notes);
+            notes.setText(notes(release.optString("body")));
+            if (isInstalled(release, installed)) {
+                item.findViewById(R.id.onfirelos_history_installed).setVisibility(View.VISIBLE);
+            }
+            final View chevron = item.findViewById(R.id.onfirelos_history_chevron);
+            if (i == active) {
+                notes.setVisibility(View.VISIBLE);
+                chevron.setVisibility(View.GONE);
+            } else {
+                final TypedValue ripple = new TypedValue();
+                getTheme().resolveAttribute(android.R.attr.selectableItemBackground, ripple, true);
+                item.setBackgroundResource(ripple.resourceId);
+                item.setOnClickListener(v -> {
+                    final boolean open = notes.getVisibility() != View.VISIBLE;
+                    TransitionManager.beginDelayedTransition(mList);
+                    notes.setVisibility(open ? View.VISIBLE : View.GONE);
+                    chevron.animate().rotation(open ? 180f : 0f);
+                });
+            }
+            parent.addView(item);
+        }
+    }
+
+    /** A new card at the end of the list; its column for the entries. */
+    private ViewGroup card(LayoutInflater inflater) {
+        final View card = inflater.inflate(R.layout.onfirelos_history_card, mList, false);
+        // The rows' ripple stays inside the rounded corners.
+        card.setClipToOutline(true);
+        mList.addView(card);
+        return card.findViewById(R.id.onfirelos_history_card_content);
+    }
+
+    private static String name(JSONObject release) {
+        return release.optString("name", release.optString("tag_name"));
+    }
+
+    private static boolean isInstalled(JSONObject release, String installed) {
+        return installed != null && Pattern.compile(
+                "ON-FireLOS " + Pattern.quote(installed) + "(\\D|$)").matcher(name(release)).find();
+    }
+
+    /** "1.02" from the display id ON-FireLOS-1.02-<date>.<time>, null for other builds. */
+    private static String installedVersion() {
+        final Matcher m = Pattern.compile("ON-FireLOS-([0-9.]+)-").matcher(Build.DISPLAY);
+        return m.find() ? m.group(1) : null;
+    }
+
+    private String date(String iso) {
+        final SimpleDateFormat parser = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'",
+                Locale.ROOT);
+        parser.setTimeZone(TimeZone.getTimeZone("UTC"));
+        try {
+            final Date when = parser.parse(iso);
+            return DateFormat.getDateInstance(DateFormat.LONG).format(when);
+        } catch (ParseException e) {
+            return "";
+        }
+    }
+
+    /**
+     * The release notes as plain text: headings bold, list points as bullets, links and
+     * markup dropped, the checksum line left out.
+     */
+    static CharSequence notes(String markdown) {
+        final SpannableStringBuilder out = new SpannableStringBuilder();
+        boolean blank = false;
+        for (String raw : markdown.replace("\r", "").split("\n")) {
+            String line = raw.trim();
+            if (line.isEmpty()) {
+                blank = out.length() > 0;
+                continue;
+            }
+            // How to update is what this page is for; the hashes are for the download page.
+            if (line.startsWith("SHA-256") || line.contains("suez.json")
+                    || line.replace("**", "").startsWith("Updating:")) {
+                continue;
+            }
+            line = line.replaceAll("\\[([^\\]]*)\\]\\([^)]*\\)", "$1")
+                    .replace("**", "").replace("`", "")
+                    .replaceAll("(^|\\s)\\*(\\S[^*]*?)\\*(?=[\\s.,;:!?)]|$)", "$1$2");
+            if (out.length() > 0) {
+                out.append(blank ? "\n\n" : "\n");
+            }
+            blank = false;
+            if (line.startsWith("#")) {
+                final int start = out.length();
+                out.append(line.replaceFirst("^#+\\s*", ""));
+                out.setSpan(new StyleSpan(android.graphics.Typeface.BOLD), start, out.length(),
+                        Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            } else if (line.startsWith("- ") || line.startsWith("* ")) {
+                out.append("•  ").append(line.substring(2));
+            } else {
+                out.append(line);
+            }
+        }
+        return out;
+    }
+}
