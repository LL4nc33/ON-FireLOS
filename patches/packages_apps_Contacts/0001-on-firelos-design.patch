+    /** ON-FireLOS: the large title says what the tool bar's title says. */
+    public void setLargeTitle(CharSequence title) {
+        if (mLargeTitle != null) {
+            mLargeTitle.setText(title);
+        }
+    }
+
+    @Override
+    public void onScroll(AbsListView view, int firstVisibleItem, int visibleItemCount,
+            int totalItemCount) {
+        super.onScroll(view, firstVisibleItem, visibleItemCount, totalItemCount);
+        updateLargeTitle();
+    }
+
+    @Override
+    public void onHiddenChanged(boolean hidden) {
+        super.onHiddenChanged(hidden);
+        if (hidden) {
+            setToolbarTitleAlpha(1f);
+        } else {
+            updateLargeTitle();
+        }
+    }
+
+    @Override
+    public void onDestroyView() {
+        // The screens that take the list's place have no large title.
+        setToolbarTitleAlpha(1f);
+        mLargeTitle = null;
+        super.onDestroyView();
+    }
+
+    /**
+     * ON-FireLOS: the large title shows on the plain list only; the tool bar's title fades in
+     * as much of it as has scrolled away.
+     */
+    private void updateLargeTitle() {
+        if (mLargeTitle == null) return;
+        // The tool bar's search field counts from when it opens, before anything is typed.
+        final boolean show = !isSearchMode() && (mActionBarAdapter == null
+                || !mActionBarAdapter.isSearchMode() && !mActionBarAdapter.isSelectionMode());
+        mLargeTitle.setVisibility(show ? View.VISIBLE : View.GONE);
+        float away = 1f;
+        final View row = (View) mLargeTitle.getParent();
+        final int height = mLargeTitle.getHeight();
+        if (show && height == 0) {
+            away = 0f;  // not laid out yet: the list is at its top
+        } else if (show && row.getParent() == getListView()) {
+            // A row out of view is detached and counts as away.
+            away = Math.max(0f, Math.min(1f,
+                    (getListView().getPaddingTop() - row.getTop()) / (float) height));
+        }
+        setToolbarTitleAlpha(show ? away : 1f);
+    }
+
+    private void setToolbarTitleAlpha(float alpha) {
+        final Activity activity = getActivity();
+        if (activity == null) return;
+        final android.support.v7.widget.Toolbar toolbar = activity.findViewById(R.id.toolbar);
+        if (toolbar == null) return;
+        final int color = ContextCompat.getColor(activity, R.color.onfirelos_on_background);
+        toolbar.setTitleTextColor(ColorUtils.setAlphaComponent(color,
+                Math.round(android.graphics.Color.alpha(color) * alpha)));
     }
 
