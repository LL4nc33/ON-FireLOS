+
+/**
+ * World map (Equal Earth projection) with one tappable shape per country.
+ *
+ * <p>Geometry comes from {@code assets/world.txt} (see tools/make_world_asset.py). The asset is
+ * parsed once per process on a background thread and shared by all instances. All public
+ * methods must be called on the main thread.
+ */
+public class WorldMapView extends View {
+
+    private static final String TAG = "WorldMapView";
+    private static final String ASSET = "world.txt";
+
+    /** Size of the asset coordinate frame. Must match the header line of world.txt. */
+    public static final int ASSET_WIDTH = 2000;
+    public static final int ASSET_HEIGHT = 875;
+    /** Width / height of the drawn map. */
+    public static final float ASPECT = (float) ASSET_WIDTH / ASSET_HEIGHT;
+
+    // Equal Earth projection, identical to the generator.
+    private static final double A1 = 1.340264;
+    private static final double A2 = -0.081106;
+    private static final double A3 = 0.000893;
+    private static final double A4 = 0.003796;
+    private static final double M = Math.sqrt(3.0) / 2.0;
+    private static final double LAT_TOP = 84.0;
+    private static final double LAT_BOTTOM = -58.0;
+    private static final double X_MAX = Math.PI / (M * A1);
+    private static final double SCALE = ASSET_WIDTH / (2.0 * X_MAX);
+    private static final double Y_TOP = equalEarthY(Math.toRadians(LAT_TOP));
+
+    private static final long ANIM_DURATION_MS = 250;
+    private static final long PRESS_HOLD_MS = 140;
+    private static final float OUTLINE_DP = 0.75f;
+    private static final float NEAREST_DP = 24f;
+    private static final float MARKER_DOT_DP = 3f;      // radius of the coloured dot
+    private static final float MARKER_RING_DP = 4.5f;   // radius of the white ring behind it
+    private static final float MARKER_HALO_DP = 11f;    // radius of the soft halo
+    private static final int PRESS_OVERLAY_ALPHA = 56;  // white overlay, of 255
+
+    /** Callback for taps on a country. */
+    public interface Listener {
+        void onCountryTapped(String iso2, String region);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Shared, immutable map data
+    // ---------------------------------------------------------------------------------------
+
+    private static final class Country {
+        final String iso;
+        final String region;
+        final Path path;          // asset coordinates, EVEN_ODD (holes cut out)
+        final RectF bounds = new RectF();
+        final int[][] rings;      // x0,y0,x1,y1,... per ring, for nearest-distance tests
+        Region hitRegion;         // built lazily on the main thread
+
+        Country(String iso, String region, int[][] rings) {
+            this.iso = iso;
+            this.region = region;
+            this.rings = rings;
+            path = new Path();
+            path.setFillType(Path.FillType.EVEN_ODD);
+            for (int[] r : rings) {
+                path.moveTo(r[0], r[1]);
+                for (int i = 2; i < r.length; i += 2) {
+                    path.lineTo(r[i], r[i + 1]);
+                }
+                path.close();
+            }
+            path.computeBounds(bounds, true);
+        }
+
+        Region hitRegion() {
+            if (hitRegion == null) {
+                Region clip = new Region((int) Math.floor(bounds.left) - 1,
+                        (int) Math.floor(bounds.top) - 1,
+                        (int) Math.ceil(bounds.right) + 1,
+                        (int) Math.ceil(bounds.bottom) + 1);
+                hitRegion = new Region();
+                hitRegion.setPath(path, clip);
+            }
+            return hitRegion;
+        }
+    }
+
+    private static final class WorldData {
+        final Country[] countries;               // drawing order; tiny dots come last
+        final HashMap<String, Country> byIso = new HashMap<>();
+        final HashMap<String, Path> regionPaths = new HashMap<>();
+        final Path land = new Path();            // union of everything, for fill and outline
+
+        WorldData(ArrayList<Country> list) {
+            countries = list.toArray(new Country[list.size()]);
+            for (Country c : countries) {
+                byIso.put(c.iso, c);
+                land.addPath(c.path);
+                Path rp = regionPaths.get(c.region);
+                if (rp == null) {
+                    rp = new Path();
+                    regionPaths.put(c.region, rp);
+                }
+                rp.addPath(c.path);
+            }
+        }
+    }
+
+    // Main-thread only.
+    private static WorldData sData;
+    private static boolean sLoading;
+    private static final ArrayList<WorldMapView> sWaiting = new ArrayList<>();
+
+    /**
+     * Starts loading the map asset if it is not loaded yet. Main thread only. Safe to call
+     * repeatedly; views call it themselves.
+     */
+    public static void preload(Context context) {
+        if (sData != null || sLoading) {
+            return;
+        }
+        sLoading = true;
+        final AssetManager assets = context.getApplicationContext().getAssets();
+        final Handler main = new Handler(Looper.getMainLooper());
+        Thread t = new Thread(() -> {
+            WorldData data = null;
+            try {
+                data = load(assets);
+            } catch (IOException | RuntimeException e) {
+                Log.e(TAG, "Cannot load " + ASSET, e);
+            }
+            final WorldData result = data;
+            main.post(() -> {
+                sLoading = false;
+                if (result == null) {
+                    return;
+                }
+                sData = result;
+                ArrayList<WorldMapView> waiting = new ArrayList<>(sWaiting);
+                sWaiting.clear();
+                for (WorldMapView v : waiting) {
+                    v.onDataReady(result);
+                }
+            });
+        }, "WorldMapLoader");
+        t.setPriority(Thread.NORM_PRIORITY - 1);
+        t.start();
+    }
+
+    private static WorldData load(AssetManager assets) throws IOException {
+        ArrayList<Country> list = new ArrayList<>(240);
+        try (BufferedReader r = new BufferedReader(
+                new InputStreamReader(assets.open(ASSET), StandardCharsets.UTF_8), 16384)) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                if (line.isEmpty() || line.charAt(0) == '@') {
+                    continue;
+                }
+                if (line.charAt(0) == '#') {
+                    String expected = "#" + ASSET_WIDTH + " " + ASSET_HEIGHT;
+                    if (!line.trim().equals(expected)) {
+                        Log.w(TAG, "Asset frame " + line + " differs from " + expected);
+                    }
+                    continue;
+                }
+                int s1 = line.indexOf(' ');
+                int s2 = line.indexOf(' ', s1 + 1);
+                if (s1 <= 0 || s2 <= s1) {
+                    continue;
+                }
+                String iso = line.substring(0, s1);
+                String region = line.substring(s1 + 1, s2);
+                int[][] rings = parseRings(line, s2 + 1);
+                if (rings.length > 0) {
+                    list.add(new Country(iso, region, rings));
+                }
+            }
+        }
+        return new WorldData(list);
+    }
+
+    /** Parses "x,y x,y|x,y ..." starting at {@code start} without creating substrings. */
+    private static int[][] parseRings(String s, int start) {
+        ArrayList<int[]> rings = new ArrayList<>();
+        int[] buf = new int[256];
+        int n = 0;
+        int value = 0;
+        boolean neg = false;
+        boolean inNumber = false;
+        final int len = s.length();
+        for (int i = start; i <= len; i++) {
+            char c = i < len ? s.charAt(i) : '|';
+            if (c >= '0' && c <= '9') {
+                value = value * 10 + (c - '0');
+                inNumber = true;
+                continue;
+            }
+            if (c == '-') {
+                neg = true;
+                continue;
+            }
+            if (inNumber) {
+                if (n == buf.length) {
+                    int[] bigger = new int[n * 2];
+                    System.arraycopy(buf, 0, bigger, 0, n);
+                    buf = bigger;
+                }
+                buf[n++] = neg ? -value : value;
+                value = 0;
+                neg = false;
+                inNumber = false;
+            }
+            if (c == '|') {
+                if (n >= 6 && (n & 1) == 0) {
+                    int[] ring = new int[n];
+                    System.arraycopy(buf, 0, ring, 0, n);
+                    rings.add(ring);
+                }
+                n = 0;
+            }
+        }
+        return rings.toArray(new int[rings.size()][]);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Projection
+    // ---------------------------------------------------------------------------------------
+
+    private static double equalEarthY(double phi) {
+        double theta = Math.asin(M * Math.sin(phi));
+        double t2 = theta * theta;
+        double t6 = t2 * t2 * t2;
+        return theta * (A1 + A2 * t2 + t6 * (A3 + A4 * t2));
+    }
+
+    /**
+     * Projects a geographic position into asset coordinates (0..ASSET_WIDTH, 0..ASSET_HEIGHT).
+     * Latitudes outside the drawn range are clamped to its edge.
+     *
+     * @param out receives x at index 0 and y at index 1
+     */
+    public static void project(float lon, float lat, float[] out) {
+        double phi = Math.toRadians(Math.max(LAT_BOTTOM, Math.min(LAT_TOP, lat)));
+        double lambda = Math.toRadians(lon);
+        double theta = Math.asin(M * Math.sin(phi));
+        double t2 = theta * theta;
+        double t6 = t2 * t2 * t2;
+        double x = lambda * Math.cos(theta)
+                / (M * (A1 + 3 * A2 * t2 + t6 * (7 * A3 + 9 * A4 * t2)));
+        double y = theta * (A1 + A2 * t2 + t6 * (A3 + A4 * t2));
+        out[0] = (float) ((x + X_MAX) * SCALE);
+        out[1] = (float) ((Y_TOP - y) * SCALE);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Instance state
+    // ---------------------------------------------------------------------------------------
+
+    private WorldData mData;
+    private Listener mListener;
+
+    private int mLandColor = 0xFFE8ECE3;
+    private int mRegionColor = 0xFFC9D8BD;
+    private int mSelectedColor = 0xFF2E521D;
+    private int mOutlineColor = 0xFFFFFFFF;
+
+    private String mRegion;
+    private String mPrevRegion;
+    private String mIso;
+    private String mPrevIso;
+    private Country mSelected;
+    private Country mPrevSelected;
+    private float mProgress = 1f;
+    private final ValueAnimator mAnimator;
+
+    private float mMarkerLon = Float.NaN;
+    private float mMarkerLat = Float.NaN;
+    private boolean mMarkerAnimates;
+
+    private final Matrix mMatrix = new Matrix();
+    private final Matrix mInverse = new Matrix();
+    private float mScale = 1f;   // view px per asset unit
+
+    private final Paint mFillPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mStrokePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mMarkerPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final float[] mTmp = new float[2];
+
+    private final float mDensity;
+    private final int mTouchSlop;
+    private float mDownX;
+    private float mDownY;
+    private boolean mTracking;
+    private Country mPressed;
+    private final Runnable mClearPressed = () -> {
+        mPressed = null;
+        invalidate();
+    };
+
+    public WorldMapView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mDensity = getResources().getDisplayMetrics().density;
+        mTouchSlop = ViewConfiguration.get(context).getScaledTouchSlop();
+
+        mFillPaint.setStyle(Paint.Style.FILL);
+        mStrokePaint.setStyle(Paint.Style.STROKE);
+        mStrokePaint.setStrokeJoin(Paint.Join.ROUND);
+        mStrokePaint.setStrokeCap(Paint.Cap.ROUND);
+        mMarkerPaint.setStyle(Paint.Style.FILL);
+
+        mAnimator = ValueAnimator.ofFloat(0f, 1f);
+        mAnimator.setDuration(ANIM_DURATION_MS);
+        mAnimator.setInterpolator(new PathInterpolator(0.4f, 0f, 0.2f, 1f));
+        mAnimator.addUpdateListener(a -> {
+            mProgress = (Float) a.getAnimatedValue();
+            invalidate();
+        });
+
+        setClickable(true);
+        mData = sData;
+        if (mData == null && !isInEditMode()) {
+            preload(context);
+        }
+    }
+
+    public void setListener(Listener listener) {
+        mListener = listener;
+    }
+
+    /** Sets all colours (ARGB). Land = every country, regionLand = countries of the region. */
+    public void setColors(int land, int regionLand, int selected, int outline) {
+        mLandColor = land;
+        mRegionColor = regionLand;
+        mSelectedColor = selected;
+        mOutlineColor = outline;
+        invalidate();
+    }
+
+    /**
+     * Highlights a region (EU, AF, AS, NA, SA, OC) and a country within it. Either may be null.
+     * Countries that are not on the map (e.g. Andorra) only highlight their region.
+     */
+    public void setSelection(String iso2, String region, boolean animate) {
+        if (iso2 != null) {
+            iso2 = iso2.toUpperCase(Locale.US);
+        }
+        if (equals(iso2, mIso) && equals(region, mRegion)) {
+            return;
+        }
+        mAnimator.cancel();
+        mPrevIso = mIso;
+        mPrevRegion = mRegion;
+        mIso = iso2;
+        mRegion = region;
+        resolveSelection();
+        updateContentDescription();
+        if (animate && isAttachedToWindow() && mData != null) {
+            mProgress = 0f;
+            mAnimator.start();
+        } else {
+            mProgress = 1f;
+            invalidate();
+        }
+    }
+
+    public String getSelectedIso() {
+        return mIso;
+    }
+
+    public String getSelectedRegion() {
+        return mRegion;
+    }
+
+    /**
+     * Shows a location marker. Pass {@code Float.NaN} for either value to hide it. If a selection
+     * animation is running, the marker fades in with it.
+     */
+    public void setMarker(float lon, float lat) {
+        mMarkerLon = lon;
+        mMarkerLat = lat;
+        mMarkerAnimates = mAnimator.isRunning();
+        invalidate();
+    }
+
+    private static boolean equals(String a, String b) {
+        return a == null ? b == null : a.equals(b);
+    }
+
+    private void resolveSelection() {
+        if (mData == null) {
+            mSelected = mPrevSelected = null;
+            return;
+        }
+        mSelected = mIso == null ? null : mData.byIso.get(mIso);
+        mPrevSelected = mPrevIso == null ? null : mData.byIso.get(mPrevIso);
+    }
+
+    private void updateContentDescription() {
+        if (mIso == null) {
+            setContentDescription(null);
+        } else {
+            setContentDescription(new Locale("", mIso).getDisplayCountry());
+        }
+    }
+
+    private void onDataReady(WorldData data) {
+        mData = data;
+        resolveSelection();
+        invalidate();
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Layout
+    // ---------------------------------------------------------------------------------------
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        final int wMode = MeasureSpec.getMode(widthMeasureSpec);
+        final int hMode = MeasureSpec.getMode(heightMeasureSpec);
+        final int wSize = MeasureSpec.getSize(widthMeasureSpec);
+        final int hSize = MeasureSpec.getSize(heightMeasureSpec);
+        final int padH = getPaddingLeft() + getPaddingRight();
+        final int padV = getPaddingTop() + getPaddingBottom();
+
+        int width;
+        int height;
+        if (wMode == MeasureSpec.EXACTLY && hMode == MeasureSpec.EXACTLY) {
+            width = wSize;
+            height = hSize;
+        } else if (wMode == MeasureSpec.EXACTLY) {
+            width = wSize;
+            height = Math.round((width - padH) / ASPECT) + padV;
+            if (hMode == MeasureSpec.AT_MOST) {
+                height = Math.min(height, hSize);
+            }
+        } else if (hMode == MeasureSpec.EXACTLY) {
+            height = hSize;
+            width = Math.round((height - padV) * ASPECT) + padH;
+            if (wMode == MeasureSpec.AT_MOST) {
+                width = Math.min(width, wSize);
+            }
+        } else {
+            // Neither is exact: use the available width (or a default) and derive the height.
+            width = wMode == MeasureSpec.AT_MOST ? wSize : Math.round(360 * mDensity) + padH;
+            height = Math.round((width - padH) / ASPECT) + padV;
+            if (hMode == MeasureSpec.AT_MOST && height > hSize) {
+                height = hSize;
+                width = Math.min(width, Math.round((height - padV) * ASPECT) + padH);
+            }
+        }
+        setMeasuredDimension(Math.max(width, getSuggestedMinimumWidth()),
+                Math.max(height, getSuggestedMinimumHeight()));
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        float availW = w - getPaddingLeft() - getPaddingRight();
+        float availH = h - getPaddingTop() - getPaddingBottom();
+        if (availW <= 0 || availH <= 0) {
+            mScale = 0f;
+            return;
+        }
+        mScale = Math.min(availW / ASSET_WIDTH, availH / ASSET_HEIGHT);
+        float dx = getPaddingLeft() + (availW - ASSET_WIDTH * mScale) / 2f;
+        float dy = getPaddingTop() + (availH - ASSET_HEIGHT * mScale) / 2f;
+        mMatrix.setScale(mScale, mScale);
+        mMatrix.postTranslate(dx, dy);
+        mMatrix.invert(mInverse);
+        // Outline width is given in screen pixels; the canvas is scaled by mScale.
+        mStrokePaint.setStrokeWidth(OUTLINE_DP * mDensity / mScale);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Drawing
+    // ---------------------------------------------------------------------------------------
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        final WorldData data = mData;
+        if (data == null || mScale <= 0f) {
+            return;
+        }
+        final float p = mProgress;
+
+        canvas.save();
+        canvas.concat(mMatrix);
+
+        fill(canvas, data.land, mLandColor, 1f);
+
+        // Region crossfade.
+        final boolean sameRegion = equals(mPrevRegion, mRegion);
+        if (!sameRegion && mPrevRegion != null && p < 1f) {
+            Path prev = data.regionPaths.get(mPrevRegion);
+            if (prev != null) {
+                fill(canvas, prev, mRegionColor, 1f - p);
+            }
+        }
+        if (mRegion != null) {
+            Path cur = data.regionPaths.get(mRegion);
+            if (cur != null) {
+                fill(canvas, cur, mRegionColor, sameRegion ? 1f : p);
+            }
+        }
+
+        // Selected country crossfade.
+        final boolean sameCountry = mPrevSelected == mSelected;
+        if (!sameCountry && mPrevSelected != null && p < 1f) {
+            fill(canvas, mPrevSelected.path, mSelectedColor, 1f - p);
+        }
+        if (mSelected != null) {
+            fill(canvas, mSelected.path, mSelectedColor, sameCountry ? 1f : p);
+        }
+
+        // Pressed feedback: subtle brighten.
+        if (mPressed != null) {
+            mFillPaint.setColor(Color.WHITE);
+            mFillPaint.setAlpha(PRESS_OVERLAY_ALPHA);
+            canvas.drawPath(mPressed.path, mFillPaint);
+        }
+
+        mStrokePaint.setColor(mOutlineColor);
+        canvas.drawPath(data.land, mStrokePaint);
+
+        canvas.restore();
+
+        drawMarker(canvas);
+    }
+
+    private void fill(Canvas canvas, Path path, int color, float alpha) {
+        if (alpha <= 0f) {
+            return;
+        }
+        mFillPaint.setColor(color);
+        if (alpha < 1f) {
+            mFillPaint.setAlpha(Math.round(Color.alpha(color) * alpha));
+        }
+        canvas.drawPath(path, mFillPaint);
+    }
+
+    private void drawMarker(Canvas canvas) {
+        if (Float.isNaN(mMarkerLon) || Float.isNaN(mMarkerLat)) {
+            return;
+        }
+        project(mMarkerLon, mMarkerLat, mTmp);
+        mMatrix.mapPoints(mTmp);
+        final float x = mTmp[0];
+        final float y = mTmp[1];
+        final float a = mMarkerAnimates ? mProgress : 1f;
+        if (a <= 0f) {
+            return;
+        }
+        final int base = Color.alpha(mSelectedColor);
+
+        mMarkerPaint.setColor(mSelectedColor);
+        mMarkerPaint.setAlpha(Math.round(base * 0.22f * a));
+        canvas.drawCircle(x, y, MARKER_HALO_DP * mDensity, mMarkerPaint);
+
+        mMarkerPaint.setColor(Color.WHITE);
+        mMarkerPaint.setAlpha(Math.round(255 * a));
+        canvas.drawCircle(x, y, MARKER_RING_DP * mDensity, mMarkerPaint);
+
+        mMarkerPaint.setColor(mSelectedColor);
+        mMarkerPaint.setAlpha(Math.round(base * a));
+        canvas.drawCircle(x, y, MARKER_DOT_DP * mDensity, mMarkerPaint);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Touch
+    // ---------------------------------------------------------------------------------------
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        if (!isEnabled() || mData == null || mScale <= 0f) {
+            return super.onTouchEvent(event);
+        }
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                removeCallbacks(mClearPressed);
+                mDownX = event.getX();
+                mDownY = event.getY();
+                mTracking = true;
+                mPressed = hitTest(mDownX, mDownY);
+                invalidate();
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (mTracking && (Math.abs(event.getX() - mDownX) > mTouchSlop
+                        || Math.abs(event.getY() - mDownY) > mTouchSlop)) {
+                    mTracking = false;
+                    mPressed = null;
+                    invalidate();
+                }
+                return true;
+            case MotionEvent.ACTION_UP:
+                if (mTracking) {
+                    mTracking = false;
+                    Country c = mPressed;
+                    if (c != null) {
+                        performClick();
+                        if (mListener != null) {
+                            mListener.onCountryTapped(c.iso, c.region);
+                        }
+                        postDelayed(mClearPressed, PRESS_HOLD_MS);
+                    }
+                }
+                return true;
+            case MotionEvent.ACTION_CANCEL:
+                mTracking = false;
+                if (mPressed != null) {
+                    mPressed = null;
+                    invalidate();
+                }
+                return true;
+            default:
+                return true;
+        }
+    }
+
+    /** Returns the country under the given view coordinate, or the nearest one within 24 dp. */
+    private Country hitTest(float viewX, float viewY) {
+        final WorldData data = mData;
+        if (data == null) {
+            return null;
+        }
+        mTmp[0] = viewX;
+        mTmp[1] = viewY;
+        mInverse.mapPoints(mTmp);
+        final float ax = mTmp[0];
+        final float ay = mTmp[1];
+        final int ix = Math.round(ax);
+        final int iy = Math.round(ay);
+
+        // Topmost first: small island dots are drawn last.
+        final Country[] cs = data.countries;
+        for (int i = cs.length - 1; i >= 0; i--) {
+            Country c = cs[i];
+            if (c.bounds.contains(ax, ay) && c.hitRegion().contains(ix, iy)) {
+                return c;
+            }
+        }
+
+        final float maxDist = NEAREST_DP * mDensity / mScale;
+        Country best = null;
+        float bestDist = maxDist;
+        for (Country c : cs) {
+            RectF b = c.bounds;
+            if (ax < b.left - bestDist || ax > b.right + bestDist
+                    || ay < b.top - bestDist || ay > b.bottom + bestDist) {
+                continue;
+            }
+            float d = distanceToOutline(c, ax, ay);
+            if (d < bestDist) {
+                bestDist = d;
+                best = c;
+            }
+        }
+        return best;
+    }
+
+    private static float distanceToOutline(Country c, float px, float py) {
+        float best = Float.MAX_VALUE;
+        for (int[] r : c.rings) {
+            final int n = r.length;
+            for (int i = 0; i < n; i += 2) {
+                float x1 = r[i];
+                float y1 = r[i + 1];
+                int j = (i + 2) % n;
+                float x2 = r[j];
+                float y2 = r[j + 1];
+                float dx = x2 - x1;
+                float dy = y2 - y1;
+                float len2 = dx * dx + dy * dy;
+                float t = len2 == 0f ? 0f : ((px - x1) * dx + (py - y1) * dy) / len2;
+                if (t < 0f) {
+                    t = 0f;
+                } else if (t > 1f) {
+                    t = 1f;
+                }
+                float ex = x1 + t * dx - px;
+                float ey = y1 + t * dy - py;
+                float d2 = ex * ex + ey * ey;
+                if (d2 < best) {
+                    best = d2;
+                }
+            }
+        }
+        return (float) Math.sqrt(best);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Lifecycle
+    // ---------------------------------------------------------------------------------------
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        if (mData == null) {
+            if (sData != null) {
+                onDataReady(sData);
+            } else if (!isInEditMode()) {
+                if (!sWaiting.contains(this)) {
+                    sWaiting.add(this);
+                }
+                preload(getContext());
+            }
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        sWaiting.remove(this);
+        mAnimator.cancel();
+        mProgress = 1f;
+        removeCallbacks(mClearPressed);
+        mPressed = null;
+        mTracking = false;
+        super.onDetachedFromWindow();
+    }
+}
