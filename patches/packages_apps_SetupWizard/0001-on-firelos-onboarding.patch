+     * WEP: 5, 13 or 16 characters, or the key as 10, 26 or 32 hex digits - the lengths
+     * wpa_supplicant takes (config.c, "Invalid WEP key length"); Settings would let any
+     * through and the connection would just fail.
+     */
+    private static boolean isValidWep(String password) {
+        if (isHexWepKey(password)) {
+            return true;
+        }
+        final int bytes = password.getBytes(StandardCharsets.UTF_8).length;
+        return bytes == 5 || bytes == 13 || bytes == 16;
+    }
+
+    private static boolean isHexWepKey(String password) {
+        final int length = password.length();
+        return (length == 10 || length == 26 || length == 32)
+                && password.matches("[0-9A-Fa-f]*");
+    }
+
+    /**
+     * The password dialog, also for "add network" (name, with or without a WPA/WPA2
+     * password). A DialogFragment, so it outlives a rotation with what was typed and is
+     * never left behind by a finished page.
+     */
+    public static class PasswordDialog extends DialogFragment {
+
+        static final String TAG = "onfirelos_wifi_password";
+
+        private static final String ARG_SSID = "ssid";
+        private static final String ARG_SECURITY = "security";
+        private static final String ARG_NETWORK_ID = "network_id";
+        private static final String ARG_HIDDEN = "hidden";
+
+        /** A network name is at most 32 bytes. */
+        private static final int SSID_MAX_BYTES = 32;
+
+        private EditText mSsidView;
+        private RadioGroup mSecurityView;
+        private View mPasswordGroup;
+        private EditText mPasswordView;
+
+        /** {@code ssid} null: "add network". */
+        static PasswordDialog newInstance(String ssid, int security, int networkId,
+                boolean hidden) {
+            final Bundle args = new Bundle();
+            args.putString(ARG_SSID, ssid);
+            args.putInt(ARG_SECURITY, security);
+            args.putInt(ARG_NETWORK_ID, networkId);
+            args.putBoolean(ARG_HIDDEN, hidden);
+            final PasswordDialog dialog = new PasswordDialog();
+            dialog.setArguments(args);
+            return dialog;
+        }
+
+        private boolean isAddNetwork() {
+            return getArguments().getString(ARG_SSID) == null;
+        }
+
+        @Override
+        public Dialog onCreateDialog(Bundle savedInstanceState) {
+            final boolean add = isAddNetwork();
+            final AlertDialog.Builder builder =
+                    new AlertDialog.Builder(getActivity(), R.style.OnFireLOS_WifiDialog);
+            final View view = LayoutInflater.from(builder.getContext()).inflate(
+                    R.layout.onfirelos_wifi_password, null);
+            mSsidView = (EditText) view.findViewById(R.id.wifi_ssid);
+            mSecurityView = (RadioGroup) view.findViewById(R.id.wifi_security);
+            mPasswordGroup = view.findViewById(R.id.wifi_password_group);
+            mPasswordView = (EditText) view.findViewById(R.id.wifi_password);
+            final CheckBox showPassword = (CheckBox) view.findViewById(R.id.wifi_show_password);
+
+            mSsidView.setVisibility(add ? View.VISIBLE : View.GONE);
+            mSecurityView.setVisibility(add ? View.VISIBLE : View.GONE);
+
+            final TextWatcher watcher = new TextWatcher() {
+                @Override
+                public void beforeTextChanged(CharSequence s, int start, int count, int after) {
+                }
+
+                @Override
+                public void onTextChanged(CharSequence s, int start, int before, int count) {
+                }
+
+                @Override
+                public void afterTextChanged(Editable s) {
+                    updateConnectButton();
+                }
+            };
+            mSsidView.addTextChangedListener(watcher);
+            mPasswordView.addTextChangedListener(watcher);
+            mSecurityView.setOnCheckedChangeListener((group, checkedId) -> {
+                updatePasswordGroup();
+                updateConnectButton();
+            });
+            // Also called when a rotation restores the box ticked.
+            showPassword.setOnCheckedChangeListener((button, checked) -> {
+                final int selection = mPasswordView.getSelectionEnd();
+                mPasswordView.setInputType(InputType.TYPE_CLASS_TEXT | (checked
+                        ? InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD
+                        : InputType.TYPE_TEXT_VARIATION_PASSWORD));
+                // A password field turns monospace by itself: the system font, as elsewhere.
+                mPasswordView.setTypeface(android.graphics.Typeface.DEFAULT);
+                if (selection >= 0) {
+                    mPasswordView.setSelection(Math.min(selection, mPasswordView.length()));
+                }
+            });
+            mPasswordView.setOnEditorActionListener((textView, actionId, event) -> {
+                final boolean done = actionId == EditorInfo.IME_ACTION_DONE
+                        || (event != null && event.getKeyCode() == KeyEvent.KEYCODE_ENTER
+                                && event.getAction() == KeyEvent.ACTION_DOWN);
+                if (!done) {
+                    return false;
+                }
+                if (isValid()) {
+                    submit();
+                    dismiss();
+                }
+                return true;
+            });
+            updatePasswordGroup();
+            mPasswordView.setTypeface(android.graphics.Typeface.DEFAULT);
+            (add ? mSsidView : mPasswordView).requestFocus();
+
+            final AlertDialog dialog = builder
+                    .setTitle(add ? getString(R.string.onfirelos_wifi_add)
+                            : getArguments().getString(ARG_SSID))
+                    .setView(view)
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .setPositiveButton(R.string.onfirelos_wifi_connect,
+                            (dialogInterface, which) -> submit())
+                    .create();
+            // The wizard hides the system navigation bar; so does its dialog. The keyboard
+            // comes up with the dialog, for the field that has the focus.
+            SystemBarHelper.hideSystemBars(dialog);
+            dialog.getWindow().setSoftInputMode(
+                    WindowManager.LayoutParams.SOFT_INPUT_STATE_VISIBLE
+                    | WindowManager.LayoutParams.SOFT_INPUT_IS_FORWARD_NAVIGATION);
+            return dialog;
+        }
+
+        @Override
+        public void onStart() {
+            super.onStart();
+            // The buttons exist once the dialog is shown.
+            updateConnectButton();
+        }
+
+        private int security() {
+            if (!isAddNetwork()) {
+                return getArguments().getInt(ARG_SECURITY);
+            }
+            return mSecurityView.getCheckedRadioButtonId() == R.id.wifi_security_none
+                    ? SECURITY_NONE : SECURITY_PSK;
+        }
+
+        private String ssid() {
+            return isAddNetwork() ? mSsidView.getText().toString()
+                    : getArguments().getString(ARG_SSID);
+        }
+
+        private boolean isValid() {
+            if (isAddNetwork()) {
+                final int bytes = ssid().getBytes(StandardCharsets.UTF_8).length;
+                if (bytes == 0 || bytes > SSID_MAX_BYTES) {
+                    return false;
+                }
+            }
+            final String password = mPasswordView.getText().toString();
+            switch (security()) {
+                case SECURITY_PSK:
+                    return isValidPsk(password);
+                case SECURITY_WEP:
+                    return isValidWep(password);
+                default:
+                    return true;
+            }
+        }
+
+        private void updatePasswordGroup() {
+            mPasswordGroup.setVisibility(security() == SECURITY_NONE ? View.GONE : View.VISIBLE);
+        }
+
+        private void updateConnectButton() {
+            final AlertDialog dialog = (AlertDialog) getDialog();
+            if (dialog == null) {
+                return;
+            }
+            final Button button = dialog.getButton(DialogInterface.BUTTON_POSITIVE);
+            if (button != null) {
+                button.setEnabled(isValid());
+            }
+        }
+
+        private void submit() {
+            final WifiSetupActivity activity = (WifiSetupActivity) getActivity();
+            if (activity == null || activity.isDestroyed() || !isValid()) {
+                return;
+            }
+            final boolean add = isAddNetwork();
+            final String ssid = ssid();
+            final int security = security();
+            final String password = security == SECURITY_NONE ? null
+                    : mPasswordView.getText().toString();
+            // A name typed in is a hidden network: Wi-Fi then asks for it by name.
+            final WifiConfiguration config = newConfig(ssid, security, password,
+                    getArguments().getInt(ARG_NETWORK_ID, WifiConfiguration.INVALID_NETWORK_ID),
+                    add || getArguments().getBoolean(ARG_HIDDEN));
+            activity.connect(config, key(ssid, security));
+        }
+    }
 }
