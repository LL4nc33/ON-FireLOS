+package org.lineageos.setupwizard.util;
+
+import android.content.Context;
+import android.icu.text.TimeZoneNames;
+import android.util.Log;
+
+import libcore.util.CountryTimeZones;
+import libcore.util.CountryTimeZones.TimeZoneMapping;
+import libcore.util.CountryZonesFinder;
+import libcore.util.TimeZoneFinder;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/**
+ * Countries and time zones grouped by continent, for the time-zone page.
+ *
+ * <p>Obtain with {@link #getInstance(Context)}; the first call reads tzlookup.xml and the map
+ * asset and must not run on the main thread. The instance is immutable afterwards, so all
+ * methods are safe to call from any thread.
+ *
+ * <p>Country codes are upper-case ISO 3166 alpha-2 everywhere in this API.
+ */
+public final class TimeZoneRegions {
+
+    private static final String TAG = "TimeZoneRegions";
+    private static final String ASSET = "world.txt";
+
+    /** Region codes in display order. */
+    public static final String[] REGIONS = {"EU", "AF", "AS", "NA", "SA", "OC"};
+    // UN M.49 area codes: Europe, Africa, Asia, North America (incl. Central America and
+    // the Caribbean, matching Natural Earth), South America, Oceania.
+    private static final String[] M49 = {"150", "002", "142", "003", "005", "009"};
+    private static final String[] ENGLISH = {
+            "Europe", "Africa", "Asia", "North America", "South America", "Oceania"};
+
+    /** Same cut-off as Settings' FilteredCountryTimeZones (1 Jan 2019 UTC). */
+    private static final long MIN_USE_DATE_OF_TIMEZONE = 1546300800000L;
+
+    // Region rules for countries that are not drawn on the map. Must agree with
+    // tools/make_world_asset.py.
+    private static final HashSet<String> SOUTH_AMERICA = new HashSet<>();
+    private static final HashMap<String, String> ISO_REGION_OVERRIDES = new HashMap<>();
+    private static final HashMap<String, String> PREFIX_REGION = new HashMap<>();
+    /** Countries on the map that tzlookup.xml does not list, with the zone tzdata uses. */
+    private static final HashMap<String, String> EXTRA_ZONES = new HashMap<>();
+    private static final HashMap<String, String> LANGUAGE_COUNTRY = new HashMap<>();
+
+    static {
+        for (String s : "AR BO BR CL CO EC FK GF GY PE PY SR UY VE GS".split(" ")) {
+            SOUTH_AMERICA.add(s);
+        }
+        String[] overrides = {
+                "BM", "NA", "CV", "AF", "SH", "AF", "FO", "EU", "IS", "EU", "IO", "AS",
+                "MV", "AS", "TF", "AF", "CX", "OC", "CC", "OC", "KM", "AF", "MG", "AF",
+                "MU", "AF", "RE", "AF", "SC", "AF", "YT", "AF", "SJ", "EU", "CY", "AS"};
+        for (int i = 0; i < overrides.length; i += 2) {
+            ISO_REGION_OVERRIDES.put(overrides[i], overrides[i + 1]);
+        }
+        String[] prefixes = {
+                "Europe", "EU", "Africa", "AF", "Asia", "AS", "America", "NA",
+                "Australia", "OC", "Pacific", "OC", "Arctic", "EU", "Atlantic", "EU",
+                "Indian", "AF"};
+        for (int i = 0; i < prefixes.length; i += 2) {
+            PREFIX_REGION.put(prefixes[i], prefixes[i + 1]);
+        }
+        // Kosovo is drawn by Natural Earth but has no entry in tzlookup.xml / zone.tab;
+        // tzdata documents Europe/Belgrade as its time zone.
+        EXTRA_ZONES.put("XK", "Europe/Belgrade");
+
+        String[] lang = {
+                "de", "DE", "en", "US", "fr", "FR", "es", "ES", "it", "IT", "pt", "PT",
+                "nl", "NL", "pl", "PL", "ru", "RU", "tr", "TR", "ja", "JP", "zh", "CN",
+                "ko", "KR", "sv", "SE", "da", "DK", "nb", "NO", "nn", "NO", "no", "NO",
+                "fi", "FI", "cs", "CZ", "sk", "SK", "sl", "SI", "hr", "HR", "sr", "RS",
+                "bs", "BA", "mk", "MK", "sq", "AL", "bg", "BG", "el", "GR", "hu", "HU",
+                "ro", "RO", "uk", "UA", "be", "BY", "lt", "LT", "lv", "LV", "et", "EE",
+                "is", "IS", "ga", "IE", "cy", "GB", "mt", "MT", "lb", "LU", "ca", "ES",
+                "eu", "ES", "gl", "ES", "ar", "EG", "he", "IL", "iw", "IL", "fa", "IR",
+                "ur", "PK", "hi", "IN", "bn", "BD", "ta", "IN", "te", "IN", "mr", "IN",
+                "gu", "IN", "kn", "IN", "ml", "IN", "pa", "IN", "ne", "NP", "si", "LK",
+                "id", "ID", "in", "ID", "ms", "MY", "th", "TH", "vi", "VN", "fil", "PH",
+                "tl", "PH", "km", "KH", "lo", "LA", "my", "MM", "mn", "MN", "ka", "GE",
+                "hy", "AM", "az", "AZ", "kk", "KZ", "uz", "UZ", "ky", "KG", "sw", "KE",
+                "am", "ET", "af", "ZA", "zu", "ZA", "xh", "ZA"};
+        for (int i = 0; i < lang.length; i += 2) {
+            LANGUAGE_COUNTRY.put(lang[i], lang[i + 1]);
+        }
+    }
+
+    /** One selectable time zone of a country. */
+    public static final class Zone {
+        /** Olson ID, e.g. "Europe/Vienna". */
+        public final String id;
+        /** Localized exemplar city, e.g. "Wien". */
+        public final String city;
+        /** Current offset including DST, "GMT+1:00" style (ASCII digits). */
+        public final String offset;
+        /** Current offset including DST in milliseconds. */
+        public final int offsetMillis;
+        /** Localized long name of the current period, e.g. "Mitteleuropäische Normalzeit". */
+        public final String longName;
+        /** Location from tzdata zone.tab, or NaN if unknown. */
+        public final float lat;
+        public final float lon;
+
+        Zone(String id, String city, String offset, int offsetMillis, String longName,
+                float lat, float lon) {
+            this.id = id;
+            this.city = city;
+            this.offset = offset;
+            this.offsetMillis = offsetMillis;
+            this.longName = longName;
+            this.lat = lat;
+            this.lon = lon;
+        }
+
+        @Override
+        public String toString() {
+            return id + " (" + city + ", " + offset + ")";
+        }
+    }
+
+    private static TimeZoneRegions sInstance;
+
+    /**
+     * Returns the shared instance, building it on first use. Blocking (tens of milliseconds on
+     * first call): do not call from the main thread.
+     */
+    public static synchronized TimeZoneRegions getInstance(Context context) {
+        if (sInstance == null) {
+            sInstance = new TimeZoneRegions(context.getApplicationContext());
+        }
+        return sInstance;
+    }
+
+    /** Returns the instance if it has already been built, else null. Never blocks long. */
+    public static synchronized TimeZoneRegions peekInstance() {
+        return sInstance;
+    }
+
+    private final CountryZonesFinder mFinder;                       // null if tz data broken
+    private final HashMap<String, String> mMapRegion = new HashMap<>(); // drawn on the map
+    private final HashMap<String, float[]> mZoneCoords = new HashMap<>(); // id -> {lon, lat}
+    private final HashMap<String, String> mRegionOf = new HashMap<>();   // every listed country
+    private final HashMap<String, List<String>> mCountries = new HashMap<>();
+
+    private TimeZoneRegions(Context context) {
+        readAsset(context);
+
+        CountryZonesFinder finder = null;
+        try {
+            finder = TimeZoneFinder.getInstance().getCountryZonesFinder();
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Cannot read tzlookup", e);
+        }
+        mFinder = finder;
+
+        for (String r : REGIONS) {
+            mCountries.put(r, new ArrayList<>());
+        }
+        HashSet<String> all = new HashSet<>();
+        if (mFinder != null) {
+            for (String lower : mFinder.lookupAllCountryIsoCodes()) {
+                all.add(lower.toUpperCase(Locale.US));
+            }
+        }
+        for (String iso : EXTRA_ZONES.keySet()) {
+            if (mMapRegion.containsKey(iso)) {
+                all.add(iso);
+            }
+        }
+        ArrayList<String> sorted = new ArrayList<>(all);
+        Collections.sort(sorted);   // deterministic order before the locale sort
+        for (String iso : sorted) {
+            String region = computeRegion(iso);
+            if (region == null) {
+                continue;   // e.g. AQ (Antarctica): not offered in any region
+            }
+            List<String> list = mCountries.get(region);
+            if (list != null) {
+                mRegionOf.put(iso, region);
+                list.add(iso);
+            }
+        }
+    }
+
+    private void readAsset(Context context) {
+        try (BufferedReader r = new BufferedReader(new InputStreamReader(
+                context.getAssets().open(ASSET), StandardCharsets.UTF_8), 16384)) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                if (line.isEmpty() || line.charAt(0) == '#') {
+                    continue;
+                }
+                if (line.charAt(0) == '@') {
+                    // "@Europe/Vienna 16.33 48.22"  (lon lat)
+                    int s1 = line.indexOf(' ');
+                    int s2 = line.indexOf(' ', s1 + 1);
+                    if (s1 > 1 && s2 > s1) {
+                        try {
+                            float lon = Float.parseFloat(line.substring(s1 + 1, s2));
+                            float lat = Float.parseFloat(line.substring(s2 + 1).trim());
+                            mZoneCoords.put(line.substring(1, s1), new float[] {lon, lat});
+                        } catch (NumberFormatException e) {
+                            Log.w(TAG, "Bad zone line: " + line);
+                        }
+                    }
+                    continue;
+                }
+                // "AT EU x,y ..."
+                int s1 = line.indexOf(' ');
+                int s2 = s1 < 0 ? -1 : line.indexOf(' ', s1 + 1);
+                if (s1 > 0 && s2 > s1) {
+                    mMapRegion.put(line.substring(0, s1), line.substring(s1 + 1, s2));
+                }
+            }
+        } catch (IOException e) {
+            Log.e(TAG, "Cannot read " + ASSET, e);
+        }
+    }
+
+    private String computeRegion(String iso) {
+        String region = mMapRegion.get(iso);
+        if (region != null) {
+            return region;
+        }
+        if (SOUTH_AMERICA.contains(iso)) {
+            return "SA";
+        }
+        region = ISO_REGION_OVERRIDES.get(iso);
+        if (region != null) {
+            return region;
+        }
+        String zone = defaultZone(iso);
+        if (zone == null) {
+            return null;
+        }
+        int slash = zone.indexOf('/');
+        return slash > 0 ? PREFIX_REGION.get(zone.substring(0, slash)) : null;
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Regions
+    // ---------------------------------------------------------------------------------------
+
+    /** Localized continent name (ICU / CLDR via UN M.49 codes), English if unavailable. */
+    public static String regionName(String region, Locale locale) {
+        for (int i = 0; i < REGIONS.length; i++) {
+            if (REGIONS[i].equals(region)) {
+                String name = new Locale("", M49[i]).getDisplayCountry(locale);
+                if (name == null || name.isEmpty() || name.equals(M49[i])) {
+                    name = ENGLISH[i];
+                }
+                return name;
+            }
+        }
+        return region;
+    }
+
+    /** Region code (EU, AF, ...) of a country, or null if it is not offered. */
+    public String regionOf(String iso) {
+        return iso == null ? null : mRegionOf.get(iso.toUpperCase(Locale.US));
+    }
+
+    /**
+     * All countries with time zones in the given region, sorted by their display name in
+     * {@code locale}.
+     */
+    public List<String> countriesIn(String region, Locale locale) {
+        List<String> src = mCountries.get(region);
+        if (src == null) {
+            return Collections.emptyList();
+        }
+        final HashMap<String, String> names = new HashMap<>(src.size() * 2);
+        for (String iso : src) {
+            names.put(iso, countryName(iso, locale));
+        }
+        final Collator collator = Collator.getInstance(locale);
+        collator.setStrength(Collator.PRIMARY);
+        ArrayList<String> result = new ArrayList<>(src);
+        Collections.sort(result, (a, b) -> {
+            int c = collator.compare(names.get(a), names.get(b));
+            return c != 0 ? c : a.compareTo(b);
+        });
+        return Collections.unmodifiableList(result);
+    }
+
+    public List<String> countriesIn(String region) {
+        return countriesIn(region, Locale.getDefault());
+    }
+
+    /** Localized country name, e.g. "Österreich". */
+    public static String countryName(String iso, Locale locale) {
+        return new Locale("", iso).getDisplayCountry(locale);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Zones
+    // ---------------------------------------------------------------------------------------
+
+    private CountryTimeZones lookup(String iso) {
+        return mFinder == null || iso == null ? null : mFinder.lookupCountryTimeZones(iso);
+    }
+
+    /** Default zone of a country (the best guess if only the country is known), or null. */
+    public String defaultZone(String iso) {
+        CountryTimeZones ctz = lookup(iso);
+        String id = ctz == null ? null : ctz.getDefaultTimeZoneId();
+        if (id == null && iso != null) {
+            id = EXTRA_ZONES.get(iso.toUpperCase(Locale.US));
+        }
+        return id;
+    }
+
+    /** Zone IDs offered for a country, in tzlookup priority order. */
+    private List<String> zoneIds(String iso) {
+        ArrayList<String> ids = new ArrayList<>();
+        CountryTimeZones ctz = lookup(iso);
+        if (ctz != null) {
+            for (TimeZoneMapping m : ctz.getTimeZoneMappings()) {
+                if (m.showInPicker && (m.notUsedAfter == null
+                        || m.notUsedAfter >= MIN_USE_DATE_OF_TIMEZONE)) {
+                    ids.add(m.timeZoneId);
+                }
+            }
+        }
+        if (ids.isEmpty()) {
+            String def = defaultZone(iso);
+            if (def != null) {
+                ids.add(def);
+            }
+        }
+        return ids;
+    }
+
+    /**
+     * The zones to offer for a country, sorted by current UTC offset, then city. Empty if the
+     * country has no time zone data.
+     */
+    public List<Zone> zonesFor(String iso, Locale locale) {
+        List<String> ids = zoneIds(iso);
+        if (ids.isEmpty()) {
+            return Collections.emptyList();
+        }
+        final long now = System.currentTimeMillis();
+        final Date nowDate = new Date(now);
+        final TimeZoneNames tzNames = TimeZoneNames.getInstance(locale);
+        ArrayList<Zone> zones = new ArrayList<>(ids.size());
+        for (String id : ids) {
+            TimeZone tz = TimeZone.getTimeZone(id);
+            int offset = tz.getOffset(now);
+            String longName = tz.getDisplayName(tz.inDaylightTime(nowDate), TimeZone.LONG, locale);
+            float[] ll = mZoneCoords.get(id);
+            zones.add(new Zone(id, exemplarCity(tzNames, id), formatOffset(offset), offset,
+                    longName, ll == null ? Float.NaN : ll[1], ll == null ? Float.NaN : ll[0]));
+        }
+        final Collator collator = Collator.getInstance(locale);
+        Collections.sort(zones, (a, b) -> {
+            if (a.offsetMillis != b.offsetMillis) {
+                return a.offsetMillis < b.offsetMillis ? -1 : 1;
+            }
+            return collator.compare(a.city, b.city);
+        });
+        return Collections.unmodifiableList(zones);
+    }
+
+    public List<Zone> zonesFor(String iso) {
+        return zonesFor(iso, Locale.getDefault());
+    }
+
+    /** How many zones {@link #zonesFor} offers for a country, without naming them. */
+    public int zoneCount(String iso) {
+        return zoneIds(iso).size();
+    }
+
+    /** Coordinates {lon, lat} of a zone from tzdata zone.tab, or null. */
+    public float[] zoneLocation(String tzId) {
+        float[] ll = tzId == null ? null : mZoneCoords.get(tzId);
+        return ll == null ? null : new float[] {ll[0], ll[1]};
+    }
+
+    private static String exemplarCity(TimeZoneNames names, String id) {
+        String city = null;
+        try {
+            // CLDR keys its names by the canonical ID (e.g. Asia/Calcutta for Asia/Kolkata).
+            String canonical = android.icu.util.TimeZone.getCanonicalID(id);
+            if (canonical != null) {
+                city = names.getExemplarLocationName(canonical);
+            }
+            if (city == null || city.isEmpty()) {
+                city = names.getExemplarLocationName(id);
+            }
+        } catch (RuntimeException e) {
+            city = null;
+        }
+        if (city == null || city.isEmpty()) {
+            int slash = id.lastIndexOf('/');
+            city = id.substring(slash + 1).replace('_', ' ');
+        }
+        return city;
+    }
+
+    /** "GMT+1:00", "GMT-3:30", "GMT+0:00". */
+    public static String formatOffset(int offsetMillis) {
+        char sign = offsetMillis < 0 ? '-' : '+';
+        int abs = Math.abs(offsetMillis) / 60000;
+        return String.format(Locale.US, "GMT%c%d:%02d", sign, abs / 60, abs % 60);
+    }
+
+    // ---------------------------------------------------------------------------------------
+    // Lookups
+    // ---------------------------------------------------------------------------------------
+
+    /**
+     * Country for a zone ID (reverse lookup), or null for zones such as UTC/Etc that belong to
+     * no country.
+     */
+    public String countryForZone(String tzId) {
+        if (tzId == null || tzId.isEmpty()) {
+            return null;
+        }
+        String iso = countryForZoneExact(tzId);
+        if (iso == null) {
+            try {
+                String canonical = android.icu.util.TimeZone.getCanonicalID(tzId);
+                if (canonical != null && !canonical.equals(tzId)) {
+                    iso = countryForZoneExact(canonical);
+                }
+                if (iso == null) {
+                    String region = android.icu.util.TimeZone.getRegion(tzId);
+                    if (region != null && region.length() == 2) {
+                        iso = region.toUpperCase(Locale.US);
+                    }
+                }
+            } catch (RuntimeException e) {
+                // IllegalArgumentException for IDs ICU does not know.
+                iso = null;
+            }
+        }
+        return iso;
+    }
+
+    private String countryForZoneExact(String tzId) {
+        if (mFinder == null) {
+            return null;
+        }
+        List<CountryTimeZones> list = mFinder.lookupCountryTimeZonesForZoneId(tzId);
+        if (list.isEmpty()) {
+            return null;
+        }
+        CountryTimeZones best = list.get(0);
+        for (CountryTimeZones ctz : list) {
+            if (tzId.equals(ctz.getDefaultTimeZoneId())) {
+                best = ctz;
+                break;
+            }
+        }
+        return best.getCountryIso().toUpperCase(Locale.US);
+    }
+
+    /**
+     * Best guess of the user's country: the locale's country if set, else a typical country
+     * for the language, else "US".
+     */
+    public static String guessCountry(Locale l) {
+        if (l == null) {
+            return "US";
+        }
+        String country = l.getCountry();
+        if (country != null && country.length() == 2) {
+            return country.toUpperCase(Locale.US);
+        }
+        String lang = l.getLanguage();
+        if ("zh".equals(lang)) {
+            return "Hant".equals(l.getScript()) ? "TW" : "CN";
+        }
+        String guess = LANGUAGE_COUNTRY.get(lang);
+        return guess != null ? guess : "US";
+    }
+}
