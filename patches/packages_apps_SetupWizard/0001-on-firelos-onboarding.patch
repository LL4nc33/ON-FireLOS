+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 ON-FireLOS, Apache-2.0. Date and time as two quiet pills,
+     for a tablet that has no network yet. -->
+<merge xmlns:android="http://schemas.android.com/apk/res/android">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginBottom="16dp"
+        android:orientation="horizontal">
+
+        <Button
+            android:id="@+id/date_button"
+            android:layout_width="wrap_content"
+            android:layout_height="48dp"
+            android:background="@drawable/onfirelos_tonal_button"
+            android:drawableStart="@drawable/onfirelos_ic_event"
+            android:drawablePadding="10dp"
+            android:paddingStart="18dp"
+            android:paddingEnd="22dp"
+            android:textSize="16sp"
+            android:textAllCaps="false"
+            android:textColor="@color/primary_text"
+            android:fontFamily="sans-serif-medium"
+            android:stateListAnimator="@null" />
+
+        <Button
+            android:id="@+id/time_button"
+            android:layout_width="wrap_content"
+            android:layout_height="48dp"
+            android:layout_marginStart="12dp"
+            android:background="@drawable/onfirelos_tonal_button"
+            android:drawableStart="@drawable/onfirelos_ic_schedule"
+            android:drawablePadding="10dp"
+            android:paddingStart="18dp"
+            android:paddingEnd="22dp"
+            android:textSize="16sp"
+            android:textAllCaps="false"
+            android:textColor="@color/primary_text"
+            android:fontFamily="sans-serif-medium"
+            android:stateListAnimator="@null" />
+
+    </LinearLayout>
+
+</merge>
