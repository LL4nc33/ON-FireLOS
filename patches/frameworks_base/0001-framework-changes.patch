+package com.android.systemui.qs.tiles;
+
+import android.content.Intent;
+import android.service.quicksettings.Tile;
+import android.view.WindowManager;
+
+import com.android.internal.logging.nano.MetricsProto.MetricsEvent;
+import com.android.internal.util.ScreenshotHelper;
+import com.android.systemui.R;
+import com.android.systemui.plugins.qs.QSTile.State;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+
+/** Quick settings tile: screenshot; a long press selects an area. A button, not a switch. */
+public class ScreenshotTile extends QSTileImpl<State> {
+    // Long enough for the shade to slide away; it must not be in the picture.
+    private static final long COLLAPSE_DELAY_MS = 500;
+
+    private final Icon mIcon = ResourceIcon.get(R.drawable.ic_qs_screenshot);
+    private final ScreenshotHelper mScreenshotHelper;
+
+    public ScreenshotTile(QSHost host) {
+        super(host);
+        mScreenshotHelper = new ScreenshotHelper(mContext);
+    }
+
+    @Override
+    public State newTileState() {
+        return new State();
+    }
+
+    @Override
+    public void handleSetListening(boolean listening) {
+    }
+
+    @Override
+    protected void handleClick() {
+        take(WindowManager.TAKE_SCREENSHOT_FULLSCREEN);
+    }
+
+    @Override
+    protected void handleLongClick() {
+        take(WindowManager.TAKE_SCREENSHOT_SELECTED_REGION);
+    }
+
+    private void take(int type) {
+        mHost.collapsePanels();
+        mUiHandler.postDelayed(() -> mScreenshotHelper.takeScreenshot(type, true, true,
+                mUiHandler), COLLAPSE_DELAY_MS);
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return null;
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_screenshot_label);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return MetricsEvent.QS_PANEL;
+    }
+
+    @Override
+    protected void handleUpdateState(State state, Object arg) {
+        state.icon = mIcon;
+        state.label = mContext.getString(R.string.quick_settings_screenshot_label);
+        state.contentDescription = state.label;
+        state.state = Tile.STATE_INACTIVE;
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/screenrecord/RecordingService.java b/packages/SystemUI/src/com/android/systemui/screenrecord/RecordingService.java
new file mode 100644
index 00000000..217cd52b
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/screenrecord/RecordingService.java
@@ -0,0 +1,389 @@
+/*
+ * Copyright (C) 2026 The ON-FireLOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.systemui.screenrecord;
+
+import android.app.Notification;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.graphics.Point;
+import android.hardware.display.DisplayManager;
+import android.hardware.display.VirtualDisplay;
+import android.media.MediaCodec;
+import android.media.MediaCodecInfo;
+import android.media.MediaFormat;
+import android.media.MediaMuxer;
+import android.media.MediaScannerConnection;
+import android.media.projection.IMediaProjection;
+import android.media.projection.IMediaProjectionManager;
+import android.media.projection.MediaProjection;
+import android.media.projection.MediaProjectionManager;
+import android.net.Uri;
+import android.os.Environment;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.ServiceManager;
+import android.util.Log;
+import android.view.Surface;
+import android.view.WindowManager;
+
+import com.android.systemui.R;
+import com.android.systemui.SystemUI;
+import com.android.systemui.util.NotificationChannels;
+
+import java.io.File;
+import java.nio.ByteBuffer;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.Locale;
+
+/**
+ * Screen recording, started from its quick settings tile.
+ *
+ * Android 9 has none of its own. The screen is mirrored into a virtual
+ * display whose surface feeds an H.264 encoder; the result goes to
+ * Movies/Screenrecords as MP4. MediaTek's hardware encoder cannot take its
+ * input from a surface (it lacks the native-window metadata mode Android 9
+ * relies on), so this uses Android's software encoder, at 1280x800 - the
+ * panel's 16:10, as large as that encoder allows on this CPU. No sound:
+ * Android 9 cannot capture what apps play.
+ */
+public class RecordingService extends Service {
+    private static final String TAG = "RecordingService";
+    private static final String ACTION_START = "com.android.systemui.screenrecord.START";
+    private static final String ACTION_STOP = "com.android.systemui.screenrecord.STOP";
+    private static final int NOTIFICATION_RECORDING = 4271;
+    private static final int NOTIFICATION_SAVED = 4272;
+    private static final String ENCODER = "OMX.google.h264.encoder";
+    private static final int LONG_SIDE = 1280;
+    private static final int SHORT_SIDE = 800;
+    private static final int BIT_RATE = 6_000_000;
+    private static final int FRAME_RATE = 30;
+
+    public interface Listener {
+        void onRecordingChanged(boolean recording);
+    }
+
+    // Read from the tile's background thread, changed on the main thread.
+    private static volatile boolean sRecording;
+    private static final List<Listener> sListeners = new CopyOnWriteArrayList<>();
+
+    public static boolean isRecording() {
+        return sRecording;
+    }
+
+    public static void addListener(Listener l) {
+        sListeners.add(l);
+    }
+
+    public static void removeListener(Listener l) {
+        sListeners.remove(l);
+    }
+
+    public static Intent startIntent(Context context) {
+        return new Intent(ACTION_START).setClass(context, RecordingService.class);
+    }
+
+    public static Intent stopIntent(Context context) {
+        return new Intent(ACTION_STOP).setClass(context, RecordingService.class);
+    }
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private MediaProjection mProjection;
+    private VirtualDisplay mVirtualDisplay;
+    private MediaCodec mCodec;
+    private Surface mInputSurface;
+    private MediaMuxer mMuxer;
+    private volatile boolean mStopping;
+    private File mFile;
+    private int mTrack;
+
+    // Another app starting a capture of its own takes the screen from us.
+    private final MediaProjection.Callback mProjectionStopped = new MediaProjection.Callback() {
+        @Override
+        public void onStop() {
+            stopRecording();
+        }
+    };
+
+    private final BroadcastReceiver mScreenOff = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            // Nothing to record with the screen off; keep what there is.
+            stopRecording();
+        }
+    };
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        String action = intent != null ? intent.getAction() : null;
+        if (ACTION_START.equals(action) && !sRecording) {
+            // Before anything that can fail: a service started in the
+            // foreground that never gets there takes SystemUI down with it.
+            startForeground(NOTIFICATION_RECORDING, recordingNotification());
+            if (!startRecording()) {
+                cleanUp();
+                if (mFile != null) {
+                    mFile.delete();
+                }
+                stopForeground(true);
+                stopSelf();
+            }
+        } else if (ACTION_STOP.equals(action)) {
+            if (sRecording) {
+                stopRecording();
+            } else {
+                // A late tap on the notification: nothing left to stop.
+                stopSelf();
+            }
+        }
+        return START_NOT_STICKY;
+    }
+
+    private boolean startRecording() {
+        try {
+            // SystemUI may record the screen itself, with no consent dialog:
+            // the tile is the user's request.
+            IMediaProjectionManager mpm = IMediaProjectionManager.Stub.asInterface(
+                    ServiceManager.getService(Context.MEDIA_PROJECTION_SERVICE));
+            IMediaProjection projection = mpm.createProjection(getApplicationInfo().uid,
+                    getPackageName(), MediaProjectionManager.TYPE_SCREEN_CAPTURE, false);
+            mProjection = new MediaProjection(this, projection);
+            mProjection.registerCallback(mProjectionStopped, mHandler);
+
+            Point real = new Point();
+            getSystemService(WindowManager.class).getDefaultDisplay().getRealSize(real);
+            boolean landscape = real.x >= real.y;
+            int width = landscape ? LONG_SIDE : SHORT_SIDE;
+            int height = landscape ? SHORT_SIDE : LONG_SIDE;
+
+            MediaFormat format = MediaFormat.createVideoFormat(
+                    MediaFormat.MIMETYPE_VIDEO_AVC, width, height);
+            format.setInteger(MediaFormat.KEY_COLOR_FORMAT,
+                    MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface);
+            format.setInteger(MediaFormat.KEY_BIT_RATE, BIT_RATE);
+            format.setInteger(MediaFormat.KEY_FRAME_RATE, FRAME_RATE);
+            format.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1);
+            mCodec = MediaCodec.createByCodecName(ENCODER);
+            mCodec.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE);
+            mInputSurface = mCodec.createInputSurface();
+            mCodec.start();
+
+            File dir = new File(Environment.getExternalStoragePublicDirectory(
+                    Environment.DIRECTORY_MOVIES), "Screenrecords");
+            if (!dir.isDirectory() && !dir.mkdirs()) {
+                throw new IllegalStateException("cannot create " + dir);
+            }
+            mFile = new File(dir, "Screenrecord_" + new SimpleDateFormat(
+                    "yyyyMMdd_HHmmss", Locale.ROOT).format(new Date()) + ".mp4");
+            mMuxer = new MediaMuxer(mFile.getPath(), MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4);
+
+            mVirtualDisplay = mProjection.createVirtualDisplay("ScreenRecording", width, height,
+                    getResources().getDisplayMetrics().densityDpi,
+                    DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR, mInputSurface, null, null);
+            if (mVirtualDisplay == null) {
+                throw new IllegalStateException("no virtual display");
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "Cannot start recording", e);
+            return false;
+        }
+
+        mStopping = false;
+        mTrack = -1;
+        new Thread(this::drain, "ScreenRecordEncoder").start();
+        registerReceiver(mScreenOff, new IntentFilter(Intent.ACTION_SCREEN_OFF));
+        setRecording(true);
+        return true;
+    }
+
+    /**
+     * Moves encoded frames into the file until the end of the stream. Any
+     * failure - the codec service can die under it - ends the recording and
+     * keeps what was written; this thread runs in SystemUI, and an uncaught
+     * exception here would take the status bar down with it.
+     */
+    private void drain() {
+        boolean wrote;
+        try {
+            drainLoop();
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Recording ended by an encoder error", e);
+        }
+        try {
+            wrote = mTrack >= 0;
+            if (wrote) {
+                mMuxer.stop();
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot finish the file", e);
+            wrote = false;
+        }
+        final boolean result = wrote;
+        mHandler.post(() -> onFinished(result));
+    }
+
+    private void drainLoop() {
+        MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+        boolean endSignalled = false;
+        while (true) {
+            if (mStopping && !endSignalled) {
+                mCodec.signalEndOfInputStream();
+                endSignalled = true;
+            }
+            int index = mCodec.dequeueOutputBuffer(info, 10_000);
+            if (index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                mTrack = mMuxer.addTrack(mCodec.getOutputFormat());
+                mMuxer.start();
+            } else if (index >= 0) {
+                ByteBuffer data = mCodec.getOutputBuffer(index);
+                boolean config = (info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0;
+                if (data != null && info.size > 0 && !config && mTrack >= 0) {
+                    data.position(info.offset);
+                    data.limit(info.offset + info.size);
+                    mMuxer.writeSampleData(mTrack, data, info);
+                }
+                mCodec.releaseOutputBuffer(index, false);
+                if ((info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) {
+                    break;
+                }
+            }
+        }
+    }
+
+    private void stopRecording() {
+        if (!sRecording || mStopping) {
+            return;
+        }
+        mStopping = true;
+        // The rest happens once the encoder has handed out its last frame.
+    }
+
+    private void onFinished(boolean wrote) {
+        cleanUp();
+        stopForeground(true);
+        if (wrote) {
+            // The service stops right away; the scan outlives it.
+            MediaScannerConnection.scanFile(getApplicationContext(),
+                    new String[] { mFile.getPath() },
+                    new String[] { "video/mp4" }, (path, uri) -> mHandler.post(() ->
+                            showSaved(uri)));
+        } else if (mFile != null) {
+            mFile.delete();
+        }
+        stopSelf();
+    }
+
+    private void cleanUp() {
+        if (sRecording) {
+            unregisterReceiver(mScreenOff);
+        }
+        if (mVirtualDisplay != null) {
+            mVirtualDisplay.release();
+            mVirtualDisplay = null;
+        }
+        if (mCodec != null) {
+            try {
+                mCodec.stop();
+            } catch (IllegalStateException ignored) {
+            }
+            mCodec.release();
+            mCodec = null;
+        }
+        if (mInputSurface != null) {
+            mInputSurface.release();
+            mInputSurface = null;
+        }
+        if (mMuxer != null) {
+            try {
+                mMuxer.release();
+            } catch (IllegalStateException ignored) {
+            }
+            mMuxer = null;
+        }
+        if (mProjection != null) {
+            mProjection.unregisterCallback(mProjectionStopped);
+            mProjection.stop();
+            mProjection = null;
+        }
+        setRecording(false);
+    }
+
+    private static void setRecording(boolean recording) {
+        if (sRecording == recording) {
+            return;
+        }
+        sRecording = recording;
+        for (Listener l : sListeners) {
+            l.onRecordingChanged(recording);
+        }
+    }
+
+    private Notification recordingNotification() {
+        PendingIntent stop = PendingIntent.getService(this, 0, stopIntent(this),
+                PendingIntent.FLAG_UPDATE_CURRENT);
+        Notification.Builder b = new Notification.Builder(this, NotificationChannels.GENERAL)
+                .setSmallIcon(R.drawable.ic_qs_screenrecord)
+                .setContentTitle(getString(R.string.screenrecord_recording))
+                .setContentText(getString(R.string.screenrecord_tap_to_stop))
+                .setContentIntent(stop)
+                .setOngoing(true)
+                .setShowWhen(true)
+                .setUsesChronometer(true)
+                .addAction(new Notification.Action.Builder(null,
+                        getString(R.string.screenrecord_stop), stop).build());
+        SystemUI.overrideNotificationAppName(this, b, true);
+        return b.build();
+    }
+
+    private void showSaved(Uri uri) {
+        if (uri == null) {
+            return;
+        }
+        Intent view = new Intent(Intent.ACTION_VIEW).setDataAndType(uri, "video/mp4")
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        Intent share = Intent.createChooser(new Intent(Intent.ACTION_SEND)
+                .setType("video/mp4").putExtra(Intent.EXTRA_STREAM, uri)
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION), null)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        Notification.Builder b = new Notification.Builder(this,
+                NotificationChannels.SCREENSHOTS_HEADSUP)
+                .setSmallIcon(R.drawable.ic_qs_screenrecord)
+                .setContentTitle(getString(R.string.screenrecord_saved))
+                .setContentText(getString(R.string.screenrecord_saved_text))
