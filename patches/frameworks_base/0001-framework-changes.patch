diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/NavBarAppAction.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/NavBarAppAction.java
new file mode 100644
index 00000000..cd1b3477
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/NavBarAppAction.java
@@ -0,0 +1,350 @@
+/*
+ * Copyright (C) 2026 ON-FireLOS
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.statusbar.phone;
+
+import android.app.ActivityManager;
+import android.app.ActivityManager.RecentTaskInfo;
+import android.Manifest;
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.PorterDuff;
+import android.graphics.PorterDuffXfermode;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+import android.graphics.drawable.BitmapDrawable;
+import android.graphics.drawable.Drawable;
+import android.os.UserHandle;
+
+import com.android.settingslib.development.DevelopmentSettingsEnabler;
+import com.android.systemui.R;
+import com.android.systemui.shared.system.ActivityManagerWrapper;
+import com.android.systemui.statusbar.policy.KeyButtonDrawable;
+
+/**
+ * ON-FireLOS: the free slot on the right of the navigation bar, for an action
+ * of the app in front - only where one fits:
+ * <ul>
+ * <li>the browser: how many tabs are open; tap for the tab overview, long
+ * press for a new tab;</li>
+ * <li>the browser's tab overview: close all tabs (the browser offers undo);</li>
+ * <li>the recent apps overview: clear all - the launcher's own button for it
+ * sits at the far end of the list;</li>
+ * <li>the gallery: its settings (Immich server, camera backup);</li>
+ * <li>the clock: its menu (screen saver, settings) - it has no top bar;</li>
+ * <li>Settings, once developer options are switched on: straight to them -
+ * they sit deep under System, Advanced;</li>
+ * <li>the camera: tap for the mode options (timer, grid, HDR, camera switch),
+ * long press for the mode list (photo, video, settings).</li>
+ * </ul>
+ * Everywhere else the slot stays empty, the home screen too.
+ */
+final class NavBarAppAction {
+    private static final String JELLY = "org.lineageos.jelly";
+    private static final String JELLY_MAIN = JELLY + ".MainActivity";
+    private static final String JELLY_SHOW_TABS = "org.lineageos.jelly.action.SHOW_TABS";
+    private static final String JELLY_NEW_TAB = "org.lineageos.jelly.action.NEW_TAB";
+    private static final String JELLY_TABS = JELLY + ".TabsActivity";
+    private static final String JELLY_CLOSE_ALL = "org.lineageos.jelly.action.CLOSE_ALL_TABS";
+    private static final int MAX_TABS = 64;
+
+    private static final String CAMERA = "com.android.camera2";
+    private static final String CAMERA_MAIN = "com.android.camera.CameraActivity";
+    // Started from the home screen, the camera runs under its launcher alias.
+    private static final String CAMERA_LAUNCHER = "com.android.camera.CameraLauncher";
+    private static final String CAMERA_MODE_LIST = "org.lineageos.camera.action.MODE_LIST";
+    private static final String CAMERA_MODE_OPTIONS = "org.lineageos.camera.action.MODE_OPTIONS";
+
+    private static final String GALLERY = "com.android.gallery3d";
+    private static final String GALLERY_MAIN = "com.android.gallery3d.app.GalleryActivity";
+    private static final String GALLERY_SETTINGS = "org.codeaurora.gallery.action.OPEN_SETTINGS";
+
+    private static final String CLOCK = "com.android.deskclock";
+    private static final String CLOCK_MAIN = CLOCK + ".DeskClock";
+    private static final String CLOCK_MENU = CLOCK + ".action.SHOW_MENU";
+
+    private static final String SETTINGS = "com.android.settings";
+    private static final String SETTINGS_DEVELOPMENT =
+            "org.lineageos.settings.action.OPEN_DEVELOPMENT";
+
+    // The launcher says when its overview is open with apps in it.
+    private static final String LAUNCHER = "com.android.launcher3";
+    private static final String LAUNCHER_STATE = "org.lineageos.trebuchet.action.OVERVIEW_STATE";
+    private static final String LAUNCHER_CLEAR_ALL = "org.lineageos.trebuchet.action.CLEAR_ALL";
+
+    private final Context mContext;
+    private final int mLightColor;
+    private final int mDarkColor;
+    private final int mSize;
+
+    // What the slot shows ("tabs:3", "camera"), so an unchanged icon is not
+    // drawn again.
+    private String mShown;
+    private KeyButtonDrawable mIcon;
+    private CharSequence mLabel;
+
+    private boolean mOverviewClearAll;
+    private Runnable mOnChange;
+    private final BroadcastReceiver mLauncherReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            mOverviewClearAll = intent.getBooleanExtra("clear_all", false);
+            if (mOnChange != null) {
+                mOnChange.run();
+            }
+        }
+    };
+
+    NavBarAppAction(Context context, int lightColor, int darkColor) {
+        mContext = context;
+        mLightColor = lightColor;
+        mDarkColor = darkColor;
+        mSize = Math.round(28 * context.getResources().getDisplayMetrics().density);
+    }
+
+    /** Starts listening to the launcher; {@code onChange} asks for an update(). */
+    void start(Runnable onChange) {
+        mOnChange = onChange;
+        // Only the launcher may say so: it holds STATUS_BAR, apps cannot.
+        mContext.registerReceiverAsUser(mLauncherReceiver, UserHandle.ALL,
+                new IntentFilter(LAUNCHER_STATE), Manifest.permission.STATUS_BAR, null);
+    }
+
+    void stop() {
+        mContext.unregisterReceiver(mLauncherReceiver);
+        mOnChange = null;
+    }
+
+    KeyButtonDrawable getIcon() {
+        return mIcon;
+    }
+
+    CharSequence getLabel() {
+        return mLabel;
+    }
+
+    /** Looks at the tasks again; returns true if the slot has to be redrawn. */
+    boolean update() {
+        ActivityManagerWrapper am = ActivityManagerWrapper.getInstance();
+        ActivityManager.RunningTaskInfo top = am.getRunningTask();
+        ComponentName topActivity = top != null ? top.topActivity : null;
+        String shown = null;
+        if (is(topActivity, JELLY, JELLY_MAIN)) {
+            int tabs = 0;
+            for (RecentTaskInfo task : am.getRecentTasks(MAX_TABS,
+                    ActivityManager.getCurrentUser())) {
+                if (is(task.baseIntent != null ? task.baseIntent.getComponent() : null,
+                        JELLY, JELLY_MAIN)) {
+                    tabs++;
+                }
+            }
+            shown = "tabs:" + Math.max(tabs, 1);
+        } else if (is(topActivity, JELLY, JELLY_TABS)) {
+            shown = "closetabs";
+        } else if (is(topActivity, GALLERY, GALLERY_MAIN)) {
+            shown = "gallery";
+        } else if (is(topActivity, CLOCK, CLOCK_MAIN)) {
+            shown = "clock";
+        } else if (topActivity != null && SETTINGS.equals(topActivity.getPackageName())
+                && DevelopmentSettingsEnabler.isDevelopmentSettingsEnabled(mContext)) {
+            shown = "development";
+        } else if (mOverviewClearAll && topActivity != null
+                && LAUNCHER.equals(topActivity.getPackageName())) {
+            shown = "clearall";
+        } else if (is(topActivity, CAMERA, CAMERA_MAIN)
+                || is(topActivity, CAMERA, CAMERA_LAUNCHER)) {
+            shown = "camera";
+        }
+        if (shown == null ? mShown == null : shown.equals(mShown)) {
+            return false;
+        }
+        mShown = shown;
+        if (shown == null) {
+            mIcon = null;
+            mLabel = null;
+        } else if (shown.equals("camera")) {
+            mIcon = KeyButtonDrawable.create(mContext, dots(mLightColor), dots(mDarkColor),
+                    false /* hasShadow */);
+            mLabel = mContext.getString(R.string.navbar_camera_modes);
+        } else if (shown.equals("clock")) {
+            mIcon = KeyButtonDrawable.create(mContext, dots(mLightColor), dots(mDarkColor),
+                    false /* hasShadow */);
+            mLabel = mContext.getString(R.string.accessibility_menu);
+        } else if (shown.equals("gallery")) {
+            mIcon = KeyButtonDrawable.create(mContext, gear(mLightColor), gear(mDarkColor),
+                    false /* hasShadow */);
+            mLabel = mContext.getString(R.string.accessibility_quick_settings_settings);
+        } else if (shown.equals("development")) {
+            mIcon = KeyButtonDrawable.create(mContext, braces(mLightColor), braces(mDarkColor),
+                    false /* hasShadow */);
+            mLabel = mContext.getString(R.string.development_settings_title);
+        } else if (shown.equals("clearall") || shown.equals("closetabs")) {
+            mIcon = KeyButtonDrawable.create(mContext, clearAll(mLightColor),
+                    clearAll(mDarkColor), false /* hasShadow */);
+            mLabel = mContext.getString(R.string.recents_stack_action_button_label);
+        } else {
+            int n = Integer.parseInt(shown.substring(5));
+            String count = n > 99 ? ":D" : String.valueOf(n);
+            mIcon = KeyButtonDrawable.create(mContext, tabs(count, mLightColor),
+                    tabs(count, mDarkColor), false /* hasShadow */);
+            mLabel = mContext.getString(R.string.navbar_browser_tabs, n);
+        }
+        return true;
+    }
+
+    void onClick() {
+        if (mShown == null) {
+            return;
+        }
+        if (mShown.equals("camera")) {
+            send(CAMERA, CAMERA_MODE_OPTIONS);
+        } else if (mShown.equals("gallery")) {
+            send(GALLERY, GALLERY_SETTINGS);
+        } else if (mShown.equals("clock")) {
+            send(CLOCK, CLOCK_MENU);
+        } else if (mShown.equals("development")) {
+            send(SETTINGS, SETTINGS_DEVELOPMENT);
+        } else if (mShown.equals("clearall")) {
+            send(LAUNCHER, LAUNCHER_CLEAR_ALL);
+        } else if (mShown.equals("closetabs")) {
+            send(JELLY, JELLY_CLOSE_ALL);
+        } else {
+            send(JELLY, JELLY_SHOW_TABS);
+        }
+    }
+
+    boolean onLongClick() {
+        if (mShown == null || mShown.equals("clearall") || mShown.equals("closetabs")
+                || mShown.equals("development") || mShown.equals("gallery")
+                || mShown.equals("clock")) {
+            return false;
+        }
+        if (mShown.equals("camera")) {
+            send(CAMERA, CAMERA_MODE_LIST);
+        } else {
+            send(JELLY, JELLY_NEW_TAB);
+        }
+        return true;
+    }
+
+    private static boolean is(ComponentName c, String pkg, String cls) {
+        return c != null && pkg.equals(c.getPackageName()) && cls.equals(c.getClassName());
+    }
+
+    // The app in front does the action itself, as from its own controls: an
+    // activity started from the bar during its touch gesture is parked by the
+    // activity manager and never shows.
+    private void send(String pkg, String action) {
+        mContext.sendBroadcastAsUser(new Intent(action).setPackage(pkg), UserHandle.CURRENT);
+    }
+
+    // The tab count in a rounded frame, like the browser draws it.
+    private Drawable tabs(String count, int color) {
+        Bitmap bitmap = Bitmap.createBitmap(mSize, mSize, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bitmap);
+        float d = mContext.getResources().getDisplayMetrics().density;
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setColor(color);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(2 * d);
+        float inset = 5 * d;
+        canvas.drawRoundRect(new RectF(inset, inset, mSize - inset, mSize - inset),
+                3 * d, 3 * d, paint);
+        paint.setStyle(Paint.Style.FILL);
+        paint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+        paint.setTextAlign(Paint.Align.CENTER);
+        paint.setTextSize((count.length() > 1 ? 10 : 12) * d);
+        float y = mSize / 2f - (paint.descent() + paint.ascent()) / 2f;
+        canvas.drawText(count, mSize / 2f, y, paint);
+        return new BitmapDrawable(mContext.getResources(), bitmap);
+    }
+
+    // Close all: two windows stacked, an X on the front one - the tab
+    // count's frame, in the same stroke, so the two read as one family.
+    private Drawable clearAll(int color) {
+        Bitmap bitmap = Bitmap.createBitmap(mSize, mSize, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bitmap);
+        // Drawn on the icon's 28 dp grid.
+        canvas.scale(mSize / 28f, mSize / 28f);
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setColor(color);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(2);
+        canvas.drawRoundRect(new RectF(8, 4, 24, 20), 3, 3, paint);
+        // The front window hides the back one's corner.
+        Paint clear = new Paint(Paint.ANTI_ALIAS_FLAG);
+        clear.setXfermode(new PorterDuffXfermode(PorterDuff.Mode.CLEAR));
+        canvas.drawRoundRect(new RectF(3, 7, 21, 25), 4, 4, clear);
+        canvas.drawRoundRect(new RectF(4, 8, 20, 24), 3, 3, paint);
+        float arm = 3.2f;
+        canvas.drawLine(12 - arm, 16 - arm, 12 + arm, 16 + arm, paint);
+        canvas.drawLine(12 - arm, 16 + arm, 12 + arm, 16 - arm, paint);
+        return new BitmapDrawable(mContext.getResources(), bitmap);
+    }
+
+    // Material's settings gear, a little smaller than the grid so it weighs
+    // about as much as the bar's line icons.
