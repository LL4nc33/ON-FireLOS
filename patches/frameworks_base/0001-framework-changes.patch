+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.systemui.screenrecord;
+
+import android.animation.ObjectAnimator;
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.PixelFormat;
+import android.graphics.Point;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.text.format.DateUtils;
+import android.view.Gravity;
+import android.view.LayoutInflater;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.view.WindowManager;
+import android.view.animation.PathInterpolator;
+import android.widget.TextView;
+
+import com.android.systemui.R;
+
+/**
+ * While a recording runs: a small chip above everything - a pulsing red dot, the time recorded
+ * so far and a stop button, so the shade need not come down for it. It can be dragged anywhere,
+ * like a picture-in-picture window, and settles at the nearer side when let go.
+ */
+public class RecordingChip {
+    private final WindowManager mWindowManager;
+    private final View mView;
+    private final TextView mTime;
+    private final ObjectAnimator mPulse;
+    private final WindowManager.LayoutParams mParams;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final int mMargin;
+    private final int mSlop;
+    private long mStart;
+    private boolean mShown;
+
+    private final Runnable mTick = new Runnable() {
+        @Override
+        public void run() {
+            mTime.setText(DateUtils.formatElapsedTime(
+                    (SystemClock.elapsedRealtime() - mStart) / 1000));
+            mHandler.postDelayed(this, 1000);
+        }
+    };
+
+    public RecordingChip(Context context, Runnable onStop) {
+        mWindowManager = context.getSystemService(WindowManager.class);
+        mView = LayoutInflater.from(context).inflate(R.layout.onfirelos_recording_chip, null);
+        mTime = mView.findViewById(R.id.recording_time);
+        mView.findViewById(R.id.recording_stop).setOnClickListener(v -> onStop.run());
+        mPulse = ObjectAnimator.ofFloat(mView.findViewById(R.id.recording_dot), View.ALPHA,
+                1f, 0.25f);
+        mPulse.setDuration(800);
+        mPulse.setRepeatMode(ValueAnimator.REVERSE);
+        mPulse.setRepeatCount(ValueAnimator.INFINITE);
+        final float density = context.getResources().getDisplayMetrics().density;
+        mMargin = Math.round(16 * density);
+        mSlop = ViewConfiguration.get(context).getScaledTouchSlop();
+        mParams = new WindowManager.LayoutParams(
+                WindowManager.LayoutParams.WRAP_CONTENT, WindowManager.LayoutParams.WRAP_CONTENT,
+                WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+                PixelFormat.TRANSLUCENT);
+        mParams.gravity = Gravity.TOP | Gravity.START;
+        mParams.y = Math.round(72 * density);
+        mParams.setTitle("RecordingChip");
+        mView.setOnTouchListener(new Drag());
+    }
+
+    /** At the top right at first, below the status bar. */
+    public void show() {
+        if (mShown) return;
+        mStart = SystemClock.elapsedRealtime();
+        mTick.run();
+        mView.measure(View.MeasureSpec.UNSPECIFIED, View.MeasureSpec.UNSPECIFIED);
+        mParams.x = screen().x - mView.getMeasuredWidth() - mMargin;
+        mWindowManager.addView(mView, mParams);
+        mShown = true;
+        mPulse.start();
+    }
+
+    public void hide() {
+        if (!mShown) return;
+        mShown = false;
+        mHandler.removeCallbacks(mTick);
+        mPulse.cancel();
+        mWindowManager.removeViewImmediate(mView);
+    }
+
+    private Point screen() {
+        final Point size = new Point();
+        mWindowManager.getDefaultDisplay().getRealSize(size);
+        return size;
+    }
+
+    private void update() {
+        if (mShown) mWindowManager.updateViewLayout(mView, mParams);
+    }
+
+    /** To the nearer side, and back onto the screen if it was pulled past an edge. */
+    private void settle() {
+        final Point size = screen();
+        final int width = mView.getWidth();
+        final int fromX = mParams.x;
+        final int fromY = mParams.y;
+        final int toX = fromX + width / 2 < size.x / 2 ? mMargin : size.x - width - mMargin;
+        final int toY = Math.max(mMargin, Math.min(fromY, size.y - mView.getHeight() - mMargin));
+        final ValueAnimator animator = ValueAnimator.ofFloat(0f, 1f);
+        animator.setDuration(250);
+        animator.setInterpolator(new PathInterpolator(0.4f, 0f, 0.2f, 1f));
+        animator.addUpdateListener(a -> {
+            final float t = (float) a.getAnimatedValue();
+            mParams.x = Math.round(fromX + (toX - fromX) * t);
+            mParams.y = Math.round(fromY + (toY - fromY) * t);
+            update();
+        });
+        animator.start();
+    }
+
+    /** A drag moves the chip; a touch that does not move leaves it be. */
+    private final class Drag implements View.OnTouchListener {
+        private float mDownX;
+        private float mDownY;
+        private int mStartX;
+        private int mStartY;
+        private boolean mDragging;
+
+        @Override
+        public boolean onTouch(View view, MotionEvent event) {
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    mDownX = event.getRawX();
+                    mDownY = event.getRawY();
+                    mStartX = mParams.x;
+                    mStartY = mParams.y;
+                    mDragging = false;
+                    return true;
+                case MotionEvent.ACTION_MOVE:
+                    final float dx = event.getRawX() - mDownX;
+                    final float dy = event.getRawY() - mDownY;
+                    if (!mDragging && Math.hypot(dx, dy) > mSlop) {
+                        mDragging = true;
+                    }
+                    if (mDragging) {
+                        mParams.x = mStartX + Math.round(dx);
+                        mParams.y = mStartY + Math.round(dy);
+                        update();
+                    }
+                    return true;
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    if (mDragging) settle();
+                    return true;
+                default:
+                    return false;
+            }
+        }
+    }
+}
