+package com.android.systemui.qs.tiles;
+
+import android.content.Intent;
+import android.service.quicksettings.Tile;
+import android.view.WindowManager;
+
+import com.android.internal.logging.nano.MetricsProto.MetricsEvent;
+import com.android.internal.util.ScreenshotHelper;
+import com.android.systemui.R;
+import com.android.systemui.plugins.qs.QSTile.BooleanState;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+import com.android.systemui.screenrecord.CaptureDialog;
+import com.android.systemui.screenrecord.RecordingService;
+
+/**
+ * Quick settings tile: screenshot and screen recording in one. A tap asks which, in a small
+ * dialog; while a recording runs, it stops it. A long press takes a screenshot of an area.
+ */
+public class CaptureTile extends QSTileImpl<BooleanState>
+        implements RecordingService.Listener, CaptureDialog.Callback {
+    // Long enough for the shade and the dialog to slide away; they must not be in the picture.
+    private static final long SCREENSHOT_DELAY_MS = 500;
+    private static final long RECORD_DELAY_MS = 600;
+
+    private final Icon mIcon = ResourceIcon.get(R.drawable.ic_qs_screenshot);
+    private final Icon mRecordingIcon = ResourceIcon.get(R.drawable.ic_qs_screenrecord);
+    private final ScreenshotHelper mScreenshotHelper;
+
+    public CaptureTile(QSHost host) {
+        super(host);
+        mScreenshotHelper = new ScreenshotHelper(mContext);
+        RecordingService.addListener(this);
+    }
+
+    @Override
+    protected void handleDestroy() {
+        super.handleDestroy();
+        RecordingService.removeListener(this);
+    }
+
+    @Override
+    public BooleanState newTileState() {
+        return new BooleanState();
+    }
+
+    @Override
+    public void handleSetListening(boolean listening) {
+    }
+
+    @Override
+    protected void handleClick() {
+        if (RecordingService.isRecording()) {
+            mContext.startService(RecordingService.stopIntent(mContext));
+            return;
+        }
+        mHost.collapsePanels();
+        mUiHandler.post(() -> new CaptureDialog(mContext, this).show());
+    }
+
+    @Override
+    protected void handleLongClick() {
+        if (RecordingService.isRecording()) {
+            return;
+        }
+        mHost.collapsePanels();
+        screenshot(WindowManager.TAKE_SCREENSHOT_SELECTED_REGION);
+    }
+
+    @Override
+    public void onScreenshot() {
+        screenshot(WindowManager.TAKE_SCREENSHOT_FULLSCREEN);
+    }
+
+    @Override
+    public void onRecord(boolean microphone) {
+        mUiHandler.postDelayed(() -> mContext.startForegroundService(
+                RecordingService.startIntent(mContext, microphone)), RECORD_DELAY_MS);
+    }
+
+    private void screenshot(int type) {
+        mUiHandler.postDelayed(() -> mScreenshotHelper.takeScreenshot(type, true, true,
+                mUiHandler), SCREENSHOT_DELAY_MS);
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return null;
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_capture_label);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return MetricsEvent.QS_PANEL;
+    }
+
+    @Override
+    public void onRecordingChanged(boolean recording) {
+        refreshState();
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        state.value = RecordingService.isRecording();
+        state.icon = state.value ? mRecordingIcon : mIcon;
+        state.label = getTileLabel();
+        state.secondaryLabel = state.value
+                ? mContext.getString(R.string.screenrecord_tap_to_stop) : null;
+        state.contentDescription = state.label;
+        state.state = state.value ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+    }
+}
