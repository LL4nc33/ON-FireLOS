+import java.util.Locale;
+
+/**
+ * Screen recording, started from the capture tile's dialog.
+ *
+ * Android 9 has none of its own. The screen is mirrored into a virtual
+ * display whose surface feeds an H.264 encoder; the result goes to
+ * Movies/Screenrecords as MP4. MediaTek's hardware encoder cannot take its
+ * input from a surface (it lacks the native-window metadata mode Android 9
+ * relies on), so this uses Android's software encoder, at 1280x800 - the
+ * panel's 16:10, as large as that encoder allows on this CPU.
+ *
+ * Sound from the microphone if asked for, as AAC. What apps play cannot be
+ * recorded: Android 9 has no playback capture, and the remote submix it
+ * offers instead takes the sound off the speaker while it records.
+ */
+public class RecordingService extends Service {
+    private static final String TAG = "RecordingService";
+    private static final String ACTION_START = "com.android.systemui.screenrecord.START";
+    private static final String ACTION_STOP = "com.android.systemui.screenrecord.STOP";
+    private static final String EXTRA_MICROPHONE = "microphone";
+    private static final int NOTIFICATION_RECORDING = 4271;
+    private static final int NOTIFICATION_SAVED = 4272;
+    private static final String ENCODER = "OMX.google.h264.encoder";
+    private static final int LONG_SIDE = 1280;
+    private static final int SHORT_SIDE = 800;
+    private static final int BIT_RATE = 6_000_000;
+    private static final int FRAME_RATE = 30;
+    private static final int SAMPLE_RATE = 44100;
+    private static final int AUDIO_BIT_RATE = 128_000;
+    // How long the first track waits for the other before the file starts without it.
+    private static final long TRACK_WAIT_MS = 2000;
+
+    public interface Listener {
+        void onRecordingChanged(boolean recording);
+    }
+
+    // Read from the tile's background thread, changed on the main thread.
+    private static volatile boolean sRecording;
+    private static final List<Listener> sListeners = new CopyOnWriteArrayList<>();
+
+    public static boolean isRecording() {
+        return sRecording;
+    }
+
+    public static void addListener(Listener l) {
+        sListeners.add(l);
+    }
+
+    public static void removeListener(Listener l) {
+        sListeners.remove(l);
+    }
+
+    public static Intent startIntent(Context context, boolean microphone) {
+        return new Intent(ACTION_START).setClass(context, RecordingService.class)
+                .putExtra(EXTRA_MICROPHONE, microphone);
+    }
+
+    public static Intent stopIntent(Context context) {
+        return new Intent(ACTION_STOP).setClass(context, RecordingService.class);
+    }
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private MediaProjection mProjection;
+    private VirtualDisplay mVirtualDisplay;
+    private MediaCodec mCodec;
+    private Surface mInputSurface;
+    private AudioRecord mAudioRecord;
+    private MediaCodec mAudioCodec;
+    private long mAudioStartUs;
+    private MediaMuxer mMuxer;
+    private RecordingChip mChip;
+    private volatile boolean mStopping;
+    private File mFile;
+
+    // The file starts once every track's format is known; both encoder threads write to it.
+    private final Object mMuxerLock = new Object();
+    private int mTracksMissing;
+    private boolean mAudioTrackAdded;
+    private boolean mMuxerStarted;
+    private int mThreadsRunning;
+
+    // Another app starting a capture of its own takes the screen from us.
+    private final MediaProjection.Callback mProjectionStopped = new MediaProjection.Callback() {
+        @Override
+        public void onStop() {
+            stopRecording();
+        }
+    };
+
+    private final BroadcastReceiver mScreenOff = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            // Nothing to record with the screen off; keep what there is.
+            stopRecording();
+        }
+    };
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        String action = intent != null ? intent.getAction() : null;
+        if (ACTION_START.equals(action) && !sRecording) {
+            // Before anything that can fail: a service started in the
+            // foreground that never gets there takes SystemUI down with it.
+            startForeground(NOTIFICATION_RECORDING, recordingNotification());
+            if (!startRecording(intent.getBooleanExtra(EXTRA_MICROPHONE, false))) {
+                cleanUp();
+                if (mFile != null) {
+                    mFile.delete();
+                }
+                stopForeground(true);
+                stopSelf();
+            }
+        } else if (ACTION_STOP.equals(action)) {
+            if (sRecording) {
+                stopRecording();
+            } else {
+                // A late tap on the notification: nothing left to stop.
+                stopSelf();
+            }
+        }
+        return START_NOT_STICKY;
+    }
+
+    private boolean startRecording(boolean microphone) {
+        try {
+            // SystemUI may record the screen itself, with no consent dialog:
+            // the tile is the user's request.
+            IMediaProjectionManager mpm = IMediaProjectionManager.Stub.asInterface(
+                    ServiceManager.getService(Context.MEDIA_PROJECTION_SERVICE));
+            IMediaProjection projection = mpm.createProjection(getApplicationInfo().uid,
+                    getPackageName(), MediaProjectionManager.TYPE_SCREEN_CAPTURE, false);
+            mProjection = new MediaProjection(this, projection);
+            mProjection.registerCallback(mProjectionStopped, mHandler);
+
+            Point real = new Point();
+            getSystemService(WindowManager.class).getDefaultDisplay().getRealSize(real);
+            boolean landscape = real.x >= real.y;
+            int width = landscape ? LONG_SIDE : SHORT_SIDE;
+            int height = landscape ? SHORT_SIDE : LONG_SIDE;
+
+            MediaFormat format = MediaFormat.createVideoFormat(
+                    MediaFormat.MIMETYPE_VIDEO_AVC, width, height);
+            format.setInteger(MediaFormat.KEY_COLOR_FORMAT,
+                    MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface);
+            format.setInteger(MediaFormat.KEY_BIT_RATE, BIT_RATE);
+            format.setInteger(MediaFormat.KEY_FRAME_RATE, FRAME_RATE);
+            format.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1);
+            mCodec = MediaCodec.createByCodecName(ENCODER);
+            mCodec.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE);
+            mInputSurface = mCodec.createInputSurface();
+            mCodec.start();
+
+            File dir = new File(Environment.getExternalStoragePublicDirectory(
+                    Environment.DIRECTORY_MOVIES), "Screenrecords");
+            if (!dir.isDirectory() && !dir.mkdirs()) {
+                throw new IllegalStateException("cannot create " + dir);
+            }
+            mFile = new File(dir, "Screenrecord_" + new SimpleDateFormat(
+                    "yyyyMMdd_HHmmss", Locale.ROOT).format(new Date()) + ".mp4");
+            mMuxer = new MediaMuxer(mFile.getPath(), MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4);
+
+            mVirtualDisplay = mProjection.createVirtualDisplay("ScreenRecording", width, height,
+                    getResources().getDisplayMetrics().densityDpi,
+                    DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR, mInputSurface, null, null);
+            if (mVirtualDisplay == null) {
+                throw new IllegalStateException("no virtual display");
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "Cannot start recording", e);
+            return false;
+        }
+
+        // The microphone is extra: without it, the picture alone.
+        boolean audio = false;
+        if (microphone) {
+            try {
+                startAudio();
+                audio = true;
+            } catch (Exception e) {
+                Log.w(TAG, "Recording without the microphone", e);
+                releaseAudio();
+            }
+        }
+
+        mStopping = false;
+        mMuxerStarted = false;
+        mTracksMissing = audio ? 2 : 1;
+        mAudioTrackAdded = false;
+        mThreadsRunning = audio ? 2 : 1;
+        new Thread(this::drain, "ScreenRecordEncoder").start();
+        if (audio) {
+            new Thread(this::drainAudio, "ScreenRecordAudio").start();
+        }
+        registerReceiver(mScreenOff, new IntentFilter(Intent.ACTION_SCREEN_OFF));
+        setRecording(true);
+        mChip = new RecordingChip(this, this::stopRecording);
+        mChip.show();
+        return true;
+    }
+
+    private void startAudio() throws Exception {
+        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO)
+                != PackageManager.PERMISSION_GRANTED) {
+            throw new IllegalStateException("no permission for the microphone");
+        }
+        int min = AudioRecord.getMinBufferSize(SAMPLE_RATE, AudioFormat.CHANNEL_IN_MONO,
+                AudioFormat.ENCODING_PCM_16BIT);
+        mAudioRecord = new AudioRecord(MediaRecorder.AudioSource.MIC, SAMPLE_RATE,
+                AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT,
+                Math.max(min, 8192) * 2);
+        if (mAudioRecord.getState() != AudioRecord.STATE_INITIALIZED) {
+            throw new IllegalStateException("microphone not available");
+        }
+        MediaFormat format = MediaFormat.createAudioFormat(MediaFormat.MIMETYPE_AUDIO_AAC,
+                SAMPLE_RATE, 1);
+        format.setInteger(MediaFormat.KEY_AAC_PROFILE,
+                MediaCodecInfo.CodecProfileLevel.AACObjectLC);
+        format.setInteger(MediaFormat.KEY_BIT_RATE, AUDIO_BIT_RATE);
+        format.setInteger(MediaFormat.KEY_MAX_INPUT_SIZE, 16384);
+        mAudioCodec = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_AUDIO_AAC);
+        mAudioCodec.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE);
+        mAudioCodec.start();
+        mAudioRecord.startRecording();
+        // The first samples read were taken from here on; the picture's clock is the same.
+        mAudioStartUs = System.nanoTime() / 1000;
+        if (mAudioRecord.getRecordingState() != AudioRecord.RECORDSTATE_RECORDING) {
+            throw new IllegalStateException("microphone in use");
+        }
+    }
+
+    /**
+     * Moves encoded frames into the file until the end of the stream. Any
+     * failure - the codec service can die under it - ends the recording and
+     * keeps what was written; this thread runs in SystemUI, and an uncaught
+     * exception here would take the status bar down with it.
+     */
+    private void drain() {
+        try {
+            drainLoop();
+        } catch (RuntimeException | InterruptedException e) {
+            Log.w(TAG, "Recording ended by an encoder error", e);
+            mHandler.post(this::releaseDisplay);
+        }
+        // The sound ends with the picture.
+        mStopping = true;
+        threadDone();
+    }
+
+    private void drainLoop() throws InterruptedException {
+        MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+        boolean endSignalled = false;
+        int track = -1;
+        while (true) {
+            if (mStopping && !endSignalled) {
+                mCodec.signalEndOfInputStream();
+                endSignalled = true;
+            }
+            int index = mCodec.dequeueOutputBuffer(info, 10_000);
+            if (index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                track = addTrack(mCodec.getOutputFormat());
+            } else if (index >= 0) {
+                ByteBuffer data = mCodec.getOutputBuffer(index);
+                boolean config = (info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0;
+                if (data != null && info.size > 0 && !config && track >= 0) {
+                    data.position(info.offset);
+                    data.limit(info.offset + info.size);
+                    writeSample(track, data, info);
+                }
+                mCodec.releaseOutputBuffer(index, false);
+                if ((info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) {
+                    break;
+                }
+            }
+        }
+    }
+
+    /** Microphone to AAC to the file, until the picture ends. A failure here costs only the sound. */
+    private void drainAudio() {
+        try {
+            drainAudioLoop();
+        } catch (RuntimeException | InterruptedException e) {
+            Log.w(TAG, "Sound ended by an error", e);
+        }
+        synchronized (mMuxerLock) {
+            if (!mMuxerStarted && mTracksMissing > 0 && !mAudioTrackAdded) {
+                // Its track never came: the picture goes on alone.
+                mTracksMissing--;
+                startMuxerIfReady();
+            }
+        }
+        threadDone();
+    }
+
+    private void drainAudioLoop() throws InterruptedException {
+        MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+        long samples = 0;
+        boolean endQueued = false;
+        int track = -1;
+        while (true) {
+            if (!endQueued) {
+                int in = mAudioCodec.dequeueInputBuffer(10_000);
+                if (in >= 0) {
+                    long time = mAudioStartUs + samples * 1_000_000L / SAMPLE_RATE;
+                    if (mStopping) {
+                        mAudioCodec.queueInputBuffer(in, 0, 0, time,
+                                MediaCodec.BUFFER_FLAG_END_OF_STREAM);
+                        endQueued = true;
+                    } else {
+                        ByteBuffer buffer = mAudioCodec.getInputBuffer(in);
+                        int read = mAudioRecord.read(buffer, buffer.capacity());
+                        if (read < 0) {
+                            throw new IllegalStateException("microphone read failed: " + read);
+                        }
+                        mAudioCodec.queueInputBuffer(in, 0, read, time, 0);
+                        samples += read / 2;
+                    }
+                }
+            }
+            int index;
+            while ((index = mAudioCodec.dequeueOutputBuffer(info, endQueued ? 10_000 : 0))
+                    != MediaCodec.INFO_TRY_AGAIN_LATER) {
+                if (index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                    track = addTrack(mAudioCodec.getOutputFormat());
+                    mAudioTrackAdded = true;
+                } else if (index >= 0) {
+                    ByteBuffer data = mAudioCodec.getOutputBuffer(index);
+                    boolean config = (info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0;
+                    if (data != null && info.size > 0 && !config && track >= 0) {
+                        data.position(info.offset);
+                        data.limit(info.offset + info.size);
+                        writeSample(track, data, info);
+                    }
+                    mAudioCodec.releaseOutputBuffer(index, false);
+                    if ((info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) {
+                        return;
+                    }
+                }
+            }
+        }
+    }
+
+    /** A track for the file; -1 if the file has already started without it. */
+    private int addTrack(MediaFormat format) {
+        synchronized (mMuxerLock) {
+            if (mMuxerStarted) {
+                return -1;
+            }
+            int track = mMuxer.addTrack(format);
+            mTracksMissing--;
+            startMuxerIfReady();
+            return track;
+        }
+    }
+
+    // Called with mMuxerLock held.
+    private void startMuxerIfReady() {
+        if (mTracksMissing == 0 && !mMuxerStarted) {
+            mMuxer.start();
+            mMuxerStarted = true;
+            mMuxerLock.notifyAll();
+        }
+    }
+
+    /** Writes a sample once the file has started; waits a little for the other track first. */
+    private void writeSample(int track, ByteBuffer data, MediaCodec.BufferInfo info)
+            throws InterruptedException {
+        synchronized (mMuxerLock) {
+            long deadline = SystemClock.uptimeMillis() + TRACK_WAIT_MS;
+            while (!mMuxerStarted) {
+                long left = deadline - SystemClock.uptimeMillis();
+                if (left <= 0) {
+                    // The other track never came: the file starts without it.
+                    mTracksMissing = 0;
+                    startMuxerIfReady();
+                    break;
+                }
+                mMuxerLock.wait(left);
+            }
+            mMuxer.writeSampleData(track, data, info);
+        }
+    }
+
+    /** The last encoder thread to end closes the file. */
+    private void threadDone() {
+        boolean wrote = false;
+        synchronized (mMuxerLock) {
+            if (--mThreadsRunning > 0) {
+                return;
+            }
+            if (mMuxerStarted) {
+                try {
+                    mMuxer.stop();
+                    wrote = true;
+                } catch (RuntimeException e) {
+                    Log.w(TAG, "Cannot finish the file", e);
+                }
+            }
+        }
+        final boolean result = wrote;
+        mHandler.post(() -> onFinished(result));
+    }
+
+    private void stopRecording() {
+        if (!sRecording || mStopping) {
+            return;
+        }
+        releaseDisplay();
+        mStopping = true;
+        // The rest happens once the encoders have handed out their last frames.
+    }
+
+    /**
+     * The screen first: once the encoder has its end of stream (or has died), surfaceflinger
+     * must no longer draw into its surface - a frame swapped into it then fails, and
+     * surfaceflinger aborts, taking the whole system with it. The chip goes with it.
+     */
+    private void releaseDisplay() {
+        if (mVirtualDisplay != null) {
+            mVirtualDisplay.release();
+            mVirtualDisplay = null;
+        }
+        hideChip();
+    }
+
+    private void onFinished(boolean wrote) {
+        cleanUp();
+        stopForeground(true);
+        if (wrote) {
+            // The service stops right away; the scan outlives it.
+            MediaScannerConnection.scanFile(getApplicationContext(),
+                    new String[] { mFile.getPath() },
+                    new String[] { "video/mp4" }, (path, uri) -> mHandler.post(() ->
+                            showSaved(uri)));
+        } else if (mFile != null) {
+            mFile.delete();
+        }
+        stopSelf();
+    }
+
+    private void hideChip() {
+        if (mChip != null) {
+            mChip.hide();
+            mChip = null;
+        }
+    }
+
+    private void cleanUp() {
+        hideChip();
+        if (sRecording) {
+            unregisterReceiver(mScreenOff);
+        }
+        if (mVirtualDisplay != null) {
+            mVirtualDisplay.release();
+            mVirtualDisplay = null;
+        }
+        if (mCodec != null) {
+            try {
+                mCodec.stop();
+            } catch (IllegalStateException ignored) {
+            }
+            mCodec.release();
+            mCodec = null;
+        }
+        if (mInputSurface != null) {
+            mInputSurface.release();
+            mInputSurface = null;
+        }
+        releaseAudio();
+        if (mMuxer != null) {
+            try {
+                mMuxer.release();
+            } catch (IllegalStateException ignored) {
+            }
+            mMuxer = null;
+        }
+        if (mProjection != null) {
+            mProjection.unregisterCallback(mProjectionStopped);
+            mProjection.stop();
+            mProjection = null;
+        }
+        setRecording(false);
+    }
+
+    private void releaseAudio() {
+        if (mAudioRecord != null) {
+            try {
+                mAudioRecord.stop();
+            } catch (IllegalStateException ignored) {
+            }
+            mAudioRecord.release();
+            mAudioRecord = null;
+        }
+        if (mAudioCodec != null) {
+            try {
+                mAudioCodec.stop();
+            } catch (IllegalStateException ignored) {
+            }
+            mAudioCodec.release();
+            mAudioCodec = null;
+        }
+    }
+
+    private static void setRecording(boolean recording) {
+        if (sRecording == recording) {
+            return;
+        }
+        sRecording = recording;
+        for (Listener l : sListeners) {
+            l.onRecordingChanged(recording);
+        }
+    }
+
+    private Notification recordingNotification() {
+        PendingIntent stop = PendingIntent.getService(this, 0, stopIntent(this),
+                PendingIntent.FLAG_UPDATE_CURRENT);
+        Notification.Builder b = new Notification.Builder(this, NotificationChannels.GENERAL)
+                .setSmallIcon(R.drawable.ic_qs_screenrecord)
+                .setContentTitle(getString(R.string.screenrecord_recording))
+                .setContentText(getString(R.string.screenrecord_tap_to_stop))
+                .setContentIntent(stop)
+                .setOngoing(true)
+                .setShowWhen(true)
+                .setUsesChronometer(true)
+                .addAction(new Notification.Action.Builder(null,
+                        getString(R.string.screenrecord_stop), stop).build());
+        SystemUI.overrideNotificationAppName(this, b, true);
+        return b.build();
+    }
+
+    private void showSaved(Uri uri) {
+        if (uri == null) {
+            return;
+        }
+        Intent view = new Intent(Intent.ACTION_VIEW).setDataAndType(uri, "video/mp4")
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        Intent share = Intent.createChooser(new Intent(Intent.ACTION_SEND)
+                .setType("video/mp4").putExtra(Intent.EXTRA_STREAM, uri)
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION), null)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        Notification.Builder b = new Notification.Builder(this,
+                NotificationChannels.SCREENSHOTS_HEADSUP)
+                .setSmallIcon(R.drawable.ic_qs_screenrecord)
+                .setContentTitle(getString(R.string.screenrecord_saved))
+                .setContentText(getString(R.string.screenrecord_saved_text))
+                .setContentIntent(PendingIntent.getActivity(this, 0, view,
+                        PendingIntent.FLAG_UPDATE_CURRENT))
+                .addAction(new Notification.Action.Builder(null,
+                        getString(R.string.screenrecord_share),
+                        PendingIntent.getActivity(this, 1, share,
+                                PendingIntent.FLAG_UPDATE_CURRENT)).build())
+                .setAutoCancel(true);
+        SystemUI.overrideNotificationAppName(this, b, true);
+        getSystemService(NotificationManager.class).notify(NOTIFICATION_SAVED, b.build());
+    }
+}
