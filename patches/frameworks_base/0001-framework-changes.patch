diff --git a/packages/SystemUI/res/layout/onfirelos_capture_dialog.xml b/packages/SystemUI/res/layout/onfirelos_capture_dialog.xml
new file mode 100644
index 00000000..b6a3b938
--- /dev/null
+++ b/packages/SystemUI/res/layout/onfirelos_capture_dialog.xml
@@ -0,0 +1,112 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 The ON-FireLOS Project
+
+     Licensed under the Apache License, Version 2.0 (the "License");
+     you may not use this file except in compliance with the License.
+     You may obtain a copy of the License at
+
+          http://www.apache.org/licenses/LICENSE-2.0
+
+     Unless required by applicable law or agreed to in writing, software
+     distributed under the License is distributed on an "AS IS" BASIS,
+     WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+     See the License for the specific language governing permissions and
+     limitations under the License.
+-->
+
+<!-- ON-FireLOS: what to capture - two cards, and the microphone for recordings. -->
+<LinearLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:paddingBottom="16dp"
+    android:paddingEnd="24dp"
+    android:paddingStart="24dp"
+    android:paddingTop="24dp">
+
+    <TextView
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginBottom="20dp"
+        android:fontFamily="sans-serif-medium"
+        android:text="@string/quick_settings_capture_label"
+        android:textColor="?android:attr/textColorPrimary"
+        android:textSize="20sp" />
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal">
+
+        <LinearLayout
+            android:id="@+id/capture_screenshot"
+            style="@style/OnFireLosCaptureOption">
+
+            <ImageView
+                style="@style/OnFireLosCaptureOptionIcon"
+                android:src="@drawable/ic_qs_screenshot" />
+
+            <TextView
+                style="@style/OnFireLosCaptureOptionLabel"
+                android:text="@string/quick_settings_screenshot_label" />
+
+        </LinearLayout>
+
+        <Space
+            android:layout_width="12dp"
+            android:layout_height="0dp" />
+
+        <LinearLayout
+            android:id="@+id/capture_record"
+            style="@style/OnFireLosCaptureOption">
+
+            <ImageView
+                style="@style/OnFireLosCaptureOptionIcon"
+                android:src="@drawable/ic_qs_screenrecord" />
+
+            <TextView
+                style="@style/OnFireLosCaptureOptionLabel"
+                android:text="@string/quick_settings_screenrecord_label" />
+
+        </LinearLayout>
+
+    </LinearLayout>
+
+    <LinearLayout
+        android:id="@+id/capture_microphone"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="8dp"
+        android:background="@drawable/onfirelos_capture_row"
+        android:gravity="center_vertical"
+        android:minHeight="56dp"
+        android:orientation="horizontal"
+        android:paddingEnd="8dp"
+        android:paddingStart="8dp">
+
+        <ImageView
+            android:layout_width="24dp"
+            android:layout_height="24dp"
+            android:importantForAccessibility="no"
+            android:src="@drawable/ic_onfirelos_capture_mic"
+            android:tint="?android:attr/textColorSecondary" />
+
+        <TextView
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="16dp"
+            android:layout_weight="1"
+            android:text="@string/capture_microphone"
+            android:textColor="?android:attr/textColorPrimary"
+            android:textSize="16sp" />
+
+        <Switch
+            android:id="@+id/capture_microphone_switch"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:contentDescription="@string/capture_microphone" />
+
+    </LinearLayout>
+
+</LinearLayout>
