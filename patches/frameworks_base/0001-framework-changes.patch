+    // ON-FireLOS: a list for the cards of PreferenceGroupAdapter - no lines between the items,
+    // the press shown by each card itself, in from the sides by its width (Settings' column on
+    // a tablet). Once per list.
+    private static final java.util.WeakHashMap<ListView, Boolean> sCardLists =
+            new java.util.WeakHashMap<>();
+
+    private static void styleForCards(ListView listView) {
+        if (sCardLists.put(listView, Boolean.TRUE) != null) {
+            return;
+        }
+        final float density = listView.getResources().getDisplayMetrics().density;
+        final int start = listView.getPaddingStart();
+        final int end = listView.getPaddingEnd();
+        final int air = Math.round(16 * density);
+        listView.setPaddingRelative(start + air, listView.getPaddingTop() + air / 2, end + air,
+                listView.getPaddingBottom() + air);
+        listView.addOnLayoutChangeListener((view, left, top, right, bottom,
+                oldLeft, oldTop, oldRight, oldBottom) -> {
+            final float width = (right - left) / density;
+            final int side = Math.round((width >= 1100 ? 160 : width >= 760 ? 80 : 16) * density);
+            if (view.getPaddingStart() != start + side) {
+                view.setPaddingRelative(start + side, view.getPaddingTop(), end + side,
+                        view.getPaddingBottom());
+            }
+        });
+        listView.setClipToPadding(false);
+        listView.setScrollBarStyle(android.view.View.SCROLLBARS_OUTSIDE_OVERLAY);
+        listView.setDivider(null);
+        listView.setSelector(android.R.color.transparent);
+    }
