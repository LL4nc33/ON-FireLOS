+
+package com.android.systemui.qs.tiles;
+
+import android.app.ActivityManager;
+import android.content.ComponentName;
+import android.content.ContentResolver;
+import android.content.Intent;
+import android.database.ContentObserver;
+import android.provider.Settings;
+import android.service.quicksettings.Tile;
+import android.text.TextUtils;
+import android.widget.Switch;
+
+import com.android.internal.logging.nano.MetricsProto.MetricsEvent;
+import com.android.systemui.R;
+import com.android.systemui.plugins.qs.QSTile.BooleanState;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+
+/**
+ * Quick settings tile: the standby screen - the clock's screen saver with time, date, weather
+ * and the next alarm, dimmed - whenever the tablet charges and its screen goes off. On means
+ * the screen saver is on, it is the clock's, and it starts when the screen goes off. A long
+ * press opens the screen saver settings.
+ */
+public class StandbyTile extends QSTileImpl<BooleanState> {
+    private static final ComponentName CLOCK_DREAM = new ComponentName(
+            "com.android.deskclock", "com.android.deskclock.Screensaver");
+
+    private final Icon mIcon = ResourceIcon.get(R.drawable.ic_qs_standby);
+    private final ContentObserver mObserver;
+    private boolean mListening;
+
+    public StandbyTile(QSHost host) {
+        super(host);
+        mObserver = new ContentObserver(mHandler) {
+            @Override
+            public void onChange(boolean selfChange) {
+                refreshState();
+            }
+        };
+    }
+
+    @Override
+    public BooleanState newTileState() {
+        return new BooleanState();
+    }
+
+    @Override
+    public void handleSetListening(boolean listening) {
+        if (mListening == listening) return;
+        mListening = listening;
+        final ContentResolver resolver = mContext.getContentResolver();
+        if (listening) {
+            for (String setting : new String[] { Settings.Secure.SCREENSAVER_ENABLED,
+                    Settings.Secure.SCREENSAVER_COMPONENTS,
+                    Settings.Secure.SCREENSAVER_ACTIVATE_ON_SLEEP }) {
+                resolver.registerContentObserver(Settings.Secure.getUriFor(setting), false,
+                        mObserver, ActivityManager.getCurrentUser());
+            }
+            refreshState();
+        } else {
+            resolver.unregisterContentObserver(mObserver);
+        }
+    }
+
+    /** Whether the clock's standby screen starts when the screen goes off while charging. */
+    private boolean isOn() {
+        final ContentResolver resolver = mContext.getContentResolver();
+        final int user = ActivityManager.getCurrentUser();
+        final boolean enabled = Settings.Secure.getIntForUser(resolver,
+                Settings.Secure.SCREENSAVER_ENABLED, mContext.getResources().getBoolean(
+                        com.android.internal.R.bool.config_dreamsEnabledByDefault) ? 1 : 0,
+                user) != 0;
+        final boolean onSleep = Settings.Secure.getIntForUser(resolver,
+                Settings.Secure.SCREENSAVER_ACTIVATE_ON_SLEEP, mContext.getResources().getBoolean(
+                        com.android.internal.R.bool.config_dreamsActivatedOnSleepByDefault)
+                        ? 1 : 0, user) != 0;
+        String components = Settings.Secure.getStringForUser(resolver,
+                Settings.Secure.SCREENSAVER_COMPONENTS, user);
+        if (components == null) {
+            components = mContext.getResources().getString(
+                    com.android.internal.R.string.config_dreamsDefaultComponent);
+        }
+        boolean clock = false;
+        if (!TextUtils.isEmpty(components)) {
+            for (String component : components.split(",")) {
+                clock |= CLOCK_DREAM.equals(ComponentName.unflattenFromString(component.trim()));
+            }
+        }
+        return enabled && onSleep && clock;
+    }
+
+    @Override
+    protected void handleClick() {
+        final boolean on = !mState.value;
+        final ContentResolver resolver = mContext.getContentResolver();
+        final int user = ActivityManager.getCurrentUser();
+        if (on) {
+            Settings.Secure.putStringForUser(resolver, Settings.Secure.SCREENSAVER_COMPONENTS,
+                    CLOCK_DREAM.flattenToString(), user);
+            Settings.Secure.putIntForUser(resolver,
+                    Settings.Secure.SCREENSAVER_ACTIVATE_ON_SLEEP, 1, user);
+        }
+        Settings.Secure.putIntForUser(resolver, Settings.Secure.SCREENSAVER_ENABLED,
+                on ? 1 : 0, user);
+        refreshState(on);
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return new Intent(Settings.ACTION_DREAM_SETTINGS);
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_standby_label);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return MetricsEvent.QS_PANEL;
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        state.value = arg instanceof Boolean ? (Boolean) arg : isOn();
+        state.state = state.value ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+        state.icon = mIcon;
+        state.label = getTileLabel();
+        state.secondaryLabel = state.value
+                ? mContext.getString(R.string.quick_settings_standby_charging) : null;
+        state.contentDescription = state.label;
+        state.expandedAccessibilityClassName = Switch.class.getName();
+    }
+}
