+/**
+ * Asks what to capture: a screenshot or a screen recording, the recording with the microphone
+ * or without. The microphone choice is kept for next time.
+ */
+public class CaptureDialog extends SystemUIDialog {
+    private static final String PREF_MICROPHONE = "OnFireLosCaptureMicrophone";
+
+    public interface Callback {
+        void onScreenshot();
+
+        void onRecord(boolean microphone);
+    }
+
+    public CaptureDialog(Context context, Callback callback) {
+        super(context, R.style.Theme_SystemUI_Dialog_Capture);
+        final View view = LayoutInflater.from(getContext()).inflate(
+                R.layout.onfirelos_capture_dialog, null);
+
+        // Granted with the system's own apps on a new build; without it, no choice to offer.
+        final boolean allowed = context.checkSelfPermission(Manifest.permission.RECORD_AUDIO)
+                == PackageManager.PERMISSION_GRANTED;
+        final Switch microphone = view.findViewById(R.id.capture_microphone_switch);
+        microphone.setChecked(allowed && Prefs.getBoolean(context, PREF_MICROPHONE, false));
+        microphone.setOnCheckedChangeListener((button, checked) ->
+                Prefs.putBoolean(context, PREF_MICROPHONE, checked));
+        final View microphoneRow = view.findViewById(R.id.capture_microphone);
+        microphoneRow.setVisibility(allowed ? View.VISIBLE : View.GONE);
+        microphoneRow.setOnClickListener(v -> microphone.toggle());
+
+        view.findViewById(R.id.capture_screenshot).setOnClickListener(v -> {
+            dismiss();
+            callback.onScreenshot();
+        });
+        view.findViewById(R.id.capture_record).setOnClickListener(v -> {
+            dismiss();
+            callback.onRecord(microphone.isChecked());
+        });
+        setView(view, 0, 0, 0, 0);
+        getWindow().setBackgroundDrawableResource(R.drawable.onfirelos_capture_dialog_background);
+    }
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        // A compact card, not the width of a tablet's dialog.
+        getWindow().setLayout(getContext().getResources().getDimensionPixelSize(
+                R.dimen.onfirelos_capture_dialog_width), ViewGroup.LayoutParams.WRAP_CONTENT);
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/screenrecord/RecordingChip.java b/packages/SystemUI/src/com/android/systemui/screenrecord/RecordingChip.java
