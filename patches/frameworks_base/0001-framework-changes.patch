+import com.android.systemui.qs.tiles.DarkStyle;
+
+/**
+ * ON-FireLOS: light and dark, at the end of the brightness row. On is dark, off is light, as
+ * the dark theme tile was; a long press opens the style settings, where it can also follow
+ * the wallpaper or the time of day. Drawn like a tile's icon: in the accent circle while on.
+ */
+public class DarkModeButton extends ImageView implements View.OnClickListener,
+        View.OnLongClickListener {
+
+    private final GradientDrawable mCircle = new GradientDrawable();
+    private boolean mObserving;
+
+    private final ContentObserver mObserver = new ContentObserver(new Handler()) {
+        @Override
+        public void onChange(boolean selfChange) {
+            update();
+        }
+    };
+
+    public DarkModeButton(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mCircle.setShape(GradientDrawable.OVAL);
+        setBackground(new RippleDrawable(ColorStateList.valueOf(
+                Utils.getColorAttr(context, android.R.attr.colorControlHighlight)), mCircle,
+                null));
+        setImageResource(R.drawable.ic_qs_dark_theme);
+        setScaleType(ScaleType.CENTER);
+        setContentDescription(context.getString(R.string.quick_settings_dark_theme_label));
+        // Read as a switch: "Dark theme, on/off".
+        setAccessibilityDelegate(new AccessibilityDelegate() {
+            @Override
+            public void onInitializeAccessibilityNodeInfo(View host,
+                    android.view.accessibility.AccessibilityNodeInfo info) {
+                super.onInitializeAccessibilityNodeInfo(host, info);
+                info.setClassName(android.widget.Switch.class.getName());
+                info.setCheckable(true);
+                info.setChecked(host.isActivated());
+            }
+        });
+        setOnClickListener(this);
+        setOnLongClickListener(this);
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        // The brightness row is also the standalone brightness dialog's and the mirror shown
+        // while its slider is dragged: the button belongs to the quick settings panel only.
+        if (!inQuickSettings()) {
+            setVisibility(GONE);
+            return;
+        }
+        DarkStyle.observe(getContext(), mObserver);
+        mObserving = true;
+        update();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        if (mObserving) {
+            getContext().getContentResolver().unregisterContentObserver(mObserver);
+            mObserving = false;
+        }
+        super.onDetachedFromWindow();
+    }
+
+    // In the automatic styles the look changes without the setting: it arrives as a change of
+    // the night mode, with the panel's colours.
+    @Override
+    protected void onConfigurationChanged(android.content.res.Configuration newConfig) {
+        super.onConfigurationChanged(newConfig);
+        if (mObserving) {
+            update();
+        }
+    }
+
+    private boolean inQuickSettings() {
+        for (android.view.ViewParent p = getParent(); p != null; p = p.getParent()) {
+            if (p instanceof com.android.systemui.qs.QSPanel) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // The colours of a tile, read afresh for the look in use: the accent circle with the panel
+    // colour while on, a quiet circle with the secondary text colour while off
+    // (QSTileBaseView, QSTileImpl).
+    private void update() {
+        final Context context = getContext();
+        final boolean dark = DarkStyle.isDark(context);
+        setActivated(dark);
+        mCircle.setColor(dark ? Utils.getColorAttr(context, android.R.attr.colorAccent)
+                : Utils.getDisabled(context,
+                        Utils.getColorAttr(context, android.R.attr.textColorTertiary)));
+        setImageTintList(ColorStateList.valueOf(Utils.getColorAttr(context,
+                dark ? android.R.attr.colorPrimary : android.R.attr.textColorSecondary)));
+    }
+
+    @Override
+    public void onClick(View view) {
+        performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY);
+        DarkStyle.set(getContext(), !DarkStyle.isDark(getContext()));
+        update();
+    }
+
+    @Override
+    public boolean onLongClick(View view) {
+        Dependency.get(ActivityStarter.class).postStartActivityDismissingKeyguard(
+                new Intent("org.lineageos.lineageparts.STYLE_SETTINGS"), 0);
+        return true;
+    }
+}
