+    // ON-FireLOS: the items of each category lie on a rounded card (docs/DESIGN.md), as in
+    // Settings; category titles stay on the background. The card is each item's background,
+    // with the press ripple on it, so recycled views are set again for their new place.
+    private float mCardRadius = -1;
+    private int mCardColor;
+    private ColorStateList mCardRipple;
+    // ON-FireLOS: the fine line between two items of a card, and the accent for values.
+    private int mLineColor;
+    private int mLineInset;
+    private int mLineHeight;
+    private int mAccentColor;
+    private static final java.util.WeakHashMap<android.widget.TextView, ColorStateList>
+            sSummaryColors = new java.util.WeakHashMap<>();
+
+    private void styleAsCard(View view, int position, ViewGroup parent) {
+        if (getItem(position) instanceof PreferenceCategory) {
+            return;
+        }
+        if (mCardRadius < 0) {
+            final Context context = parent.getContext();
+            mCardRadius = 20 * context.getResources().getDisplayMetrics().density;
+            final TypedArray a = context.obtainStyledAttributes(new int[] {
+                    android.R.attr.colorBackgroundFloating,
+                    android.R.attr.colorControlHighlight,
+                    android.R.attr.textColorPrimary,
+                    android.R.attr.colorAccent });
+            mCardColor = a.getColor(0, Color.WHITE);
+            mCardRipple = ColorStateList.valueOf(a.getColor(1, 0x1f000000));
+            mLineColor = (a.getColor(2, Color.BLACK) & 0x00ffffff) | 0x1a000000;
+            mAccentColor = a.getColor(3, Color.BLACK);
+            a.recycle();
+            final float density = context.getResources().getDisplayMetrics().density;
+            mLineInset = Math.round(20 * density);
+            mLineHeight = Math.max(1, (int) density);
+        }
+        final float top = position == 0
+                || getItem(position - 1) instanceof PreferenceCategory ? mCardRadius : 0;
+        final float bottom = position == getCount() - 1
+                || getItem(position + 1) instanceof PreferenceCategory ? mCardRadius : 0;
+        final GradientDrawable card = new GradientDrawable();
+        card.setColor(mCardColor);
+        card.setCornerRadii(new float[] { top, top, top, top, bottom, bottom, bottom, bottom });
+        Drawable content = card;
+        if (bottom == 0) {
+            // More of the card below: a fine line at the foot, in from both sides.
+            final android.graphics.drawable.LayerDrawable layers =
+                    new android.graphics.drawable.LayerDrawable(new Drawable[] {
+                            card, new android.graphics.drawable.ColorDrawable(mLineColor) });
+            layers.setLayerGravity(1, android.view.Gravity.BOTTOM);
+            layers.setLayerHeight(1, mLineHeight);
+            layers.setLayerInsetStart(1, mLineInset);
+            layers.setLayerInsetEnd(1, mLineInset);
+            content = layers;
+        }
+        view.setBackground(new RippleDrawable(mCardRipple, content, null));
+    }
+
+    // ON-FireLOS: a list setting's current value in the accent, as Settings shows values.
+    // The summary's own colours are kept on the view and come back when it is used again.
+    private void colorValue(View view, Preference preference) {
+        final View found = view.findViewById(com.android.internal.R.id.summary);
+        if (!(found instanceof android.widget.TextView)) {
+            return;
+        }
+        final android.widget.TextView summary = (android.widget.TextView) found;
+        final boolean value = preference instanceof ListPreference
+                && ((ListPreference) preference).getEntry() != null
+                && android.text.TextUtils.equals(((ListPreference) preference).getEntry(),
+                        summary.getText());
+        if (value) {
+            if (!sSummaryColors.containsKey(summary)) {
+                sSummaryColors.put(summary, summary.getTextColors());
+            }
+            if (mCardRadius >= 0) {
+                // Dimmed like the summary when the setting is disabled.
+                summary.setTextColor(new ColorStateList(
+                        new int[][] { { -android.R.attr.state_enabled }, {} },
+                        new int[] { (mAccentColor & 0x00ffffff) | 0x61000000, mAccentColor }));
+            }
+        } else {
+            final ColorStateList kept = sSummaryColors.remove(summary);
+            if (kept != null) {
+                summary.setTextColor(kept);
+            }
+        }
+    }
