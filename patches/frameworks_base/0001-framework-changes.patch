+package com.android.systemui.edgegesture;
+
+import android.app.ActivityManager;
+import android.app.ActivityOptions;
+import android.app.KeyguardManager;
+import android.content.Context;
+import android.content.res.Configuration;
+import android.database.ContentObserver;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Point;
+import android.hardware.input.InputManager;
+import android.inputmethodservice.InputMethodService;
+import android.os.IBinder;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.provider.Settings;
+import android.view.Gravity;
+import android.view.HapticFeedbackConstants;
+import android.view.InputDevice;
+import android.view.KeyCharacterMap;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.view.WindowManager;
+
+import com.android.systemui.R;
+import com.android.systemui.SysUiServiceProvider;
+import com.android.systemui.SystemUI;
+import com.android.systemui.statusbar.CommandQueue;
+import com.android.systemui.shared.system.ActivityManagerWrapper;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Edge gestures, as on Apple devices.
+ *
+ * A short swipe in from the left edge goes back, from the right edge forward
+ * (where an app has a forward, e.g. the browser; others ignore the key). A
+ * long swipe switches to the app beside the current one in Recents: from the
+ * left to the one used before, from the right back again.
+ *
+ * Android 9 has no way to watch touches without taking them, so two narrow
+ * windows along the edges receive them. Taps, holds and scrolls in such a
+ * strip are handed on to the app below; only swipes inward are kept.
+ */
+public class EdgeGestures extends SystemUI implements CommandQueue.Callbacks {
+    private static final String SETTING_ENABLED = "onfirelos_edge_gestures";
+    private static final String SETTING_LONG_SWIPE = "onfirelos_edge_long_swipe";
+    private static final String SETTING_WIDTH = "onfirelos_edge_width";
+
+    private static final int LEFT = 0;
+    private static final int RIGHT = 1;
+
+    // A finger that rests this long in a strip without swiping is not
+    // swiping - the touch goes to the app.
+    private static final long HOLD_TIMEOUT = 200;
+
+    // A swipe across this share of the screen switches apps.
+    private static final float LONG_SWIPE_FRACTION = 0.35f;
+
+    // While the keyboard is shown the strips end at this share of the screen
+    // height, above the keyboard: a swipe-typed word that starts on the
+    // outermost key column would otherwise count as "back".
+    private static final float IME_SHOWN_BOTTOM = 0.45f;
+
+    private WindowManager mWindowManager;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private EdgeView[] mEdges;
+    private ArrowView mArrow;
+
+    private int mEdgeWidth;
+    private int mBackThreshold;
+    private boolean mLongSwipe;
+    private boolean mImeShown;
+
+    @Override
+    public void start() {
+        mWindowManager = mContext.getSystemService(WindowManager.class);
+        // All three switched in Settings > System > Gestures.
+        ContentObserver observer = new ContentObserver(mHandler) {
+            @Override
+            public void onChange(boolean selfChange) {
+                update();
+            }
+        };
+        for (String key : new String[] { SETTING_ENABLED, SETTING_LONG_SWIPE, SETTING_WIDTH }) {
+            mContext.getContentResolver().registerContentObserver(
+                    Settings.Secure.getUriFor(key), false, observer);
+        }
+        SysUiServiceProvider.getComponent(mContext, CommandQueue.class).addCallbacks(this);
+        update();
+    }
+
+    @Override
+    public void setImeWindowStatus(IBinder token, int vis, int backDisposition,
+            boolean showImeSwitcher) {
+        boolean shown = (vis & InputMethodService.IME_VISIBLE) != 0;
+        if (shown != mImeShown) {
+            mImeShown = shown;
+            update();
+        }
+    }
+
+    @Override
+    protected void onConfigurationChanged(Configuration newConfig) {
+        update();
+    }
+
+    private boolean isEnabled() {
+        return Settings.Secure.getInt(mContext.getContentResolver(), SETTING_ENABLED, 1) != 0;
+    }
+
+    /** Adds, places or removes the two strips. */
+    private void update() {
+        removeEdges();
+        if (!isEnabled()) {
+            return;
+        }
+        float density = mContext.getResources().getDisplayMetrics().density;
+        int widthDp = Settings.Secure.getInt(mContext.getContentResolver(), SETTING_WIDTH, 14);
+        mEdgeWidth = Math.round(Math.max(6, Math.min(32, widthDp)) * density);
+        mLongSwipe = Settings.Secure.getInt(mContext.getContentResolver(),
+                SETTING_LONG_SWIPE, 1) != 0;
+        mBackThreshold = Math.round(56 * density);
+
+        Point size = new Point();
+        mWindowManager.getDefaultDisplay().getRealSize(size);
+        // Clear of the status bar - pulling the shade down starts there - and
+        // of the navigation bar at the bottom.
+        int top = mContext.getResources().getDimensionPixelSize(
+                com.android.internal.R.dimen.status_bar_height) + Math.round(24 * density);
+        int bottom = mContext.getResources().getDimensionPixelSize(
+                com.android.internal.R.dimen.navigation_bar_height);
+        int height = mImeShown
+                ? Math.max(0, Math.round(size.y * IME_SHOWN_BOTTOM) - top)
+                : Math.max(0, size.y - top - bottom);
+
+        mEdges = new EdgeView[] { new EdgeView(mContext, LEFT), new EdgeView(mContext, RIGHT) };
+        for (EdgeView edge : mEdges) {
+            WindowManager.LayoutParams lp = new WindowManager.LayoutParams(mEdgeWidth, height,
+                    WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL,
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                            | WindowManager.LayoutParams.FLAG_SPLIT_TOUCH,
+                    PixelFormat.TRANSLUCENT);
+            lp.gravity = Gravity.TOP | (edge.mSide == LEFT ? Gravity.LEFT : Gravity.RIGHT);
+            lp.y = top;
+            lp.setTitle(edge.mSide == LEFT ? "EdgeGesture:left" : "EdgeGesture:right");
+            mWindowManager.addView(edge, lp);
+        }
+    }
+
+    private void removeEdges() {
+        hideArrow();
+        if (mEdges != null) {
+            for (EdgeView edge : mEdges) {
+                edge.abandon();
+                mWindowManager.removeViewImmediate(edge);
+            }
+            mEdges = null;
+        }
+    }
+
+    // --- The arrow that follows the finger.
+
+    private void showArrow(int side) {
+        if (mArrow != null) {
+            return;
+        }
+        float density = mContext.getResources().getDisplayMetrics().density;
+        Point size = new Point();
+        mWindowManager.getDefaultDisplay().getRealSize(size);
+        mArrow = new ArrowView(mContext, side);
+        WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                Math.round(120 * density), size.y,
+                WindowManager.LayoutParams.TYPE_NAVIGATION_BAR_PANEL,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+                PixelFormat.TRANSLUCENT);
+        lp.gravity = Gravity.TOP | (side == LEFT ? Gravity.LEFT : Gravity.RIGHT);
+        lp.setTitle("EdgeGesture:arrow");
+        mWindowManager.addView(mArrow, lp);
+    }
+
+    private void hideArrow() {
+        if (mArrow != null) {
+            mWindowManager.removeViewImmediate(mArrow);
+            mArrow = null;
+        }
+    }
+
+    private final class ArrowView extends View {
+        private final int mSide;
+        private final Paint mCircle = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint mStroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path mPath = new Path();
+        private float mY;
+        private float mProgress;
+        private boolean mLong;
+
+        ArrowView(Context context, int side) {
+            super(context);
+            mSide = side;
+            mCircle.setColor(0xE6202124);
+            mStroke.setColor(Color.WHITE);
+            mStroke.setStyle(Paint.Style.STROKE);
+            mStroke.setStrokeCap(Paint.Cap.ROUND);
+            mStroke.setStrokeJoin(Paint.Join.ROUND);
+            mStroke.setStrokeWidth(3 * getResources().getDisplayMetrics().density);
+        }
+
+        void set(float y, float progress, boolean isLong) {
+            mY = y;
+            mProgress = progress;
+            mLong = isLong;
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            float d = getResources().getDisplayMetrics().density;
+            float p = Math.min(1f, mProgress);
+            float r = 22 * d;
+            // Slides in with the finger, up to a third of the strip.
+            float travel = 16 * d + p * (getWidth() / 3f);
+            float cx = mSide == LEFT ? travel : getWidth() - travel;
+            mCircle.setAlpha(Math.round(80 + 150 * p));
+            canvas.drawCircle(cx, mY, r, mCircle);
+            mStroke.setAlpha(Math.round(120 + 135 * p));
+            // Points in the direction of the action; doubled for an app switch.
+            float s = 7 * d;
+            float dir = mSide == LEFT ? -1 : 1;
+            mPath.reset();
+            int arrows = mLong ? 2 : 1;
+            for (int i = 0; i < arrows; i++) {
+                float ox = arrows == 2 ? (i == 0 ? -s * 0.6f : s * 0.6f) : 0;
+                mPath.moveTo(cx + ox - dir * s * 0.5f, mY - s);
+                mPath.lineTo(cx + ox + dir * s * 0.5f, mY);
+                mPath.lineTo(cx + ox - dir * s * 0.5f, mY + s);
+            }
+            canvas.drawPath(mPath, mStroke);
+        }
+    }
+
+    // --- One strip along an edge.
+
+    private final class EdgeView extends View {
+        final int mSide;
+        private final int mSlop;
+        private float mDownX;
+        private float mDownY;
+        private long mDownTime;
+        private int mDeviceId;
+        private int mSource;
+        private boolean mSwiping;
+        private boolean mArmed;
+        private boolean mLong;
+        // Not a swipe: the touch belongs to the app below, until the next one.
+        private boolean mHandedOver;
+        // The app has its DOWN. Until then the finger's moves wait here; after
+        // it the dispatcher sends them to the app directly.
+        private boolean mHandOverReady;
+        private final List<MotionEvent> mWaiting = new ArrayList<>();
+        // A finger resting in the strip is holding something - a key to repeat,
+        // a handle to drag - and not starting a swipe.
+        private final Runnable mHoldCheck = this::handOver;
+        private final Runnable mReplay = this::replay;
+
+        EdgeView(Context context, int side) {
+            super(context);
+            mSide = side;
+            mSlop = ViewConfiguration.get(mContext).getScaledTouchSlop();
+        }
+
+        @Override
+        public boolean onTouchEvent(MotionEvent e) {
+            if (mHandedOver && e.getActionMasked() != MotionEvent.ACTION_DOWN) {
+                keep(e);
+                return true;
+            }
+            switch (e.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    mDownX = e.getRawX();
+                    mDownY = e.getRawY();
+                    mDownTime = e.getDownTime();
+                    mDeviceId = e.getDeviceId();
+                    mSource = e.getSource();
+                    mSwiping = false;
+                    mArmed = false;
+                    mLong = false;
+                    mHandedOver = false;
+                    // Locked: everything belongs to the lock screen.
+                    if (mContext.getSystemService(KeyguardManager.class).isKeyguardLocked()) {
+                        handOver();
+                    } else {
+                        mHandler.postDelayed(mHoldCheck, HOLD_TIMEOUT);
+                    }
+                    return true;
+
+                case MotionEvent.ACTION_MOVE: {
+                    float dx = mSide == LEFT ? e.getRawX() - mDownX : mDownX - e.getRawX();
+                    float dy = Math.abs(e.getRawY() - mDownY);
+                    if (!mSwiping) {
+                        if (dy > mSlop && dy > dx) {
+                            // Scrolling along the edge: not ours.
+                            handOver();
+                            keep(e);
+                            return true;
+                        }
+                        if (dx > mSlop) {
+                            mSwiping = true;
+                            mHandler.removeCallbacks(mHoldCheck);
+                            showArrow(mSide);
+                        }
+                    }
+                    if (mSwiping) {
+                        int width = mWindowManager.getDefaultDisplay().getWidth();
+                        boolean armed = dx >= mBackThreshold;
+                        boolean isLong = mLongSwipe && dx >= width * LONG_SWIPE_FRACTION;
+                        if (armed != mArmed || isLong != mLong) {
+                            performHapticFeedback(HapticFeedbackConstants.CLOCK_TICK);
+                        }
+                        mArmed = armed;
+                        mLong = isLong;
+                        if (mArrow != null) {
+                            mArrow.set(e.getRawY(), dx / mBackThreshold, isLong);
+                        }
+                    }
+                    return true;
+                }
+
+                case MotionEvent.ACTION_UP:
+                    mHandler.removeCallbacks(mHoldCheck);
+                    if (mSwiping) {
+                        if (mLong) {
+                            switchApp(mSide == LEFT);
+                        } else if (mArmed) {
+                            sendKey(mSide == LEFT ? KeyEvent.KEYCODE_BACK
+                                    : KeyEvent.KEYCODE_FORWARD);
+                        }
+                    } else {
+                        // A tap: a toolbar's back arrow reaches into the strip.
+                        handOver();
+                        keep(e);
+                    }
+                    hideArrow();
+                    return true;
+
+                case MotionEvent.ACTION_CANCEL:
+                    mHandler.removeCallbacks(mHoldCheck);
+                    hideArrow();
+                    return true;
+            }
+            return true;
+        }
+
+        /**
+         * Gives the current touch to the app below: the strip steps out of
+         * input, and the touch is started again where it began, as the same
+         * device. The dispatcher takes that for a new touch of the finger that
+         * is still down and sends the rest of it to the app.
+         */
+        private void handOver() {
+            if (mHandedOver || mSwiping) {
+                return;
+            }
+            mHandedOver = true;
+            mHandOverReady = false;
+            mHandler.removeCallbacks(mHoldCheck);
+            setTouchable(false);
+            // A frame for the window manager to take the strip out of input.
+            mHandler.postDelayed(mReplay, 32);
+        }
+
+        private void replay() {
+            // In their own time, all of them: the app measures speed from it.
+            inject(MotionEvent.ACTION_DOWN, mDownX, mDownY, mDownTime);
+            for (MotionEvent w : mWaiting) {
+                inject(w.getActionMasked(), w.getRawX(), w.getRawY(), w.getEventTime());
+                w.recycle();
+            }
+            mWaiting.clear();
+            mHandOverReady = true;
+            // The app keeps the touch to its end; the strip is free for the next.
+            mHandler.postDelayed(() -> setTouchable(true), 50);
+        }
+
+        /** What the finger does before the app has the touch. */
+        private void keep(MotionEvent e) {
+            int action = e.getActionMasked();
+            // Further fingers stay out of it: the app gets one.
+            // A cancel ends the touch too: the app must not keep a finger down.
+            if (!mHandOverReady && (action == MotionEvent.ACTION_MOVE
+                    || action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL)) {
+                mWaiting.add(MotionEvent.obtain(e));
+            }
+        }
+
+        /** The strip goes away mid-touch. */
+        void abandon() {
+            mHandler.removeCallbacks(mHoldCheck);
+            mHandler.removeCallbacks(mReplay);
+            for (MotionEvent w : mWaiting) {
+                w.recycle();
+            }
+            mWaiting.clear();
+            mHandedOver = false;
+        }
+
+        private void inject(int action, float x, float y, long time) {
+            MotionEvent.PointerProperties[] props = { new MotionEvent.PointerProperties() };
+            props[0].id = 0;
+            props[0].toolType = MotionEvent.TOOL_TYPE_FINGER;
+            MotionEvent.PointerCoords[] coords = { new MotionEvent.PointerCoords() };
+            coords[0].x = x;
+            coords[0].y = y;
+            coords[0].pressure = action == MotionEvent.ACTION_UP ? 0 : 1;
+            coords[0].size = 1;
+            MotionEvent ev = MotionEvent.obtain(mDownTime, time, action,
+                    1, props, coords, 0, 0, 1, 1, mDeviceId, 0, mSource, 0);
+            InputManager.getInstance().injectInputEvent(ev,
+                    InputManager.INJECT_INPUT_EVENT_MODE_ASYNC);
+            ev.recycle();
+        }
+
+        private void setTouchable(boolean touchable) {
+            if (!isAttachedToWindow()) {
+                return;
+            }
+            WindowManager.LayoutParams lp = (WindowManager.LayoutParams) getLayoutParams();
+            if (touchable) {
+                lp.flags &= ~WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE;
+            } else {
+                lp.flags |= WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE;
+            }
+            mWindowManager.updateViewLayout(this, lp);
+        }
+    }
+
+    // --- Actions.
+
+    private void sendKey(int keyCode) {
+        long now = SystemClock.uptimeMillis();
+        for (int action : new int[] { KeyEvent.ACTION_DOWN, KeyEvent.ACTION_UP }) {
+            KeyEvent ev = new KeyEvent(now, now, action, keyCode, 0, 0,
+                    KeyCharacterMap.VIRTUAL_KEYBOARD, 0,
+                    KeyEvent.FLAG_FROM_SYSTEM | KeyEvent.FLAG_VIRTUAL_HARD_KEY,
+                    InputDevice.SOURCE_KEYBOARD);
+            InputManager.getInstance().injectInputEvent(ev,
+                    InputManager.INJECT_INPUT_EVENT_MODE_ASYNC);
+        }
+    }
+
+    // Apps as the user went through them with long swipes: Recents reorders
+    // with every switch, so going back and forth needs the order from before.
+    private final List<Integer> mSwitchOrder = new ArrayList<>();
+    private int mSwitchPos;
+
+    private void switchApp(boolean toPrevious) {
+        ActivityManagerWrapper am = ActivityManagerWrapper.getInstance();
+        ActivityManager.RunningTaskInfo running = am.getRunningTask();
+        int current = running != null ? running.id : -1;
+        boolean continuing = mSwitchPos >= 0 && mSwitchPos < mSwitchOrder.size()
+                && mSwitchOrder.get(mSwitchPos) == current;
+        if (!continuing) {
+            mSwitchOrder.clear();
+            for (ActivityManager.RecentTaskInfo t : am.getRecentTasks(
+                    ActivityManager.getMaxRecentTasksStatic(), ActivityManager.getCurrentUser())) {
+                mSwitchOrder.add(t.persistentId);
+            }
+            // -1 on the home screen, which is not in Recents: "previous" is
+            // then the app used last.
+            mSwitchPos = mSwitchOrder.indexOf(current);
+        }
+        int target = mSwitchPos + (toPrevious ? 1 : -1);
+        if (target < 0 || target >= mSwitchOrder.size()) {
+            return;
+        }
+        ActivityOptions options = ActivityOptions.makeCustomAnimation(mContext,
+                toPrevious ? R.anim.edge_in_from_left : R.anim.edge_in_from_right,
+                toPrevious ? R.anim.edge_out_to_right : R.anim.edge_out_to_left);
+        if (am.startActivityFromRecents(mSwitchOrder.get(target), options)) {
+            mSwitchPos = target;
+        } else {
+            // Removed from Recents since: start over next time.
+            mSwitchOrder.clear();
+        }
+    }
+}
