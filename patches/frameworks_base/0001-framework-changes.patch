+package com.android.systemui.qs.tiles;
+
+import android.app.UiModeManager;
+import android.content.Context;
+import android.database.ContentObserver;
+import android.os.UserHandle;
+
+import lineageos.providers.LineageSettings;
+import lineageos.style.StyleInterface;
+
+/**
+ * The system style as light and dark: the dark theme tile and the button beside the
+ * brightness read and set it here, for the user in front (SystemUI serves every user).
+ */
+public final class DarkStyle {
+    private DarkStyle() {}
+
+    private static int style(Context context) {
+        return LineageSettings.System.getIntForUser(context.getContentResolver(),
+                LineageSettings.System.BERRY_GLOBAL_STYLE,
+                StyleInterface.STYLE_GLOBAL_AUTO_WALLPAPER, UserHandle.USER_CURRENT);
+    }
+
+    /** Light or dark set by hand, not following the wallpaper or the time of day. */
+    public static boolean isFixed(Context context) {
+        final int style = style(context);
+        return style == StyleInterface.STYLE_GLOBAL_LIGHT
+                || style == StyleInterface.STYLE_GLOBAL_DARK;
+    }
+
+    public static boolean isDark(Context context) {
+        if (isFixed(context)) {
+            return style(context) == StyleInterface.STYLE_GLOBAL_DARK;
+        }
+        // Automatic: what StatusBar last applied, through the night mode.
+        final UiModeManager uiMode = context.getSystemService(UiModeManager.class);
+        return uiMode != null && uiMode.getNightMode() == UiModeManager.MODE_NIGHT_YES;
+    }
+
+    /**
+     * Dark or light by hand. An app that set the style before no longer holds it: the style
+     * settings would otherwise show it as managed by that app.
+     */
+    public static void set(Context context, boolean dark) {
+        LineageSettings.System.putIntForUser(context.getContentResolver(),
+                LineageSettings.System.BERRY_GLOBAL_STYLE, dark
+                        ? StyleInterface.STYLE_GLOBAL_DARK : StyleInterface.STYLE_GLOBAL_LIGHT,
+                UserHandle.USER_CURRENT);
+        LineageSettings.System.putStringForUser(context.getContentResolver(),
+                LineageSettings.System.BERRY_MANAGED_BY_APP, "", UserHandle.USER_CURRENT);
+    }
+
+    /** Changes for any user: the observer looks again for the one in front. */
+    public static void observe(Context context, ContentObserver observer) {
+        context.getContentResolver().registerContentObserver(
+                LineageSettings.System.getUriFor(LineageSettings.System.BERRY_GLOBAL_STYLE),
+                false, observer, UserHandle.USER_ALL);
+    }
+}
