+package com.android.systemui.settings;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.res.ColorStateList;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.RippleDrawable;
+import android.provider.Settings;
+import android.util.AttributeSet;
+import android.view.HapticFeedbackConstants;
+import android.view.View;
+import android.widget.ImageView;
+
+import com.android.settingslib.Utils;
+import com.android.systemui.Dependency;
+import com.android.systemui.R;
+import com.android.systemui.plugins.ActivityStarter;
+
+/**
+ * ON-FireLOS: Settings, at the end of the brightness row beside the light/dark button. Drawn
+ * like that button while off: a quiet circle with the gear in the secondary text colour.
+ */
+public class SettingsButton extends ImageView implements View.OnClickListener {
+
+    private final GradientDrawable mCircle = new GradientDrawable();
+
+    public SettingsButton(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mCircle.setShape(GradientDrawable.OVAL);
+        setBackground(new RippleDrawable(ColorStateList.valueOf(
+                Utils.getColorAttr(context, android.R.attr.colorControlHighlight)), mCircle,
+                null));
+        setImageResource(R.drawable.ic_settings);
+        setScaleType(ScaleType.CENTER);
+        setContentDescription(context.getString(R.string.accessibility_quick_settings_settings));
+        setOnClickListener(this);
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        // As the light/dark button: the brightness row is also the brightness dialog's and
+        // the mirror shown while its slider is dragged.
+        if (!inQuickSettings()) {
+            setVisibility(GONE);
+            return;
+        }
+        update();
+    }
+
+    @Override
+    protected void onConfigurationChanged(android.content.res.Configuration newConfig) {
+        super.onConfigurationChanged(newConfig);
+        update();
+    }
+
+    private boolean inQuickSettings() {
+        for (android.view.ViewParent p = getParent(); p != null; p = p.getParent()) {
+            if (p instanceof com.android.systemui.qs.QSPanel) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void update() {
+        final Context context = getContext();
+        mCircle.setColor(Utils.getDisabled(context,
+                Utils.getColorAttr(context, android.R.attr.textColorTertiary)));
+        setImageTintList(ColorStateList.valueOf(Utils.getColorAttr(context,
+                android.R.attr.textColorSecondary)));
+    }
+
+    @Override
+    public void onClick(View view) {
+        performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY);
+        Dependency.get(ActivityStarter.class).postStartActivityDismissingKeyguard(
+                new Intent(Settings.ACTION_SETTINGS), 0);
+    }
+}
