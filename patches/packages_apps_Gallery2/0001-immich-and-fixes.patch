diff --git a/src/com/android/gallery3d/app/SectionPanel.java b/src/com/android/gallery3d/app/SectionPanel.java
new file mode 100644
index 0000000..5d788f0
--- /dev/null
+++ b/src/com/android/gallery3d/app/SectionPanel.java
@@ -0,0 +1,427 @@
+/*
+ * Copyright (C) 2026 ON-FireLOS
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.gallery3d.app;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.Outline;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.net.Uri;
+import android.os.Handler;
+import android.text.TextUtils;
+import android.text.format.DateUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewOutlineProvider;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import com.android.gallery3d.data.DataManager;
+import com.android.gallery3d.data.MediaItem;
+import com.android.gallery3d.data.MediaSet;
+import com.android.gallery3d.immich.ImmichBackupJob;
+import com.android.gallery3d.immich.ImmichConfig;
+import com.android.gallery3d.util.ThreadPool;
+
+import org.codeaurora.gallery.R;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * ON-FireLOS: what the section in the rail holds, one tap away. A tap on the
+ * rail's current section, at its top, slides this panel out beside the rail:
+ * the albums with their covers and counts, for Immich its albums and how the
+ * backup stands, for videos the ones left halfway. It lies over the content
+ * rather than pushing it aside, so the grid behind it stays as it is; a tap
+ * outside, back, or the section again closes it.
+ */
+public class SectionPanel extends FrameLayout {
+    /** What a choice in the panel opens. */
+    public interface Opener {
+        void openAlbum(String path);
+
+        void openVideo(Uri uri, String title, long position);
+    }
+
+    private static final int WIDTH_DP = 300;
+    private static final int MAX_ALBUMS = 60;
+    private static final int MAX_VIDEOS = 12;
+
+    private final GalleryActivity mActivity;
+    private final Opener mOpener;
+    private final Handler mHandler = new Handler();
+    private final View mScrim;
+    private final ScrollView mCard;
+    private final LinearLayout mList;
+    private final int mStrong;
+    private final int mQuiet;
+    private int mSection = -1;
+    private final List<com.android.gallery3d.util.Future<?>> mJobs = new ArrayList<>();
+    // Results of a load the panel has been closed or changed since go nowhere.
+    private int mGeneration;
+
+    public SectionPanel(GalleryActivity activity, Opener opener) {
+        super(activity);
+        mActivity = activity;
+        mOpener = opener;
+        mStrong = activity.getColor(R.color.gallery_bar_foreground);
+        mQuiet = (mStrong & 0x00FFFFFF) | 0x99000000;
+        setElevation(dp(16));
+        setVisibility(GONE);
+
+        mScrim = new View(activity);
+        mScrim.setBackgroundColor(0x66000000);
+        mScrim.setOnClickListener(v -> close());
+        addView(mScrim, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+
+        mCard = new ScrollView(activity);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(activity.getColor(R.color.gallery_bar_background));
+        float r = dp(24);
+        bg.setCornerRadii(new float[] {0, 0, r, r, r, r, 0, 0});
+        mCard.setBackground(bg);
+        mCard.setElevation(dp(8));
+        mCard.setClipToPadding(false);
+        mList = new LinearLayout(activity);
+        mList.setOrientation(LinearLayout.VERTICAL);
+        // Clear of the status bar the gallery draws under.
+        mList.setPadding(dp(12), dp(40), dp(12), dp(24));
+        mCard.addView(mList, new ScrollView.LayoutParams(LayoutParams.MATCH_PARENT,
+                LayoutParams.WRAP_CONTENT));
+        addView(mCard, new LayoutParams(dp(WIDTH_DP), LayoutParams.MATCH_PARENT,
+                Gravity.START));
+    }
+
+    public boolean isOpen() {
+        return mSection >= 0;
+    }
+
+    public int section() {
+        return mSection;
+    }
+
+    /** Slides out with what the section holds. */
+    public void open(int section) {
+        cancelJobs();
+        mSection = section;
+        int generation = ++mGeneration;
+        mList.removeAllViews();
+        mList.addView(heading(title(section)));
+        if (section == 2) {
+            continueWatching();
+        } else {
+            if (section == NavRail.IMMICH) {
+                backupStatus();
+            }
+            loadAlbums(section, generation);
+        }
+        setVisibility(VISIBLE);
+        mCard.setTranslationX(-dp(WIDTH_DP));
+        mScrim.setAlpha(0);
+        mCard.animate().translationX(0).setDuration(220).start();
+        mScrim.animate().alpha(1).setDuration(220).start();
+    }
+
+    public void close() {
+        if (mSection < 0) {
+            return;
+        }
+        mSection = -1;
+        mGeneration++;
+        cancelJobs();
+        mCard.animate().translationX(-dp(WIDTH_DP)).setDuration(180).start();
+        mScrim.animate().alpha(0).setDuration(180).withEndAction(() -> {
+            if (mSection < 0) {
+                setVisibility(GONE);
+                // The covers go with the rows.
+                mList.removeAllViews();
+            }
+        }).start();
+    }
+
+    /** Stops what is still loading (also when the gallery goes). */
+    public void cancelJobs() {
+        for (com.android.gallery3d.util.Future<?> f : mJobs) {
+            f.cancel();
+        }
+        mJobs.clear();
+    }
+
+    private String title(int section) {
+        int res = section == NavRail.IMMICH ? R.string.immich_title
+                : section == 2 ? R.string.panel_continue : R.string.albums_title;
+        return mActivity.getString(res);
+    }
+
+    // Albums
+
+    private static final class Album {
+        String path;
+        String name;
+        int count;
+        MediaItem cover;
+    }
+
+    private void loadAlbums(int section, int generation) {
+        TextView wait = detail(mActivity.getString(R.string.loading));
+        mList.addView(wait);
+        final String rootPath = section == NavRail.IMMICH ? "/immich/all"
+                : mActivity.getDataManager().getTopSetPath(DataManager.INCLUDE_ALL);
+        mJobs.add(mActivity.getThreadPool().submit(jc -> readAlbums(rootPath, jc),
+                future -> mHandler.post(() -> {
+                    if (generation != mGeneration) {
+                        return;
+                    }
+                    mList.removeView(wait);
+                    List<Album> albums = future.get();
+                    if (albums == null || albums.isEmpty()) {
+                        mList.addView(detail(mActivity.getString(R.string.empty_album)));
+                        return;
+                    }
+                    for (Album a : albums) {
+                        addAlbum(a, generation);
+                    }
+                })));
+    }
+
+    // On a pool thread. The album sets load in the background; the section's
+    // own page has usually done so already, else wait for it a little.
+    private List<Album> readAlbums(String rootPath, ThreadPool.JobContext jc) {
+        DataManager manager = mActivity.getDataManager();
+        MediaSet root = manager.getMediaSet(rootPath);
+        if (root == null) {
+            return null;
+        }
+        List<Album> albums = new ArrayList<>();
+        for (int tries = 0; tries < 15 && !jc.isCancelled(); tries++) {
+            synchronized (DataManager.LOCK) {
+                root.reload();
+            }
+            if (root.getSubMediaSetCount() > 0 && !root.isLoading()) {
+                break;
+            }
+            try {
+                Thread.sleep(200);
+            } catch (InterruptedException e) {
+                return null;
+            }
+            if (jc.isCancelled()) {
+                return null;
+            }
+        }
+        int n = Math.min(root.getSubMediaSetCount(), MAX_ALBUMS);
+        for (int i = 0; i < n && !jc.isCancelled(); i++) {
+            MediaSet set = root.getSubMediaSet(i);
+            if (set == null) {
+                continue;
+            }
+            Album a = new Album();
+            synchronized (DataManager.LOCK) {
+                set.reload();
+            }
+            a.path = set.getPath().toString();
+            a.name = set.getName();
+            a.count = set.getMediaItemCount();
+            a.cover = set.getCoverMediaItem();
+            albums.add(a);
+        }
+        return albums;
+    }
+
+    private void addAlbum(Album a, int generation) {
+        ImageView thumb = new ImageView(mActivity);
+        thumb.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        GradientDrawable placeholder = new GradientDrawable();
+        placeholder.setColor((mStrong & 0x00FFFFFF) | 0x1F000000);
+        thumb.setBackground(placeholder);
+        thumb.setOutlineProvider(new ViewOutlineProvider() {
+            @Override
+            public void getOutline(View view, Outline outline) {
+                outline.setRoundRect(0, 0, view.getWidth(), view.getHeight(), dp(12));
+            }
+        });
+        thumb.setClipToOutline(true);
+        View row = row(thumb, a.name, java.text.NumberFormat.getInstance().format(a.count));
+        row.setOnClickListener(v -> {
+            close();
+            mOpener.openAlbum(a.path);
+        });
+        mList.addView(row);
+        if (a.cover != null && generation == mGeneration) {
+            final int rotation = a.cover.getRotation();
+            mJobs.add(mActivity.getThreadPool().submit(
+                    a.cover.requestImage(MediaItem.TYPE_MICROTHUMBNAIL),
+                    future -> {
+                        Bitmap b = future.get();
+                        mHandler.post(() -> {
+                            if (generation == mGeneration && b != null) {
+                                thumb.setImageBitmap(b);
+                                thumb.setRotation(rotation);
+                            }
+                        });
+                    }));
+        }
+    }
+
+    // Immich
+
+    private void backupStatus() {
+        SharedPreferences prefs = ImmichConfig.prefs(mActivity);
+        if (!prefs.getBoolean(ImmichConfig.KEY_BACKUP, false)) {
+            return;
+        }
+        long last = prefs.getLong(ImmichBackupJob.KEY_LAST_RUN, 0);
+        String status;
+        if (last > 0) {
+            String[] r = prefs.getString(ImmichBackupJob.KEY_LAST_RESULT, "0/0/0").split("/");
+            status = mActivity.getString(R.string.immich_backup_last,
+                    DateUtils.getRelativeTimeSpanString(last), r[0], r.length > 2 ? r[2] : "0");
+        } else {
+            status = mActivity.getString(R.string.immich_backup_waiting);
+        }
+        mList.addView(detail(status));
+        TextView now = new TextView(mActivity);
+        now.setText(R.string.panel_back_up_now);
+        now.setTextColor(mActivity.getColor(R.color.accent));
+        now.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        now.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
+        now.setPadding(dp(12), dp(10), dp(12), dp(14));
+        now.setBackgroundResource(ripple());
+        now.setOnClickListener(v -> {
+            ImmichBackupJob.runNow(mActivity);
+            now.setEnabled(false);
+            now.setAlpha(0.5f);
+        });
+        mList.addView(now, new LinearLayout.LayoutParams(LayoutParams.WRAP_CONTENT,
+                LayoutParams.WRAP_CONTENT));
+    }
+
+    // Videos left halfway, newest first, as the player keeps them.
+
+    private void continueWatching() {
+        SharedPreferences prefs = mActivity.getSharedPreferences("video_positions",
+                Context.MODE_PRIVATE);
+        List<Map.Entry<String, Long>> left = new ArrayList<>();
+        for (Map.Entry<String, ?> e : prefs.getAll().entrySet()) {
+            if (e.getKey().endsWith(".t") && e.getValue() instanceof Long) {
+                String key = e.getKey().substring(0, e.getKey().length() - 2);
+                if (prefs.getString(key + ".u", null) != null) {
+                    left.add(new java.util.AbstractMap.SimpleEntry<>(key, (Long) e.getValue()));
+                }
+            }
+        }
+        Collections.sort(left, (a, b) -> Long.compare(b.getValue(), a.getValue()));
+        if (left.isEmpty()) {
+            mList.addView(detail(mActivity.getString(R.string.panel_no_videos)));
+            return;
+        }
+        for (int i = 0; i < Math.min(left.size(), MAX_VIDEOS); i++) {
+            String key = left.get(i).getKey();
+            Uri uri = Uri.parse(prefs.getString(key + ".u", ""));
+            String title = prefs.getString(key + ".n", "");
+            long position = prefs.getLong(key, 0);
+            ImageView icon = new ImageView(mActivity);
+            icon.setImageResource(R.drawable.ic_player_play);
+            icon.setImageTintList(android.content.res.ColorStateList.valueOf(mStrong));
+            icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE);
+            icon.setPadding(dp(12), dp(12), dp(12), dp(12));
+            GradientDrawable round = new GradientDrawable();
+            round.setCornerRadius(dp(12));
+            round.setColor((mStrong & 0x00FFFFFF) | 0x1F000000);
+            icon.setBackground(round);
+            View row = row(icon, TextUtils.isEmpty(title) ? uri.getLastPathSegment() : title,
+                    mActivity.getString(R.string.panel_at,
+                            DateUtils.formatElapsedTime(position / 1000)));
+            row.setOnClickListener(v -> {
+                close();
+                mOpener.openVideo(uri, title, position);
+            });
+            mList.addView(row);
+        }
+    }
+
+    // Views
+
+    private View row(ImageView thumb, String name, String detail) {
+        LinearLayout row = new LinearLayout(mActivity);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setPadding(dp(12), dp(8), dp(12), dp(8));
+        row.setBackgroundResource(ripple());
+        row.addView(thumb, new LinearLayout.LayoutParams(dp(56), dp(56)));
+        LinearLayout text = new LinearLayout(mActivity);
+        text.setOrientation(LinearLayout.VERTICAL);
+        text.setPadding(dp(16), 0, 0, 0);
+        TextView title = new TextView(mActivity);
+        title.setText(name);
+        title.setTextColor(mStrong);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+        title.setSingleLine(true);
+        title.setEllipsize(TextUtils.TruncateAt.END);
+        text.addView(title);
+        TextView sub = new TextView(mActivity);
+        sub.setText(detail);
+        sub.setTextColor(mQuiet);
+        sub.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
+        sub.setSingleLine(true);
+        text.addView(sub);
+        row.addView(text, new LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1));
+        row.setLayoutParams(new LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT,
+                LayoutParams.WRAP_CONTENT));
+        return row;
+    }
+
+    private TextView heading(String text) {
+        TextView t = new TextView(mActivity);
+        t.setText(text);
+        t.setTextColor(mStrong);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 22);
+        t.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
+        t.setPadding(dp(12), dp(8), dp(12), dp(16));
+        return t;
+    }
+
+    private TextView detail(String text) {
+        TextView t = new TextView(mActivity);
+        t.setText(text);
+        t.setTextColor(mQuiet);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        t.setPadding(dp(12), dp(4), dp(12), dp(8));
+        return t;
+    }
+
+    private int ripple() {
+        TypedValue v = new TypedValue();
+        mActivity.getTheme().resolveAttribute(android.R.attr.selectableItemBackground, v, true);
+        return v.resourceId;
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                getResources().getDisplayMetrics());
+    }
+}
