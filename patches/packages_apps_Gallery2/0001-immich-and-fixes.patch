+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.gallery3d.immich;
+
+import android.content.Context;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/**
+ * The few calls of Immich's REST API (2.x and 3.x; tested with 2.7.5) the
+ * gallery needs: albums, a page of assets, thumbnails, originals and uploads.
+ * Signs in with an API key in the x-api-key header. Every call blocks and
+ * belongs on a background thread.
+ */
+public final class ImmichClient {
+    public static final String THUMBNAIL = "thumbnail";
+    public static final String PREVIEW = "preview";
+    public static final String FULLSIZE = "fullsize";
+
+    private static final int CONNECT_TIMEOUT = 10_000;
+    private static final int READ_TIMEOUT = 30_000;
+
+    private final String mServer;
+    private final String mKey;
+    // Server's major version, asked once: 2.x wants device ids with uploads,
+    // 3.x dropped them.
+    private int mMajor = -1;
+
+    private ImmichClient(String server, String key) {
+        mServer = server;
+        mKey = key;
+    }
+
+    /** A client for the configured server, or null if none is set up. */
+    public static ImmichClient get(Context context) {
+        String server = ImmichConfig.server(context);
+        String key = ImmichConfig.apiKey(context);
+        return server != null && key != null ? new ImmichClient(server, key) : null;
+    }
+
+    public static ImmichClient forTest(String server, String key) {
+        return new ImmichClient(ImmichConfig.normalize(server), key.trim());
+    }
+
+    public String server() {
+        return mServer;
+    }
+
+    public String apiKey() {
+        return mKey;
+    }
+
+    /** Server version, e.g. "3.3.5". */
+    public String version() throws IOException {
+        JSONObject v = object(request("GET", "/api/server/version", null));
+        mMajor = v.optInt("major");
+        return v.optInt("major") + "." + v.optInt("minor") + "." + v.optInt("patch");
+    }
+
+    private int major() throws IOException {
+        if (mMajor < 0) {
+            version();
+        }
+        return mMajor;
+    }
+
+    /** The signed-in user's name and e-mail. */
+    public JSONObject me() throws IOException {
+        return object(request("GET", "/api/users/me", null));
+    }
+
+    /** Own and shared albums. */
+    public JSONArray albums() throws IOException {
+        return array(request("GET", "/api/albums", null));
+    }
+
+    /**
+     * One page of assets, newest first: of an album, or of the whole timeline
+     * when albumId is null. The result's "items" are AssetResponseDto; its
+     * "total" counts only this page, see timelineCount() and the album's
+     * assetCount for the whole.
+     */
+    public JSONObject assets(String albumId, int page, int size) throws IOException {
+        JSONObject body = new JSONObject();
+        try {
+            body.put("page", page);
+            body.put("size", size);
+            body.put("order", "desc");
+            // For the orientation: originals are turned as their EXIF says.
+            body.put("withExif", true);
+            if (albumId != null) {
+                body.put("albumIds", new JSONArray().put(albumId));
+            } else {
+                body.put("visibility", "timeline");
+            }
+        } catch (JSONException e) {
+            throw new IOException(e);
+        }
+        JSONObject result = object(request("POST", "/api/search/metadata", body.toString()));
+        JSONObject assets = result.optJSONObject("assets");
+        return assets != null ? assets : new JSONObject();
+    }
+
+    /** How many photos and videos the timeline holds (sum of its month buckets). */
+    public int timelineCount() throws IOException {
+        JSONArray buckets = array(request("GET", "/api/timeline/buckets?visibility=timeline", null));
+        int n = 0;
+        for (int i = 0; i < buckets.length(); i++) {
+            JSONObject b = buckets.optJSONObject(i);
+            if (b != null) {
+                n += b.optInt("count");
+            }
+        }
+        return n;
+    }
+
+    /** A rendition of an asset as bytes: thumbnail (~250 px), preview (~1440 px), fullsize. */
+    public byte[] thumbnail(String id, String size) throws IOException {
+        HttpURLConnection c = open("GET", "/api/assets/" + id + "/thumbnail?size=" + size);
+        try (InputStream in = check(c)) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream(64 * 1024);
+            copy(in, out);
+            return out.toByteArray();
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    /**
+     * Downloads the original, or the full-size rendition, to a file. Each
+     * download writes a file of its own and renames it when complete, so two
+     * at once for the same picture cannot mix their bytes.
+     */
+    public void download(String id, boolean original, File file,
+            java.util.function.BooleanSupplier cancelled) throws IOException {
+        String path = original ? "/api/assets/" + id + "/original"
+                : "/api/assets/" + id + "/thumbnail?size=" + FULLSIZE;
+        File part = File.createTempFile(file.getName() + ".", ".part", file.getParentFile());
+        boolean done = false;
+        HttpURLConnection c = open("GET", path);
+        try (InputStream in = check(c); OutputStream out = new FileOutputStream(part)) {
+            byte[] buf = new byte[32 * 1024];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                if (cancelled.getAsBoolean()) {
+                    throw new IOException("cancelled");
+                }
+                out.write(buf, 0, n);
+            }
+            done = true;
+        } finally {
+            c.disconnect();
+            if (!done) {
+                part.delete();
+            }
+        }
+        if (!part.renameTo(file)) {
+            part.delete();
+            throw new IOException("rename failed");
+        }
+    }
+
+    /** The header a player needs for a video on the configured server; else null. */
+    public static java.util.Map<String, String> headersFor(Context context, android.net.Uri uri) {
+        String server = ImmichConfig.server(context);
+        if (uri == null || server == null || !uri.toString().startsWith(server + "/api/")) {
+            return null;
+        }
+        String key = ImmichConfig.apiKey(context);
+        if (key == null) {
+            return null;
+        }
+        java.util.Map<String, String> headers = new java.util.HashMap<>();
+        headers.put("x-api-key", key);
+        return headers;
+    }
+
+    public String playbackUrl(String id) {
+        return mServer + "/api/assets/" + id + "/video/playback";
+    }
+
+    /**
+     * Which of these files the server has already: sends id/checksum pairs
+     * (SHA-1, base64) and returns the ids it would take.
+     */
+    public JSONArray bulkUploadCheck(JSONArray items) throws IOException {
+        JSONObject body = new JSONObject();
+        try {
+            body.put("assets", items);
+        } catch (JSONException e) {
+            throw new IOException(e);
+        }
+        JSONObject result = object(request("POST", "/api/assets/bulk-upload-check",
+                body.toString()));
+        JSONArray results = result.optJSONArray("results");
+        return results != null ? results : new JSONArray();
+    }
+
+    /**
+     * Uploads one file; returns "created" or "duplicate". deviceAssetId names
+     * the file on this device (for 2.x servers, which require it).
+     */
+    public String upload(File file, String name, String mimeType, long created, long modified,
+            String sha1Base64, String deviceAssetId, ProgressListener progress)
+            throws IOException {
+        boolean deviceIds = major() < 3;
+        String boundary = "----immich" + Long.toHexString(System.nanoTime());
+        HttpURLConnection c = open("POST", "/api/assets");
+        c.setDoOutput(true);
+        c.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
+        if (sha1Base64 != null) {
+            c.setRequestProperty("x-immich-checksum", sha1Base64);
+        }
+        StringBuilder head = new StringBuilder();
+        if (deviceIds) {
+            field(head, boundary, "deviceAssetId", deviceAssetId);
+            field(head, boundary, "deviceId", "ON-FireLOS-" + android.os.Build.DEVICE);
+        }
+        field(head, boundary, "fileCreatedAt", iso(created));
+        field(head, boundary, "fileModifiedAt", iso(modified));
+        field(head, boundary, "filename", name);
+        head.append("--").append(boundary).append("\r\n")
+                .append("Content-Disposition: form-data; name=\"assetData\"; filename=\"")
+                .append(name.replace("\"", "")).append("\"\r\n")
+                .append("Content-Type: ").append(mimeType).append("\r\n\r\n");
+        byte[] headBytes = head.toString().getBytes(StandardCharsets.UTF_8);
+        byte[] tail = ("\r\n--" + boundary + "--\r\n").getBytes(StandardCharsets.UTF_8);
+        long length = file.length();
+        c.setFixedLengthStreamingMode(headBytes.length + length + tail.length);
+        try (OutputStream out = c.getOutputStream();
+                InputStream in = new java.io.FileInputStream(file)) {
+            out.write(headBytes);
+            byte[] buf = new byte[64 * 1024];
+            long sent = 0;
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                out.write(buf, 0, n);
+                sent += n;
+                if (progress != null) {
+                    progress.onProgress(sent, length);
+                }
+            }
+            out.write(tail);
+        }
+        try (InputStream in = check(c)) {
+            JSONObject r = object(readAll(in));
+            return r.optString("status", "created");
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    public interface ProgressListener {
+        void onProgress(long done, long total);
+    }
+
+    // HTTP
+
+    private HttpURLConnection open(String method, String path) throws IOException {
+        return openUrl(method, new URL(mServer + path));
+    }
+
+    private HttpURLConnection openUrl(String method, URL url) throws IOException {
+        HttpURLConnection c = (HttpURLConnection) url.openConnection();
+        // Redirects are followed by hand, and only within this server: the
+        // platform would otherwise send the API key header along to any host.
+        c.setInstanceFollowRedirects(false);
+        c.setRequestMethod(method);
+        c.setConnectTimeout(CONNECT_TIMEOUT);
+        c.setReadTimeout(READ_TIMEOUT);
+        c.setRequestProperty("x-api-key", mKey);
+        c.setRequestProperty("Accept", "application/json, */*");
+        c.setRequestProperty("User-Agent", "ON-FireLOS-Gallery");
+        return c;
+    }
+
+    private String request(String method, String path, String json) throws IOException {
+        HttpURLConnection c = open(method, path);
+        try {
+            if (json != null) {
+                byte[] body = json.getBytes(StandardCharsets.UTF_8);
+                c.setDoOutput(true);
+                c.setRequestProperty("Content-Type", "application/json");
+                c.setFixedLengthStreamingMode(body.length);
+                try (OutputStream out = c.getOutputStream()) {
+                    out.write(body);
+                }
+            }
+            try (InputStream in = check(c)) {
+                return readAll(in);
+            }
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    // GET responses that redirect within the server (e.g. "fullsize" to the
+    // original when the server keeps no extra copy) are followed here.
+    private InputStream check(HttpURLConnection c) throws IOException {
+        for (int hops = 0; ; hops++) {
+            int code = c.getResponseCode();
+            if (code < 300 || code >= 400 || hops >= 3
+                    || !"GET".equals(c.getRequestMethod())) {
+                return checkStatus(c);
+            }
+            String location = c.getHeaderField("Location");
+            URL next = location != null ? new URL(c.getURL(), location) : null;
+            URL base = new URL(mServer);
+            if (next == null || !next.getProtocol().equals(base.getProtocol())
+                    || !next.getHost().equalsIgnoreCase(base.getHost())
+                    || next.getPort() != base.getPort()) {
+                c.disconnect();
+                throw new IOException("redirect off the server refused");
+            }
+            c.disconnect();
+            c = openUrl("GET", next);
+        }
+    }
+
+    private static InputStream checkStatus(HttpURLConnection c) throws IOException {
+        int code = c.getResponseCode();
+        if (code == 401 || code == 403) {
+            throw new AuthException(code);
+        }
+        if (code < 200 || code >= 300) {
+            // The server's message, for the log; a few hundred bytes suffice.
+            String detail = "";
+            try (InputStream err = c.getErrorStream()) {
+                if (err != null) {
+                    byte[] buf = new byte[512];
+                    int n = err.read(buf);
+                    detail = n > 0 ? new String(buf, 0, n, StandardCharsets.UTF_8) : "";
+                }
+            } catch (IOException ignored) {
+            }
+            throw new HttpException(code, detail);
+        }
+        return c.getInputStream();
+    }
+
+    /** Wrong or revoked API key. */
+    public static final class AuthException extends IOException {
+        AuthException(int code) {
+            super("HTTP " + code);
+        }
+    }
+
+    /** Any other status outside 2xx. */
+    public static final class HttpException extends IOException {
+        public final int code;
+
+        HttpException(int code, String detail) {
+            super("HTTP " + code + " " + detail);
+            this.code = code;
+        }
+
+        /** True if trying again later can help (server trouble, overload). */
+        public boolean isTransient() {
+            return code >= 500 || code == 408 || code == 429;
+        }
+    }
+
+    private static String readAll(InputStream in) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        copy(in, out);
+        return out.toString("UTF-8");
+    }
+
+    private static void copy(InputStream in, OutputStream out) throws IOException {
+        byte[] buf = new byte[32 * 1024];
+        int n;
+        while ((n = in.read(buf)) > 0) {
+            out.write(buf, 0, n);
+        }
+    }
+
+    private static JSONObject object(String s) throws IOException {
+        try {
+            return new JSONObject(s);
+        } catch (JSONException e) {
+            throw new IOException("bad JSON", e);
+        }
+    }
+
+    private static JSONArray array(String s) throws IOException {
+        try {
+            return new JSONArray(s);
+        } catch (JSONException e) {
+            throw new IOException("bad JSON", e);
+        }
+    }
+
+    private static void field(StringBuilder b, String boundary, String name, String value) {
+        b.append("--").append(boundary).append("\r\n")
+                .append("Content-Disposition: form-data; name=\"").append(name).append("\"\r\n\r\n")
+                .append(value).append("\r\n");
+    }
+
+    public static String iso(long ms) {
+        SimpleDateFormat f = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US);
+        f.setTimeZone(TimeZone.getTimeZone("UTC"));
+        return f.format(new Date(ms));
+    }
+
+    /** Parses Immich's ISO dates ("2026-11-03T10:20:30.000Z"); 0 if unreadable. */
+    public static long parseDate(String s) {
+        if (s == null || s.length() < 19) {
+            return 0;
+        }
+        try {
+            SimpleDateFormat f = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss", Locale.US);
+            f.setTimeZone(TimeZone.getTimeZone("UTC"));
+            return f.parse(s.substring(0, 19)).getTime();
+        } catch (java.text.ParseException e) {
+            return 0;
+        }
+    }
+}
diff --git a/src/com/android/gallery3d/immich/ImmichConfig.java b/src/com/android/gallery3d/immich/ImmichConfig.java
new file mode 100644
index 0000000..b88a110
--- /dev/null
+++ b/src/com/android/gallery3d/immich/ImmichConfig.java
@@ -0,0 +1,225 @@
+/*
+ * Copyright (C) 2026 ON-FireLOS
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.gallery3d.immich;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+import android.text.TextUtils;
+import android.util.Base64;
+import android.util.Log;
+
+import java.nio.charset.StandardCharsets;
+import java.security.KeyStore;
+
+import javax.crypto.Cipher;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+
+/**
+ * Where the Immich server is and how to sign in to it. The API key is kept
+ * encrypted with a key that never leaves the Android keystore: /data is not
+ * encrypted on this device, so a plain key in the preferences could be read
+ * by anyone with the tablet and a recovery.
+ */
+public final class ImmichConfig {
+    private static final String TAG = "ImmichConfig";
+    private static final String PREFS = "immich";
+    private static final String KEY_SERVER = "server";
+    private static final String KEY_API_KEY = "api_key";
+    public static final String KEY_SHOW = "show_in_gallery";
+    public static final String KEY_BACKUP = "backup";
+    public static final String KEY_BACKUP_WIFI = "backup_wifi_only";
+    public static final String KEY_BACKUP_CHARGING = "backup_charging_only";
+    public static final String KEY_BACKUP_SINCE = "backup_since";
+    private static final String KEYSTORE = "AndroidKeyStore";
+    private static final String ALIAS = "immich_api_key";
+
+    // Bumped whenever the server or key changes, so what was loaded from the
+    // old one is loaded again.
+    private static volatile long sVersion = 1;
+
+    private ImmichConfig() {
+    }
+
+    public static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public static long version() {
+        return sVersion;
+    }
+
+    public static void changed() {
+        sVersion++;
+    }
+
+    /** The server's base address without a trailing slash, or null. */
+    public static String server(Context context) {
+        String s = prefs(context).getString(KEY_SERVER, null);
+        return TextUtils.isEmpty(s) ? null : s;
+    }
+
+    // The key decrypted once per stored value: every thumbnail asks for it,
+    // and each keystore round trip is a binder call. A failure is not
+    // remembered (the keystore may only be busy), only reported once.
+    private static String sStoredKey;
+    private static String sKey;
+    private static volatile boolean sWarned;
+
+    public static String apiKey(Context context) {
+        String stored = prefs(context).getString(KEY_API_KEY, null);
+        if (TextUtils.isEmpty(stored)) {
+            return null;
+        }
+        synchronized (ImmichConfig.class) {
+            if (stored.equals(sStoredKey)) {
+                return sKey;
+            }
+        }
+        String key = null;
+        try {
+            byte[] all = Base64.decode(stored, Base64.NO_WRAP);
+            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+            cipher.init(Cipher.DECRYPT_MODE, key(), new GCMParameterSpec(128, all, 0, 12));
+            key = new String(cipher.doFinal(all, 12, all.length - 12), StandardCharsets.UTF_8);
+        } catch (Exception e) {
+            if (!sWarned) {
+                sWarned = true;
+                Log.w(TAG, "API key unreadable: " + e);
+            }
+            return null;
+        }
+        synchronized (ImmichConfig.class) {
+            sStoredKey = stored;
+            sKey = key;
+        }
+        return key;
+    }
+
+    public static boolean isConfigured(Context context) {
+        return server(context) != null && apiKey(context) != null;
+    }
+
+    public static boolean showInGallery(Context context) {
+        return prefs(context).getBoolean(KEY_SHOW, true) && isConfigured(context);
+    }
+
+    /** Stores server and key; an empty key keeps the one stored. */
+    public static void save(Context context, String server, String apiKey) {
+        SharedPreferences.Editor e = prefs(context).edit();
+        e.putString(KEY_SERVER, normalize(server));
+        if (!TextUtils.isEmpty(apiKey)) {
+            try {
+                Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+                cipher.init(Cipher.ENCRYPT_MODE, key());
+                byte[] iv = cipher.getIV();
+                byte[] data = cipher.doFinal(apiKey.trim().getBytes(StandardCharsets.UTF_8));
+                byte[] all = new byte[iv.length + data.length];
+                System.arraycopy(iv, 0, all, 0, iv.length);
+                System.arraycopy(data, 0, all, iv.length, data.length);
+                e.putString(KEY_API_KEY, Base64.encodeToString(all, Base64.NO_WRAP));
+            } catch (Exception ex) {
+                Log.e(TAG, "cannot store API key", ex);
+            }
+        }
+        e.apply();
+        changed();
+    }
+
+    /**
+     * Signs out: the key and its keystore key go, and with them everything
+     * fetched from the server - originals and thumbnails - so no picture of
+     * it stays on the tablet.
+     */
+    public static void forget(Context context) {
+        prefs(context).edit().remove(KEY_SERVER).remove(KEY_API_KEY).apply();
+        synchronized (ImmichConfig.class) {
+            sStoredKey = null;
+            sKey = null;
+        }
+        try {
+            KeyStore store = KeyStore.getInstance(KEYSTORE);
+            store.load(null);
+            store.deleteEntry(ALIAS);
+        } catch (Exception e) {
+            Log.w(TAG, "keystore", e);
+        }
+        java.io.File cache = context.getCacheDir();
+        deleteTree(new java.io.File(cache, "immich"));
+        deleteTree(new java.io.File(cache, "immich-upload"));
+        // The thumbnail cache holds local and remote pictures in one file; it
+        // is rebuilt from the device's photos as they are shown.
+        java.io.File[] files = cache.listFiles();
+        for (int i = 0; files != null && i < files.length; i++) {
+            if (files[i].getName().startsWith("imgcache")) {
+                files[i].delete();
+            }
+        }
+        changed();
+    }
+
+    static void deleteTree(java.io.File f) {
+        java.io.File[] children = f.listFiles();
+        for (int i = 0; children != null && i < children.length; i++) {
+            deleteTree(children[i]);
+        }
+        f.delete();
+    }
+
+    /** True if the server is reached without encryption. */
+    public static boolean isCleartext(String server) {
+        return server != null && server.startsWith("http://");
+    }
+
+    /** "immich.example:2283/" -> "https://immich.example:2283" */
+    public static String normalize(String server) {
+        if (server == null) {
+            return null;
+        }
+        String s = server.trim();
+        while (s.endsWith("/")) {
+            s = s.substring(0, s.length() - 1);
+        }
+        if (s.endsWith("/api")) {
+            s = s.substring(0, s.length() - 4);
+        }
+        if (!s.isEmpty() && !s.startsWith("http://") && !s.startsWith("https://")) {
+            s = "https://" + s;
+        }
+        return s;
+    }
+
+    private static SecretKey key() throws Exception {
+        KeyStore store = KeyStore.getInstance(KEYSTORE);
+        store.load(null);
+        KeyStore.Entry entry = store.getEntry(ALIAS, null);
+        if (entry instanceof KeyStore.SecretKeyEntry) {
+            return ((KeyStore.SecretKeyEntry) entry).getSecretKey();
+        }
+        KeyGenerator generator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, KEYSTORE);
+        generator.init(new KeyGenParameterSpec.Builder(ALIAS,
+                KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                .setKeySize(256)
+                .build());
+        return generator.generateKey();
+    }
+}
