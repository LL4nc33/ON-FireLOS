+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.gallery3d.player;
+
+import android.content.Context;
+import android.net.Uri;
+
+import com.android.gallery3d.immich.ImmichClient;
+import com.google.android.exoplayer2.C;
+import com.google.android.exoplayer2.upstream.BaseDataSource;
+import com.google.android.exoplayer2.upstream.DataSource;
+import com.google.android.exoplayer2.upstream.DataSpec;
+import com.google.android.exoplayer2.upstream.DefaultHttpDataSource;
+import com.google.android.exoplayer2.upstream.HttpDataSource;
+import com.google.android.exoplayer2.upstream.TransferListener;
+
+import java.io.EOFException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * HTTP for the player. Videos on the Immich server need the API key in a
+ * header; ExoPlayer's own HTTP source would send its headers to wherever a
+ * redirect points. So those go through a small source of their own that
+ * sends the key to the server only and follows redirects only within it;
+ * everything else takes ExoPlayer's source, without any key.
+ */
+final class SecureHttpDataSource implements DataSource {
+    private final Context mContext;
+    private final List<TransferListener> mListeners = new ArrayList<>();
+    private DataSource mDelegate;
+
+    static Factory factory(Context context) {
+        return () -> new SecureHttpDataSource(context.getApplicationContext());
+    }
+
+    private SecureHttpDataSource(Context context) {
+        mContext = context;
+    }
+
+    @Override
+    public void addTransferListener(TransferListener listener) {
+        mListeners.add(listener);
+    }
+
+    @Override
+    public long open(DataSpec dataSpec) throws IOException {
+        Map<String, String> headers = ImmichClient.headersFor(mContext, dataSpec.uri);
+        mDelegate = headers != null ? new ImmichSource(headers)
+                : new DefaultHttpDataSource.Factory()
+                        .setUserAgent("ON-FireLOS-Gallery")
+                        .setAllowCrossProtocolRedirects(false)
+                        .createDataSource();
+        for (TransferListener l : mListeners) {
+            mDelegate.addTransferListener(l);
+        }
+        return mDelegate.open(dataSpec);
+    }
+
+    @Override
+    public int read(byte[] buffer, int offset, int length) throws IOException {
+        return mDelegate.read(buffer, offset, length);
+    }
+
+    @Override
+    public Uri getUri() {
+        return mDelegate != null ? mDelegate.getUri() : null;
+    }
+
+    @Override
+    public Map<String, List<String>> getResponseHeaders() {
+        return mDelegate != null ? mDelegate.getResponseHeaders() : Collections.emptyMap();
+    }
+
+    @Override
+    public void close() throws IOException {
+        if (mDelegate != null) {
+            mDelegate.close();
+            mDelegate = null;
+        }
+    }
+
+    /** Ranged reads from the Immich server; its key goes nowhere else. */
+    private static final class ImmichSource extends BaseDataSource {
+        private final Map<String, String> mHeaders;
+        private HttpURLConnection mConnection;
+        private InputStream mIn;
+        private Uri mUri;
+        private long mRemaining;
+        private boolean mOpened;
+
+        ImmichSource(Map<String, String> headers) {
+            super(true);
+            mHeaders = headers;
+        }
+
+        @Override
+        public long open(DataSpec spec) throws IOException {
+            transferInitializing(spec);
+            URL url = new URL(spec.uri.toString());
+            String origin = origin(url);
+            for (int hops = 0; ; hops++) {
+                mConnection = (HttpURLConnection) url.openConnection();
+                mConnection.setInstanceFollowRedirects(false);
+                mConnection.setConnectTimeout(10_000);
+                mConnection.setReadTimeout(30_000);
+                for (Map.Entry<String, String> h : mHeaders.entrySet()) {
+                    mConnection.setRequestProperty(h.getKey(), h.getValue());
+                }
+                if (spec.position > 0 || spec.length != C.LENGTH_UNSET) {
+                    mConnection.setRequestProperty("Range", "bytes=" + spec.position + "-"
+                            + (spec.length != C.LENGTH_UNSET
+                                    ? String.valueOf(spec.position + spec.length - 1) : ""));
+                }
+                int code = mConnection.getResponseCode();
+                if (code >= 300 && code < 400 && hops < 3) {
+                    String location = mConnection.getHeaderField("Location");
+                    URL next = location != null ? new URL(url, location) : null;
+                    mConnection.disconnect();
+                    if (next == null || !origin(next).equals(origin)) {
+                        throw new IOException("redirect off the server refused");
+                    }
+                    url = next;
+                    continue;
+                }
+                if (code == 416 && spec.position > 0 && spec.position == total(mConnection)) {
+                    // Asked to read on at the very end (a retry): nothing left.
+                    mConnection.disconnect();
+                    mConnection = null;
+                    mRemaining = 0;
+                    mUri = Uri.parse(url.toString());
+                    mOpened = true;
+                    transferStarted(spec);
+                    return 0;
+                }
+                if (code != 200 && code != 206) {
+                    String message = mConnection.getResponseMessage();
+                    java.util.Map<String, List<String>> headers = mConnection.getHeaderFields();
+                    mConnection.disconnect();
+                    throw new HttpDataSource.InvalidResponseCodeException(code, message, null,
+                            headers, spec, new byte[0]);
+                }
+                mIn = mConnection.getInputStream();
+                long length = mConnection.getContentLengthLong();
+                if (code == 200 && spec.position > 0) {
+                    // The server ignored the range: skip to the position.
+                    long skip = spec.position;
+                    while (skip > 0) {
+                        long n = mIn.skip(skip);
+                        if (n <= 0) {
+                            throw new EOFException();
+                        }
+                        skip -= n;
+                    }
+                    if (length >= 0) {
+                        length -= spec.position;
+                    }
+                }
+                mRemaining = spec.length != C.LENGTH_UNSET ? spec.length
+                        : (length >= 0 ? length : C.LENGTH_UNSET);
+                mUri = Uri.parse(url.toString());
+                mOpened = true;
+                transferStarted(spec);
+                return mRemaining;
+            }
+        }
+
+        // The size after "bytes */" in a 416's Content-Range; -1 if absent.
+        private static long total(HttpURLConnection c) {
+            String range = c.getHeaderField("Content-Range");
+            int slash = range != null ? range.lastIndexOf('/') : -1;
+            try {
+                return slash >= 0 ? Long.parseLong(range.substring(slash + 1).trim()) : -1;
+            } catch (NumberFormatException e) {
+                return -1;
+            }
+        }
+
+        private static String origin(URL u) {
+            int port = u.getPort() != -1 ? u.getPort() : u.getDefaultPort();
+            return u.getProtocol() + "://" + u.getHost().toLowerCase() + ":" + port;
+        }
+
+        @Override
+        public int read(byte[] buffer, int offset, int length) throws IOException {
+            if (length == 0) {
+                return 0;
+            }
+            if (mRemaining == 0) {
+                return C.RESULT_END_OF_INPUT;
+            }
+            int max = mRemaining == C.LENGTH_UNSET ? length : (int) Math.min(length, mRemaining);
+            int n = mIn.read(buffer, offset, max);
+            if (n == -1) {
+                if (mRemaining != C.LENGTH_UNSET) {
+                    throw new EOFException();
+                }
+                return C.RESULT_END_OF_INPUT;
+            }
+            if (mRemaining != C.LENGTH_UNSET) {
+                mRemaining -= n;
+            }
+            bytesTransferred(n);
+            return n;
+        }
+
+        @Override
+        public Uri getUri() {
+            return mUri;
+        }
+
+        @Override
+        public void close() throws IOException {
+            try {
+                if (mIn != null) {
+                    mIn.close();
+                }
+            } finally {
+                mIn = null;
+                if (mConnection != null) {
+                    mConnection.disconnect();
+                    mConnection = null;
+                }
+                if (mOpened) {
+                    mOpened = false;
+                    transferEnded();
+                }
+            }
+        }
+    }
+}
