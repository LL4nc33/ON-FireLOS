+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.gallery3d.app;
+
+import android.animation.Animator;
+import android.animation.AnimatorListenerAdapter;
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.view.MotionEvent;
+import android.view.VelocityTracker;
+import android.view.ViewConfiguration;
+import android.view.animation.AccelerateInterpolator;
+import android.view.animation.DecelerateInterpolator;
+
+/**
+ * ON-FireLOS: a sideways swipe over a section switches to the one next to it in the rail, as the
+ * clock's tabs do - towards the left the next one down the rail, towards the right the one above.
+ * The page follows the finger part of the way and fades; let go far or fast enough, it slides
+ * out and the next section slides in from the side it was swiped from, otherwise it springs
+ * back. With no section on that side it gives a little and springs back. The pages are drawn
+ * with OpenGL on one surface, so this moves the page drawn rather than two views. Only at a
+ * section's top, not inside an album or photo (whose sideways swipes go on to the next
+ * picture), not while selecting and not with the side panel open: the host decides.
+ */
+final class SectionSwipe {
+
+    interface Host {
+        /** The section shown, or -1 when a swipe must not switch sections now. */
+        int swipeableSection();
+
+        /** The section one step on in the rail (+1 down, -1 up), or -1 if none. */
+        int neighbour(int section, int step);
+
+        void showSection(int section);
+
+        /** Draws the page moved sideways by x pixels, at the given opacity. */
+        void setContentShift(float x, float alpha);
+    }
+
+    /** What the activity does with the event. */
+    static final int PASS = 0;
+    static final int CONSUME = 1;
+    /** Consumed, and the swipe has just begun: the page's own gesture gets a cancel. */
+    static final int STARTED = 2;
+
+    private static final float FOLLOW = 0.4f;
+    private static final float RUBBER = 0.12f;
+
+    private final Host mHost;
+    private final int mSlop;
+    private final float mDensity;
+    private VelocityTracker mVelocity;
+    private ValueAnimator mAnimator;
+    private boolean mTracking;
+    private boolean mDragging;
+    private int mSection;
+    private float mDownX;
+    private float mDownY;
+    private float mShift;
+    private float mAlpha = 1f;
+
+    SectionSwipe(Context context, Host host) {
+        mHost = host;
+        mSlop = ViewConfiguration.get(context).getScaledTouchSlop();
+        mDensity = context.getResources().getDisplayMetrics().density;
+    }
+
+    int onTouch(MotionEvent event, int width) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mDragging = false;
+                if (mAnimator == null && (mShift != 0f || mAlpha != 1f)) {
+                    // Left moved by an animation the activity's pause cut short.
+                    apply(0f, 1f);
+                }
+                mSection = mAnimator == null ? mHost.swipeableSection() : -1;
+                mTracking = mSection >= 0;
+                if (!mTracking) return PASS;
+                mDownX = event.getX();
+                mDownY = event.getY();
+                if (mVelocity == null) mVelocity = VelocityTracker.obtain();
+                mVelocity.clear();
+                mVelocity.addMovement(event);
+                return PASS;
+
+            case MotionEvent.ACTION_POINTER_DOWN:
+                // Two fingers zoom the grid; only a swipe that already began goes on.
+                if (!mDragging) mTracking = false;
+                return mDragging ? CONSUME : PASS;
+
+            case MotionEvent.ACTION_MOVE: {
+                if (!mTracking) return PASS;
+                mVelocity.addMovement(event);
+                float dx = event.getX() - mDownX;
+                float dy = event.getY() - mDownY;
+                if (!mDragging) {
+                    if (Math.abs(dx) > mSlop && Math.abs(dx) > 1.5f * Math.abs(dy)) {
+                        mDragging = true;
+                        // Measured from here on, so the page does not jump by the slop.
+                        mDownX += Math.signum(dx) * mSlop;
+                        follow(event.getX() - mDownX, width);
+                        return STARTED;
+                    }
+                    if (Math.abs(dy) > mSlop) mTracking = false;
+                    return PASS;
+                }
+                follow(dx, width);
+                return CONSUME;
+            }
+
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL: {
+                if (!mDragging) {
+                    mTracking = false;
+                    return PASS;
+                }
+                mVelocity.addMovement(event);
+                mVelocity.computeCurrentVelocity(1000);
+                float dx = event.getX() - mDownX;
+                float vx = mVelocity.getXVelocity();
+                int target = mHost.neighbour(mSection, dx < 0 ? 1 : -1);
+                boolean far = Math.abs(dx) > 80 * mDensity;
+                boolean fast = Math.abs(vx) > 600 * mDensity && Math.signum(vx) == Math.signum(dx);
+                boolean back = Math.abs(vx) > 600 * mDensity && Math.signum(vx) != Math.signum(dx);
+                mDragging = false;
+                mTracking = false;
+                if (event.getActionMasked() == MotionEvent.ACTION_UP && target >= 0
+                        && (far || fast) && !back) {
+                    switchTo(target, Math.signum(dx), width);
+                } else {
+                    settle();
+                }
+                return CONSUME;
+            }
+
+            default:
+                return mDragging ? CONSUME : PASS;
+        }
+    }
+
+    private void follow(float dx, int width) {
+        boolean open = mHost.neighbour(mSection, dx < 0 ? 1 : -1) >= 0;
+        float shift = dx * (open ? FOLLOW : RUBBER);
+        float alpha = open ? 1f - 0.5f * Math.min(1f, Math.abs(dx) / (width * 0.5f)) : 1f;
+        apply(shift, alpha);
+    }
+
+    private void apply(float shift, float alpha) {
+        mShift = shift;
+        mAlpha = alpha;
+        mHost.setContentShift(shift, alpha);
+    }
+
+    /** Back into place. */
+    private void settle() {
+        animate(mShift, 0f, mAlpha, 1f, 200, new DecelerateInterpolator(2f), null);
+    }
+
+    /** Out to the side swiped towards, then the next section in from the other. */
+    private void switchTo(int target, float direction, int width) {
+        animate(mShift, direction * width * 0.25f, mAlpha, 0f, 110,
+                new AccelerateInterpolator(), () -> {
+                    mHost.showSection(target);
+                    animate(-direction * width * 0.15f, 0f, 0f, 1f, 260,
+                            new DecelerateInterpolator(2f), null);
+                });
+    }
+
+    private void animate(float fromShift, float toShift, float fromAlpha, float toAlpha,
+            long duration, android.animation.TimeInterpolator interpolator, Runnable then) {
+        if (mAnimator != null) mAnimator.cancel();
+        ValueAnimator animator = ValueAnimator.ofFloat(0f, 1f);
+        animator.setDuration(duration);
+        animator.setInterpolator(interpolator);
+        animator.addUpdateListener(a -> {
+            float f = (float) a.getAnimatedValue();
+            apply(fromShift + (toShift - fromShift) * f, fromAlpha + (toAlpha - fromAlpha) * f);
+        });
+        animator.addListener(new AnimatorListenerAdapter() {
+            private boolean mCancelled;
+
+            @Override
+            public void onAnimationCancel(Animator animation) {
+                mCancelled = true;
+            }
+
+            @Override
+            public void onAnimationEnd(Animator animation) {
+                if (mAnimator == animation) mAnimator = null;
+                if (mCancelled) return;
+                if (then != null) {
+                    then.run();
+                } else if (toShift == 0f && toAlpha == 1f) {
+                    apply(0f, 1f);
+                }
+            }
+        });
+        mAnimator = animator;
+        animator.start();
+    }
+}
