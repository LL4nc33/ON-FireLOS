+
+/**
+ * A photo or video on the Immich server. The grid and the photo view use the
+ * server's thumbnail (about 250 px) and preview (about 1440 px), cached on
+ * the device like local thumbnails; zooming in fetches the original - or,
+ * for formats Android 9 cannot open (HEIC, RAW), the full-size JPEG the
+ * server made of it - into a cache of at most 300 MB.
+ */
+public class ImmichItem extends MediaItem {
+    private static final String TAG = "ImmichItem";
+    private static final long CACHE_LIMIT = 300L * 1024 * 1024;
+
+    private final GalleryApp mApplication;
+    private final String mId;
+    private boolean mVideo;
+    private String mMimeType = "image/jpeg";
+    private int mWidth;
+    private int mHeight;
+    private long mDateMs;
+    private long mUpdatedMs;
+    private String mName = "";
+    private int mDurationS;
+    // EXIF orientation of the original in degrees. The server's thumbnails
+    // and previews come upright; the original is decoded as stored.
+    private int mOrientation;
+
+    ImmichItem(Path path, GalleryApp application, String id) {
+        super(path, nextVersionNumber());
+        mApplication = application;
+        mId = id;
+    }
+
+    static ImmichItem get(GalleryApp application, String id) {
+        Path path = Path.fromString("/immich/item/" + id);
+        synchronized (DataManager.LOCK) {
+            MediaObject object = application.getDataManager().peekMediaObject(path);
+            if (object instanceof ImmichItem) {
+                return (ImmichItem) object;
+            }
+            return new ImmichItem(path, application, id);
+        }
+    }
+
+    /** The item for an AssetResponseDto, with what the server says about it. */
+    static ImmichItem from(GalleryApp application, JSONObject a) {
+        ImmichItem item = get(application, a.optString("id"));
+        synchronized (item) {
+            item.mVideo = "VIDEO".equals(a.optString("type"));
+            item.mMimeType = a.optString("originalMimeType",
+                    item.mVideo ? "video/mp4" : "image/jpeg");
+            item.mWidth = a.optInt("width", 0);
+            item.mHeight = a.optInt("height", 0);
+            String taken = a.optString("localDateTime", a.optString("fileCreatedAt", null));
+            item.mDateMs = ImmichClient.parseDate(taken);
+            item.mUpdatedMs = ImmichClient.parseDate(a.optString("updatedAt", null));
+            item.mName = a.optString("originalFileName", "");
+            item.mDurationS = parseDuration(a.optString("duration", null));
+            JSONObject exif = a.optJSONObject("exifInfo");
+            item.mOrientation = degrees(exif != null ? exif.optString("orientation", "") : "");
+        }
+        return item;
+    }
+
+    private static int degrees(String exifOrientation) {
+        switch (exifOrientation) {
+            case "6": return 90;
+            case "3": return 180;
+            case "8": return 270;
+            default: return 0; // upright, or mirrored, which the gallery cannot show
+        }
+    }
+
+    // "0:01:23.456000" -> 83
+    private static int parseDuration(String d) {
+        if (d == null) {
+            return 0;
+        }
+        try {
+            String[] p = d.split(":");
+            if (p.length != 3) {
+                return 0;
+            }
+            return Integer.parseInt(p[0]) * 3600 + Integer.parseInt(p[1]) * 60
+                    + (int) Double.parseDouble(p[2]);
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    public String getId() {
+        return mId;
+    }
+
+    @Override
+    public Job<Bitmap> requestImage(int type) {
+        return new ImageCacheRequest(mApplication, mPath, mUpdatedMs, type,
+                MediaItem.getTargetSize(type)) {
+            @Override
+            public Bitmap onDecodeOriginal(JobContext jc, int type) {
+                ImmichClient client = ImmichClient.get(mApplication.getAndroidContext());
+                if (client == null) {
+                    return null;
+                }
+                try {
+                    byte[] data = client.thumbnail(mId, type == TYPE_MICROTHUMBNAIL
+                            ? ImmichClient.THUMBNAIL : ImmichClient.PREVIEW);
+                    if (jc.isCancelled()) {
+                        return null;
+                    }
+                    int target = MediaItem.getTargetSize(type);
+                    BitmapFactory.Options options = new BitmapFactory.Options();
+                    options.inJustDecodeBounds = true;
+                    BitmapFactory.decodeByteArray(data, 0, data.length, options);
+                    options.inSampleSize = type == TYPE_MICROTHUMBNAIL
+                            ? BitmapUtils.computeSampleSizeLarger(
+                                    options.outWidth, options.outHeight, target)
+                            : BitmapUtils.computeSampleSizeLarger((float) target
+                                    / Math.max(1, Math.max(options.outWidth, options.outHeight)));
+                    options.inJustDecodeBounds = false;
+                    options.inPreferredConfig = Bitmap.Config.ARGB_8888;
+                    return DecodeUtils.ensureGLCompatibleBitmap(
+                            DecodeUtils.decode(jc, data, options));
+                } catch (Exception e) {
+                    Log.w(TAG, "thumbnail " + mId + ": " + e);
+                    return null;
+                }
+            }
+        };
+    }
+
+    @Override
+    public Job<BitmapRegionDecoder> requestLargeImage() {
+        return jc -> {
+            File file = cached(mApplication.getAndroidContext(), jc);
+            if (file == null) {
+                return null;
+            }
+            return DecodeUtils.createBitmapRegionDecoder(jc, file.getPath(), false);
+        };
+    }
+
+    // Formats BitmapRegionDecoder can open on Android 9; others come as JPEG.
+    private boolean decodable() {
+        return "image/jpeg".equals(mMimeType) || "image/png".equals(mMimeType)
+                || "image/webp".equals(mMimeType);
+    }
+
+    /** The full picture on the device, fetched once; null if unreachable. */
+    private File cached(Context context, JobContext jc) {
+        File dir = new File(context.getCacheDir(), "immich");
+        dir.mkdirs();
+        File file = new File(dir, mId + (decodable() ? "" : ".full"));
+        if (file.exists()) {
+            file.setLastModified(System.currentTimeMillis());
+            return file;
+        }
+        ImmichClient client = ImmichClient.get(context);
+        if (client == null) {
+            return null;
+        }
+        try {
+            client.download(mId, decodable(), file, jc::isCancelled);
+        } catch (Exception e) {
+            Log.w(TAG, "original " + mId + ": " + e);
+            return null;
+        }
+        trim(dir);
+        return file;
+    }
+
+    private static synchronized void trim(File dir) {
+        File[] files = dir.listFiles();
+        if (files == null) {
+            return;
+        }
+        long total = 0;
+        for (File f : files) {
+            total += f.length();
+        }
+        if (total <= CACHE_LIMIT) {
+            return;
+        }
+        Arrays.sort(files, (a, b) -> Long.compare(a.lastModified(), b.lastModified()));
+        for (File f : files) {
+            if (total <= CACHE_LIMIT * 3 / 4) {
+                break;
+            }
+            total -= f.length();
+            f.delete();
+        }
+    }
+
+    @Override
+    public synchronized int getSupportedOperations() {
+        return mVideo ? SUPPORT_PLAY | SUPPORT_INFO : SUPPORT_FULL_IMAGE | SUPPORT_INFO;
+    }
+
+    @Override
+    public synchronized int getMediaType() {
+        return mVideo ? MEDIA_TYPE_VIDEO : MEDIA_TYPE_IMAGE;
+    }
+
+    @Override
+    public Uri getPlayUri() {
+        ImmichClient client = ImmichClient.get(mApplication.getAndroidContext());
+        return client != null ? Uri.parse(client.playbackUrl(mId)) : null;
+    }
+
+    @Override
+    public Uri getContentUri() {
+        return getPlayUri();
+    }
+
+    @Override
+    public synchronized String getMimeType() {
+        return mMimeType;
+    }
+
+    // The original is turned for display by this much; the full-size JPEG the
+    // server makes of other formats comes upright.
+    @Override
+    public synchronized int getFullImageRotation() {
+        return !mVideo && decodable() ? mOrientation : 0;
+    }
+
+    // As stored, before the turn - the size the photo view turns along with
+    // the picture. The server gives the upright size.
+    @Override
+    public synchronized int getWidth() {
+        return getFullImageRotation() % 180 != 0 ? mHeight : mWidth;
+    }
+
+    @Override
+    public synchronized int getHeight() {
+        return getFullImageRotation() % 180 != 0 ? mWidth : mHeight;
+    }
+
+    @Override
+    public synchronized long getDateInMs() {
+        return mDateMs;
+    }
+
+    @Override
+    public synchronized String getName() {
+        return mName;
+    }
+
+    @Override
+    public synchronized MediaDetails getDetails() {
+        MediaDetails details = super.getDetails();
+        details.addDetail(MediaDetails.INDEX_TITLE, mName);
+        if (mDateMs > 0) {
+            details.addDetail(MediaDetails.INDEX_DATETIME,
+                    java.text.DateFormat.getDateTimeInstance().format(new java.util.Date(mDateMs)));
+        }
+        if (mWidth > 0) {
+            details.addDetail(MediaDetails.INDEX_WIDTH, mWidth);
+            details.addDetail(MediaDetails.INDEX_HEIGHT, mHeight);
+        }
+        if (mVideo && mDurationS > 0) {
+            details.addDetail(MediaDetails.INDEX_DURATION, mDurationS);
+        }
+        details.addDetail(MediaDetails.INDEX_MIMETYPE, mMimeType);
+        return details;
+    }
+}
