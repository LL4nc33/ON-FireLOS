--- a/Android.mk
+++ b/Android.mk
@@ -1,5 +1,20 @@
 LOCAL_PATH := $(call my-dir)
 
+# ON-FireLOS: ExoPlayer and Guava for the video player, fetched by
+# scripts/fetch-exoplayer.sh (checksums there).
+include $(CLEAR_VARS)
+LOCAL_PREBUILT_STATIC_JAVA_LIBRARIES := \
+    gallery2-exoplayer-core:libs/exoplayer-core.jar \
+    gallery2-exoplayer-common:libs/exoplayer-common.jar \
+    gallery2-exoplayer-container:libs/exoplayer-container.jar \
+    gallery2-exoplayer-datasource:libs/exoplayer-datasource.jar \
+    gallery2-exoplayer-decoder:libs/exoplayer-decoder.jar \
+    gallery2-exoplayer-extractor:libs/exoplayer-extractor.jar \
+    gallery2-exoplayer-database:libs/exoplayer-database.jar \
+    gallery2-guava:libs/guava.jar \
+    gallery2-failureaccess:libs/failureaccess.jar
+include $(BUILD_MULTI_PREBUILT)
+
 include $(CLEAR_VARS)
 
 LOCAL_MODULE_TAGS := optional
@@ -15,6 +30,15 @@ LOCAL_STATIC_ANDROID_LIBRARIES := \
     androidx.legacy_legacy-support-v13
 
 LOCAL_STATIC_JAVA_LIBRARIES := \
+    gallery2-exoplayer-core \
+    gallery2-exoplayer-common \
+    gallery2-exoplayer-container \
+    gallery2-exoplayer-datasource \
+    gallery2-exoplayer-decoder \
+    gallery2-exoplayer-extractor \
+    gallery2-exoplayer-database \
+    gallery2-guava \
+    gallery2-failureaccess \
     org.codeaurora.gallery.common \
     xmp_toolkit \
     mp4parser
@@ -50,12 +74,17 @@ LOCAL_SHARED_LIBRARIES += \
 
 LOCAL_REQUIRED_MODULES := libts_detected_face_jni libts_face_beautify_jni
 
-LOCAL_PROGUARD_FLAG_FILES := proguard.flags
+LOCAL_PROGUARD_FLAG_FILES := proguard.flags libs/exoplayer.flags proguard-player.flags
+# ExoPlayer and Guava take the app past one dex file's 64K methods.
+LOCAL_DX_FLAGS += --multi-dex
 
 LOCAL_JAVA_LIBRARIES += org.apache.http.legacy
 
 LOCAL_JARJAR_RULES := $(LOCAL_PATH)/jarjar-rules.txt
 
+# ON-FireLOS: reworked for the ROM; the version says so after its own.
+LOCAL_AAPT_FLAGS += --version-name "1.1.40030 · $(ONFIRELOS_APP_VERSION)"
+
 include $(BUILD_PACKAGE)
 
 ifeq ($(strip $(LOCAL_PACKAGE_OVERRIDES)),)
