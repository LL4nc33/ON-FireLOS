+
+package com.android.gallery3d.immich;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Base64;
+import android.util.Log;
+
+import org.codeaurora.gallery.R;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Uploads files to Immich - for the camera backup and for "share to Immich" -
+ * asking the server first which of them it has already (by SHA-1), so
+ * nothing goes up twice. Shows one quiet notification with the progress.
+ */
+public final class ImmichUploader {
+    private static final String TAG = "ImmichUploader";
+    private static final String CHANNEL = "immich_upload";
+    public static final int NOTIFICATION = 0x1a3c;
+
+    /** A file to upload. */
+    public static final class Item {
+        public final File file;
+        public final String name;
+        public final String mimeType;
+        public final long created;
+        public final long modified;
+        public final String deviceAssetId;
+        String sha1;
+        // For the camera backup: where it stands in the media store.
+        long mediaId;
+        boolean video;
+
+        public Item(File file, String name, String mimeType, long created, long modified,
+                String deviceAssetId) {
+            this.file = file;
+            this.name = name;
+            this.mimeType = mimeType;
+            this.created = created;
+            this.modified = modified;
+            this.deviceAssetId = deviceAssetId;
+        }
+    }
+
+    /** What happened. */
+    public static final class Result {
+        public int uploaded;
+        public int skipped;
+        public int failed;
+        public boolean authFailed;
+        /** Stopped early: cancelled, or the server or network failed for now. */
+        public boolean retry;
+        /** Where it stopped early: the file being checked or sent. */
+        public Item stuck;
+    }
+
+    /** Told of each file that is dealt with for good, in the order given. */
+    public interface Listener {
+        void done(Item item);
+    }
+
+    public interface Cancel {
+        boolean isCancelled();
+    }
+
+    // Files are hashed, checked with the server and uploaded a batch at a
+    // time, so the first upload starts after a few files, not after all.
+    private static final int BATCH = 25;
+
+    private final Context mContext;
+    private final NotificationManager mNotifications;
+
+    public ImmichUploader(Context context) {
+        mContext = context.getApplicationContext();
+        mNotifications = mContext.getSystemService(NotificationManager.class);
+        NotificationChannel channel = new NotificationChannel(CHANNEL,
+                mContext.getString(R.string.immich_upload_channel),
+                NotificationManager.IMPORTANCE_LOW);
+        channel.setShowBadge(false);
+        mNotifications.createNotificationChannel(channel);
+    }
+
+    public Result upload(List<Item> items, Cancel cancel) {
+        return upload(items, cancel, null);
+    }
+
+    /**
+     * Uploads what the server does not have; blocks, call from a background
+     * thread. Stops at the first failure that may pass (network, server
+     * trouble), so every file before it is dealt with and the listener has
+     * heard of each in order. A file the server refuses for good, or one that
+     * cannot be read, counts as failed and does not hold up the ones after it.
+     */
+    public Result upload(List<Item> items, Cancel cancel, Listener listener) {
+        Result result = new Result();
+        ImmichClient client = ImmichClient.get(mContext);
+        if (client == null || items.isEmpty()) {
+            return result;
+        }
+        int total = items.size();
+        try {
+            for (int from = 0; from < total; from += BATCH) {
+                List<Item> batch = items.subList(from, Math.min(total, from + BATCH));
+                result.stuck = batch.get(0);
+                Set<Item> wanted = check(client, batch, cancel);
+                if (wanted == null) {
+                    result.retry = true;
+                    break;
+                }
+                for (int i = 0; i < batch.size(); i++) {
+                    Item item = batch.get(i);
+                    if (item.sha1 == null) {
+                        // Gone since it was listed: nothing to back up.
+                        // Still there but unreadable: report it, move on.
+                        if (item.file.exists()) {
+                            result.failed++;
+                        }
+                    } else if (!wanted.contains(item)) {
+                        result.skipped++;
+                    } else {
+                        if (cancel != null && cancel.isCancelled()) {
+                            result.retry = true;
+                            return finish(result);
+                        }
+                        result.stuck = item;
+                        if (!send(client, item, from + i, total, result)) {
+                            continue; // refused for good: counted, not done
+                        }
+                    }
+                    if (listener != null) {
+                        listener.done(item);
+                    }
+                }
+            }
+        } catch (ImmichClient.AuthException e) {
+            result.authFailed = true;
+            result.failed++;
+        } catch (ImmichClient.HttpException e) {
+            Log.w(TAG, "upload: " + e.getMessage());
+            if (e.isTransient()) {
+                result.retry = true;
+            } else {
+                result.failed++;
+            }
+        } catch (IOException e) {
+            Log.w(TAG, "upload: " + e);
+            result.retry = true;
+        }
+        return finish(result);
+    }
+
+    // One file; false if the server refused it for good. Failures that may
+    // pass are thrown.
+    private boolean send(ImmichClient client, Item item, int index, int total, Result result)
+            throws IOException {
+        show(index, total, 0);
+        try {
+            String status = client.upload(item.file, item.name, item.mimeType,
+                    item.created, item.modified, item.sha1, item.deviceAssetId,
+                    (done, size) -> show(index, total, size > 0 ? (int) (done * 100 / size) : 0));
+            if ("duplicate".equals(status)) {
+                result.skipped++;
+            } else {
+                result.uploaded++;
+            }
+            return true;
+        } catch (ImmichClient.HttpException e) {
+            if (e.isTransient()) {
+                throw e;
+            }
+            Log.w(TAG, "refused " + item.name + ": " + e.getMessage());
+            result.failed++;
+            return false;
+        }
+    }
+
+    private Result finish(Result result) {
+        done(result);
+        return result;
+    }
+
+    // Hashes a batch and asks which files the server would take; null if
+    // cancelled while hashing. Files that cannot be read keep sha1 null.
+    private Set<Item> check(ImmichClient client, List<Item> batch, Cancel cancel)
+            throws IOException {
+        JSONArray query = new JSONArray();
+        for (int i = 0; i < batch.size(); i++) {
+            if (cancel != null && cancel.isCancelled()) {
+                return null;
+            }
+            Item item = batch.get(i);
+            item.sha1 = sha1(item.file);
+            if (item.sha1 == null) {
+                continue;
+            }
+            try {
+                query.put(new JSONObject().put("id", String.valueOf(i))
+                        .put("checksum", item.sha1));
+            } catch (org.json.JSONException ignored) {
+            }
+        }
+        Set<Item> wanted = new HashSet<>();
+        if (query.length() == 0) {
+            return wanted;
+        }
+        JSONArray answer = client.bulkUploadCheck(query);
+        for (int i = 0; i < answer.length(); i++) {
+            JSONObject r = answer.optJSONObject(i);
+            if (r != null && "accept".equals(r.optString("action"))) {
+                int index = r.optInt("id", -1);
+                if (index >= 0 && index < batch.size()) {
+                    wanted.add(batch.get(index));
+                }
+            }
+        }
+        return wanted;
+    }
+
+    static String sha1(File file) {
+        try (InputStream in = new FileInputStream(file)) {
+            MessageDigest digest = MessageDigest.getInstance("SHA-1");
+            byte[] buf = new byte[64 * 1024];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                digest.update(buf, 0, n);
+            }
+            return Base64.encodeToString(digest.digest(), Base64.NO_WRAP);
+        } catch (Exception e) {
+            Log.w(TAG, "sha1 " + file + ": " + e);
+            return null;
+        }
+    }
+
+    private PendingIntent settings() {
+        return PendingIntent.getActivity(mContext, 0,
+                new Intent(mContext, ImmichSettingsActivity.class), PendingIntent.FLAG_IMMUTABLE);
+    }
+
+    private int mShownIndex = -1;
+    private int mShownPercent;
+
+    private void show(int index, int total, int percent) {
+        // A file sends its bytes in 64 KB steps; the notification moves in 5 % steps.
+        if (index == mShownIndex && percent < mShownPercent + 5) {
+            return;
+        }
+        mShownIndex = index;
+        mShownPercent = percent;
+        Notification n = new Notification.Builder(mContext, CHANNEL)
+                .setSmallIcon(R.drawable.ic_immich_upload)
+                .setContentTitle(mContext.getString(R.string.immich_uploading, index + 1, total))
+                .setProgress(100, percent, false)
+                .setOngoing(true)
+                .setOnlyAlertOnce(true)
+                .setContentIntent(settings())
+                .build();
+        mNotifications.notify(NOTIFICATION, n);
+    }
+
+    /** The notification while shared items are being read, before the upload starts. */
+    public Notification preparing() {
+        return new Notification.Builder(mContext, CHANNEL)
+                .setSmallIcon(R.drawable.ic_immich_upload)
+                .setContentTitle(mContext.getString(R.string.immich_upload_started))
+                .setProgress(0, 0, true)
+                .setOngoing(true)
+                .build();
+    }
+
+    private void done(Result r) {
+        if (r.uploaded == 0 && r.failed == 0 && r.skipped == 0) {
+            mNotifications.cancel(NOTIFICATION);
+            return;
+        }
+        if (r.retry && r.uploaded == 0 && r.failed == 0 && r.skipped == 0) {
+            // Nothing done yet and it goes on later: no message.
+            mNotifications.cancel(NOTIFICATION);
+            return;
+        }
+        String text = r.authFailed ? mContext.getString(R.string.immich_error_auth)
+                : r.failed > 0 ? mContext.getString(R.string.immich_upload_failed, r.failed)
+                : r.uploaded > 0 ? mContext.getString(R.string.immich_uploaded, r.uploaded)
+                : mContext.getString(R.string.immich_already_there, r.skipped);
+        Notification n = new Notification.Builder(mContext, CHANNEL)
+                .setSmallIcon(R.drawable.ic_immich_upload)
+                .setContentTitle(mContext.getString(R.string.immich_title))
+                .setContentText(text)
+                .setAutoCancel(true)
+                .setContentIntent(settings())
+                .build();
+        mNotifications.notify(NOTIFICATION, n);
+    }
+}
