+
+package com.android.gallery3d.data;
+
+import com.android.gallery3d.app.GalleryApp;
+
+/**
+ * ON-FireLOS: photos on an Immich server, next to the ones on the device -
+ * the place the gallery once kept for Picasa web albums.
+ * <pre>
+ * /immich/all            the albums: all photos, then each Immich album
+ * /immich/timeline       all photos, newest first
+ * /immich/album/{id}     one album
+ * /immich/item/{id}      one photo or video
+ * </pre>
+ */
+public class ImmichSource extends MediaSource {
+    public static final String PREFIX = "immich";
+    public static final Path PATH_ALL = Path.fromString("/immich/all");
+
+    private static final int ALBUM_SET = 0;
+    private static final int TIMELINE = 1;
+    private static final int ALBUM = 2;
+    private static final int ITEM = 3;
+
+    private final GalleryApp mApplication;
+    private final PathMatcher mMatcher = new PathMatcher();
+
+    public ImmichSource(GalleryApp application) {
+        super(PREFIX);
+        mApplication = application;
+        mMatcher.add("/immich/all", ALBUM_SET);
+        mMatcher.add("/immich/timeline", TIMELINE);
+        mMatcher.add("/immich/album/*", ALBUM);
+        mMatcher.add("/immich/item/*", ITEM);
+    }
+
+    @Override
+    public MediaObject createMediaObject(Path path) {
+        switch (mMatcher.match(path)) {
+            case ALBUM_SET:
+                return new ImmichAlbumSet(path, mApplication);
+            case TIMELINE:
+                return new ImmichAlbum(path, mApplication, null, null, 0, null);
+            case ALBUM:
+                return new ImmichAlbum(path, mApplication, mMatcher.getVar(0), null, 0, null);
+            case ITEM:
+                // Only reached for an item not loaded through an album yet:
+                // what it is becomes known once an album lists it.
+                return new ImmichItem(path, mApplication, mMatcher.getVar(0));
+            default:
+                throw new RuntimeException("bad path: " + path);
+        }
+    }
+}
diff --git a/src/com/android/gallery3d/immich/ImmichBackupJob.java b/src/com/android/gallery3d/immich/ImmichBackupJob.java
