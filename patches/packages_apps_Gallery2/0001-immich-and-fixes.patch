+    private void showTracks(View anchor) {
+        if (mPlayer == null) {
+            return;
+        }
+        Context context = getContext();
+        PopupMenu menu = new PopupMenu(context, anchor);
+        Tracks tracks = mPlayer.getCurrentTracks();
+        int id = 0;
+        boolean anyText = false;
+        boolean textOn = false;
+        for (Tracks.Group group : tracks.getGroups()) {
+            int type = group.getType();
+            if (type != C.TRACK_TYPE_AUDIO && type != C.TRACK_TYPE_TEXT) {
+                continue;
+            }
+            for (int i = 0; i < group.length; i++) {
+                if (!group.isTrackSupported(i)) {
+                    continue;
+                }
+                Format f = group.getTrackFormat(i);
+                String label = (type == C.TRACK_TYPE_AUDIO
+                        ? context.getString(R.string.player_audio)
+                        : context.getString(R.string.player_subtitles)) + ": " + describe(f);
+                final Tracks.Group g = group;
+                final int index = i;
+                menu.getMenu().add(type == C.TRACK_TYPE_AUDIO ? 0 : 1, id++, 0, label)
+                        .setCheckable(true).setChecked(group.isTrackSelected(i))
+                        .setOnMenuItemClickListener(item -> {
+                            mPlayer.setTrackSelectionParameters(
+                                    mPlayer.getTrackSelectionParameters().buildUpon()
+                                            .setTrackTypeDisabled(g.getType(), false)
+                                            .setOverrideForType(new TrackSelectionOverride(
+                                                    g.getMediaTrackGroup(), index))
+                                            .build());
+                            return true;
+                        });
+                if (type == C.TRACK_TYPE_TEXT) {
+                    anyText = true;
+                    textOn |= group.isTrackSelected(i);
+                }
+            }
+        }
+        if (anyText) {
+            menu.getMenu().add(1, id, 0, context.getString(R.string.player_subtitles) + ": "
+                    + context.getString(R.string.player_subtitles_off))
+                    .setCheckable(true).setChecked(!textOn)
+                    .setOnMenuItemClickListener(item -> {
+                        mPlayer.setTrackSelectionParameters(
+                                mPlayer.getTrackSelectionParameters().buildUpon()
+                                        .setTrackTypeDisabled(C.TRACK_TYPE_TEXT, true)
+                                        .build());
+                        return true;
+                    });
+        }
+        menu.setOnDismissListener(m -> scheduleHide());
+        menu.show();
+        mHandler.removeCallbacks(mHide);
+    }
+
+    private static String describe(Format f) {
+        String language = f.language != null && !"und".equals(f.language)
+                ? new Locale(f.language).getDisplayLanguage() : null;
+        String name = f.label != null ? f.label : language;
+        String channels = f.channelCount > 0
+                ? (f.channelCount >= 6 ? "5.1" : f.channelCount == 2 ? "Stereo" : "Mono") : null;
+        StringBuilder b = new StringBuilder(name != null ? name : "#" + (f.id != null ? f.id : "?"));
+        if (channels != null) {
+            b.append(" · ").append(channels);
+        }
+        return b.toString();
+    }
+
+    static String time(long ms) {
+        long s = Math.max(0, ms / 1000);
+        return s >= 3600
+                ? String.format(Locale.ROOT, "%d:%02d:%02d", s / 3600, s / 60 % 60, s % 60)
+                : String.format(Locale.ROOT, "%d:%02d", s / 60, s % 60);
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                getResources().getDisplayMetrics());
+    }
+
+    /** Taps, double taps, sideways swipes and the brightness and volume swipes. */
+    private final class Gestures extends GestureDetector.SimpleOnGestureListener {
+        private int mMode; // 0 none, 1 brightness, 2 volume, 3 sideways
+        private float mStartValue;
+        private float mStartY;
+
+        @Override
+        public boolean onDown(MotionEvent e) {
+            mMode = 0;
+            return true;
+        }
+
+        @Override
+        public boolean onSingleTapConfirmed(MotionEvent e) {
+            boolean show = mInline ? !mHost.barsShown() : !controlsShown();
+            showControls(show);
+            mHost.onTap(show);
+            return true;
+        }
+
+        @Override
+        public boolean onDoubleTap(MotionEvent e) {
+            float x = e.getX() / getWidth();
+            if (x < 0.35f) {
+                seekBy(-SEEK_MS);
+            } else if (x > 0.65f) {
+                seekBy(SEEK_MS);
+            } else {
+                togglePlay();
+            }
+            return true;
+        }
+
+        @Override
+        public boolean onFling(MotionEvent down, MotionEvent e, float vx, float vy) {
+            // Inline, a sideways swipe moves to the next picture, as on photos.
+            if (mInline && down != null && mMode != 1 && mMode != 2
+                    && Math.abs(vx) > Math.abs(vy) * 1.5f
+                    && Math.abs(e.getX() - down.getX()) > dp(48)) {
+                mHost.onSwipe(vx < 0 ? 1 : -1);
+                return true;
+            }
+            return false;
+        }
+
+        @Override
+        public boolean onScroll(MotionEvent down, MotionEvent e, float dx, float dy) {
+            if (down == null) {
+                return false;
+            }
+            if (mMode == 0) {
+                float moveX = Math.abs(e.getX() - down.getX());
+                float moveY = Math.abs(e.getY() - down.getY());
+                if (moveX > dp(16) && moveX > moveY) {
+                    mMode = 3;
+                }
+                if (moveY < dp(16) || moveY < moveX) {
+                    return false;
+                }
+                mStartY = e.getY();
+                if (down.getX() < getWidth() / 2f) {
+                    mMode = 1;
+                    Window window = mHost.window();
+                    float b = window != null ? window.getAttributes().screenBrightness : -1;
+                    if (b < 0) {
+                        b = Settings.System.getInt(getContext().getContentResolver(),
+                                Settings.System.SCREEN_BRIGHTNESS, 128) / 255f;
+                    }
+                    mStartValue = b;
+                } else {
+                    mMode = 2;
+                    mStartValue = mAudio.getStreamVolume(AudioManager.STREAM_MUSIC);
+                }
+            }
+            if (mMode == 3) {
+                return false;
+            }
+            // A full sweep over two thirds of the height covers the whole range.
+            float delta = (mStartY - e.getY()) / (getHeight() * 0.66f);
+            Context context = getContext();
+            if (mMode == 1) {
+                Window window = mHost.window();
+                if (window == null) {
+                    return false;
+                }
+                float b = Math.max(0.01f, Math.min(1f, mStartValue + delta));
+                WindowManager.LayoutParams lp = window.getAttributes();
+                if (Float.isNaN(mWindowBrightness)) {
+                    mWindowBrightness = lp.screenBrightness;
+                }
+                lp.screenBrightness = b;
+                window.setAttributes(lp);
+                badge(context.getString(R.string.player_brightness) + "  "
+                        + Math.round(b * 100) + " %");
+            } else {
+                int max = mAudio.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
+                int v = Math.max(0, Math.min(max, Math.round(mStartValue + delta * max)));
+                mAudio.setStreamVolume(AudioManager.STREAM_MUSIC, v, 0);
+                badge(context.getString(R.string.player_volume) + "  "
+                        + Math.round(v * 100f / max) + " %");
+            }
+            return true;
+        }
+    }
+
+    /** Holds the video surface at the video's shape, as large as fits. */
+    static final class AspectFrame extends FrameLayout {
+        final SurfaceView surface;
+        float aspect;
+
+        AspectFrame(Context context) {
+            super(context);
+            surface = new SurfaceView(context);
+            addView(surface, new LayoutParams(LayoutParams.MATCH_PARENT,
+                    LayoutParams.MATCH_PARENT, Gravity.CENTER));
+        }
+
+        void setAspect(float a) {
+            if (a != aspect) {
+                aspect = a;
+                requestLayout();
+            }
+        }
+
+        @Override
+        protected void onMeasure(int widthSpec, int heightSpec) {
+            int w = MeasureSpec.getSize(widthSpec);
+            int h = MeasureSpec.getSize(heightSpec);
+            if (aspect > 0 && w > 0 && h > 0) {
+                if (w / (float) h > aspect) {
+                    w = Math.round(h * aspect);
+                } else {
+                    h = Math.round(w / aspect);
+                }
+            }
+            super.onMeasure(MeasureSpec.makeMeasureSpec(w, MeasureSpec.EXACTLY),
+                    MeasureSpec.makeMeasureSpec(h, MeasureSpec.EXACTLY));
+        }
+    }
+}
