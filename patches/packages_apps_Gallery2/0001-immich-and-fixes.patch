+
+import org.codeaurora.gallery.R;
+
+import org.json.JSONObject;
+
+/**
+ * Immich in the gallery: the server, the API key (stored encrypted, never
+ * shown again), whether its albums appear next to the device's, and the
+ * camera backup with its conditions.
+ */
+public class ImmichSettingsActivity extends Activity {
+    private EditText mServer;
+    private EditText mKey;
+    private TextView mStatus;
+    private Button mConnect;
+    private Button mForget;
+    private Switch mShow;
+    private Switch mBackup;
+    private Switch mWifi;
+    private Switch mCharging;
+    private TextView mBackupStatus;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (getActionBar() != null) {
+            getActionBar().setDisplayHomeAsUpEnabled(true);
+        }
+        SharedPreferences prefs = ImmichConfig.prefs(this);
+
+        LinearLayout list = new LinearLayout(this);
+        list.setOrientation(LinearLayout.VERTICAL);
+        int pad = dp(24);
+        list.setPadding(pad, dp(8), pad, pad);
+
+        list.addView(header(R.string.immich_server_section));
+        mServer = new EditText(this);
+        mServer.setHint(R.string.immich_server_hint);
+        mServer.setSingleLine(true);
+        mServer.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        mServer.setText(ImmichConfig.server(this));
+        list.addView(mServer);
+        mKey = new EditText(this);
+        mKey.setSingleLine(true);
+        mKey.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);
+        list.addView(mKey);
+        mStatus = new TextView(this);
+        mStatus.setTextAppearance(android.R.style.TextAppearance_Material_Body1);
+        mStatus.setPadding(0, dp(8), 0, dp(8));
+        list.addView(mStatus);
+        LinearLayout buttons = new LinearLayout(this);
+        mConnect = new Button(this);
+        mConnect.setText(R.string.immich_connect);
+        mConnect.setOnClickListener(v -> connect());
+        buttons.addView(mConnect);
+        mForget = new Button(this, null, android.R.attr.borderlessButtonStyle);
+        mForget.setText(R.string.immich_forget);
+        mForget.setOnClickListener(v -> {
+            ImmichConfig.forget(this);
+            prefs.edit().putBoolean(ImmichConfig.KEY_BACKUP, false).apply();
+            ImmichBackupJob.schedule(this);
+            mServer.setText("");
+            mKey.setText("");
+            refresh();
+        });
+        buttons.addView(mForget);
+        list.addView(buttons);
+        TextView permissions = new TextView(this);
+        permissions.setText(R.string.immich_key_permissions);
+        permissions.setTextAppearance(android.R.style.TextAppearance_Material_Caption);
+        permissions.setPadding(0, dp(4), 0, dp(16));
+        list.addView(permissions);
+
+        list.addView(header(R.string.immich_gallery_section));
+        mShow = toggle(list, R.string.immich_show, ImmichConfig.KEY_SHOW, true);
+
+        list.addView(header(R.string.immich_backup_section));
+        mBackup = toggle(list, R.string.immich_backup, ImmichConfig.KEY_BACKUP, false);
+        mWifi = toggle(list, R.string.immich_backup_wifi, ImmichConfig.KEY_BACKUP_WIFI, true);
+        mCharging = toggle(list, R.string.immich_backup_charging,
+                ImmichConfig.KEY_BACKUP_CHARGING, false);
+        mBackupStatus = new TextView(this);
+        mBackupStatus.setTextAppearance(android.R.style.TextAppearance_Material_Caption);
+        mBackupStatus.setPadding(0, dp(8), 0, 0);
+        list.addView(mBackupStatus);
+
+        ScrollView scroll = new ScrollView(this);
+        scroll.addView(list);
+        setContentView(scroll);
+        refresh();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        refresh();
+    }
+
+    @Override
+    public boolean onOptionsItemSelected(MenuItem item) {
+        if (item.getItemId() == android.R.id.home) {
+            finish();
+            return true;
+        }
+        return super.onOptionsItemSelected(item);
+    }
+
+    private void refresh() {
+        boolean configured = ImmichConfig.isConfigured(this);
+        mKey.setHint(configured ? R.string.immich_key_hint_stored : R.string.immich_key_hint);
+        mForget.setVisibility(configured ? View.VISIBLE : View.GONE);
+        if (mStatus.getText().length() == 0 || !configured) {
+            String status = configured ? getString(R.string.immich_status_saved)
+                    : getString(R.string.immich_status_none);
+            if (configured && ImmichConfig.isCleartext(ImmichConfig.server(this))) {
+                status += "\n" + getString(R.string.immich_cleartext);
+            }
+            mStatus.setText(status);
+        }
+        mShow.setEnabled(configured);
+        mBackup.setEnabled(configured);
+        boolean backup = configured && mBackup.isChecked();
+        mWifi.setEnabled(backup);
+        mCharging.setEnabled(backup);
+        SharedPreferences prefs = ImmichConfig.prefs(this);
+        long last = prefs.getLong(ImmichBackupJob.KEY_LAST_RUN, 0);
+        if (backup && last > 0) {
+            String[] r = prefs.getString(ImmichBackupJob.KEY_LAST_RESULT, "0/0/0").split("/");
+            mBackupStatus.setText(getString(R.string.immich_backup_last,
+                    DateUtils.getRelativeTimeSpanString(last), r[0], r[2]));
+        } else {
+            mBackupStatus.setText(backup ? getString(R.string.immich_backup_waiting) : "");
+        }
+    }
+
+    // Tries server and key; stores them only if both work.
+    private void connect() {
+        String server = mServer.getText().toString();
+        String key = mKey.getText().toString().trim();
+        if (server.trim().isEmpty()) {
+            mStatus.setText(R.string.immich_status_none);
+            return;
+        }
+        if (key.isEmpty()) {
+            // The stored key only ever goes to the server it was stored for:
+            // a changed or mistyped address needs the key entered again.
+            if (!ImmichConfig.normalize(server).equals(ImmichConfig.server(this))) {
+                mStatus.setText(R.string.immich_key_needed);
+                return;
+            }
+            key = ImmichConfig.apiKey(this);
+        }
+        if (key == null) {
+            mStatus.setText(R.string.immich_status_none);
+            return;
+        }
+        mConnect.setEnabled(false);
+        mStatus.setText(R.string.immich_connecting);
+        final String apiKey = key;
+        new AsyncTask<Void, Void, String>() {
+            boolean mOk;
+
+            @Override
+            protected String doInBackground(Void... v) {
+                ImmichClient client = ImmichClient.forTest(server, apiKey);
+                try {
+                    String version = client.version();
+                    JSONObject me = client.me();
+                    client.albums();
+                    mOk = true;
+                    return getString(R.string.immich_status_connected, version,
+                            me.optString("name", me.optString("email")));
+                } catch (ImmichClient.AuthException e) {
+                    return getString(R.string.immich_error_auth);
+                } catch (Exception e) {
+                    return getString(R.string.immich_error_unreachable, e.getMessage());
+                }
+            }
+
+            @Override
+            protected void onPostExecute(String message) {
+                mConnect.setEnabled(true);
+                mStatus.setText(message);
+                if (mOk) {
+                    ImmichConfig.save(ImmichSettingsActivity.this, server, apiKey);
+                    if (ImmichConfig.isCleartext(ImmichConfig.server(ImmichSettingsActivity.this))) {
+                        mStatus.setText(message + "\n" + getString(R.string.immich_cleartext));
+                    }
+                    mServer.setText(ImmichConfig.server(ImmichSettingsActivity.this));
+                    mKey.setText("");
+                    ImmichBackupJob.schedule(ImmichSettingsActivity.this);
+                }
+                refresh();
+            }
+        }.execute();
+    }
+
+    private TextView header(int text) {
+        TextView t = new TextView(this);
+        t.setText(text);
+        t.setTextAppearance(android.R.style.TextAppearance_Material_Body2);
+        TypedValue accent = new TypedValue();
+        getTheme().resolveAttribute(android.R.attr.colorAccent, accent, true);
+        t.setTextColor(accent.data);
+        t.setPadding(0, dp(24), 0, dp(8));
+        return t;
+    }
+
+    private Switch toggle(LinearLayout list, int text, String key, boolean def) {
+        Switch s = new Switch(this);
+        s.setText(text);
+        s.setTextAppearance(android.R.style.TextAppearance_Material_Subhead);
+        s.setChecked(ImmichConfig.prefs(this).getBoolean(key, def));
+        s.setPadding(0, dp(12), 0, dp(12));
+        s.setOnCheckedChangeListener((b, on) -> {
+            ImmichConfig.prefs(this).edit().putBoolean(key, on).apply();
+            if (key.equals(ImmichConfig.KEY_SHOW)) {
+                ImmichConfig.changed();
+            } else {
+                ImmichBackupJob.schedule(this);
+                if (key.equals(ImmichConfig.KEY_BACKUP) && on) {
+                    ImmichBackupJob.runNow(this);
+                }
+            }
+            refresh();
+        });
+        list.addView(s, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT));
+        return s;
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                getResources().getDisplayMetrics());
+    }
+}
