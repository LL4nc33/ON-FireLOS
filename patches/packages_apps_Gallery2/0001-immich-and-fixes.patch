index 0000000..cd8167c
--- /dev/null
+++ b/src/com/android/gallery3d/immich/ImmichBackupJob.java
@@ -0,0 +1,292 @@
+/*
+ * Copyright (C) 2026 ON-FireLOS
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.gallery3d.immich;
+
+import android.app.job.JobInfo;
+import android.app.job.JobParameters;
+import android.app.job.JobScheduler;
+import android.app.job.JobService;
+import android.content.BroadcastReceiver;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.MediaStore;
+import android.util.Log;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Camera backup to Immich. Woken by new photos and videos (and twice a day
+ * in case one slipped by), it runs only on unmetered Wi-Fi and while charging
+ * if so chosen, and uploads the camera's pictures added since the last run.
+ * The server is asked first what it has, so turning backup on for a camera
+ * roll that was already backed up by another app costs a checksum, no upload.
+ */
+public class ImmichBackupJob extends JobService {
+    private static final String TAG = "ImmichBackup";
+    private static final int JOB_CHANGES = 0x1a3c01;
+    private static final int JOB_PERIODIC = 0x1a3c02;
+    private static final String KEY_LAST_ID_IMAGE = "backup_last_image";
+    private static final String KEY_LAST_ID_VIDEO = "backup_last_video";
+    public static final String KEY_LAST_RUN = "backup_last_run";
+    public static final String KEY_LAST_RESULT = "backup_last_result";
+    private static final String KEY_STUCK = "backup_stuck";
+    private static final String KEY_STUCK_TRIES = "backup_stuck_tries";
+
+    private static final int JOB_RETRY = 0x1a3c03;
+    private static final long RETRY_MS = TimeUnit.MINUTES.toMillis(15);
+
+    // One run at a time; a trigger during a run asks it to look once more.
+    private static final AtomicBoolean sRunning = new AtomicBoolean();
+    private static final AtomicBoolean sLookAgain = new AtomicBoolean();
+    private volatile boolean mStopped;
+
+    /** (Re)schedules or cancels the jobs after a settings change, at start and boot. */
+    public static void schedule(Context context) {
+        schedule(context, false);
+    }
+
+    private static void schedule(Context context, boolean rearm) {
+        JobScheduler scheduler = context.getSystemService(JobScheduler.class);
+        SharedPreferences prefs = ImmichConfig.prefs(context);
+        if (!prefs.getBoolean(ImmichConfig.KEY_BACKUP, false)
+                || !ImmichConfig.isConfigured(context)) {
+            scheduler.cancel(JOB_CHANGES);
+            scheduler.cancel(JOB_PERIODIC);
+            scheduler.cancel(JOB_RETRY);
+            return;
+        }
+        ComponentName service = new ComponentName(context, ImmichBackupJob.class);
+        int network = network(prefs);
+        boolean charging = charging(prefs);
+        JobInfo changes = new JobInfo.Builder(JOB_CHANGES, service)
+                .addTriggerContentUri(new JobInfo.TriggerContentUri(
+                        MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
+                        JobInfo.TriggerContentUri.FLAG_NOTIFY_FOR_DESCENDANTS))
+                .addTriggerContentUri(new JobInfo.TriggerContentUri(
+                        MediaStore.Video.Media.EXTERNAL_CONTENT_URI,
+                        JobInfo.TriggerContentUri.FLAG_NOTIFY_FOR_DESCENDANTS))
+                // A burst of shots: wait until it is over.
+                .setTriggerContentUpdateDelay(TimeUnit.SECONDS.toMillis(30))
+                .setTriggerContentMaxDelay(TimeUnit.MINUTES.toMillis(10))
+                .setRequiredNetworkType(network)
+                .setRequiresCharging(charging)
+                .build();
+        if (rearm) {
+            // A content trigger fires once: watch again.
+            scheduler.schedule(changes);
+        } else {
+            ensure(scheduler, changes);
+        }
+        ensure(scheduler, new JobInfo.Builder(JOB_PERIODIC, service)
+                .setPeriodic(TimeUnit.HOURS.toMillis(12))
+                .setRequiredNetworkType(network)
+                .setRequiresCharging(charging)
+                .setPersisted(true)
+                .build());
+    }
+
+    // Leaves a job alone that is scheduled the same way already: scheduling
+    // it again would stop a run in progress and restart the twelve hours.
+    private static void ensure(JobScheduler scheduler, JobInfo job) {
+        JobInfo old = scheduler.getPendingJob(job.getId());
+        if (old == null || old.getNetworkType() != job.getNetworkType()
+                || old.isRequireCharging() != job.isRequireCharging()) {
+            scheduler.schedule(job);
+        }
+    }
+
+    private static boolean enabled(Context context) {
+        return ImmichConfig.prefs(context).getBoolean(ImmichConfig.KEY_BACKUP, false)
+                && ImmichConfig.isConfigured(context);
+    }
+
+    // Anything in the camera folder past where the backup stands.
+    private boolean hasNew() {
+        SharedPreferences prefs = ImmichConfig.prefs(this);
+        return collect(MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
+                prefs.getLong(KEY_LAST_ID_IMAGE, 0), false, new ArrayList<>())
+                > prefs.getLong(KEY_LAST_ID_IMAGE, 0)
+                || collect(MediaStore.Video.Media.EXTERNAL_CONTENT_URI,
+                prefs.getLong(KEY_LAST_ID_VIDEO, 0), true, new ArrayList<>())
+                > prefs.getLong(KEY_LAST_ID_VIDEO, 0);
+    }
+
+    private static int network(SharedPreferences prefs) {
+        return prefs.getBoolean(ImmichConfig.KEY_BACKUP_WIFI, true)
+                ? JobInfo.NETWORK_TYPE_UNMETERED : JobInfo.NETWORK_TYPE_ANY;
+    }
+
+    private static boolean charging(SharedPreferences prefs) {
+        return prefs.getBoolean(ImmichConfig.KEY_BACKUP_CHARGING, false);
+    }
+
+    /** Starts a run now (from the settings), still under the chosen conditions. */
+    public static void runNow(Context context) {
+        retry(context, 0);
+    }
+
+    private static void retry(Context context, long delay) {
+        SharedPreferences prefs = ImmichConfig.prefs(context);
+        context.getSystemService(JobScheduler.class).schedule(
+                new JobInfo.Builder(JOB_RETRY, new ComponentName(context, ImmichBackupJob.class))
+                        .setMinimumLatency(delay)
+                        .setRequiredNetworkType(network(prefs))
+                        .setRequiresCharging(charging(prefs))
+                        .build());
+    }
+
+    @Override
+    public boolean onStartJob(JobParameters params) {
+        if (!sRunning.compareAndSet(false, true)) {
+            sLookAgain.set(true);
+            return false;
+        }
+        mStopped = false;
+        new Thread(() -> {
+            boolean again = false;
+            try {
+                do {
+                    sLookAgain.set(false);
+                    again = backup();
+                } while (!again && !mStopped && sLookAgain.get());
+            } catch (RuntimeException e) {
+                Log.w(TAG, "backup: " + e);
+                again = true;
+            } finally {
+                sRunning.set(false);
+                jobFinished(params, false);
+                // The content trigger fires once: the job that ran is watched
+                // again. Another one is left as it is - it may hold a change.
+                schedule(this, params.getJobId() == JOB_CHANGES);
+                if (enabled(this)) {
+                    if (again || mStopped) {
+                        retry(this, RETRY_MS);
+                    } else if (hasNew()) {
+                        // Taken while the run went on, before the trigger
+                        // watched again.
+                        retry(this, TimeUnit.SECONDS.toMillis(30));
+                    }
+                }
+            }
+        }, TAG).start();
+        return true;
+    }
+
+    @Override
+    public boolean onStopJob(JobParameters params) {
+        // Conditions gone (Wi-Fi, charger): stop after this file, retry later.
+        mStopped = true;
+        return false;
+    }
+
+    /** One run; returns true if it should be retried. */
+    private boolean backup() {
+        SharedPreferences prefs = ImmichConfig.prefs(this);
+        if (!prefs.getBoolean(ImmichConfig.KEY_BACKUP, false)) {
+            return false;
+        }
+        long lastImage = prefs.getLong(KEY_LAST_ID_IMAGE, 0);
+        long lastVideo = prefs.getLong(KEY_LAST_ID_VIDEO, 0);
+        List<ImmichUploader.Item> items = new ArrayList<>();
+        long maxImage = collect(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, lastImage, false,
+                items);
+        long maxVideo = collect(MediaStore.Video.Media.EXTERNAL_CONTENT_URI, lastVideo, true,
+                items);
+        if (items.isEmpty()) {
+            prefs.edit().putLong(KEY_LAST_ID_IMAGE, maxImage)
+                    .putLong(KEY_LAST_ID_VIDEO, maxVideo).apply();
+            return false;
+        }
+        Log.i(TAG, items.size() + " new in the camera roll");
+        // Each file dealt with moves the start of the next run past it, in
+        // media-store order, so a run cut short or failing halfway does not
+        // go over the same files again.
+        long[] mark = {lastImage, lastVideo};
+        ImmichUploader.Result r = new ImmichUploader(this).upload(items, () -> mStopped,
+                item -> mark[item.video ? 1 : 0] = item.mediaId);
+        boolean complete = !r.retry && !r.authFailed;
+        if (r.retry && !mStopped && r.stuck != null) {
+            // The same file in the way three runs running (a server error
+            // that does not pass, a connection cut on it): pass it by.
+            String id = (r.stuck.video ? "v" : "i") + r.stuck.mediaId;
+            int tries = id.equals(prefs.getString(KEY_STUCK, null))
+                    ? prefs.getInt(KEY_STUCK_TRIES, 0) + 1 : 1;
+            prefs.edit().putString(KEY_STUCK, id).putInt(KEY_STUCK_TRIES, tries).apply();
+            if (tries >= 3) {
+                Log.w(TAG, "giving up on " + r.stuck.name);
+                mark[r.stuck.video ? 1 : 0] = r.stuck.mediaId;
+                r.failed++;
+                prefs.edit().remove(KEY_STUCK).remove(KEY_STUCK_TRIES).apply();
+            }
+        }
+        prefs.edit().putLong(KEY_LAST_RUN, System.currentTimeMillis())
+                .putString(KEY_LAST_RESULT, r.uploaded + "/" + r.skipped + "/" + r.failed)
+                .putLong(KEY_LAST_ID_IMAGE, complete ? maxImage : mark[0])
+                .putLong(KEY_LAST_ID_VIDEO, complete ? maxVideo : mark[1])
+                .apply();
+        return r.retry && !r.authFailed;
+    }
+
+    // The camera's pictures (DCIM/Camera) newer than the last run's.
+    private long collect(Uri uri, long after, boolean video, List<ImmichUploader.Item> out) {
+        String[] columns = {MediaStore.MediaColumns._ID, MediaStore.MediaColumns.DATA,
+                MediaStore.MediaColumns.DISPLAY_NAME, MediaStore.MediaColumns.MIME_TYPE,
+                MediaStore.MediaColumns.DATE_MODIFIED, MediaStore.Images.ImageColumns.DATE_TAKEN};
+        long max = after;
+        try (Cursor c = getContentResolver().query(uri, columns,
+                MediaStore.MediaColumns._ID + " > ? AND " + MediaStore.MediaColumns.DATA
+                        + " LIKE ?",
+                new String[] {String.valueOf(after), "%/DCIM/Camera/%"},
+                MediaStore.MediaColumns._ID)) {
+            while (c != null && c.moveToNext()) {
+                long id = c.getLong(0);
+                File file = new File(c.getString(1));
+                max = Math.max(max, id);
+                if (!file.isFile()) {
+                    continue;
+                }
+                long modified = c.getLong(4) * 1000;
+                long taken = c.isNull(5) ? modified : c.getLong(5);
+                ImmichUploader.Item item = new ImmichUploader.Item(file, c.getString(2),
+                        c.getString(3), taken > 0 ? taken : modified, modified,
+                        file.getName() + "-" + file.length());
+                item.mediaId = id;
+                item.video = video;
+                out.add(item);
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "media query: " + e);
+        }
+        return max;
+    }
+
+    /** Boot and app update: the change trigger does not survive a reboot. */
+    public static class Starter extends BroadcastReceiver {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            schedule(context);
+        }
+    }
+}
