+
+package com.android.gallery3d.player;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.media.AudioManager;
+import android.net.Uri;
+import android.os.Handler;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.GestureDetector;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.SurfaceView;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.ImageButton;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.PopupMenu;
+import android.widget.SeekBar;
+import android.widget.TextView;
+
+import com.google.android.exoplayer2.C;
+import com.google.android.exoplayer2.DefaultRenderersFactory;
+import com.google.android.exoplayer2.ExoPlayer;
+import com.google.android.exoplayer2.Format;
+import com.google.android.exoplayer2.MediaItem;
+import com.google.android.exoplayer2.PlaybackException;
+import com.google.android.exoplayer2.Player;
+import com.google.android.exoplayer2.Tracks;
+import com.google.android.exoplayer2.audio.AudioAttributes;
+import com.google.android.exoplayer2.source.DefaultMediaSourceFactory;
+import com.google.android.exoplayer2.text.Cue;
+import com.google.android.exoplayer2.text.CueGroup;
+import com.google.android.exoplayer2.trackselection.TrackSelectionOverride;
+import com.google.android.exoplayer2.upstream.DefaultDataSource;
+import com.google.android.exoplayer2.video.VideoSize;
+
+import org.codeaurora.gallery.R;
+
+import java.util.Locale;
+
+/**
+ * ON-FireLOS: the video player itself - ExoPlayer on the hardware decoders
+ * behind a calm, touch-friendly surface: big controls in the middle, double
+ * tap left or right for 10 s back or ahead, a swipe up or down on the left
+ * for brightness and on the right for volume, audio and subtitle tracks, and
+ * it remembers where a video was left off.
+ *
+ * It runs full screen in VideoActivity and inside the gallery's photo view;
+ * the {@link Host} is what differs. Inline it leaves the title to the
+ * gallery, offers a button to go full screen, and passes a sideways swipe on
+ * so the gallery can move to the next picture.
+ */
+public final class PlayerView extends FrameLayout {
+    private static final String PREFS = "video_positions";
+    private static final long SEEK_MS = 10_000;
+    private static final long HIDE_MS = 3_500;
+    // The last videos left halfway, at most this many: older ones are dropped.
+    private static final int REMEMBERED = 100;
+
+    /** What the player needs from where it is shown. */
+    public interface Host {
+        Window window();
+
+        /** The back arrow (full screen only). */
+        void onBack();
+
+        /** Picture-in-picture; false where there is none. */
+        boolean enterPip(float aspect);
+
+        boolean isInPip();
+
+        /** The full-screen button (inline only). */
+        void onFullscreen();
+
+        /** A tap showed or hid the controls. */
+        void onTap(boolean controlsShown);
+
+        /** Inline: whether the gallery's bars show, which a tap toggles. */
+        boolean barsShown();
+
+        /** A sideways swipe, +1 for the next picture, -1 for the previous. */
+        void onSwipe(int direction);
+    }
+
+    private final Host mHost;
+    private final boolean mInline;
+    private final Handler mHandler = new Handler();
+    private final AudioManager mAudio;
+
+    private ExoPlayer mPlayer;
+    private Uri mUri;
+    private String mTitle;
+
+    private AspectFrame mFrame;
+    private View mControls;
+    private ImageButton mPlay;
+    private ImageButton mTracks;
+    private TextView mTitleView;
+    private SeekBar mSeek;
+    private TextView mElapsed;
+    private TextView mTotal;
+    private TextView mSubtitle;
+    private TextView mBadge;
+    private TextView mResume;
+    private TextView mError;
+    private boolean mDragging;
+    private float mWindowBrightness = Float.NaN;
+
+    private final Runnable mHide = () -> showControls(false);
+    private final Runnable mHideBadge = () -> mBadge.animate().alpha(0).setDuration(200).start();
+    private final Runnable mProgress = new Runnable() {
+        @Override
+        public void run() {
+            updateProgress();
+            mHandler.postDelayed(this, 250);
+        }
+    };
+
+    public PlayerView(Context context, Host host, boolean inline) {
+        super(context);
+        mHost = host;
+        mInline = inline;
+        mAudio = context.getSystemService(AudioManager.class);
+        buildViews();
+    }
+
+    /**
+     * Starts a video. A position of -1 continues where it was left off, and
+     * says so for a moment, with a way back to the start.
+     */
+    public void open(Uri uri, String title, long position, boolean play) {
+        release();
+        mUri = uri;
+        mTitle = title;
+        mTitleView.setText(title);
+        mError.setVisibility(View.GONE);
+        mFrame.setAspect(0);
+        Context context = getContext();
+        // A video past the hardware decoder's size (phone recordings of
+        // 2336x1080, say) falls back to the software decoder rather than
+        // failing on the first.
+        mPlayer = new ExoPlayer.Builder(context,
+                new DefaultRenderersFactory(context).setEnableDecoderFallback(true))
+                .setMediaSourceFactory(new DefaultMediaSourceFactory(
+                        new DefaultDataSource.Factory(context,
+                                SecureHttpDataSource.factory(context))))
+                .setAudioAttributes(new AudioAttributes.Builder()
+                        .setUsage(C.USAGE_MEDIA)
+                        .setContentType(C.AUDIO_CONTENT_TYPE_MOVIE)
+                        .build(), true)
+                .setHandleAudioBecomingNoisy(true)
+                .setWakeMode(C.WAKE_MODE_NETWORK)
+                .setSeekBackIncrementMs(SEEK_MS)
+                .setSeekForwardIncrementMs(SEEK_MS)
+                .build();
+        mPlayer.setVideoSurfaceView(mFrame.surface);
+        mPlayer.addListener(mListener);
+        mPlayer.setMediaItem(MediaItem.fromUri(uri));
+        mPlayer.prepare();
+        long resume = position >= 0 ? position : prefs().getLong(key(), 0);
+        if (resume > 0) {
+            mPlayer.seekTo(resume);
+            if (position < 0) {
+                mResume.setText(getContext().getString(R.string.player_resumed, time(resume))
+                        + "   " + getContext().getString(R.string.player_restart));
+                mResume.setVisibility(View.VISIBLE);
+                mHandler.postDelayed(() -> mResume.setVisibility(View.GONE), 6000);
+            }
+        }
+        mPlayer.setPlayWhenReady(play);
+        mHandler.removeCallbacks(mProgress);
+        mHandler.post(mProgress);
+        showControls(true);
+    }
+
+    /** Stops and frees the decoder; where it stood is kept for next time. */
+    public void release() {
+        mHandler.removeCallbacksAndMessages(null);
+        Window window = mHost.window();
+        if (!Float.isNaN(mWindowBrightness) && window != null) {
+            WindowManager.LayoutParams lp = window.getAttributes();
+            lp.screenBrightness = mWindowBrightness;
+            window.setAttributes(lp);
+            mWindowBrightness = Float.NaN;
+        }
+        if (mPlayer != null) {
+            remember();
+            mPlayer.removeListener(mListener);
+            mPlayer.release();
+            mPlayer = null;
+            keepScreenOn(false);
+        }
+    }
+
+    public void onHostResume() {
+        if (mPlayer != null) {
+            mHandler.removeCallbacks(mProgress);
+            mHandler.post(mProgress);
+        }
+    }
+
+    public void onHostPause() {
+        mHandler.removeCallbacks(mProgress);
+        remember();
+    }
+
+    public void pause() {
+        if (mPlayer != null) {
+            mPlayer.pause();
+        }
+    }
+
+    public boolean isOpen() {
+        return mPlayer != null;
+    }
+
+    public long position() {
+        return mPlayer != null ? mPlayer.getCurrentPosition() : 0;
+    }
+
+    public boolean playWhenReady() {
+        return mPlayer != null && mPlayer.getPlayWhenReady();
+    }
+
+    public boolean isPlaying() {
+        return mPlayer != null && mPlayer.isPlaying();
+    }
+
+    public float aspect() {
+        return mFrame.aspect;
+    }
+
+    private final Player.Listener mListener = new Player.Listener() {
+        @Override
+        public void onVideoSizeChanged(VideoSize size) {
+            if (size.width > 0 && size.height > 0) {
+                mFrame.setAspect(size.width * size.pixelWidthHeightRatio / size.height);
+            }
+        }
+
+        @Override
+        public void onIsPlayingChanged(boolean playing) {
+            updatePlayButton();
+            // The screen stays on while a video plays, not while paused.
+            keepScreenOn(playing);
+            if (playing) {
+                scheduleHide();
+            } else {
+                mHandler.removeCallbacks(mHide);
+            }
+        }
+
+        @Override
+        public void onPlaybackStateChanged(int state) {
+            updatePlayButton();
+            if (state == Player.STATE_ENDED) {
+                forget();
+                showControls(true);
+            }
+        }
+
+        @Override
+        public void onPlayerError(PlaybackException error) {
+            mError.setText(getContext().getString(R.string.player_error) + "\n"
+                    + error.getErrorCodeName());
+            mError.setVisibility(View.VISIBLE);
+            showControls(true);
+        }
+
+        @Override
+        public void onCues(CueGroup cues) {
+            StringBuilder text = new StringBuilder();
+            for (Cue cue : cues.cues) {
+                if (cue.text != null) {
+                    if (text.length() > 0) {
+                        text.append('\n');
+                    }
+                    text.append(cue.text);
+                }
+            }
+            mSubtitle.setText(text);
+            mSubtitle.setVisibility(text.length() > 0 ? View.VISIBLE : View.GONE);
+        }
+
+        @Override
+        public void onTracksChanged(Tracks tracks) {
+            int choices = 0;
+            for (Tracks.Group g : tracks.getGroups()) {
+                if (g.getType() == C.TRACK_TYPE_TEXT) {
+                    choices += 2;
+                } else if (g.getType() == C.TRACK_TYPE_AUDIO) {
+                    choices++;
+                }
+            }
+            mTracks.setVisibility(choices > 1 ? View.VISIBLE : View.GONE);
+        }
+    };
+
+    private void keepScreenOn(boolean on) {
+        Window window = mHost.window();
+        if (window == null) {
+            return;
+        }
+        if (on) {
+            window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        } else {
+            window.clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        }
+    }
+
+    // Where each video was left off: from 10 s in, up to 10 s before the end.
+
+    private SharedPreferences prefs() {
+        return getContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private String key() {
+        try {
+            byte[] d = java.security.MessageDigest.getInstance("SHA-1")
+                    .digest(mUri.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            StringBuilder s = new StringBuilder();
+            for (int i = 0; i < 8; i++) {
+                s.append(String.format("%02x", d[i]));
+            }
+            return s.toString();
+        } catch (java.security.NoSuchAlgorithmException e) {
+            return Integer.toHexString(mUri.toString().hashCode());
+        }
+    }
+
+    private void remember() {
+        if (mPlayer == null) {
+            return;
+        }
+        long position = mPlayer.getCurrentPosition();
+        long duration = mPlayer.getDuration();
+        if (position > 10_000 && duration != C.TIME_UNSET && position < duration - 10_000) {
+            SharedPreferences prefs = prefs();
+            SharedPreferences.Editor e = prefs.edit().putLong(key(), position)
+                    .putLong(key() + ".t", System.currentTimeMillis())
+                    .putString(key() + ".u", mUri.toString())
+                    .putString(key() + ".n", mTitle != null ? mTitle : "");
+            java.util.Map<String, ?> all = prefs.getAll();
+            if (all.size() > 4 * REMEMBERED) {
+                // Drop the entry left longest ago.
+                String oldest = null;
+                long oldestTime = Long.MAX_VALUE;
+                for (java.util.Map.Entry<String, ?> entry : all.entrySet()) {
+                    if (entry.getKey().endsWith(".t") && !entry.getKey().equals(key() + ".t")
+                            && entry.getValue() instanceof Long
+                            && (Long) entry.getValue() < oldestTime) {
+                        oldestTime = (Long) entry.getValue();
+                        oldest = entry.getKey();
+                    }
+                }
+                if (oldest != null) {
+                    String base = oldest.substring(0, oldest.length() - 2);
+                    e.remove(oldest).remove(base).remove(base + ".u").remove(base + ".n");
+                }
+            }
+            e.apply();
+        } else if (duration != C.TIME_UNSET) {
+            forget();
+        }
+    }
+
+    private void forget() {
+        if (mUri != null) {
+            prefs().edit().remove(key()).remove(key() + ".t").remove(key() + ".u")
+                    .remove(key() + ".n").apply();
+        }
+    }
