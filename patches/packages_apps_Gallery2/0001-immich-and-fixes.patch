+    private void updateRail(boolean animate) {
+        if (mNavRail == null) {
+            return;
+        }
+        final View holder = (View) mNavRail.getParent();
+        final boolean show = mDrawerLayoutSupported && !mMediaFullscreen;
+        final int full = mNavRail.getLayoutParams().width;
+        boolean shown = holder.getVisibility() == View.VISIBLE;
+        if (mRailAnimator != null) {
+            mRailAnimator.cancel();
+            mRailAnimator = null;
+        }
+        if (!animate || shown == show && holder.getLayoutParams().width == (show ? full : 0)) {
+            setRailWidth(holder, full);
+            holder.setVisibility(show ? View.VISIBLE : View.GONE);
+            return;
+        }
+        int from = shown ? holder.getLayoutParams().width : 0;
+        setRailWidth(holder, from);
+        holder.setVisibility(View.VISIBLE);
+        mRailAnimator = android.animation.ValueAnimator.ofInt(from, show ? full : 0);
+        mRailAnimator.setDuration(220);
+        mRailAnimator.setInterpolator(
+                new android.view.animation.PathInterpolator(0.4f, 0f, 0.2f, 1f));
+        mRailAnimator.addUpdateListener(
+                a -> setRailWidth(holder, (Integer) a.getAnimatedValue()));
+        mRailAnimator.addListener(new android.animation.AnimatorListenerAdapter() {
+            private boolean mCancelled;
+
+            @Override
+            public void onAnimationCancel(android.animation.Animator a) {
+                mCancelled = true;
+            }
+
+            @Override
+            public void onAnimationEnd(android.animation.Animator a) {
+                if (!mCancelled && !show) {
+                    holder.setVisibility(View.GONE);
+                    setRailWidth(holder, full);
+                }
+            }
+        });
+        mRailAnimator.start();
+    }
