+
+package com.android.gallery3d.player;
+
+import android.app.Activity;
+import android.app.PictureInPictureParams;
+import android.content.Intent;
+import android.content.res.Configuration;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Bundle;
+import android.provider.OpenableColumns;
+import android.text.TextUtils;
+import android.util.Rational;
+import android.view.View;
+import android.view.Window;
+
+/**
+ * ON-FireLOS: the video player full screen, for every video opened from
+ * another app and for the gallery's own when they go full screen. The player
+ * itself is {@link PlayerView}; this adds picture-in-picture and immersive
+ * mode. The gallery hands over where its inline player stood with
+ * {@link #EXTRA_POSITION} and {@link #EXTRA_PLAYING}.
+ */
+public class VideoActivity extends Activity implements PlayerView.Host {
+    public static final String EXTRA_POSITION = "org.onfirelos.gallery.extra.POSITION";
+    public static final String EXTRA_PLAYING = "org.onfirelos.gallery.extra.PLAYING";
+
+    private PlayerView mPlayer;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Uri uri = getIntent().getData();
+        if (uri == null) {
+            finish();
+            return;
+        }
+        mPlayer = new PlayerView(this, this, false);
+        setContentView(mPlayer);
+        immersive();
+        long position;
+        boolean play;
+        if (savedInstanceState != null) {
+            position = savedInstanceState.getLong("position", 0);
+            play = savedInstanceState.getBoolean("playing", true);
+        } else {
+            position = getIntent().getLongExtra(EXTRA_POSITION, -1);
+            play = getIntent().getBooleanExtra(EXTRA_PLAYING, true);
+        }
+        mPlayer.open(uri, title(uri), position, play);
+    }
+
+    @Override
+    protected void onSaveInstanceState(Bundle out) {
+        super.onSaveInstanceState(out);
+        if (mPlayer != null && mPlayer.isOpen()) {
+            out.putLong("position", mPlayer.position());
+            out.putBoolean("playing", mPlayer.playWhenReady());
+        }
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        immersive();
+        if (mPlayer != null) {
+            mPlayer.onHostResume();
+        }
+    }
+
+    @Override
+    protected void onPause() {
+        super.onPause();
+        if (mPlayer != null) {
+            mPlayer.onHostPause();
+        }
+    }
+
+    @Override
+    protected void onStop() {
+        super.onStop();
+        // Out of sight and not in picture-in-picture: stop.
+        if (mPlayer != null && !isInPictureInPictureMode()) {
+            mPlayer.pause();
+        }
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        if (mPlayer != null) {
+            mPlayer.release();
+            mPlayer = null;
+        }
+    }
+
+    @Override
+    protected void onUserLeaveHint() {
+        super.onUserLeaveHint();
+        // Home while a video plays: it carries on in a small window.
+        if (mPlayer != null && mPlayer.isPlaying()) {
+            enterPip(mPlayer.aspect());
+        }
+    }
+
+    @Override
+    public void onPictureInPictureModeChanged(boolean pip, Configuration config) {
+        super.onPictureInPictureModeChanged(pip, config);
+        if (mPlayer != null) {
+            mPlayer.showControls(!pip);
+        }
+        if (!pip) {
+            immersive();
+        }
+    }
+
+    // PlayerView.Host
+
+    @Override
+    public Window window() {
+        return getWindow();
+    }
+
+    @Override
+    public void onBack() {
+        finish();
+    }
+
+    @Override
+    public boolean enterPip(float aspect) {
+        float a = aspect > 0 ? aspect : 16f / 9f;
+        a = Math.max(0.42f, Math.min(2.39f, a));
+        return enterPictureInPictureMode(new PictureInPictureParams.Builder()
+                .setAspectRatio(new Rational(Math.round(a * 1000), 1000))
+                .build());
+    }
+
+    @Override
+    public boolean isInPip() {
+        return isInPictureInPictureMode();
+    }
+
+    @Override
+    public void onFullscreen() {
+    }
+
+    @Override
+    public void onTap(boolean controlsShown) {
+    }
+
+    @Override
+    public void onSwipe(int direction) {
+    }
+
+    @Override
+    public boolean barsShown() {
+        return false;
+    }
+
+    private String title(Uri uri) {
+        String t = getIntent().getStringExtra(Intent.EXTRA_TITLE);
+        if (!TextUtils.isEmpty(t)) {
+            return t;
+        }
+        if ("content".equals(uri.getScheme())) {
+            try (Cursor c = getContentResolver().query(uri,
+                    new String[] {OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+                if (c != null && c.moveToFirst() && !c.isNull(0)) {
+                    return c.getString(0);
+                }
+            } catch (RuntimeException ignored) {
+            }
+        }
+        String last = uri.getLastPathSegment();
+        return last != null ? last : "";
+    }
+
+    private void immersive() {
+        getWindow().getDecorView().setSystemUiVisibility(
+                View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY | View.SYSTEM_UI_FLAG_FULLSCREEN
+                        | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION | View.SYSTEM_UI_FLAG_LAYOUT_STABLE
+                        | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
+                        | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION);
+    }
+}
