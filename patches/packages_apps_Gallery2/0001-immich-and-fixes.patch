+
+/**
+ * ON-FireLOS: the gallery's sections as a navigation rail on the left, the
+ * way large-screen photo apps do it, instead of a bar along the bottom: the
+ * photos keep the full height and the thumb reaches it holding the tablet in
+ * landscape. The sections sit at the foot: holding a 10" tablet with both
+ * hands, the thumbs are at the bottom corners. The current section sits in a
+ * pill of the accent colour. The settings are in the navigation bar's slot.
+ */
+public class NavRail extends LinearLayout {
+    public interface Listener {
+        void onSectionSelected(int index);
+    }
+
+    // The fourth, Immich, shows only while it is set up.
+    private static final int[] ICONS = {R.drawable.ic_timeline, R.drawable.ic_album,
+            R.drawable.ic_video, R.drawable.ic_immich_cloud};
+    private static final int[] LABELS = {R.string.timeline_title, R.string.albums_title,
+            R.string.videos_title, R.string.immich_title};
+    public static final int IMMICH = 3;
+
+    private final View[] mItems = new View[ICONS.length];
+    private final View[] mPills = new View[ICONS.length];
+    private final ImageView[] mIcons = new ImageView[ICONS.length];
+    private final TextView[] mLabels = new TextView[ICONS.length];
+    private final int mStrong;
+    private final int mQuiet;
+    private final int mPill;
+    private Listener mListener;
+    private Listener mReselectListener;
+    private int mSelected = 0;
+
+    public NavRail(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setOrientation(VERTICAL);
+        setGravity(Gravity.CENTER_HORIZONTAL);
+        setBackgroundColor(context.getColor(R.color.gallery_bar_background));
+        mStrong = context.getColor(R.color.gallery_bar_foreground);
+        mQuiet = (mStrong & 0x00FFFFFF) | 0x99000000;
+        mPill = (context.getColor(R.color.accent) & 0x00FFFFFF) | 0x52000000;
+        setPadding(0, 0, 0, dp(12));
+        // The sections at the foot, where the thumb is.
+        addView(new View(context), new LayoutParams(1, 0, 1));
+
+        for (int i = 0; i < ICONS.length; i++) {
+            final int index = i;
+            LinearLayout item = new LinearLayout(context);
+            item.setOrientation(VERTICAL);
+            item.setGravity(Gravity.CENTER_HORIZONTAL);
+            item.setPadding(0, dp(10), 0, dp(10));
+            FrameLayout pill = new FrameLayout(context);
+            GradientDrawable shape = new GradientDrawable();
+            shape.setCornerRadius(dp(16));
+            pill.setBackground(shape);
+            ImageView icon = new ImageView(context);
+            icon.setImageResource(ICONS[i]);
+            pill.addView(icon, new FrameLayout.LayoutParams(dp(24), dp(24), Gravity.CENTER));
+            item.addView(pill, new LayoutParams(dp(56), dp(32)));
+            TextView label = new TextView(context);
+            label.setText(LABELS[i]);
+            label.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+            label.setGravity(Gravity.CENTER);
+            label.setSingleLine(true);
+            LayoutParams lp = new LayoutParams(dp(80), LayoutParams.WRAP_CONTENT);
+            lp.topMargin = dp(4);
+            item.addView(label, lp);
+            item.setContentDescription(context.getString(LABELS[i]));
+            item.setOnClickListener(v -> select(index, true));
+            addView(item, new LayoutParams(dp(80), LayoutParams.WRAP_CONTENT));
+            mItems[i] = item;
+            mPills[i] = pill;
+            mIcons[i] = icon;
+            mLabels[i] = label;
+        }
+
+        mItems[IMMICH].setVisibility(GONE);
+        update();
+    }
+
+    public void setImmichVisible(boolean visible) {
+        mItems[IMMICH].setVisibility(visible ? VISIBLE : GONE);
+    }
+
+    public void setListener(Listener listener) {
+        mListener = listener;
+    }
+
+    /** Told of a tap on the section already shown. */
+    public void setReselectListener(Listener listener) {
+        mReselectListener = listener;
+    }
+
+    public int selected() {
+        return mSelected;
+    }
+
+    /** The section shown in the rail one step on (+1 down, -1 up) from another; -1 if none. */
+    public int neighbour(int from, int step) {
+        for (int i = from + step; i >= 0 && i < mItems.length; i += step) {
+            if (mItems[i].getVisibility() == VISIBLE) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    /** Marks a section; with notify, also switches to it. */
+    public void select(int index, boolean notify) {
+        boolean changed = index != mSelected;
+        mSelected = index;
+        update();
+        if (notify && changed && mListener != null) {
+            mListener.onSectionSelected(index);
+        } else if (notify && !changed && mReselectListener != null) {
+            mReselectListener.onSectionSelected(index);
+        }
+    }
+
+    private void update() {
+        for (int i = 0; i < mPills.length; i++) {
+            boolean on = i == mSelected;
+            ((GradientDrawable) mPills[i].getBackground()).setColor(on ? mPill : 0);
+            mIcons[i].setImageTintList(ColorStateList.valueOf(on ? mStrong : mQuiet));
+            mLabels[i].setTextColor(on ? mStrong : mQuiet);
+            mLabels[i].setTypeface(Typeface.create("sans-serif-medium",
+                    on ? Typeface.BOLD : Typeface.NORMAL));
+        }
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                getResources().getDisplayMetrics());
+    }
+}
