+
+package com.android.gallery3d.data;
+
+import android.os.Handler;
+import android.os.SystemClock;
+import android.util.Log;
+
+import org.codeaurora.gallery.R;
+import com.android.gallery3d.app.GalleryApp;
+import com.android.gallery3d.immich.ImmichClient;
+import com.android.gallery3d.immich.ImmichConfig;
+import com.android.gallery3d.util.Future;
+import com.android.gallery3d.util.FutureListener;
+import com.android.gallery3d.util.ThreadPool;
+import com.android.gallery3d.util.ThreadPool.JobContext;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+
+/**
+ * The Immich albums: "All photos" first, then every album the user owns or
+ * shares. Loaded in the background; empty until Immich is set up, and kept
+ * as it was when the server cannot be reached.
+ */
+public class ImmichAlbumSet extends MediaSet implements FutureListener<ArrayList<MediaSet>> {
+    private static final String TAG = "ImmichAlbumSet";
+    // Albums change rarely; look again at most every five minutes.
+    private static final long REFRESH_MS = 5 * 60 * 1000;
+
+    private final GalleryApp mApplication;
+    private final Handler mHandler;
+    private ArrayList<MediaSet> mAlbums = new ArrayList<>();
+    private ArrayList<MediaSet> mLoadBuffer;
+    private Future<ArrayList<MediaSet>> mLoadTask;
+    private boolean mIsLoading;
+    private long mLoadedConfig;
+    private long mLoadedAt;
+
+    public ImmichAlbumSet(Path path, GalleryApp application) {
+        super(path, nextVersionNumber());
+        mApplication = application;
+        mHandler = new Handler(application.getMainLooper());
+    }
+
+    @Override
+    public String getName() {
+        return mApplication.getResources().getString(R.string.immich_title);
+    }
+
+    @Override
+    public MediaSet getSubMediaSet(int index) {
+        return mAlbums.get(index);
+    }
+
+    @Override
+    public int getSubMediaSetCount() {
+        return mAlbums.size();
+    }
+
+    @Override
+    public synchronized boolean isLoading() {
+        return mIsLoading;
+    }
+
+    @Override
+    public synchronized long reload() {
+        long now = SystemClock.elapsedRealtime();
+        boolean stale = mLoadedConfig != ImmichConfig.version()
+                || now - mLoadedAt > REFRESH_MS;
+        if (stale && !mIsLoading) {
+            mLoadedConfig = ImmichConfig.version();
+            mLoadedAt = now;
+            mIsLoading = true;
+            mLoadTask = mApplication.getThreadPool().submit(new Loader(), this);
+        }
+        if (mLoadBuffer != null) {
+            mAlbums = mLoadBuffer;
+            mLoadBuffer = null;
+            for (MediaSet album : mAlbums) {
+                album.reload();
+            }
+            mDataVersion = nextVersionNumber();
+        }
+        return mDataVersion;
+    }
+
+    @Override
+    public synchronized void onFutureDone(Future<ArrayList<MediaSet>> future) {
+        if (mLoadTask != future) return;
+        mIsLoading = false;
+        ArrayList<MediaSet> albums = future.get();
+        if (albums == null) {
+            // Unreachable: keep what is shown, and try again on the next
+            // reload instead of after the five minutes.
+            mLoadedConfig = Long.MIN_VALUE;
+            return;
+        }
+        mLoadBuffer = albums;
+        mHandler.post(this::notifyContentChanged);
+    }
+
+    private class Loader implements ThreadPool.Job<ArrayList<MediaSet>> {
+        @Override
+        public ArrayList<MediaSet> run(JobContext jc) {
+            ArrayList<MediaSet> albums = new ArrayList<>();
+            if (!ImmichConfig.showInGallery(mApplication.getAndroidContext())) {
+                return albums;
+            }
+            ImmichClient client = ImmichClient.get(mApplication.getAndroidContext());
+            if (client == null) {
+                return albums;
+            }
+            DataManager manager = mApplication.getDataManager();
+            try {
+                JSONObject first = client.assets(null, 1, 1);
+                JSONArray items = first.optJSONArray("items");
+                String cover = items != null && items.length() > 0
+                        ? items.getJSONObject(0).optString("id", null) : null;
+                albums.add(album(manager, Path.fromString("/immich/timeline"), null,
+                        mApplication.getResources().getString(R.string.immich_all_photos),
+                        client.timelineCount(), cover));
+                JSONArray list = client.albums();
+                for (int i = 0; i < list.length() && !jc.isCancelled(); i++) {
+                    JSONObject a = list.getJSONObject(i);
+                    String id = a.getString("id");
+                    albums.add(album(manager, Path.fromString("/immich/album/" + id), id,
+                            a.optString("albumName"), a.optInt("assetCount", 0),
+                            a.optString("albumThumbnailAssetId", null)));
+                }
+                return albums;
+            } catch (Exception e) {
+                Log.w(TAG, "albums: " + e);
+                return null;
+            }
+        }
+    }
+
+    private ImmichAlbum album(DataManager manager, Path path, String id, String name,
+            int count, String cover) {
+        MediaObject object;
+        synchronized (DataManager.LOCK) {
+            object = manager.peekMediaObject(path);
+            if (!(object instanceof ImmichAlbum)) {
+                return new ImmichAlbum(path, mApplication, id, name, count, cover);
+            }
+        }
+        // Outside DataManager.LOCK: update() takes the album's own lock, and
+        // getCoverMediaItem() takes the two the other way round.
+        ((ImmichAlbum) object).update(name, count, cover);
+        return (ImmichAlbum) object;
+    }
+}
