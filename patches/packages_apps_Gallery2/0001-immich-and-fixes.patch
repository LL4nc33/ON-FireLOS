+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.gallery3d.data;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.util.SparseArray;
+
+import com.android.gallery3d.app.GalleryApp;
+import com.android.gallery3d.immich.ImmichClient;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+
+/**
+ * One Immich album, or all photos (id null), newest first. Only the pages
+ * that are looked at are fetched - 200 assets each - so a library of tens of
+ * thousands of photos costs no more memory than the part on screen. The
+ * network is never used under this object's lock, so the UI thread never
+ * waits for it; asked from the UI thread, a missing page is fetched in the
+ * background and the gallery told when it is in.
+ */
+public class ImmichAlbum extends MediaSet {
+    private static final String TAG = "ImmichAlbum";
+    private static final int PAGE = 200;
+    // Pages kept: enough for fast scrolling back and forth.
+    private static final int KEEP_PAGES = 8;
+
+    private final GalleryApp mApplication;
+    private final Handler mHandler;
+    private final String mId;
+    private String mName;
+    private volatile int mCount;
+    private String mCoverId;
+    private final SparseArray<ArrayList<MediaItem>> mPages = new SparseArray<>();
+    private final ArrayList<Integer> mPageOrder = new ArrayList<>();
+    private final HashSet<Integer> mLoading = new HashSet<>();
+
+    public ImmichAlbum(Path path, GalleryApp application, String id, String name, int count,
+            String coverId) {
+        super(path, nextVersionNumber());
+        mApplication = application;
+        mHandler = new Handler(application.getMainLooper());
+        mId = id;
+        mName = name != null ? name : "";
+        mCount = count;
+        mCoverId = coverId;
+    }
+
+    synchronized void update(String name, int count, String coverId) {
+        boolean changed = count != mCount || (coverId != null && !coverId.equals(mCoverId));
+        mName = name != null ? name : mName;
+        mCount = count;
+        mCoverId = coverId;
+        if (changed) {
+            mPages.clear();
+            mPageOrder.clear();
+            mDataVersion = nextVersionNumber();
+        }
+    }
+
+    @Override
+    public synchronized String getName() {
+        return mName;
+    }
+
+    @Override
+    public boolean isLeafAlbum() {
+        return true;
+    }
+
+    @Override
+    public int getMediaItemCount() {
+        return Math.max(mCount, 0);
+    }
+
+    @Override
+    public MediaItem getCoverMediaItem() {
+        // ImmichItem.get takes DataManager.LOCK, under which the album set
+        // calls update(): never hold this album's lock while taking it.
+        String cover;
+        synchronized (this) {
+            cover = mCoverId;
+        }
+        if (cover != null) {
+            return ImmichItem.get(mApplication, cover);
+        }
+        return super.getCoverMediaItem();
+    }
+
+    @Override
+    public ArrayList<MediaItem> getMediaItem(int start, int count) {
+        ArrayList<MediaItem> result = new ArrayList<>(count);
+        int end = Math.min(start + count, getMediaItemCount());
+        for (int i = start; i < end; ) {
+            int p = i / PAGE;
+            ArrayList<MediaItem> page = page(p);
+            int from = i - p * PAGE;
+            if (from >= page.size()) {
+                break;
+            }
+            int to = Math.min(page.size(), end - p * PAGE);
+            result.addAll(page.subList(from, to));
+            i = p * PAGE + to;
+        }
+        return result;
+    }
+
+    private ArrayList<MediaItem> page(int p) {
+        synchronized (this) {
+            ArrayList<MediaItem> page = mPages.get(p);
+            if (page != null) {
+                return page;
+            }
+            if (Looper.myLooper() == Looper.getMainLooper()) {
+                if (mLoading.add(p)) {
+                    mApplication.getThreadPool().submit(jc -> {
+                        fetch(p);
+                        synchronized (ImmichAlbum.this) {
+                            mLoading.remove(p);
+                        }
+                        mHandler.post(this::notifyContentChanged);
+                        return null;
+                    });
+                }
+                return new ArrayList<>();
+            }
+        }
+        ArrayList<MediaItem> page = fetch(p);
+        return page != null ? page : new ArrayList<>();
+    }
+
+    // Network, without the lock; keeps the page unless the fetch failed.
+    private ArrayList<MediaItem> fetch(int p) {
+        ImmichClient client = ImmichClient.get(mApplication.getAndroidContext());
+        if (client == null) {
+            return null;
+        }
+        ArrayList<MediaItem> page = new ArrayList<>();
+        try {
+            JSONObject result = client.assets(mId, p + 1, PAGE);
+            JSONArray items = result.optJSONArray("items");
+            for (int i = 0; items != null && i < items.length(); i++) {
+                page.add(ImmichItem.from(mApplication, items.getJSONObject(i)));
+            }
+        } catch (Exception e) {
+            Log.w(TAG, mName + " page " + p + ": " + e);
+            return null; // not kept: tried again next time
+        }
+        synchronized (this) {
+            if (mPages.get(p) == null) {
+                mPageOrder.add(p); // fetched twice at once: listed once
+            }
+            mPages.put(p, page);
+            while (mPageOrder.size() > KEEP_PAGES) {
+                mPages.remove(mPageOrder.remove(0));
+            }
+            mDataVersion = nextVersionNumber();
+        }
+        return page;
+    }
+
+    @Override
+    public synchronized long reload() {
+        return mDataVersion;
+    }
+}
