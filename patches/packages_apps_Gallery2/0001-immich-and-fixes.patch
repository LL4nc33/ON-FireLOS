diff --git a/proguard-player.flags b/proguard-player.flags
new file mode 100644
index 0000000..4596d17
--- /dev/null
+++ b/proguard-player.flags
@@ -0,0 +1,16 @@
+# ON-FireLOS: the video player's libraries.
+# ExoPlayer's download notification helper uses androidx.core, which the
+# player never reaches; its resources are not packaged either.
+-dontwarn androidx.core.**
+-dontwarn androidx.annotation.**
+-dontwarn com.google.android.exoplayer2.core.R*
+-dontwarn com.google.android.exoplayer2.offline.**
+-dontwarn com.google.android.exoplayer2.scheduler.**
+-dontwarn com.google.android.exoplayer2.ui.**
+# Classes of Android 10 to 12 (MediaParser, media metrics, Spatializer, ...),
+# which ExoPlayer calls only behind version checks; the SDK here is 9.
+-dontwarn com.google.android.exoplayer2.**
+# Guava's optional pieces.
+-dontwarn com.google.common.util.concurrent.**
+-dontwarn com.google.common.collect.MinMaxPriorityQueue
+-keep class com.android.gallery3d.player.** { *; }
