+
+package com.android.gallery3d.player;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.net.Uri;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+
+import org.codeaurora.gallery.R;
+
+/**
+ * ON-FireLOS: a video played where it is shown in the gallery's photo view,
+ * beside the rail, rather than in a screen of its own. The player lies over
+ * the photo view and under the gallery's bars and floating actions; a tap
+ * shows or hides its controls together with those, a sideways swipe moves on
+ * to the next picture, and its full-screen button hands the video over to
+ * VideoActivity where it stands. The decoder exists only while a video plays.
+ */
+public final class InlineVideo implements PlayerView.Host {
+    /** What the photo view does for the player. */
+    public interface Page {
+        void onTap(boolean controlsShown);
+
+        /** Moves to the next or previous picture; false if there is none. */
+        boolean onSwipe(int direction);
+
+        boolean barsShown();
+    }
+
+    private final Activity mActivity;
+    private final ViewGroup mParent;
+    private final Page mPage;
+    private PlayerView mView;
+    private Uri mUri;
+    private String mTitle;
+
+    public InlineVideo(Activity activity, ViewGroup parent, Page page) {
+        mActivity = activity;
+        mParent = parent;
+        mPage = page;
+    }
+
+    /** False if there is nothing to play (an Immich video while signed out). */
+    public boolean play(Uri uri, String title) {
+        stop();
+        if (uri == null) {
+            return false;
+        }
+        mUri = uri;
+        mTitle = title;
+        mView = new PlayerView(mActivity, this, true);
+        mParent.addView(mView, indexAboveGl(), new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        mView.open(uri, title, -1, true);
+        return true;
+    }
+
+    /** Stops and removes the player; where the video stood is kept. */
+    public void stop() {
+        if (mView != null) {
+            mView.release();
+            mParent.removeView(mView);
+            mView = null;
+        }
+    }
+
+    public boolean isShown() {
+        return mView != null;
+    }
+
+    // Right above the GL view and its cover, under whatever comes after.
+    private int indexAboveGl() {
+        int index = -1;
+        for (int id : new int[] {R.id.gl_parent_layout, R.id.gl_root_cover}) {
+            View v = mParent.findViewById(id);
+            if (v != null && v.getParent() == mParent) {
+                index = Math.max(index, mParent.indexOfChild(v));
+            }
+        }
+        return index + 1;
+    }
+
+    // PlayerView.Host
+
+    @Override
+    public Window window() {
+        return mActivity.getWindow();
+    }
+
+    @Override
+    public void onBack() {
+        stop();
+    }
+
+    @Override
+    public boolean enterPip(float aspect) {
+        return false;
+    }
+
+    @Override
+    public boolean isInPip() {
+        return false;
+    }
+
+    @Override
+    public void onFullscreen() {
+        if (mView == null) {
+            return;
+        }
+        long position = mView.position();
+        boolean playing = mView.playWhenReady();
+        Uri uri = mUri;
+        String title = mTitle;
+        stop();
+        mActivity.startActivity(new Intent(mActivity, VideoActivity.class)
+                .setDataAndType(uri, "video/*")
+                .putExtra(Intent.EXTRA_TITLE, title)
+                .putExtra(VideoActivity.EXTRA_POSITION, position)
+                .putExtra(VideoActivity.EXTRA_PLAYING, playing));
+    }
+
+    @Override
+    public void onTap(boolean controlsShown) {
+        mPage.onTap(controlsShown);
+    }
+
+    @Override
+    public void onSwipe(int direction) {
+        // A move stops the video through the photo view's own change.
+        mPage.onSwipe(direction);
+    }
+
+    @Override
+    public boolean barsShown() {
+        return mPage.barsShown();
+    }
+}
