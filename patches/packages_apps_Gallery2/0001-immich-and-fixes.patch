+
+package com.android.gallery3d.immich;
+
+import android.app.Activity;
+import android.app.Notification;
+import android.app.Service;
+import android.content.ClipData;
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.provider.MediaStore;
+import android.provider.OpenableColumns;
+import android.util.Log;
+import android.widget.Toast;
+
+import org.codeaurora.gallery.R;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * "Upload to Immich" in the share sheet of every app. The activity only hands
+ * the shared items, with the right to read them, to a short foreground
+ * service and is gone again; the service copies and uploads them.
+ */
+public class ImmichShareActivity extends Activity {
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!ImmichConfig.isConfigured(this)) {
+            Toast.makeText(this, R.string.immich_not_set_up, Toast.LENGTH_LONG).show();
+            startActivity(new Intent(this, ImmichSettingsActivity.class));
+            finish();
+            return;
+        }
+        Intent in = getIntent();
+        ClipData clip = null;
+        if (Intent.ACTION_SEND_MULTIPLE.equals(in.getAction())) {
+            ArrayList<Uri> uris = in.getParcelableArrayListExtra(Intent.EXTRA_STREAM);
+            for (int i = 0; uris != null && i < uris.size(); i++) {
+                if (clip == null) {
+                    clip = ClipData.newRawUri(null, uris.get(i));
+                } else {
+                    clip.addItem(new ClipData.Item(uris.get(i)));
+                }
+            }
+        } else {
+            Uri uri = in.getParcelableExtra(Intent.EXTRA_STREAM);
+            if (uri != null) {
+                clip = ClipData.newRawUri(null, uri);
+            }
+        }
+        if (clip != null) {
+            Intent service = new Intent(this, UploadService.class);
+            service.setClipData(clip);
+            service.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            try {
+                startForegroundService(service);
+                Toast.makeText(this, R.string.immich_upload_started, Toast.LENGTH_SHORT).show();
+            } catch (SecurityException e) {
+                // An item the sharing app may not pass on.
+                Log.w("ImmichUpload", "share refused: " + e);
+                Toast.makeText(this, getString(R.string.immich_upload_failed,
+                        clip.getItemCount()), Toast.LENGTH_LONG).show();
+            }
+        }
+        finish();
+    }
+
+    /** Copies the shared items to the cache and uploads them. */
+    public static class UploadService extends Service {
+        private static final String TAG = "ImmichUpload";
+        // Shares that come in while one is still uploading run beside it,
+        // each in a folder of its own; the notification stays while any runs.
+        private static final java.util.concurrent.atomic.AtomicInteger sRunning =
+                new java.util.concurrent.atomic.AtomicInteger();
+
+        @Override
+        public IBinder onBind(Intent intent) {
+            return null;
+        }
+
+        @Override
+        public int onStartCommand(Intent intent, int flags, int startId) {
+            ImmichUploader uploader = new ImmichUploader(this);
+            startForeground(ImmichUploader.NOTIFICATION, uploader.preparing());
+            ClipData clip = intent != null ? intent.getClipData() : null;
+            File root = new File(getCacheDir(), "immich-upload");
+            if (sRunning.getAndIncrement() == 0) {
+                // Copies left behind by a run that did not finish.
+                ImmichConfig.deleteTree(root);
+            }
+            new Thread(() -> {
+                File dir = new File(root, String.valueOf(startId));
+                dir.mkdirs();
+                List<ImmichUploader.Item> items = new ArrayList<>();
+                for (int i = 0; clip != null && i < clip.getItemCount(); i++) {
+                    ImmichUploader.Item item = copy(clip.getItemAt(i).getUri(), dir, i);
+                    if (item != null) {
+                        items.add(item);
+                    }
+                }
+                uploader.upload(items, null);
+                ImmichConfig.deleteTree(dir);
+                if (sRunning.decrementAndGet() == 0) {
+                    stopForeground(STOP_FOREGROUND_DETACH);
+                }
+                stopSelf(startId);
+            }, TAG).start();
+            return START_NOT_STICKY;
+        }
+
+        private ImmichUploader.Item copy(Uri uri, File dir, int n) {
+            // Only what the sharing app grants: a file:// path would be read
+            // with the gallery's own rights - its private files included.
+            if (uri == null || !"content".equals(uri.getScheme())) {
+                Log.w(TAG, "not a content uri, skipped: " + uri);
+                return null;
+            }
+            String name = "upload-" + n;
+            long taken = 0;
+            try (Cursor c = getContentResolver().query(uri, null, null, null, null)) {
+                if (c != null && c.moveToFirst()) {
+                    int i = c.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                    if (i >= 0 && !c.isNull(i)) {
+                        name = c.getString(i);
+                    }
+                    i = c.getColumnIndex(MediaStore.Images.ImageColumns.DATE_TAKEN);
+                    if (i >= 0 && !c.isNull(i)) {
+                        taken = c.getLong(i);
+                    }
+                }
+            } catch (RuntimeException e) {
+                Log.w(TAG, "query " + uri + ": " + e);
+            }
+            String mime = getContentResolver().getType(uri);
+            File file = new File(dir, n + "-" + name.replace('/', '_'));
+            try (InputStream in = getContentResolver().openInputStream(uri);
+                    OutputStream out = new FileOutputStream(file)) {
+                byte[] buf = new byte[64 * 1024];
+                int r;
+                while ((r = in.read(buf)) > 0) {
+                    out.write(buf, 0, r);
+                }
+            } catch (Exception e) {
+                Log.w(TAG, "copy " + uri + ": " + e);
+                file.delete();
+                return null;
+            }
+            long now = System.currentTimeMillis();
+            return new ImmichUploader.Item(file, name,
+                    mime != null ? mime : "application/octet-stream",
+                    taken > 0 ? taken : now, now, name + "-" + file.length());
+        }
+    }
+}
