+    private void togglePlay() {
+        if (mPlayer == null) {
+            return;
+        }
+        if (mPlayer.getPlaybackState() == Player.STATE_ENDED) {
+            mPlayer.seekTo(0);
+            mPlayer.play();
+        } else if (mPlayer.isPlaying()) {
+            mPlayer.pause();
+        } else {
+            mPlayer.play();
+        }
+        scheduleHide();
+    }
+
+    private void updatePlayButton() {
+        if (mPlayer == null) {
+            return;
+        }
+        boolean playing = mPlayer.isPlaying();
+        boolean ended = mPlayer.getPlaybackState() == Player.STATE_ENDED;
+        mPlay.setImageResource(playing ? R.drawable.ic_player_pause
+                : ended ? R.drawable.ic_player_replay : R.drawable.ic_player_play);
+        mPlay.setContentDescription(getContext().getString(playing ? R.string.player_pause
+                : R.string.player_play));
+    }
+
+    private void seekBy(long ms) {
+        if (mPlayer == null) {
+            return;
+        }
+        long target = Math.max(0, mPlayer.getCurrentPosition() + ms);
+        long duration = mPlayer.getDuration();
+        if (duration != C.TIME_UNSET) {
+            target = Math.min(target, duration);
+        }
+        mPlayer.seekTo(target);
+        badge((ms > 0 ? "+" : "−") + (Math.abs(ms) / 1000) + " s");
+        updateProgress();
+        scheduleHide();
+    }
+
+    /** Shows or hides the controls; in picture-in-picture they stay hidden. */
+    public void showControls(boolean show) {
+        mHandler.removeCallbacks(mHide);
+        if (mHost.isInPip()) {
+            show = false;
+        }
+        // Cancelling a fade-out also drops its end action, which would hide
+        // the controls just shown.
+        mControls.animate().cancel();
+        if (show) {
+            mControls.setVisibility(View.VISIBLE);
+            mControls.animate().alpha(1).setDuration(150).start();
+        } else if (mControls.getVisibility() == View.VISIBLE) {
+            mControls.animate().alpha(0).setDuration(200)
+                    .withEndAction(() -> mControls.setVisibility(View.GONE)).start();
+        }
+        if (show) {
+            scheduleHide();
+        }
+    }
+
+    private boolean controlsShown() {
+        return mControls.getVisibility() == View.VISIBLE && mControls.getAlpha() == 1;
+    }
+
+    private void scheduleHide() {
+        mHandler.removeCallbacks(mHide);
+        if (mPlayer != null && mPlayer.isPlaying() && !mDragging) {
+            mHandler.postDelayed(mHide, HIDE_MS);
+        }
+    }
+
+    private void badge(String text) {
+        mHandler.removeCallbacks(mHideBadge);
+        mBadge.setText(text);
+        mBadge.animate().cancel();
+        mBadge.setAlpha(1);
+        mHandler.postDelayed(mHideBadge, 900);
+    }
+
+    private void updateProgress() {
+        if (mPlayer == null || mDragging) {
+            return;
+        }
+        long duration = mPlayer.getDuration();
+        long position = mPlayer.getCurrentPosition();
+        mElapsed.setText(time(position));
+        if (duration != C.TIME_UNSET && duration > 0) {
+            mTotal.setText(time(duration));
+            mSeek.setProgress((int) (position * 1000 / duration));
+            mSeek.setSecondaryProgress((int) (mPlayer.getBufferedPosition() * 1000 / duration));
+        }
+    }
+
+    private long fraction(int progress) {
+        long duration = mPlayer != null ? mPlayer.getDuration() : C.TIME_UNSET;
+        return duration == C.TIME_UNSET ? 0 : duration * progress / 1000;
+    }
