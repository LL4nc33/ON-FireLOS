+package com.android.deskclock.widget;
+
+import android.content.Context;
+import android.content.res.TypedArray;
+import android.text.format.DateFormat;
+import android.util.AttributeSet;
+import android.widget.TextClock;
+
+import com.android.deskclock.R;
+
+import java.util.Locale;
+
+/**
+ * ON-FireLOS: a part of the date - the weekday, or the day and month - in the order and words
+ * of the device's language, turning over by itself at midnight.
+ */
+public class SkeletonClock extends TextClock {
+
+    public SkeletonClock(Context context) {
+        this(context, null);
+    }
+
+    public SkeletonClock(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        final TypedArray a = context.obtainStyledAttributes(attrs, R.styleable.SkeletonClock);
+        final String skeleton = a.getString(R.styleable.SkeletonClock_onfirelosSkeleton);
+        a.recycle();
+        if (skeleton != null) {
+            final String pattern = DateFormat.getBestDateTimePattern(Locale.getDefault(), skeleton);
+            setFormat12Hour(pattern);
+            setFormat24Hour(pattern);
+        }
+    }
+}
