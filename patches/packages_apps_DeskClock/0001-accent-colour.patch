+
+package com.android.deskclock.widget;
+
+import android.content.Context;
+import android.support.v7.widget.LinearLayoutManager;
+import android.support.v7.widget.RecyclerView;
+import android.view.View;
+
+/**
+ * ON-FireLOS: a vertical list whose items - from a given position on - sit at the foot while
+ * all of it fits, within the thumbs' reach on a tablet held in the hands, with the space above
+ * them. Once the list is longer than its view, it scrolls as usual from the top.
+ */
+public class BottomAlignedLayoutManager extends LinearLayoutManager {
+    private final int mFirstAtFoot;
+    private boolean mFits;
+
+    public BottomAlignedLayoutManager(Context context, int firstAtFoot) {
+        super(context);
+        mFirstAtFoot = firstAtFoot;
+    }
+
+    @Override
+    public void onLayoutChildren(RecyclerView.Recycler recycler, RecyclerView.State state) {
+        super.onLayoutChildren(recycler, state);
+        mFits = false;
+        if (state.isPreLayout() || getChildCount() == 0) return;
+        View first = null;
+        View last = null;
+        for (int i = 0; i < getChildCount(); i++) {
+            final View child = getChildAt(i);
+            final int position = getPosition(child);
+            if (first == null || position < getPosition(first)) first = child;
+            if (last == null || position > getPosition(last)) last = child;
+        }
+        // Only a list that is all there, from its very top.
+        if (getPosition(first) != 0 || getPosition(last) != getItemCount() - 1
+                || getDecoratedTop(first) < getPaddingTop()) {
+            return;
+        }
+        final int gap = getHeight() - getPaddingBottom() - getDecoratedBottom(last);
+        if (gap <= 0) return;
+        mFits = true;
+        for (int i = 0; i < getChildCount(); i++) {
+            final View child = getChildAt(i);
+            if (getPosition(child) >= mFirstAtFoot) child.offsetTopAndBottom(gap);
+        }
+    }
+
+    @Override
+    public boolean canScrollVertically() {
+        // Nothing to scroll while it all fits; scrolling would undo the gap.
+        return !mFits && super.canScrollVertically();
+    }
+}
