+
+package com.android.deskclock;
+
+import android.content.Context;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.Icon;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+
+/** ON-FireLOS: the standby screen's row of notification icons, while it is shown. */
+final class StandbyIcons implements StandbyNotifications.Listener {
+
+    private final ViewGroup mRow;
+
+    StandbyIcons(View root) {
+        mRow = root.findViewById(R.id.onfirelos_standby_icons);
+    }
+
+    void start() {
+        StandbyNotifications.addListener(this);
+        notificationsChanged();
+    }
+
+    void stop() {
+        StandbyNotifications.removeListener(this);
+    }
+
+    @Override
+    public void notificationsChanged() {
+        if (mRow == null) return;
+        final Context context = mRow.getContext();
+        final int size = context.getResources().getDimensionPixelSize(
+                R.dimen.onfirelos_standby_icon_size);
+        final int gap = size * 3 / 5;
+        final int tint = context.getColor(R.color.white_63p);
+        mRow.removeAllViews();
+        for (Icon icon : StandbyNotifications.icons()) {
+            final Drawable drawable = icon.loadDrawable(context);
+            if (drawable == null) continue;
+            drawable.mutate().setTint(tint);
+            final ImageView view = new ImageView(context);
+            view.setImageDrawable(drawable);
+            view.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+            final LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(size, size);
+            if (mRow.getChildCount() > 0) params.setMarginStart(gap);
+            mRow.addView(view, params);
+        }
+        mRow.setVisibility(mRow.getChildCount() > 0 ? View.VISIBLE : View.GONE);
+    }
+}
