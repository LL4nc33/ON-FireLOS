+package com.android.deskclock.widget;
+
+import android.content.Context;
+import android.support.v7.widget.AppCompatButton;
+import android.util.AttributeSet;
+
+/**
+ * ON-FireLOS: a tab's text button as a pill beside the action button at the foot on the right.
+ * The tabs hide the buttons they do not use with INVISIBLE; in that row a hidden pill would
+ * leave a hole, so it goes instead.
+ */
+public class PillButton extends AppCompatButton {
+    public PillButton(Context context, AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    @Override
+    public void setVisibility(int visibility) {
+        super.setVisibility(visibility == INVISIBLE ? GONE : visibility);
+    }
+}
