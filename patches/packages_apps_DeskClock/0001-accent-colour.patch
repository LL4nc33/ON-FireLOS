+
+/**
+ * ON-FireLOS: the weather for the clock - here and in the world clock cities - from Open-Meteo
+ * (open-meteo.com: free, no account). Off until turned on. Here is the tablet's rough network
+ * location, rounded to two decimals (about 1 km), or the device time zone's city without location
+ * access; the cities are looked up once by name and time zone. One request fetches all places;
+ * the results are kept for the screens and the widget and refreshed at most every half hour.
+ * Called on the main thread only.
+ */
+public final class WeatherModel {
+    /** Sent to the clock's own widgets when readings arrive or the weather is turned on or off. */
+    public static final String ACTION_CHANGED = "com.android.deskclock.weather.CHANGED";
+    private static final String TAG = "WeatherModel";
+
+    /** Told when the weather or its switch changed. */
+    public interface Listener {
+        void weatherChanged();
+    }
+
+    /** The symbol for a WMO weather code, by day or night. */
+    public static int icon(int code, boolean day) {
+        switch (code) {
+            case 0:
+                return day ? R.drawable.ic_weather_clear_day : R.drawable.ic_weather_clear_night;
+            case 1: case 2:
+                return day ? R.drawable.ic_weather_partly_cloudy_day
+                        : R.drawable.ic_weather_partly_cloudy_night;
+            case 3:
+                return R.drawable.ic_weather_cloudy;
+            case 45: case 48:
+                return R.drawable.ic_weather_fog;
+            case 51: case 53: case 55:
+                return R.drawable.ic_weather_drizzle;
+            case 56: case 57: case 66: case 67:
+                return R.drawable.ic_weather_freezing_rain;
+            case 71: case 73: case 75: case 77: case 85: case 86:
+                return R.drawable.ic_weather_snow;
+            case 95: case 96: case 99:
+                return R.drawable.ic_weather_thunderstorm;
+            default:  // 61-65, 80-82
+                return R.drawable.ic_weather_rain;
+        }
+    }
+
+    /** The words for a WMO weather code. */
+    public static int condition(int code) {
+        switch (code) {
+            case 0: return R.string.weather_clear;
+            case 1: return R.string.weather_mostly_clear;
+            case 2: return R.string.weather_partly_cloudy;
+            case 3: return R.string.weather_cloudy;
+            case 45: case 48: return R.string.weather_fog;
+            case 51: case 53: case 55: return R.string.weather_drizzle;
+            case 56: case 57: case 66: case 67: return R.string.weather_freezing_rain;
+            case 65: return R.string.weather_heavy_rain;
+            case 71: case 73: case 75: case 77: return R.string.weather_snow;
+            case 80: case 81: case 82: return R.string.weather_showers;
+            case 85: case 86: return R.string.weather_snow_showers;
+            case 95: case 96: case 99: return R.string.weather_thunderstorm;
+            default: return R.string.weather_rain;
+        }
+    }
+
+    /** One of the hours ahead: its hour of the day (local to the place) and its weather. */
+    public static final class Hour {
+        public final int hour;
+        public final int temperature;
+        public final int code;
+        public final boolean day;
+
+        Hour(int hour, int temperature, int code, boolean day) {
+            this.hour = hour;
+            this.temperature = temperature;
+            this.code = code;
+            this.day = day;
+        }
+    }
+
+    /** One of the days ahead: its date (local to the place), range and weather. */
+    public static final class Day {
+        public final int year;
+        public final int month;
+        public final int dayOfMonth;
+        public final int high;
+        public final int low;
+        public final int code;
+
+        Day(int year, int month, int dayOfMonth, int high, int low, int code) {
+            this.year = year;
+            this.month = month;
+            this.dayOfMonth = dayOfMonth;
+            this.high = high;
+            this.low = low;
+            this.code = code;
+        }
+    }
+
+    /** The weather at one place: now, today's range, the hours and days ahead. */
+    public static final class Weather {
+        /** The place's name, or null for here when no name is known. */
+        public final String place;
+        public final int temperature;
+        public final int high;
+        public final int low;
+        /** WMO weather code. */
+        public final int code;
+        public final boolean day;
+        public final List<Hour> hours;
+        public final List<Day> days;
+
+        Weather(String place, int temperature, int high, int low, int code, boolean day,
+                List<Hour> hours, List<Day> days) {
+            this.place = place;
+            this.temperature = temperature;
+            this.high = high;
+            this.low = low;
+            this.code = code;
+            this.day = day;
+            this.hours = hours;
+            this.days = days;
+        }
+
+        public int icon() {
+            return WeatherModel.icon(code, day);
+        }
+
+        public int condition() {
+            return WeatherModel.condition(code);
+        }
+
+        JSONObject toJson() throws JSONException {
+            final JSONArray hourList = new JSONArray();
+            for (Hour h : hours) {
+                hourList.put(new JSONObject().put("h", h.hour).put("t", h.temperature)
+                        .put("code", h.code).put("day", h.day));
+            }
+            final JSONArray dayList = new JSONArray();
+            for (Day d : days) {
+                dayList.put(new JSONObject().put("y", d.year).put("m", d.month)
+                        .put("d", d.dayOfMonth).put("hi", d.high).put("lo", d.low)
+                        .put("code", d.code));
+            }
+            return new JSONObject().put("place", place == null ? "" : place)
+                    .put("t", temperature).put("hi", high).put("lo", low)
+                    .put("code", code).put("day", day).put("hours", hourList)
+                    .put("days", dayList);
+        }
+
+        static Weather fromJson(String json) {
+            if (TextUtils.isEmpty(json)) return null;
+            try {
+                final JSONObject o = new JSONObject(json);
+                final String place = o.optString("place");
+                final List<Hour> hours = new ArrayList<>();
+                final JSONArray hourList = o.optJSONArray("hours");
+                for (int i = 0; hourList != null && i < hourList.length(); i++) {
+                    final JSONObject h = hourList.getJSONObject(i);
+                    hours.add(new Hour(h.getInt("h"), h.getInt("t"), h.getInt("code"),
+                            h.getBoolean("day")));
+                }
+                final List<Day> days = new ArrayList<>();
+                final JSONArray dayList = o.optJSONArray("days");
+                for (int i = 0; dayList != null && i < dayList.length(); i++) {
+                    final JSONObject d = dayList.getJSONObject(i);
+                    days.add(new Day(d.getInt("y"), d.getInt("m"), d.getInt("d"),
+                            d.getInt("hi"), d.getInt("lo"), d.getInt("code")));
+                }
+                return new Weather(place.isEmpty() ? null : place, o.getInt("t"), o.getInt("hi"),
+                        o.getInt("lo"), o.getInt("code"), o.getBoolean("day"), hours, days);
+            } catch (JSONException e) {
+                return null;
+            }
+        }
+    }
+
+    private static final String PREFS = "onfirelos_weather";
+    private static final String KEY_ENABLED = "enabled";
+    private static final String KEY_ASKED = "asked";
+    private static final String KEY_UPDATED = "updated";
+    /** Whether here came from the location; access granted later fetches again at once. */
+    private static final String KEY_FROM_LOCATION = "from_location";
+    /** The time zone here was taken from, without a location: another zone, another place. */
+    private static final String KEY_HERE_ZONE = "here_zone";
+    private static final String KEY_HERE = "here";
+    /** The name found for here: "lat,lon|name". */
+    private static final String KEY_HERE_NAME = "here_name";
+    /** + city id: the city's weather. */
+    private static final String CITY = "city.";
+    /** + city id (or "tz:" + zone): "lat,lon,name", or "" when Open-Meteo knows none. */
+    private static final String GEO = "geo.";
+
+    private static final long STALE_MS = TimeUnit.MINUTES.toMillis(30);
+    /** Readings older than this are not shown: offline for hours, they no longer say much. */
+    private static final long SHOWN_MS = TimeUnit.HOURS.toMillis(4);
+    /** The hours ahead, scrolled through on the active card. */
+    private static final int HOURS = 24;
+    /** The days ahead, today first, on the active card opened. */
+    private static final int DAYS = 14;
+    private static final int JOB_ID = 0x0F1E0001;
+    private static final int TIMEOUT_MS = 15000;
+    private static final int MAX_RESPONSE = 256 * 1024;
+
+    private static WeatherModel sInstance;
+
+    private final Context mContext;
+    private final SharedPreferences mPrefs;
+    private final Handler mMain = new Handler(Looper.getMainLooper());
+    private final List<Listener> mListeners = new ArrayList<>();
+    private boolean mRunning;
+    private boolean mAwaitingLocation;
+
+    public static WeatherModel get(Context context) {
+        if (sInstance == null) {
+            sInstance = new WeatherModel(context.getApplicationContext());
+        }
+        return sInstance;
+    }
+
+    private WeatherModel(Context context) {
+        mContext = context;
+        // Device protected, like the clock's own settings: the widget draws before unlock too.
+        mPrefs = context.createDeviceProtectedStorageContext()
+                .getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public void addListener(Listener listener) {
+        mListeners.add(listener);
+    }
+
+    public void removeListener(Listener listener) {
+        mListeners.remove(listener);
+    }
+
+    public boolean isEnabled() {
+        return mPrefs.getBoolean(KEY_ENABLED, false);
+    }
+
+    /** Whether the offer to turn it on is answered, either way. */
+    public boolean isAsked() {
+        return mPrefs.getBoolean(KEY_ASKED, false);
+    }
+
+    public boolean hasLocationAccess() {
+        return mContext.checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION)
+                == PackageManager.PERMISSION_GRANTED;
+    }
+
+    /** Turns the weather on or off; off forgets every place and reading. */
+    public void setEnabled(boolean enabled) {
+        final SharedPreferences.Editor editor = mPrefs.edit()
+                .putBoolean(KEY_ENABLED, enabled).putBoolean(KEY_ASKED, true);
+        if (!enabled) {
+            for (String key : mPrefs.getAll().keySet()) {
+                if (!key.equals(KEY_ENABLED) && !key.equals(KEY_ASKED)) editor.remove(key);
+            }
+        }
+        editor.apply();
+        final JobScheduler jobs = mContext.getSystemService(JobScheduler.class);
+        if (enabled) {
+            jobs.schedule(new JobInfo.Builder(JOB_ID,
+                    new ComponentName(mContext, WeatherJobService.class))
+                    .setPeriodic(TimeUnit.HOURS.toMillis(1))
+                    .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY)
+                    .setPersisted(true)
+                    .build());
+            refresh(true, null);
+        } else {
+            jobs.cancel(JOB_ID);
+        }
+        notifyListeners();
+        widgetsChanged();
+    }
+
+    /** The offer was declined: it does not come back; the settings switch stays. */
+    public void declineOffer() {
+        mPrefs.edit().putBoolean(KEY_ASKED, true).apply();
+        notifyListeners();
+    }
+
+    public Weather getHere() {
+        // Taken from a time zone the device has left: that place is no longer here.
+        if (!mPrefs.getBoolean(KEY_FROM_LOCATION, false) && !hereZoneCurrent()) return null;
+        return isShown() ? Weather.fromJson(mPrefs.getString(KEY_HERE, null)) : null;
+    }
+
+    public Weather getCity(City city) {
+        return isShown() ? Weather.fromJson(mPrefs.getString(CITY + city.getId(), null)) : null;
+    }
+
+    /** On, and the readings recent enough to show (or from a clock set back meanwhile). */
+    private boolean isShown() {
+        final long age = System.currentTimeMillis() - mPrefs.getLong(KEY_UPDATED, 0);
+        return isEnabled() && age < SHOWN_MS;
+    }
+
+    private boolean hereZoneCurrent() {
+        return java.util.TimeZone.getDefault().getID().equals(
+                mPrefs.getString(KEY_HERE_ZONE, null));
+    }
+
+    /**
+     * Fetches the weather when it is on and the last reading is older than half an hour (or
+     * always, if forced). Returns whether a refresh started; {@code done} then runs on the main
+     * thread when it ends.
+     */
+    public boolean refresh(boolean force, Runnable done) {
+        if (!isEnabled() || mRunning) return false;
+        final Location location = lastLocation();
+        final List<City> cities = DataModel.getDataModel().getSelectedCities();
+        final long age = System.currentTimeMillis() - mPrefs.getLong(KEY_UPDATED, 0);
+        if (!force && age >= 0 && age < STALE_MS
+                && (location == null || mPrefs.getBoolean(KEY_FROM_LOCATION, false))
+                && (location != null || hereZoneCurrent())
+                && !lacksWeather(cities)) {
+            return false;
+        }
+
+        // What to fetch, read here: the clock's data model lives on the main thread. Without
+        // a location, here is the city of the device's own time zone ("Europe/Vienna": Vienna)
+        // - not the clock's home time zone, which is where one lives while travelling.
+        final List<Place> places = new ArrayList<>();
+        final String zone = java.util.TimeZone.getDefault().getID();
+        if (location != null) {
+            places.add(new Place(KEY_HERE, round(location.getLatitude()),
+                    round(location.getLongitude())));
+        } else {
+            if (zone != null && zone.indexOf('/') > 0) {
+                places.add(new Place(KEY_HERE, "tz:" + zone,
+                        zone.substring(zone.lastIndexOf('/') + 1).replace('_', ' '), zone));
+            }
+        }
+        for (City city : cities) {
+            places.add(new Place(CITY + city.getId(), city));
+        }
+        mRunning = true;
+        new Thread(() -> {
+            try {
+                fetch(places);
+            } catch (IOException | JSONException | RuntimeException e) {
+                // Any answer that does not parse is no weather, not the end of the thread:
+                // mRunning must be reset below, or the weather never comes again.
+                Log.w(TAG, "No weather: " + e);
+            }
+            mMain.post(() -> {
+                mRunning = false;
+                // Switched off meanwhile: nothing of the places is kept.
+                if (isEnabled()) {
+                    mPrefs.edit().putBoolean(KEY_FROM_LOCATION, location != null).apply();
+                }
+                notifyListeners();
+                // Also after a failed try (offline): readings grown too old leave the widgets.
+                widgetsChanged();
+                if (done != null) done.run();
+            });
+        }, "Weather").start();
+        return true;
+    }
+
+    /** Whether a city was added since: it has no weather and is not known to be unfindable. */
+    private boolean lacksWeather(List<City> cities) {
+        for (City city : cities) {
+            // The lookup's own key (locate): per language.
+            if (!mPrefs.contains(CITY + city.getId()) && !"".equals(mPrefs.getString(
+                    GEO + Locale.getDefault().getLanguage() + "." + city.getId(), null))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The views' own state changed (the active card): bind them again. */
+    public void viewsChanged() {
+        notifyListeners();
+    }
+
+    private void notifyListeners() {
+        for (Listener listener : new ArrayList<>(mListeners)) {
+            listener.weatherChanged();
+        }
+    }
+
+    /** The network location last known, or null; asks for one if none is known yet. */
+    private Location lastLocation() {
+        if (!hasLocationAccess()) return null;
+        final LocationManager locations = mContext.getSystemService(LocationManager.class);
+        try {
+            Location location = locations.getLastKnownLocation(LocationManager.NETWORK_PROVIDER);
+            if (location == null) {
+                location = locations.getLastKnownLocation(LocationManager.PASSIVE_PROVIDER);
+            }
+            if (location == null && !mAwaitingLocation
+                    && locations.isProviderEnabled(LocationManager.NETWORK_PROVIDER)) {
+                mAwaitingLocation = true;
+                locations.requestSingleUpdate(LocationManager.NETWORK_PROVIDER,
+                        new LocationListener() {
+                            @Override
+                            public void onLocationChanged(Location l) {
+                                mAwaitingLocation = false;
+                                refresh(true, null);
+                            }
+
+                            @Override
+                            public void onStatusChanged(String p, int status, Bundle extras) {}
+
+                            @Override
+                            public void onProviderEnabled(String provider) {}
+
+                            @Override
+                            public void onProviderDisabled(String provider) {}
+                        }, Looper.getMainLooper());
+            }
+            return location;
+        } catch (SecurityException | IllegalArgumentException e) {
+            return null;
+        }
+    }
+
+    private static double round(double degrees) {
+        return Math.round(degrees * 100) / 100.0;
+    }
+
+    /** One place to fetch: known coordinates, or a city to look up first. */
+    private static final class Place {
+        final String key;
+        /** The name to look up; shown as is for a world clock city. */
+        final String name;
+        /** Key of the remembered coordinates. */
+        final String geoId;
+        final String timeZone;
+        /** Show the name the lookup found (in the user's language) rather than our own. */
+        final boolean foundName;
+        double lat;
+        double lon;
+        String found;
+        boolean located;
+
+        Place(String key, double lat, double lon) {
+            this.key = key;
+            this.name = null;
+            this.geoId = null;
+            this.timeZone = null;
+            this.foundName = false;
+            this.lat = lat;
+            this.lon = lon;
+            this.located = true;
+        }
+
+        Place(String key, City city) {
+            this.key = key;
+            this.name = city.getName();
+            this.geoId = city.getId();
+            this.timeZone = city.getTimeZone().getID();
+            this.foundName = false;
+        }
+
+        Place(String key, String geoId, String name, String timeZone) {
+            this.key = key;
+            this.name = name;
+            this.geoId = geoId;
+            this.timeZone = timeZone;
+            this.foundName = true;
+        }
+    }
+
+    /** On a worker thread. */
+    private void fetch(List<Place> places) throws IOException, JSONException {
+        final String language = Locale.getDefault().getLanguage();
+        final List<Place> located = new ArrayList<>();
+        boolean hereFound = false;
+        for (Place place : places) {
+            if (place.located || locate(place, language)) {
+                located.add(place);
+                hereFound |= KEY_HERE.equals(place.key);
+            }
+        }
+        // No place here now (a zone without a city, a city not found): the one from before,
+        // somewhere else, goes.
+        if (!hereFound && isEnabled() && mPrefs.contains(KEY_HERE)) {
+            mPrefs.edit().remove(KEY_HERE).remove(KEY_HERE_ZONE).apply();
+            widgetsChanged();
+        }
+        if (located.isEmpty()) return;
+
+        final StringBuilder lat = new StringBuilder();
+        final StringBuilder lon = new StringBuilder();
+        for (Place place : located) {
+            if (lat.length() > 0) {
+                lat.append(',');
+                lon.append(',');
+            }
+            lat.append(place.lat);
+            lon.append(place.lon);
+        }
+        final boolean fahrenheit = usesFahrenheit();
+        final String body = get("https://api.open-meteo.com/v1/forecast?latitude=" + lat
+                + "&longitude=" + lon
+                + "&current=temperature_2m,weather_code,is_day"
+                + "&daily=weather_code,temperature_2m_max,temperature_2m_min"
+                + "&hourly=temperature_2m,weather_code,is_day&forecast_hours=" + (HOURS + 1)
+                + "&timezone=auto&forecast_days=" + DAYS
+                + (fahrenheit ? "&temperature_unit=fahrenheit" : ""));
+        // One place answers with an object, several with an array in the same order.
+        final JSONArray results = body.trim().startsWith("[")
+                ? new JSONArray(body) : new JSONArray().put(new JSONObject(body));
+        if (results.length() != located.size()) throw new JSONException("places mismatch");
+
+        // Switched off while the answer was on its way: it is not kept.
+        if (!isEnabled()) return;
+        final SharedPreferences.Editor editor = mPrefs.edit();
+        // Cities taken off the world clock go; their coordinates stay, they are small.
+        final List<String> keys = new ArrayList<>();
+        for (Place place : places) keys.add(place.key);
+        for (String key : mPrefs.getAll().keySet()) {
+            if (key.startsWith(CITY) && !keys.contains(key)) editor.remove(key);
+        }
+        for (int i = 0; i < located.size(); i++) {
+            final Place place = located.get(i);
+            final JSONObject result = results.getJSONObject(i);
+            final JSONObject current = result.getJSONObject("current");
+            final JSONObject daily = result.getJSONObject("daily");
+            final String name = place.foundName && place.found != null ? place.found
+                    : place.name != null ? place.name : placeName(place.lat, place.lon);
+            // The hours after this one; times are local to the place ("2026-11-04T20:00").
+            final List<Hour> hours = new ArrayList<>();
+            final JSONObject hourly = result.optJSONObject("hourly");
+            if (hourly != null) {
+                final JSONArray times = hourly.getJSONArray("time");
+                final JSONArray temperatures = hourly.getJSONArray("temperature_2m");
+                final JSONArray codes = hourly.getJSONArray("weather_code");
+                final JSONArray days = hourly.getJSONArray("is_day");
+                for (int h = 1; h < times.length() && hours.size() < HOURS; h++) {
+                    hours.add(new Hour(Integer.parseInt(times.getString(h).substring(11, 13)),
+                            (int) Math.round(temperatures.getDouble(h)), codes.getInt(h),
+                            days.getInt(h) == 1));
+                }
+            }
+            // The days ahead, today first ("2026-11-04", local to the place).
+            final List<Day> days = new ArrayList<>();
+            final JSONArray dates = daily.getJSONArray("time");
+            final JSONArray highs = daily.getJSONArray("temperature_2m_max");
+            final JSONArray lows = daily.getJSONArray("temperature_2m_min");
+            final JSONArray dayCodes = daily.getJSONArray("weather_code");
+            for (int d = 0; d < dates.length() && days.size() < DAYS; d++) {
+                final String date = dates.getString(d);
+                days.add(new Day(Integer.parseInt(date.substring(0, 4)),
+                        Integer.parseInt(date.substring(5, 7)),
+                        Integer.parseInt(date.substring(8, 10)),
+                        (int) Math.round(highs.getDouble(d)), (int) Math.round(lows.getDouble(d)),
+                        dayCodes.getInt(d)));
+            }
+            final Weather weather = new Weather(name,
+                    (int) Math.round(current.getDouble("temperature_2m")),
+                    (int) Math.round(highs.getDouble(0)), (int) Math.round(lows.getDouble(0)),
+                    current.getInt("weather_code"), current.optInt("is_day", 1) == 1, hours,
+                    days);
+            editor.putString(place.key, weather.toJson().toString());
+            if (KEY_HERE.equals(place.key)) {
+                // The zone it stands for (none from a location): getHere drops it elsewhere.
+                editor.putString(KEY_HERE_ZONE, place.timeZone != null ? place.timeZone : "");
+            }
+        }
+        editor.putLong(KEY_UPDATED, System.currentTimeMillis()).apply();
+        widgetsChanged();
+    }
+
+    private void widgetsChanged() {
+        mContext.sendBroadcast(new android.content.Intent(ACTION_CHANGED)
+                .setPackage(mContext.getPackageName()));
+    }
+
+    /**
+     * Fahrenheit where it is in use (the US, Liberia, Myanmar) - by language and time zone both,
+     * so that US English set elsewhere still reads Celsius.
+     */
+    private static boolean usesFahrenheit() {
+        final String country = Locale.getDefault().getCountry();
+        final String zone = java.util.TimeZone.getDefault().getID();
+        switch (country) {
+            case "US":
+                return zone.startsWith("America/") || zone.startsWith("US/")
+                        || zone.equals("Pacific/Honolulu");
+            case "LR":
+                return zone.equals("Africa/Monrovia");
+            case "MM":
+                return zone.equals("Asia/Yangon") || zone.equals("Asia/Rangoon");
+            default:
+                return false;
+        }
+    }
+
+    /**
+     * Looks a city up by name, preferring the result in its time zone; remembered, per
+     * language, as the name found is in it (a lookup in English kept "Vienna" in German).
+     */
+    private boolean locate(Place place, String language) throws IOException, JSONException {
+        final String key = GEO + language + "." + place.geoId;
+        final String known = mPrefs.getString(key, null);
+        if (known == null) {
+            final JSONObject answer = new JSONObject(get(
+                    "https://geocoding-api.open-meteo.com/v1/search?count=10&format=json"
+                    + "&language=" + URLEncoder.encode(language, "UTF-8")
+                    + "&name=" + URLEncoder.encode(place.name, "UTF-8")));
+            final JSONArray results = answer.optJSONArray("results");
+            JSONObject best = null;
+            for (int i = 0; results != null && i < results.length(); i++) {
+                final JSONObject result = results.getJSONObject(i);
+                if (best == null) best = result;
+                if (place.timeZone.equals(result.optString("timezone"))) {
+                    best = result;
+                    break;
+                }
+            }
+            final String coordinates = best == null ? ""
+                    : best.getDouble("latitude") + "," + best.getDouble("longitude") + ","
+                    + best.optString("name").replace(',', ' ');
+            mPrefs.edit().putString(key, coordinates).apply();
+            return locate(place, language);
+        }
+        if (known.isEmpty()) return false;
+        final String[] parts = known.split(",", 3);
+        place.lat = Double.parseDouble(parts[0]);
+        place.lon = Double.parseDouble(parts[1]);
+        place.found = parts.length > 2 && !parts[2].isEmpty() ? parts[2] : null;
+        return true;
+    }
+
+    /** The town here, from the system's geocoder; remembered for the same coordinates. */
+    private String placeName(double lat, double lon) {
+        // In the language it was asked in: another language asks again.
+        final String key = Locale.getDefault().toLanguageTag() + ":" + lat + "," + lon + "|";
+        final String known = mPrefs.getString(KEY_HERE_NAME, "");
+        if (known.startsWith(key)) {
+            final String name = known.substring(key.length());
+            return name.isEmpty() ? null : name;
+        }
+        String name = null;
+        try {
+            if (Geocoder.isPresent()) {
+                final List<Address> addresses =
+                        new Geocoder(mContext, Locale.getDefault()).getFromLocation(lat, lon, 1);
+                if (addresses != null && !addresses.isEmpty()) {
+                    final Address address = addresses.get(0);
+                    name = address.getLocality() != null ? address.getLocality()
+                            : address.getSubAdminArea();
+                }
+            }
+        } catch (IOException | IllegalArgumentException e) {
+            // Without a name; the line then says "Current location".
+        }
+        mPrefs.edit().putString(KEY_HERE_NAME, key + (name == null ? "" : name)).apply();
+        return name;
+    }
+
+    private static String get(String url) throws IOException {
+        final HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();
+        connection.setConnectTimeout(TIMEOUT_MS);
+        connection.setReadTimeout(TIMEOUT_MS);
+        connection.setRequestProperty("User-Agent", "ON-FireLOS Clock");
+        try {
+            final int code = connection.getResponseCode();
+            if (code != HttpURLConnection.HTTP_OK) throw new IOException("HTTP " + code);
+            try (InputStream in = connection.getInputStream()) {
+                final ByteArrayOutputStream out = new ByteArrayOutputStream();
+                final byte[] buffer = new byte[8192];
+                for (int n; (n = in.read(buffer)) > 0; ) {
+                    out.write(buffer, 0, n);
+                    if (out.size() > MAX_RESPONSE) throw new IOException("response too large");
+                }
+                return out.toString("UTF-8");
+            }
+        } finally {
+            connection.disconnect();
+        }
+    }
+}
