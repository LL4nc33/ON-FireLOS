+package com.android.deskclock;
+
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import com.android.deskclock.weather.WeatherModel;
+
+import java.text.NumberFormat;
+
+/**
+ * ON-FireLOS: the weather here on the standby screen - symbol, temperature and sky - while the
+ * weather is turned on and known, following its updates for as long as it is shown.
+ */
+final class StandbyWeather implements WeatherModel.Listener {
+    private final View mRoot;
+    private final WeatherModel mModel;
+    // The notification icons under it come and go with it.
+    private final StandbyIcons mIcons;
+
+    StandbyWeather(View root) {
+        mRoot = root;
+        mModel = WeatherModel.get(root.getContext());
+        mIcons = new StandbyIcons(root);
+    }
+
+    void start() {
+        mModel.addListener(this);
+        // Fetched again only when older than half an hour.
+        mModel.refresh(false, null);
+        weatherChanged();
+        mIcons.start();
+    }
+
+    void stop() {
+        mModel.removeListener(this);
+        mIcons.stop();
+    }
+
+    @Override
+    public void weatherChanged() {
+        final View row = mRoot.findViewById(R.id.onfirelos_standby_weather);
+        if (row == null) return;
+        final WeatherModel.Weather weather = mModel.getHere();
+        row.setVisibility(weather == null ? View.GONE : View.VISIBLE);
+        if (weather == null) return;
+        ((ImageView) row.findViewById(R.id.onfirelos_standby_weather_icon))
+                .setImageResource(weather.icon());
+        ((TextView) row.findViewById(R.id.onfirelos_standby_weather_text)).setText(
+                NumberFormat.getIntegerInstance().format(weather.temperature) + "\u00b0 \u00b7 "
+                        + mRoot.getContext().getString(weather.condition()));
+    }
+}
