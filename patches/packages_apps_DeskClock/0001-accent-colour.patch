+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.alarmclock;
+
+import android.app.PendingIntent;
+import android.appwidget.AppWidgetManager;
+import android.appwidget.AppWidgetProvider;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import android.provider.AlarmClock;
+import android.text.TextUtils;
+import android.text.format.DateFormat;
+import android.view.View;
+import android.widget.RemoteViews;
+
+import com.android.deskclock.DeskClock;
+import com.android.deskclock.R;
+import com.android.deskclock.Utils;
+import com.android.deskclock.weather.WeatherModel;
+
+import java.util.Locale;
+
+/**
+ * ON-FireLOS: the "Today" widget - the weather here in a tile, the date and the next alarm.
+ * No clock: the time is in the status bar. The date (it is a TextClock) moves on by itself
+ * at midnight; the weather, the alarm and the language come with their broadcasts.
+ */
+public class GlanceAppWidgetProvider extends AppWidgetProvider {
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        super.onReceive(context, intent);
+        final String action = intent.getAction();
+        if (WeatherModel.ACTION_CHANGED.equals(action)
+                || android.app.AlarmManager.ACTION_NEXT_ALARM_CLOCK_CHANGED.equals(action)
+                || Intent.ACTION_LOCALE_CHANGED.equals(action)
+                || Intent.ACTION_TIMEZONE_CHANGED.equals(action)
+                || Intent.ACTION_TIME_CHANGED.equals(action)) {
+            // Another zone is another place here, another language other names: fetched again
+            // if the readings say so (WeatherModel.refresh).
+            if (Intent.ACTION_TIMEZONE_CHANGED.equals(action)
+                    || Intent.ACTION_LOCALE_CHANGED.equals(action)) {
+                WeatherModel.get(context).refresh(false, null);
+            }
+            final AppWidgetManager wm = AppWidgetManager.getInstance(context);
+            onUpdate(context, wm, wm.getAppWidgetIds(
+                    new ComponentName(context, GlanceAppWidgetProvider.class)));
+        }
+    }
+
+    @Override
+    public void onUpdate(Context context, AppWidgetManager wm, int[] widgetIds) {
+        if (widgetIds == null) {
+            return;
+        }
+        // Each widget for its own width.
+        for (int widgetId : widgetIds) {
+            wm.updateAppWidget(widgetId, build(context, wm.getAppWidgetOptions(widgetId)
+                    .getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_WIDTH)));
+        }
+    }
+
+    // Resized on the home screen: laid out again for the new width.
+    @Override
+    public void onAppWidgetOptionsChanged(Context context, AppWidgetManager wm, int widgetId,
+            Bundle options) {
+        wm.updateAppWidget(widgetId, build(context,
+                options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_WIDTH)));
+    }
+
+    // Measures of the layout, in dp (onfirelos_glance_widget.xml).
+    private static final float CARD_PADDING = 6;
+    private static final float COLUMN_MARGINS = 16 + 10;
+    private static final float TILE_MIN = 88;
+    private static final float TILE_PADDING = 14;
+    private static final float ICON = 26 + 8;
+    private static final float CONDITION_GAP = 10;
+
+    private static RemoteViews build(Context context, int widthDp) {
+        final RemoteViews rv = new RemoteViews(context.getPackageName(),
+                R.layout.onfirelos_glance_widget);
+        final WeatherModel.Weather weather = WeatherModel.get(context).getHere();
+        final Locale locale = Locale.getDefault();
+        final String weekday = DateFormat.getBestDateTimePattern(locale, "EEEE");
+        final String date = DateFormat.getBestDateTimePattern(locale, "dMMMM");
+        // android.text.format.DateFormat, which TextClock uses, writes a single "y" with two
+        // digits ("26"): the year in full.
+        final String oneLine = DateFormat.getBestDateTimePattern(locale, "yMMMMEEEEd")
+                .replaceAll("(?<!y)y(?!y)", "yyyy");
+        final String temperature = weather == null ? null
+                : String.format(locale, "%d\u00b0", weather.temperature);
+        final String condition = weather == null ? null
+                : context.getString(weather.condition());
+
+        // What fits the width the launcher gives the widget, measured as the texts are drawn
+        // (language, font size): the date on one line with the year, the sky beside the
+        // temperature - most of both first, then the sky, then the one line, else neither.
+        // The date as wide as it gets this year, so tomorrow's still fits.
+        final android.util.DisplayMetrics metrics = context.getResources().getDisplayMetrics();
+        final float dp = metrics.density;
+        final float sp = metrics.scaledDensity;
+        final android.text.TextPaint medium = new android.text.TextPaint();
+        medium.setTypeface(android.graphics.Typeface.create("sans-serif-medium",
+                android.graphics.Typeface.NORMAL));
+        final android.text.TextPaint regular = new android.text.TextPaint();
+        regular.setTypeface(android.graphics.Typeface.SANS_SERIF);
+        float weekdayWidth = 0;
+        float dateWidth = 0;
+        float oneLineWidth = 0;
+        final java.util.Calendar day = java.util.Calendar.getInstance();
+        day.set(java.util.Calendar.DAY_OF_YEAR, 1);
+        final int year = day.get(java.util.Calendar.YEAR);
+        medium.setTextSize(17 * sp);
+        regular.setTextSize(14 * sp);
+        for (; day.get(java.util.Calendar.YEAR) == year; day.add(java.util.Calendar.DATE, 1)) {
+            weekdayWidth = Math.max(weekdayWidth,
+                    medium.measureText(DateFormat.format(weekday, day).toString()));
+            dateWidth = Math.max(dateWidth,
+                    regular.measureText(DateFormat.format(date, day).toString()));
+            oneLineWidth = Math.max(oneLineWidth,
+                    medium.measureText(DateFormat.format(oneLine, day).toString()));
+        }
+        // The next alarm shares the date's line (or has it alone in one-line mode): its
+        // margin, icon, the icon's padding and the text, at the date's 14sp.
+        final String nextAlarm = Utils.getNextAlarm(context);
+        float alarmWidth = 0;
+        if (!TextUtils.isEmpty(nextAlarm)) {
+            final android.graphics.drawable.Drawable alarmIcon =
+                    context.getDrawable(R.drawable.ic_alarm_small);
+            alarmWidth = (12 + 4) * dp + (alarmIcon != null ? alarmIcon.getIntrinsicWidth() : 0)
+                    + regular.measureText(nextAlarm);
+        }
+        final float twoLinesWidth = Math.max(weekdayWidth, dateWidth + alarmWidth);
+        final float oneLineColumn = Math.max(oneLineWidth, alarmWidth);
+        float tile = 0;
+        float tileWithCondition = 0;
+        if (weather != null) {
+            medium.setTextSize(20 * sp);
+            final float inner = (2 * TILE_PADDING + ICON) * dp + medium.measureText(temperature);
+            tile = Math.max(TILE_MIN * dp, inner);
+            tileWithCondition = Math.max(TILE_MIN * dp,
+                    inner + CONDITION_GAP * dp + regular.measureText(condition));
+        }
+        // The time in the middle, as wide as it gets (the digits are all one width).
+        final boolean is24 = DateFormat.is24HourFormat(context);
+        final String time = DateFormat.getBestDateTimePattern(locale, is24 ? "Hm" : "hm");
+        regular.setTextSize(30 * sp);
+        final java.util.Calendar sample = java.util.Calendar.getInstance();
+        sample.set(java.util.Calendar.MINUTE, 58);
+        float clockWidth = 0;
+        for (int hour : new int[] { 10, 22 }) {
+            sample.set(java.util.Calendar.HOUR_OF_DAY, hour);
+            clockWidth = Math.max(clockWidth,
+                    regular.measureText(DateFormat.format(time, sample).toString()));
+        }
+
+        // Most first: the time with the sky and the date on one line, then less of the
+        // weather and the date beside it, then the same without the time.
+        final float width = widthDp * dp;
+        final float edge = CARD_PADDING * dp;
+        final float gap = 16 * dp;
+        boolean showClock = false;
+        boolean showCondition = false;
+        boolean showOneLine = false;
+        search:
+        for (boolean clock : new boolean[] { true, false }) {
+            for (int step = 0; step < 4; step++) {
+                final boolean withCondition = step < 2 && weather != null;
+                final boolean withOneLine = step % 2 == 0;
+                if (step < 2 && weather == null) continue;
+                final float left = edge + (weather == null ? 0
+                        : withCondition ? tileWithCondition : tile);
+                final float right = width - edge - 10 * dp
+                        - (withOneLine ? oneLineColumn : twoLinesWidth);
+                // The time sits in the middle of the room between them, its margin and the
+                // date's keeping 16dp on each side.
+                final boolean fits = clock
+                        ? right - left >= clockWidth + 2 * gap
+                        : right - left >= 2 * gap; // the invisible clock keeps its margin
+                if (fits) {
+                    showClock = clock;
+                    showCondition = withCondition;
+                    showOneLine = withOneLine;
+                    break search;
+                }
+            }
+        }
+        rv.setCharSequence(R.id.onfirelos_glance_clock, "setFormat12Hour",
+                DateFormat.getBestDateTimePattern(locale, "hm"));
+        rv.setCharSequence(R.id.onfirelos_glance_clock, "setFormat24Hour",
+                DateFormat.getBestDateTimePattern(locale, "Hm"));
+        // Invisible rather than gone: its room keeps the date at the right edge.
+        rv.setViewVisibility(R.id.onfirelos_glance_clock,
+                showClock ? View.VISIBLE : View.INVISIBLE);
+
+        // The weekday over the date, as the language writes them, in full - or the whole
+        // date on the first line, and the date's own line then only for the alarm.
+        final String first = showOneLine ? oneLine : weekday;
+        rv.setCharSequence(R.id.onfirelos_glance_weekday, "setFormat12Hour", first);
+        rv.setCharSequence(R.id.onfirelos_glance_weekday, "setFormat24Hour", first);
+        rv.setCharSequence(R.id.onfirelos_glance_date, "setFormat12Hour", date);
+        rv.setCharSequence(R.id.onfirelos_glance_date, "setFormat24Hour", date);
+        rv.setViewVisibility(R.id.onfirelos_glance_date, showOneLine ? View.GONE : View.VISIBLE);
+
+        final String alarm = Utils.getNextAlarm(context);
+        if (TextUtils.isEmpty(alarm)) {
+            rv.setViewVisibility(R.id.onfirelos_glance_alarm, View.GONE);
+        } else {
+            rv.setTextViewText(R.id.onfirelos_glance_alarm, alarm);
+            rv.setTextViewCompoundDrawablesRelative(R.id.onfirelos_glance_alarm,
+                    R.drawable.ic_alarm_small, 0, 0, 0);
+            rv.setViewVisibility(R.id.onfirelos_glance_alarm, View.VISIBLE);
+        }
+
+        if (weather == null) {
+            rv.setViewVisibility(R.id.onfirelos_glance_badge, View.GONE);
+        } else {
+            rv.setImageViewResource(R.id.onfirelos_glance_icon, weather.icon());
+            rv.setTextViewText(R.id.onfirelos_glance_temperature, temperature);
+            rv.setTextViewText(R.id.onfirelos_glance_condition, condition);
+            rv.setViewVisibility(R.id.onfirelos_glance_condition,
+                    showCondition ? View.VISIBLE : View.GONE);
+            rv.setInt(R.id.onfirelos_glance_badge, "setBackgroundResource", weather.day
+                    ? R.drawable.onfirelos_glance_weather_day
+                    : R.drawable.onfirelos_glance_weather_night);
+            rv.setViewVisibility(R.id.onfirelos_glance_badge, View.VISIBLE);
+        }
+
