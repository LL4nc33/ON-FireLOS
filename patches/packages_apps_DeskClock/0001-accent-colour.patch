+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.deskclock;
+
+import android.app.Notification;
+import android.graphics.drawable.Icon;
+import android.service.notification.NotificationListenerService;
+import android.service.notification.StatusBarNotification;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * ON-FireLOS: which apps have notifications, for the standby screen's row of icons. Its
+ * callbacks arrive on the main thread.
+ */
+public class StandbyNotifications extends NotificationListenerService {
+
+    interface Listener {
+        void notificationsChanged();
+    }
+
+    private static final int MAX_ICONS = 6;
+    private static final List<Listener> sListeners = new CopyOnWriteArrayList<>();
+    private static StandbyNotifications sConnected;
+
+    static void addListener(Listener listener) {
+        sListeners.add(listener);
+    }
+
+    static void removeListener(Listener listener) {
+        sListeners.remove(listener);
+    }
+
+    /** One small icon per app with a notification, newest first; none when not connected. */
+    static List<Icon> icons() {
+        final List<Icon> icons = new ArrayList<>();
+        final StandbyNotifications service = sConnected;
+        if (service == null) {
+            return icons;
+        }
+        final StatusBarNotification[] active;
+        try {
+            active = service.getActiveNotifications();
+        } catch (RuntimeException e) {
+            return icons;
+        }
+        if (active == null) {
+            return icons;
+        }
+        final Map<String, StatusBarNotification> byApp = new LinkedHashMap<>();
+        for (StatusBarNotification sbn : active) {
+            final Notification n = sbn.getNotification();
+            if (sbn.isOngoing() || n.getSmallIcon() == null
+                    || (n.flags & Notification.FLAG_GROUP_SUMMARY) != 0
+                    || sbn.getPackageName().equals(service.getPackageName())) {
+                continue;
+            }
+            final StatusBarNotification known = byApp.get(sbn.getPackageName());
+            if (known == null || known.getPostTime() < sbn.getPostTime()) {
+                byApp.put(sbn.getPackageName(), sbn);
+            }
+        }
+        final List<StatusBarNotification> newest = new ArrayList<>(byApp.values());
+        newest.sort((a, b) -> Long.compare(b.getPostTime(), a.getPostTime()));
+        for (StatusBarNotification sbn : newest) {
+            if (icons.size() == MAX_ICONS) break;
+            icons.add(sbn.getNotification().getSmallIcon());
+        }
+        return icons;
+    }
+
+    @Override
+    public void onListenerConnected() {
+        sConnected = this;
+        changed();
+    }
+
+    @Override
+    public void onListenerDisconnected() {
+        sConnected = null;
+        changed();
+    }
+
+    @Override
+    public void onNotificationPosted(StatusBarNotification sbn) {
+        changed();
+    }
+
+    @Override
+    public void onNotificationRemoved(StatusBarNotification sbn) {
+        changed();
+    }
+
+    private static void changed() {
+        for (Listener listener : sListeners) {
+            listener.notificationsChanged();
+        }
+    }
+}
