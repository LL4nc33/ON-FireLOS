+
+    /** A tap: another card becomes active, the active one opens or closes its days. */
+    private static void select(View card, String key) {
+        if (sSwapping) return;
+        if (key.equals(sActive)) {
+            sOpen = !sOpen;
+        } else if (isLandscape(card.getContext())) {
