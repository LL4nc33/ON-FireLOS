+package com.android.deskclock.widget;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.util.AttributeSet;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.android.deskclock.R;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * ON-FireLOS: the clock's tabs as a navigation rail on the left, the same as the gallery's: the
+ * items at the foot, where the thumbs are holding the tablet, the current one in a pill of the
+ * accent colour.
+ */
+public class NavRail extends LinearLayout {
+    public interface Listener {
+        void onItemSelected(int index);
+    }
+
+    private final List<View> mPills = new ArrayList<>();
+    private final List<ImageView> mIcons = new ArrayList<>();
+    private final List<TextView> mLabels = new ArrayList<>();
+    private final int mStrong;
+    private final int mQuiet;
+    private final int mPill;
+    private Listener mListener;
+    private int mSelected;
+
+    public NavRail(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setOrientation(VERTICAL);
+        setGravity(Gravity.CENTER_HORIZONTAL);
+        mStrong = context.getColor(R.color.white);
+        mQuiet = (mStrong & 0x00FFFFFF) | 0x99000000;
+        mPill = (context.getColor(R.color.onfirelos_accent) & 0x00FFFFFF) | 0x52000000;
+        setPadding(0, 0, 0, dp(12));
+        // The items at the foot, where the thumb is.
+        addView(new View(context), new LayoutParams(1, 0, 1));
+    }
+
+    /** Adds an item below the others. */
+    public void addItem(int iconResId, int labelResId) {
+        final Context context = getContext();
+        final int index = mPills.size();
+        final LinearLayout item = new LinearLayout(context);
+        item.setOrientation(VERTICAL);
+        item.setGravity(Gravity.CENTER_HORIZONTAL);
+        item.setPadding(0, dp(10), 0, dp(10));
+        final FrameLayout pill = new FrameLayout(context);
+        final GradientDrawable shape = new GradientDrawable();
+        shape.setCornerRadius(dp(16));
+        pill.setBackground(shape);
+        final ImageView icon = new ImageView(context);
+        icon.setImageResource(iconResId);
+        pill.addView(icon, new FrameLayout.LayoutParams(dp(24), dp(24), Gravity.CENTER));
+        item.addView(pill, new LayoutParams(dp(56), dp(32)));
+        final TextView label = new TextView(context);
+        label.setText(labelResId);
+        label.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        label.setGravity(Gravity.CENTER);
+        label.setSingleLine(true);
+        final LayoutParams labelParams = new LayoutParams(dp(80), LayoutParams.WRAP_CONTENT);
+        labelParams.topMargin = dp(4);
+        item.addView(label, labelParams);
+        item.setContentDescription(context.getString(labelResId));
+        item.setOnClickListener(v -> select(index, true));
+        addView(item, new LayoutParams(dp(80), LayoutParams.WRAP_CONTENT));
+        mPills.add(pill);
+        mIcons.add(icon);
+        mLabels.add(label);
+        update();
+    }
+
+    public void setListener(Listener listener) {
+        mListener = listener;
+    }
+
+    /** Marks an item; with notify, also tells the listener. */
+    public void select(int index, boolean notify) {
+        final boolean changed = index != mSelected;
+        mSelected = index;
+        update();
+        if (notify && changed && mListener != null) {
+            mListener.onItemSelected(index);
+        }
+    }
+
+    private void update() {
+        for (int i = 0; i < mPills.size(); i++) {
+            final boolean on = i == mSelected;
+            ((GradientDrawable) mPills.get(i).getBackground()).setColor(on ? mPill : 0);
+            mIcons.get(i).setImageTintList(ColorStateList.valueOf(on ? mStrong : mQuiet));
+            mLabels.get(i).setTextColor(on ? mStrong : mQuiet);
+            mLabels.get(i).setTypeface(Typeface.create("sans-serif-medium",
+                    on ? Typeface.BOLD : Typeface.NORMAL));
+            ((View) mPills.get(i).getParent()).setSelected(on);
+        }
+    }
+
+    private int dp(int value) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, value,
+                getResources().getDisplayMetrics());
+    }
+}
