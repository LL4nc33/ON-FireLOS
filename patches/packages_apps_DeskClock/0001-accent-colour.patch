+                        sSwapping = false;
+                    }
+                });
+                animator.start();
+                return true;
+            }
+        });
+    }
+
+    /** A picture of the view, placed where it is within the content. */
+    private static BitmapDrawable snapshot(ViewGroup content, View view) {
+        final Bitmap bitmap = Bitmap.createBitmap(view.getWidth(), view.getHeight(),
+                Bitmap.Config.ARGB_8888);
+        view.draw(new Canvas(bitmap));
+        final BitmapDrawable drawable = new BitmapDrawable(view.getResources(), bitmap);
+        drawable.setBounds(rectIn(content, view));
+        return drawable;
+    }
+
+    private static Rect rectIn(View content, View view) {
+        final int[] origin = new int[2];
+        final int[] position = new int[2];
+        content.getLocationInWindow(origin);
+        view.getLocationInWindow(position);
+        final int left = position[0] - origin[0];
+        final int top = position[1] - origin[1];
+        return new Rect(left, top, left + view.getWidth(), top + view.getHeight());
+    }
+
+    /** On the way from one place to the other; the picture keeps its shape. */
+    private static void place(Drawable drawable, Rect from, Rect to, float t) {
+        final int left = Math.round(from.left + (to.left - from.left) * t);
+        final int top = Math.round(from.top + (to.top - from.top) * t);
+        final int width = Math.round(from.width() + (to.width() - from.width()) * t);
+        final int height = Math.round(width * (float) from.height() / from.width());
+        drawable.setBounds(left, top, left + width, top + height);
+    }
+
+    /** The active card's symbol rises and settles, slowly. */
+    private static void floating(View icon, boolean on) {
+        final Object running = icon.getTag();
+        if (on && running == null) {
+            final float lift = icon.getResources().getDisplayMetrics().density * 3;
+            final ObjectAnimator animator =
+                    ObjectAnimator.ofFloat(icon, View.TRANSLATION_Y, 0, -lift, 0);
+            animator.setDuration(3600);
+            animator.setRepeatCount(5);
+            animator.setInterpolator(new AccelerateDecelerateInterpolator());
+            animator.addListener(new AnimatorListenerAdapter() {
+                @Override
+                public void onAnimationEnd(Animator animation) {
+                    sFloating.remove(animator);
+                    if (icon.getTag() == animator) icon.setTag(null);
+                }
+            });
+            animator.start();
+            icon.setTag(animator);
+            sFloating.add(animator);
+        } else if (!on && running instanceof ObjectAnimator) {
+            ((ObjectAnimator) running).cancel();
+            sFloating.remove(running);
+            icon.setTag(null);
+            icon.setTranslationY(0);
+        }
+    }
+
+    /** The hours ahead, to scroll through: time, symbol and temperature. */
+    private static void bindHours(Context context, ViewGroup row, WeatherModel.Weather weather) {
+        final LayoutInflater inflater = LayoutInflater.from(context);
+        while (row.getChildCount() < weather.hours.size()) {
+            inflater.inflate(R.layout.onfirelos_weather_hour, row, true);
+        }
+        final SimpleDateFormat format = new SimpleDateFormat(DateFormat.getBestDateTimePattern(
+                Locale.getDefault(), DateFormat.is24HourFormat(context) ? "Hm" : "ha"),
+                Locale.getDefault());
+        // The place's hours as they are: in UTC, which has no clock change to skip or repeat
+        // an hour on the day the device's own zone changes.
+        final TimeZone utc = TimeZone.getTimeZone("UTC");
+        format.setTimeZone(utc);
+        final Calendar time = Calendar.getInstance(utc);
+        time.set(Calendar.MINUTE, 0);
+        for (int i = 0; i < row.getChildCount(); i++) {
+            final View column = row.getChildAt(i);
+            column.setVisibility(i < weather.hours.size() ? VISIBLE : GONE);
+            if (i >= weather.hours.size()) continue;
+            final WeatherModel.Hour hour = weather.hours.get(i);
+            time.set(Calendar.HOUR_OF_DAY, hour.hour);
+            ((TextView) column.findViewById(R.id.weather_hour_time))
+                    .setText(format.format(time.getTime()));
+            ((ImageView) column.findViewById(R.id.weather_hour_icon))
+                    .setImageResource(WeatherModel.icon(hour.code, hour.day));
+            ((TextView) column.findViewById(R.id.weather_hour_temperature))
+                    .setText(degrees(hour.temperature));
+        }
+    }
+
+    /**
+     * The days ahead: name, symbol, low, a bar for the day's range within the whole fortnight's,
+     * and high - the way weather apps show a week.
+     */
+    private static void bindDays(Context context, ViewGroup list, WeatherModel.Weather weather) {
+        // Days already over here (readings kept while offline) are left out; today is named
+        // so, the others by weekday and date - a place ahead starts with tomorrow's weekday.
+        final Calendar today = Calendar.getInstance();
+        final int todayKey = today.get(Calendar.YEAR) * 10000
+                + (today.get(Calendar.MONTH) + 1) * 100 + today.get(Calendar.DAY_OF_MONTH);
+        final List<WeatherModel.Day> days = new ArrayList<>();
+        for (WeatherModel.Day day : weather.days) {
+            if (day.year * 10000 + day.month * 100 + day.dayOfMonth >= todayKey) days.add(day);
+        }
+        int low = Integer.MAX_VALUE;
+        int high = Integer.MIN_VALUE;
+        for (WeatherModel.Day day : days) {
+            low = Math.min(low, day.low);
+            high = Math.max(high, day.high);
+        }
+        final LayoutInflater inflater = LayoutInflater.from(context);
+        while (list.getChildCount() < days.size()) {
+            inflater.inflate(R.layout.onfirelos_weather_day, list, true);
+        }
+        final Calendar date = Calendar.getInstance();
+        for (int i = 0; i < list.getChildCount(); i++) {
+            final View row = list.getChildAt(i);
+            row.setVisibility(i < days.size() ? VISIBLE : GONE);
+            if (i >= days.size()) continue;
+            final WeatherModel.Day day = days.get(i);
+            date.set(day.year, day.month - 1, day.dayOfMonth, 12, 0, 0);
+            final long millis = date.getTimeInMillis();
+            final boolean isToday = day.year * 10000 + day.month * 100 + day.dayOfMonth == todayKey;
+            // Today, then weekday and date as the language and region write them
+            // ("Do., 5. Nov.", "Thu, Nov 5").
+            ((TextView) row.findViewById(R.id.weather_day_name)).setText(isToday
+                    ? DateUtils.getRelativeTimeSpanString(millis, System.currentTimeMillis(),
+                            DateUtils.DAY_IN_MILLIS)
+                    : DateUtils.formatDateTime(context, millis, DateUtils.FORMAT_SHOW_WEEKDAY
+                            | DateUtils.FORMAT_ABBREV_WEEKDAY | DateUtils.FORMAT_SHOW_DATE
+                            | DateUtils.FORMAT_ABBREV_MONTH | DateUtils.FORMAT_NO_YEAR));
+            ((ImageView) row.findViewById(R.id.weather_day_icon))
+                    .setImageResource(WeatherModel.icon(day.code, true));
+            ((TextView) row.findViewById(R.id.weather_day_low)).setText(degrees(day.low));
+            ((TextView) row.findViewById(R.id.weather_day_high)).setText(degrees(day.high));
+            weight(row.findViewById(R.id.weather_day_before), day.low - low);
+            weight(row.findViewById(R.id.weather_day_range), Math.max(day.high - day.low, 1));
+            weight(row.findViewById(R.id.weather_day_after), high - day.high);
+        }
+    }
+
+    private static void weight(View view, float weight) {
+        final LinearLayout.LayoutParams params = (LinearLayout.LayoutParams) view.getLayoutParams();
+        params.weight = weight;
+        view.setLayoutParams(params);
+    }
+
+    /**
+     * A card's background after the sky: a quiet diagonal gradient - blue by a clear day, navy
+     * by night, greys for cloud and fog, blue-greys for rain and snow, violet-grey for thunder -
+     * dark enough for white text, rounded like every card (docs/DESIGN.md).
+     */
+    static Drawable sky(Context context, int code, boolean day) {
+        final int[] colours;
+        switch (code) {
+            case 0:
+                colours = day ? new int[] { 0xFF2C5C8F, 0xFF4B83BE }
+                        : new int[] { 0xFF131A33, 0xFF28345C };
+                break;
+            case 1: case 2:
+                colours = day ? new int[] { 0xFF36587A, 0xFF5D7C9B }
+                        : new int[] { 0xFF1A2033, 0xFF394256 };
+                break;
+            case 3:
+                colours = day ? new int[] { 0xFF3B4149, 0xFF5A626C }
+                        : new int[] { 0xFF22262C, 0xFF3A3F47 };
+                break;
+            case 45: case 48:
+                colours = new int[] { 0xFF41474D, 0xFF666C73 };
+                break;
+            case 71: case 73: case 75: case 77: case 85: case 86:
+                colours = new int[] { 0xFF46566A, 0xFF74859A };
+                break;
+            case 95: case 96: case 99:
+                colours = new int[] { 0xFF2A2638, 0xFF4A445F };
+                break;
+            default:  // drizzle, rain, showers, freezing rain
+                colours = day ? new int[] { 0xFF2B3B4C, 0xFF46596E }
+                        : new int[] { 0xFF1C2530, 0xFF323F4D };
+                break;
+        }
+        final GradientDrawable sky = new GradientDrawable(
+                GradientDrawable.Orientation.TL_BR, colours);
+        sky.setCornerRadius(context.getResources().getDisplayMetrics().density * 20);
+        return sky;
+    }
+
+    static String degrees(int value) {
+        return NumberFormat.getIntegerInstance().format(value) + "\u00b0";
+    }
+}
