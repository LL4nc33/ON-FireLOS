diff --git a/src/org/lineageos/eleven/ui/activities/HomeActivity.java b/src/org/lineageos/eleven/ui/activities/HomeActivity.java
index 4ad5a49..a53e9e6 100644
--- a/src/org/lineageos/eleven/ui/activities/HomeActivity.java
+++ b/src/org/lineageos/eleven/ui/activities/HomeActivity.java
@@ -243,10 +243,23 @@ public class HomeActivity extends SlidingPanelActivity implements
     }
 
     private void updateStatusBarColor(int color) {
-        if (color == Color.TRANSPARENT) {
+        // ON-FireLOS: while browsing, the status bar takes the flat bar's
+        // colour with dark icons in light mode; over the player it stays dark
+        // (artwork colour or primary_dark) with light icons.
+        final boolean bar = color == Color.TRANSPARENT && mBrowsePanelActive;
+        if (bar) {
+            color = getResources().getColor(R.color.onfirelos_bar);
+        } else if (color == Color.TRANSPARENT) {
             color = getResources().getColor(R.color.primary_dark);
         }
         final Window window = getWindow();
+        final android.view.View decor = window.getDecorView();
+        int ui = decor.getSystemUiVisibility()
+                & ~android.view.View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
+        if (bar && getResources().getBoolean(R.bool.onfirelos_light_bars)) {
+            ui |= android.view.View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
+        }
+        decor.setSystemUiVisibility(ui);
         ObjectAnimator animator = ObjectAnimator.ofInt(window,
                 "statusBarColor", window.getStatusBarColor(), color);
         animator.setEvaluator(new ArgbEvaluator());
diff --git a/src/org/lineageos/eleven/ui/activities/SettingsActivity.java b/src/org/lineageos/eleven/ui/activities/SettingsActivity.java
index c1963fb..d5c3ab5 100644
--- a/src/org/lineageos/eleven/ui/activities/SettingsActivity.java
+++ b/src/org/lineageos/eleven/ui/activities/SettingsActivity.java
@@ -37,12 +37,28 @@ import org.lineageos.eleven.utils.PreferenceUtils;
 @SuppressWarnings("deprecation")
 public class SettingsActivity extends PreferenceActivity implements OnSharedPreferenceChangeListener{
 
+    // ON-FireLOS: the navigation bar in the page's colour, with dark buttons on a light one.
+    private void colourNavigationBar() {
+        final android.util.TypedValue background = new android.util.TypedValue();
+        getTheme().resolveAttribute(android.R.attr.colorBackground, background, true);
+        final android.view.Window window = getWindow();
+        window.addFlags(
+                android.view.WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
+        window.setNavigationBarColor(background.data);
+        if (android.graphics.Color.luminance(background.data) > 0.5f) {
+            final android.view.View decor = window.getDecorView();
+            decor.setSystemUiVisibility(decor.getSystemUiVisibility()
+                    | android.view.View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR);
+        }
+    }
+
     /**
      * {@inheritDoc}
      */
     @Override
     protected void onCreate(final Bundle savedInstanceState) {
         super.onCreate(savedInstanceState);
+        colourNavigationBar();
 
         // UP
         getActionBar().setDisplayHomeAsUpEnabled(true);
