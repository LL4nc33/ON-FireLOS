+    protected boolean handleMediaPermissionResult(int requestCode, int[] results) {
+        if (requestCode != MEDIA_PERM_REQ) {
+            return false;
+        }
+        boolean granted = results.length > 0;
+        for (int result : results) {
+            if (result != PackageManager.PERMISSION_GRANTED) {
+                granted = false;
+            }
+        }
+        Runnable done = granted ? mMediaGranted : mMediaDenied;
+        mMediaGranted = null;
+        mMediaDenied = null;
+        if (done != null) {
+            done.run();
+        }
+        return true;
+    }
+
+    // Picture in picture.
+    //
+    // A fullscreen video is a custom view the WebView hands out; leaving the
+    // browser with it on screen shrinks it into a floating window. The aspect
+    // ratio is asked for when the video goes fullscreen, because by the time
+    // the user leaves there is no room for an asynchronous answer.
+    private static final String VIDEO_SIZE_JS = "(function(){"
+            + "var v=document.fullscreenElement||document.webkitFullscreenElement;"
+            + "if(v&&v.tagName!='VIDEO'){v=v.querySelector('video');}"
+            + "if(!v){v=document.querySelector('video');}"
+            + "return v&&v.videoWidth?v.videoWidth+'x'+v.videoHeight:'';})()";
+    // The platform refuses anything outside 1:2.39 to 2.39:1.
+    private static final float PIP_MAX_RATIO = 2.39f;
+    private Rational mVideoAspect;
+
+    /** Call when a video goes fullscreen. */
+    protected void prepareVideoPip(WebView webView) {
+        mVideoAspect = null;
+        webView.evaluateJavascript(VIDEO_SIZE_JS, value -> {
+            if (value != null) {
+                mVideoAspect = parseAspect(value.replace("\"", ""));
+            }
+        });
+    }
+
+    private Rational mPipAspect;
+
+    private PictureInPictureParams pipParams(boolean playing) {
+        // Android shows only the buttons the app supplies; without one the
+        // window had nothing but "expand".
+        Intent intent = new Intent(mPipAction).setPackage(getPackageName());
+        PendingIntent pi = PendingIntent.getBroadcast(this, 0, intent,
+                PendingIntent.FLAG_UPDATE_CURRENT);
+        String label = getString(playing ? R.string.pip_pause : R.string.pip_play);
+        RemoteAction action = new RemoteAction(Icon.createWithResource(this, playing
+                ? android.R.drawable.ic_media_pause : android.R.drawable.ic_media_play),
+                label, label, pi);
+        return new PictureInPictureParams.Builder()
+                .setAspectRatio(mPipAspect != null ? mPipAspect : new Rational(16, 9))
+                .setActions(Collections.singletonList(action))
+                .build();
+    }
+
+    // One action per window: several browser windows may hold a video.
+    private final String mPipAction =
+            "org.lineageos.jelly.PIP_TOGGLE." + System.identityHashCode(this);
+    private boolean mPipReceiverRegistered;
+
+    private final BroadcastReceiver mPipReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (mPipWebView == null || isRendererGone()) {
+                return;
+            }
+            mPipWebView.toggleVideo(playing -> {
+                if (isInPictureInPictureMode()) {
+                    setPictureInPictureParams(pipParams(playing));
+                }
+            });
+        }
+    };
+
+    private boolean enterPip(Rational aspect) {
+        if (!PrefsUtils.getPictureInPicture(this)
+                || !getPackageManager().hasSystemFeature(
+                        PackageManager.FEATURE_PICTURE_IN_PICTURE)) {
+            return false;
+        }
+        mPipAspect = aspect;
+        try {
+            if (!enterPictureInPictureMode(pipParams(true))) {
+                return false;
+            }
+        } catch (IllegalStateException | IllegalArgumentException e) {
+            return false;
+        }
+        if (!mPipReceiverRegistered) {
+            registerReceiver(mPipReceiver, new IntentFilter(mPipAction),
+                    IntentUtils.PERMISSION_INTERNAL, null);
+            mPipReceiverRegistered = true;
+        }
+        return true;
+    }
+
+    private void unregisterPipReceiver() {
+        if (mPipReceiverRegistered) {
+            unregisterReceiver(mPipReceiver);
+            mPipReceiverRegistered = false;
+        }
+    }
+
+    @Override
+    protected void onDestroy() {
+        unregisterPipReceiver();
+        sWindows.remove(this);
+        super.onDestroy();
+    }
+
+    private boolean mLeavingForOwnActivity;
+
+    @Override
+    public void startActivityForResult(Intent intent, int requestCode, Bundle options) {
+        // Whatever the browser opens itself - a new tab, settings, the share
+        // sheet, the file picker, an app for a link - is not the user leaving:
+        // only Home and Recents are. Cleared again if the start fails.
+        mLeavingForOwnActivity = true;
+        try {
+            super.startActivityForResult(intent, requestCode, options);
+        } catch (RuntimeException e) {
+            mLeavingForOwnActivity = false;
+            throw e;
+        }
+    }
+
+    // The answer of the "open with" chooser for a link several apps can open:
+    // the chosen intent comes back here, and the chooser starts nothing itself.
+    // It lived in the browser window alone, so in a web app window picking an
+    // app did nothing at all. Guarded by the app's own signature permission:
+    // otherwise any app could hand in an intent to be started with this one's
+    // identity, its unexported windows included.
+    private final BroadcastReceiver mUrlResolvedReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            Intent resolved = intent.getParcelableExtra(Intent.EXTRA_INTENT);
+            if (resolved == null) {
+                return;
+            }
+            if (getPackageName().equals(resolved.getPackage())) {
+                loadUrlHere(intent.getStringExtra(IntentUtils.EXTRA_URL));
+            } else {
+                try {
+                    startActivity(resolved);
+                } catch (ActivityNotFoundException e) {
+                    // Uninstalled since the chooser opened.
+                }
+            }
+            android.os.ResultReceiver receiver =
+                    intent.getParcelableExtra(Intent.EXTRA_RESULT_RECEIVER);
+            if (receiver != null) {
+                receiver.send(RESULT_CANCELED, new Bundle());
+            }
+        }
+    };
+
+    /** Opens a link the user chose to keep in the browser, in this window. */
+    protected abstract void loadUrlHere(String url);
+
+    @Override
+    protected void onStart() {
+        super.onStart();
+        registerReceiver(mUrlResolvedReceiver,
+                new IntentFilter(IntentUtils.urlResolvedAction(this)),
+                IntentUtils.PERMISSION_INTERNAL, null);
+    }
+
+    @Override
+    protected void onStop() {
+        unregisterReceiver(mUrlResolvedReceiver);
+        super.onStop();
+    }
+
+    // Every browser window, to find one floating while another comes up.
+    private static final Set<WebViewExtActivity> sWindows =
+            Collections.newSetFromMap(new WeakHashMap<>());
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        sWindows.add(this);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        mLeavingForOwnActivity = false;
+        // A link from another app opens a new browser window. A video still
+        // floating from an older one would play on over it - in one browser
+        // that reads as a bug. The new window takes over; the old one stops.
+        for (WebViewExtActivity other : new ArrayList<>(sWindows)) {
+            if (other != this && !other.isFinishing() && other.isInPictureInPictureMode()) {
+                other.stopVideoAfterPip();
+                other.moveTaskToBack(true);
+            }
+        }
+    }
+
+    private static Rational parseAspect(String size) {
+        int x = size.indexOf('x');
+        if (x <= 0) {
+            return null;
+        }
+        try {
+            float w = Integer.parseInt(size.substring(0, x));
+            float h = Integer.parseInt(size.substring(x + 1));
+            if (h <= 0) {
+                return null;
+            }
+            float r = w / h;
+            return r >= 1f / PIP_MAX_RATIO && r <= PIP_MAX_RATIO
+                    ? new Rational((int) w, (int) h) : null;
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    private WebViewExt mPipWebView;
+    private boolean mWasInPip;
+    private boolean mPagePip;
+
+    /**
+     * Call from onUserLeaveHint. A fullscreen video shrinks as it is; a video
+     * playing in the page is first laid over the page, so that the small
+     * window shows the video and not a miniature of the whole site.
+     */
+    protected void maybeEnterPip(WebViewExt webView, boolean videoFullscreen) {
+        boolean ownActivity = mLeavingForOwnActivity;
+        mLeavingForOwnActivity = false;
+        // Opened by the browser itself (see startActivityForResult): the video
+        // stays where it is instead of floating over the browser or a dialog.
+        if (ownActivity || isRendererGone()) {
+            return;
+        }
+        mPipWebView = webView;
+        if (videoFullscreen) {
+            webView.setWindowSizeFrozen(true);
+            if (!enterPip(mVideoAspect)) {
+                webView.setWindowSizeFrozen(false);
+            }
+            return;
+        }
+        String playing = webView.getPlayingVideo();
+        if (playing.isEmpty()) {
+            return;
+        }
+        webView.setWindowSizeFrozen(true);
+        webView.setPagePip(true);
+        onPagePipChanged(true);
+        if (enterPip(parseAspect(playing))) {
+            mPagePip = true;
+        } else {
+            webView.setPagePip(false);
+            webView.setWindowSizeFrozen(false);
+            onPagePipChanged(false);
+        }
+    }
+
+    // screen.orientation.lock() from a fullscreen page; see WebViewExt.
+    private boolean mPageLockedOrientation;
+
+    /** True while the WebView shows a fullscreen custom view. */
+    public abstract boolean isShowingFullscreen();
+
+    void lockPageOrientation(String type) {
+        if (type == null) {
+            return;
+        }
+        int o;
+        switch (type) {
+            case "portrait-primary": o = ActivityInfo.SCREEN_ORIENTATION_PORTRAIT; break;
+            case "portrait-secondary": o = ActivityInfo.SCREEN_ORIENTATION_REVERSE_PORTRAIT; break;
+            case "portrait": o = ActivityInfo.SCREEN_ORIENTATION_SENSOR_PORTRAIT; break;
+            case "landscape-primary": o = ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE; break;
+            case "landscape-secondary": o = ActivityInfo.SCREEN_ORIENTATION_REVERSE_LANDSCAPE; break;
+            case "landscape": o = ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE; break;
+            // This tablet's natural orientation is landscape.
+            case "natural": o = ActivityInfo.SCREEN_ORIENTATION_NOSENSOR; break;
+            case "any": o = ActivityInfo.SCREEN_ORIENTATION_FULL_SENSOR; break;
+            default: return;
+        }
+        mPageLockedOrientation = true;
+        setRequestedOrientation(o);
+    }
+
+    /** Back to the user's setting; also on leaving fullscreen or the page. */
+    public void unlockPageOrientation() {
+        if (mPageLockedOrientation) {
+            mPageLockedOrientation = false;
+            setRequestedOrientation(ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED);
+        }
+    }
+
+    // A page that takes its renderer down every time it loads - too big for
+    // 2 GB, or crashing it outright - must not be reloaded for ever: each
+    // loss rebuilds the window and loads it again. The third loss within half
+    // a minute stops that; the page stays blank with an offer to try again.
+    private static final long RENDERER_LOOP_WINDOW_MS = 30000;
+    private static long sRendererLoopStart;
+    private static int sRendererGoneInRow;
+    private static String sHaltedUrl;
+    private static long sHaltedAt;
+
+    /**
+     * Call when the renderer is gone in the window in front. Tabs behind it
+     * share the renderer and hear of the same loss, but only reload once
+     * looked at again - they cannot loop, and must not count.
+     */
+    protected static void noteRendererGone(String url) {
+        long now = android.os.SystemClock.elapsedRealtime();
+        if (now - sRendererLoopStart > RENDERER_LOOP_WINDOW_MS) {
+            sRendererLoopStart = now;
+            sRendererGoneInRow = 0;
+        }
+        if (++sRendererGoneInRow >= 3) {
+            sRendererGoneInRow = 0;
+            sHaltedUrl = url;
+            sHaltedAt = now;
+        }
+    }
+
+    /** True once for the URL whose reloading was stopped. */
+    protected static boolean takeHalted(String url) {
+        if (sHaltedUrl != null && android.os.SystemClock.elapsedRealtime()
+                - sHaltedAt > RENDERER_LOOP_WINDOW_MS) {
+            // Only right after the loop: a later visit gets a fresh try.
+            sHaltedUrl = null;
+        }
+        if (url == null || !url.equals(sHaltedUrl)) {
+            return false;
+        }
+        sHaltedUrl = null;
+        return true;
+    }
+
+    /** A WebView whose renderer died must not be touched again. */
+    protected boolean isRendererGone() {
+        return false;
+    }
+
+    /** Hide or bring back what surrounds the page, e.g. the address bar. */
+    protected void onPagePipChanged(boolean pip) {
+    }
+
+    @Override
+    public void onPictureInPictureModeChanged(boolean inPip, Configuration newConfig) {
+        super.onPictureInPictureModeChanged(inPip, newConfig);
+        if (inPip) {
+            mWasInPip = true;
+            return;
+        }
+        unregisterPipReceiver();
+        if (mPipWebView == null || isRendererGone()) {
+            return;
+        }
+        if (mPagePip) {
+            mPagePip = false;
+            mPipWebView.setPagePip(false);
+            onPagePipChanged(false);
+        }
+        // Expanded or closed - Android 9 reports both the same way, and after
+        // a close it leaves the activity resumed behind the home screen, so
+        // onStop never comes. Only an expanded window gets the focus back once
+        // the animation is done. The real window size goes back to the page
+        // only then: during the animation it is still small, and that alone
+        // is enough for YouTube to switch into its picture in picture pause.
+        mPipWebView.postDelayed(() -> {
+            if (isRendererGone()) {
+                return;
+            }
+            mPipWebView.setWindowSizeFrozen(false);
+            if (!hasWindowFocus()) {
+                stopVideoAfterPip();
+            } else {
+                mWasInPip = false;
+            }
+        }, 800);
+    }
+
+    /**
+     * The floating window was closed: stop the sound and leave fullscreen,
+     * instead of playing on in the background. Returns whether it did; the
+     * caller pauses the WebView itself only from onStop, because after a
+     * close the activity may stay resumed and no onResume would wake it.
+     */
+    protected boolean stopVideoAfterPip() {
+        if (!mWasInPip || mPipWebView == null || isRendererGone()) {
+            return false;
+        }
+        mWasInPip = false;
+        mPipWebView.evaluateJavascript(PAUSE_MEDIA_JS, null);
+        onHideCustomView();
+        return true;
+    }
+
+    private static final String PAUSE_MEDIA_JS =
+            "document.querySelectorAll('video,audio').forEach(function(m){m.pause();})";
+
+    private static final int FILE_CHOOSER_REQ = 425;
+    private ValueCallback<Uri[]> mFileCallback;
+
+    /** Returns false if no app can pick files; the callback is then untouched. */
+    public boolean showFileChooser(ValueCallback<Uri[]> callback,
+                                   WebChromeClient.FileChooserParams params) {
+        Intent intent = params.createIntent();
+        if (params.getMode() == WebChromeClient.FileChooserParams.MODE_OPEN_MULTIPLE) {
+            intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true);
+        }
+        try {
+            startActivityForResult(intent, FILE_CHOOSER_REQ);
+        } catch (ActivityNotFoundException e) {
+            return false;
+        }
+        if (mFileCallback != null) {
+            // A chooser that never returned; the page must not wait forever.
+            mFileCallback.onReceiveValue(null);
+        }
+        mFileCallback = callback;
+        return true;
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        if (requestCode != FILE_CHOOSER_REQ) {
+            super.onActivityResult(requestCode, resultCode, data);
+            return;
+        }
+        if (mFileCallback == null) {
+            return;
+        }
+        Uri[] result = null;
+        if (resultCode == RESULT_OK && data != null && data.getClipData() != null) {
+            ClipData clip = data.getClipData();
+            result = new Uri[clip.getItemCount()];
+            for (int i = 0; i < clip.getItemCount(); i++) {
+                result[i] = clip.getItemAt(i).getUri();
+            }
+        } else {
+            result = WebChromeClient.FileChooserParams.parseResult(resultCode, data);
+        }
+        mFileCallback.onReceiveValue(result);
+        mFileCallback = null;
+    }
+
+    public void onPageFinishedLoading(String url) {
+    }
+
+    public void onLoadProgress(int progress) {
+    }
 }
