+package org.lineageos.jelly.webapp;
+
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.ShortcutInfo;
+import android.content.pm.ShortcutManager;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.drawable.Icon;
+import android.net.Uri;
+import android.util.Log;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.lineageos.jelly.R;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Installed web apps: the stored manifest, the icon file, and the pinned
+ * launcher shortcut that makes it an "app".
+ */
+public final class WebAppStore {
+    private static final String TAG = "WebAppStore";
+    private static final String PREFS = "webapps";
+    private static final String SHORTCUT_PREFIX = "webapp-";
+
+    public static final String ACTION_PINNED = "org.lineageos.jelly.action.WEBAPP_PINNED";
+    public static final String EXTRA_KEY = "webapp_key";
+
+    private WebAppStore() {
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static File iconFile(Context context, String key) {
+        File dir = new File(context.getFilesDir(), "webapps");
+        //noinspection ResultOfMethodCallIgnored
+        dir.mkdirs();
+        return new File(dir, key + ".png");
+    }
+
+    public static void save(Context context, WebAppManifest manifest, Bitmap icon) {
+        try {
+            prefs(context).edit()
+                    .putString(manifest.getKey(), manifest.toJson().toString())
+                    .apply();
+        } catch (JSONException e) {
+            Log.e(TAG, "Cannot store web app", e);
+            return;
+        }
+        if (icon != null) {
+            try (FileOutputStream out = new FileOutputStream(iconFile(context, manifest.getKey()))) {
+                icon.compress(Bitmap.CompressFormat.PNG, 100, out);
+            } catch (IOException e) {
+                Log.e(TAG, "Cannot store web app icon", e);
+            }
+        }
+    }
+
+    public static WebAppManifest get(Context context, String key) {
+        String json = key != null ? prefs(context).getString(key, null) : null;
+        if (json == null) {
+            return null;
+        }
+        try {
+            return WebAppManifest.fromJson(new JSONObject(json));
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    public static Bitmap getIcon(Context context, String key) {
+        File f = iconFile(context, key);
+        return f.exists() ? BitmapFactory.decodeFile(f.getPath()) : null;
+    }
+
+    /**
+     * Whether the app is still on the home screen. Removing the shortcut is how a
+     * user uninstalls a web app, so the stored record alone does not count.
+     */
+    public static boolean isInstalled(Context context, WebAppManifest manifest) {
+        return manifest != null && get(context, manifest.getKey()) != null
+                && pinnedKeys(context).contains(manifest.getKey());
+    }
+
+    /** The installed app whose scope contains the URL; the longest scope wins. */
+    public static WebAppManifest findInstalledForUrl(Context context, String url) {
+        if (url == null) {
+            return null;
+        }
+        Set<String> pinned = pinnedKeys(context);
+        WebAppManifest best = null;
+        for (String key : prefs(context).getAll().keySet()) {
+            if (!pinned.contains(key)) {
+                continue;
+            }
+            WebAppManifest m = get(context, key);
+            if (m != null && m.isInScope(url)
+                    && (best == null || m.scope.length() > best.scope.length())) {
+                best = m;
+            }
+        }
+        return best;
+    }
+
+    private static Set<String> pinnedKeys(Context context) {
+        Set<String> keys = new HashSet<>();
+        ShortcutManager sm = context.getSystemService(ShortcutManager.class);
+        if (sm == null) {
+            return keys;
+        }
+        for (ShortcutInfo info : sm.getPinnedShortcuts()) {
+            if (info.getId().startsWith(SHORTCUT_PREFIX)) {
+                keys.add(info.getId().substring(SHORTCUT_PREFIX.length()));
+            }
+        }
+        return keys;
+    }
+
+    /** Intent that opens the app; the same data URI always reuses the same task. */
+    public static Intent launchIntent(Context context, WebAppManifest manifest, String url) {
+        Intent intent = new Intent(context, WebAppActivity.class)
+                .setAction(Intent.ACTION_VIEW)
+                .setData(Uri.parse(manifest.startUrl))
+                .putExtra(EXTRA_KEY, manifest.getKey());
+        if (url != null && !url.equals(manifest.startUrl)) {
+            intent.putExtra(WebAppActivity.EXTRA_NAVIGATE_URL, url);
+        }
+        return intent;
+    }
+
+    /**
+     * Asks the launcher to pin the shortcut. The launcher shows its own
+     * confirmation; ACTION_PINNED arrives only if the user accepts.
+     */
+    public static boolean requestPin(Context context, WebAppManifest manifest, Bitmap icon,
+                                     boolean maskable) {
+        ShortcutManager sm = context.getSystemService(ShortcutManager.class);
+        if (sm == null || !sm.isRequestPinShortcutSupported()) {
+            return false;
+        }
+        Intent launch = launchIntent(context, manifest, null);
+        // Shortcut intents may only carry persistable extras - a string is fine.
+        ShortcutInfo info = new ShortcutInfo.Builder(context, SHORTCUT_PREFIX + manifest.getKey())
+                .setShortLabel(manifest.getLabel())
+                .setLongLabel(manifest.getTitle())
+                .setIcon(makeLauncherIcon(context, icon, maskable, manifest.backgroundColor))
+                .setIntent(launch)
+                .build();
+        Intent pinned = new Intent(ACTION_PINNED)
+                .setPackage(context.getPackageName())
+                .putExtra(EXTRA_KEY, manifest.getKey());
+        PendingIntent callback = PendingIntent.getBroadcast(context,
+                manifest.getKey().hashCode(), pinned, PendingIntent.FLAG_UPDATE_CURRENT);
+        return sm.requestPinShortcut(info, callback.getIntentSender());
+    }
+
+    /**
+     * Turns a manifest icon into an adaptive icon, so it gets the launcher's
+     * shape like every other app.
+     *
+     * Adaptive layer: 108 units, of which the launcher shows the inner 72.
+     * A maskable icon is designed to be cropped, its safe zone is the inner 80 %
+     * circle - mapped onto the visible 72 units it fills the shape edge to edge.
+     * A plain icon is not, so it goes onto a background at a size that keeps
+     * it clear of any mask.
+     */
+    static Icon makeLauncherIcon(Context context, Bitmap icon, boolean maskable,
+                                 int backgroundColor) {
+        if (icon == null) {
+            return Icon.createWithResource(context, R.mipmap.ic_launcher);
+        }
+        final int size = 432; // 108 units at 4 px, a xxxhdpi adaptive layer
+        Bitmap out = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(out);
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+        Rect src = new Rect(0, 0, icon.getWidth(), icon.getHeight());
+        if (maskable) {
+            // Extend the icon's own edge colour into the bleed area.
+            int edge = icon.getWidth() > 1 && icon.getHeight() > 1
+                    ? icon.getPixel(1, 1) : Color.TRANSPARENT;
+            canvas.drawColor(Color.alpha(edge) == 0xff ? edge
+                    : Color.alpha(backgroundColor) == 0xff ? backgroundColor : Color.WHITE);
+            float inset = size / 6f; // (108 - 72) / 2 / 108
+            canvas.drawBitmap(icon, src, new RectF(inset, inset, size - inset, size - inset),
+                    paint);
+        } else {
+            int bg = Color.alpha(backgroundColor) == 0xff ? backgroundColor : Color.WHITE;
+            canvas.drawColor(bg);
+            float iconSize = size * 0.5f;
+            float inset = (size - iconSize) / 2f;
+            canvas.drawBitmap(icon, src, new RectF(inset, inset, size - inset, size - inset),
+                    paint);
+        }
+        return Icon.createWithAdaptiveBitmap(out);
+    }
+}
