+
+package org.lineageos.jelly.utils;
+
+import android.util.Xml;
+
+import org.xmlpull.v1.XmlPullParser;
+import org.xmlpull.v1.XmlPullParserException;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.StringReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * ON-FireLOS: the search address of a site, from the site's address alone. First the
+ * OpenSearch description the page links to (browsers have read it since 2006; SearXNG,
+ * DuckDuckGo, Startpage and many more name one), then /opensearch.xml, where SearXNG keeps
+ * it, and else /search?q=, where most sites answer. An address with %s is taken as it is.
+ */
+public final class SearchEngineFinder {
+
+    /** What was found: the address with {searchTerms}, and the engine's name if it gave one. */
+    public static final class Engine {
+        public final String template;
+        public final String name;
+
+        Engine(String template, String name) {
+            this.template = template;
+            this.name = name;
+        }
+    }
+
+    private static final int TIMEOUT_MS = 8000;
+    private static final int MAX_REDIRECTS = 5;
+    private static final long DEADLINE_MS = 15000;
+    private static final int MAX_BYTES = 512 * 1024;
+    private static final String TERMS = "{searchTerms}";
+    private static final Pattern LINK = Pattern.compile("<link\\b[^>]*>",
+            Pattern.CASE_INSENSITIVE);
+    private static final Pattern ATTR = Pattern.compile(
+            "([a-zA-Z:-]+)\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))");
+
+    private SearchEngineFinder() {
+    }
+
+    /** Blocks (network): on a worker thread. Null if the site could not be reached at all. */
+    public static Engine find(String input, String userAgent) {
+        // Whatever a site answers, the browser stays: a failure is "not found".
+        try {
+            return findUnchecked(input, userAgent);
+        } catch (RuntimeException | OutOfMemoryError e) {
+            return null;
+        }
+    }
+
+    private static Engine findUnchecked(String input, String userAgent) {
+        String address = input.trim();
+        // Encrypted first: a typed "http://" is only kept if the site has no https.
+        boolean typedHttp = address.regionMatches(true, 0, "http://", 0, 7);
+        if (typedHttp) {
+            address = "https://" + address.substring(7);
+        } else if (!address.matches("(?i)^https://.*")) {
+            address = "https://" + address;
+        }
+        if (address.contains("%s") || address.contains(TERMS)) {
+            return new Engine(address.replace("%s", TERMS), null);
+        }
+        URL site;
+        try {
+            site = new URL(address);
+        } catch (IOException e) {
+            return null;
+        }
+        if (site.getHost().isEmpty()) {
+            return null;
+        }
+        // Three requests at most, each with its own timeouts; past this the dialog stops
+        // waiting for more and takes the plain guess.
+        final long deadline = android.os.SystemClock.elapsedRealtime() + DEADLINE_MS;
+        Page page = fetch(site, userAgent);
+        if (page == null && typedHttp) {
+            try {
+                page = fetch(new URL("http", site.getHost(), site.getPort(), site.getFile()),
+                        userAgent);
+            } catch (IOException e) {
+                return null;
+            }
+        }
+        if (page == null) {
+            return null;
+        }
+        Engine engine = null;
+        String description = page.body != null ? findDescription(page.body) : null;
+        if (description != null && android.os.SystemClock.elapsedRealtime() < deadline) {
+            engine = fromDescription(resolve(page.url, description), userAgent);
+        }
+        if (engine == null && android.os.SystemClock.elapsedRealtime() < deadline) {
+            engine = fromDescription(resolve(page.url, "/opensearch.xml"), userAgent);
+        }
+        if (engine == null) {
+            engine = new Engine(page.url.getProtocol() + "://" + page.url.getAuthority()
+                    + "/search?q=" + TERMS, null);
+        }
+        return engine;
+    }
+
+    private static final class Page {
+        final URL url;
+        final String body;
+
+        Page(URL url, String body) {
+            this.url = url;
+            this.body = body;
+        }
+    }
+
+    /** The page where redirects end, its text if it answered with it; null if unreachable. */
+    private static Page fetch(URL url, String userAgent) {
+        HttpURLConnection connection = null;
+        try {
+            // Redirects followed here, as the connection itself never changes protocol: from
+            // http on to https, but never from https back down to http.
+            int code = 0;
+            for (int hop = 0; ; hop++) {
+                connection = (HttpURLConnection) url.openConnection();
+                connection.setConnectTimeout(TIMEOUT_MS);
+                connection.setReadTimeout(TIMEOUT_MS);
+                connection.setInstanceFollowRedirects(false);
+                if (userAgent != null) {
+                    connection.setRequestProperty("User-Agent", userAgent);
+                }
+                // As a browser asks: some search servers turn away requests without these.
+                connection.setRequestProperty("Accept",
+                        "text/html,application/opensearchdescription+xml,application/xml;q=0.9,*/*;q=0.8");
+                connection.setRequestProperty("Accept-Language",
+                        Locale.getDefault().toLanguageTag() + ",en;q=0.5");
+                code = connection.getResponseCode();
+                String location = connection.getHeaderField("Location");
+                if (code < 300 || code > 308 || location == null || hop == MAX_REDIRECTS) {
+                    break;
+                }
+                URL next = new URL(url, location);
+                boolean down = "https".equals(url.getProtocol())
+                        && !"https".equals(next.getProtocol());
+                if (down || !next.getProtocol().startsWith("http")) {
+                    break;
+                }
+                connection.disconnect();
+                url = next;
+            }
+            URL end = connection.getURL();
+            if (code < 200 || code >= 300) {
+                return new Page(end, null);
+            }
+            try (InputStream in = connection.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buffer = new byte[8192];
+                int n;
+                while (out.size() < MAX_BYTES && (n = in.read(buffer)) > 0) {
+                    out.write(buffer, 0, n);
+                }
+                return new Page(end, new String(out.toByteArray(), StandardCharsets.UTF_8));
+            }
+        } catch (IOException | RuntimeException e) {
+            return null;
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    /** The href of <link rel="search" type="application/opensearchdescription+xml">. */
+    private static String findDescription(String html) {
+        Matcher link = LINK.matcher(html);
+        while (link.find()) {
+            String rel = null;
+            String type = null;
+            String href = null;
+            Matcher attr = ATTR.matcher(link.group());
+            while (attr.find()) {
+                String value = attr.group(2) != null ? attr.group(2)
+                        : attr.group(3) != null ? attr.group(3) : attr.group(4);
+                switch (attr.group(1).toLowerCase(Locale.ROOT)) {
+                    case "rel":
+                        rel = value;
+                        break;
+                    case "type":
+                        type = value;
+                        break;
+                    case "href":
+                        href = value;
+                        break;
+                }
+            }
+            if (rel != null && type != null && href != null
+                    && rel.toLowerCase(Locale.ROOT).contains("search")
+                    && "application/opensearchdescription+xml".equalsIgnoreCase(type)) {
+                return href.replace("&amp;", "&");
+            }
+        }
+        return null;
+    }
+
+    private static URL resolve(URL base, String href) {
+        try {
+            return new URL(base, href);
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    /** The HTML results address of an OpenSearch description, with its GET parameters. */
+    private static Engine fromDescription(URL url, String userAgent) {
+        if (url == null) {
+            return null;
+        }
+        Page page = fetch(url, userAgent);
+        // A description declaring its own entities is no search engine's: refused before an
+        // entity expansion could fill the memory.
+        if (page == null || page.body == null || page.body.contains("<!ENTITY")) {
+            return null;
+        }
+        String name = null;
+        String template = null;
+        StringBuilder params = new StringBuilder();
+        try {
+            XmlPullParser parser = Xml.newPullParser();
+            parser.setInput(new StringReader(page.body));
+            boolean inResults = false;
+            for (int event = parser.getEventType(); event != XmlPullParser.END_DOCUMENT;
+                    event = parser.next()) {
+                if (event == XmlPullParser.START_TAG) {
+                    String tag = localName(parser.getName());
+                    if ("ShortName".equals(tag) && name == null) {
+                        name = parser.nextText().trim();
+                    } else if ("Url".equals(tag) && template == null) {
+                        String type = parser.getAttributeValue(null, "type");
+                        String rel = parser.getAttributeValue(null, "rel");
+                        if ("text/html".equalsIgnoreCase(type)
+                                && (rel == null || "results".equalsIgnoreCase(rel))) {
+                            template = parser.getAttributeValue(null, "template");
+                            inResults = template != null;
+                        }
+                    } else if ("Param".equals(tag) && inResults) {
+                        // A search sent by POST: the same parameters work as a GET query.
+                        String key = parser.getAttributeValue(null, "name");
+                        String value = parser.getAttributeValue(null, "value");
+                        if (key != null && value != null) {
+                            params.append(params.length() == 0 ? "" : "&")
+                                    .append(key).append('=').append(value);
+                        }
+                    }
+                } else if (event == XmlPullParser.END_TAG
+                        && "Url".equals(localName(parser.getName()))) {
+                    inResults = false;
+                }
+            }
+        } catch (XmlPullParserException | IOException e) {
+            return null;
+        }
+        if (template == null) {
+            return null;
+        }
+        if (!template.contains(TERMS) && params.length() > 0) {
+            template += (template.contains("?") ? "&" : "?") + params;
+        }
+        // Optional parameters stay, empty: taking the whole parameter out could take the "?"
+        // of the query with it. The encodings are UTF-8.
+        template = template.replaceAll("\\{[^}]*\\?\\}", "")
+                .replace("{inputEncoding}", "UTF-8").replace("{outputEncoding}", "UTF-8");
+        if (!template.contains(TERMS) || !template.matches("(?i)^https?://.*")) {
+            return null;
+        }
+        return new Engine(template, name == null || name.isEmpty() ? null : name);
+    }
+
+    private static String localName(String tag) {
+        int colon = tag.indexOf(':');
+        return colon < 0 ? tag : tag.substring(colon + 1);
+    }
+}
