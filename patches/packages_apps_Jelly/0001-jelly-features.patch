+ */
+package org.lineageos.jelly.webview;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.webkit.CookieManager;
+import android.webkit.WebView;
+
+import androidx.webkit.ProfileStore;
+import androidx.webkit.WebViewCompat;
+import androidx.webkit.WebViewFeature;
+
+/**
+ * The private tabs' own WebView profile.
+ *
+ * Without it a private tab shared the cookie jar, storage and cache with
+ * every normal tab: logged in wherever the user was, and able to leave
+ * cookies behind. The browser could only switch cookies off globally while a
+ * private tab was in front - for the normal tabs as well.
+ *
+ * Each private session - from the first private tab opened to the last one
+ * closed - gets a profile of its own name. Deleting a profile right after
+ * its last WebView is destroyed fails: Chromium lets go of it a moment
+ * later. So a new session never reuses the old profile, it starts a fresh
+ * one, and old ones are deleted once they are free - a few seconds after the
+ * session ends, and again when the next one starts.
+ */
+public final class PrivateProfile {
+    private static final String TAG = "PrivateProfile";
+    private static final String PREFIX = "jelly-private-";
+    private static final long CLEANUP_DELAY_MS = 3000;
+
+    private static int sUsers;
+    // Tabs whose renderer was lost and that wait to be rebuilt: the session
+    // must outlive them, even with none of its tabs running for the moment.
+    private static int sAwaitingRebuild;
+    private static String sSession;
+
+    private PrivateProfile() {
+    }
+
+    public static boolean isSupported() {
+        return WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE);
+    }
+
+    /** Must come before anything else is done with the WebView. */
+    static boolean attach(WebView webView) {
+        if (!isSupported()) {
+            return false;
+        }
+        if (sSession == null) {
+            deleteUnused();
+            sSession = PREFIX + System.currentTimeMillis();
+        }
+        ProfileStore.getInstance().getOrCreateProfile(sSession);
+        WebViewCompat.setProfile(webView, sSession);
+        sUsers++;
+        if (sAwaitingRebuild > 0) {
+            sAwaitingRebuild--;
+        }
+        return true;
+    }
+
+    private static boolean sCleanedThisProcess;
+
+    /**
+     * Once per process, with the first WebView of any kind: a profile that was
+     * loaded stays "in use" until the process ends, so data of the last
+     * private session can only go after a restart - this is that moment.
+     */
+    static void deleteLeftovers() {
+        if (sCleanedThisProcess || !isSupported()) {
+            return;
+        }
+        sCleanedThisProcess = true;
+        deleteUnused();
+    }
+
+    /**
+     * After the WebView was destroyed. endSession: the user closed the tab,
+     * as opposed to a renderer loss the tab is rebuilt from - possibly much
+     * later, when it is looked at again, and its logins must still be there.
+     */
+    static void detach(boolean endSession) {
+        if (sUsers == 0) {
+            return;
+        }
+        sUsers--;
+        if (!endSession) {
+            sAwaitingRebuild++;
+        } else if (sUsers == 0 && sAwaitingRebuild == 0) {
+            endSession();
+        }
+    }
+
+    /** A tab whose renderer was lost is closed without being rebuilt. */
+    public static void abandonRebuild() {
+        if (sAwaitingRebuild > 0) {
+            sAwaitingRebuild--;
+        }
+        if (sUsers == 0 && sAwaitingRebuild == 0 && sSession != null) {
+            endSession();
+        }
+    }
+
+    // The session is over; a new private tab starts a new one. The files go
+    // once no private tab came back in the meantime.
+    private static void endSession() {
+        sSession = null;
+        new Handler(Looper.getMainLooper()).postDelayed(() -> {
+            if (sUsers == 0) {
+                deleteUnused();
+            }
+        }, CLEANUP_DELAY_MS);
+    }
+
+    /** Deletes every private profile but the one of a running session. */
+    private static void deleteUnused() {
+        ProfileStore store = ProfileStore.getInstance();
+        for (String name : store.getAllProfileNames()) {
+            // Without the dash: also the single profile of earlier test builds.
+            if (!name.startsWith("jelly-private") || name.equals(sSession)) {
+                continue;
+            }
+            try {
+                if (store.deleteProfile(name)) {
+                    Log.i(TAG, "Private data deleted: " + name);
+                }
+            } catch (IllegalStateException e) {
+                // Still held by a WebView being torn down; deleted next time.
+                Log.i(TAG, "Still in use, deleted next time: " + name);
+            }
+        }
+    }
+
+    public static CookieManager cookies() {
+        return ProfileStore.getInstance().getOrCreateProfile(sSession).getCookieManager();
+    }
+}
