+package org.lineageos.jelly.webapp;
+
+import android.Manifest;
+import android.app.ActivityManager;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.res.ColorStateList;
+import android.graphics.Bitmap;
+import android.content.res.Configuration;
+import android.graphics.Color;
+import android.net.Uri;
+import android.os.Bundle;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.WindowManager;
+import android.webkit.CookieManager;
+import android.webkit.WebBackForwardList;
+import android.webkit.WebChromeClient;
+import android.widget.EditText;
+import android.widget.ImageView;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import com.google.android.material.snackbar.Snackbar;
+
+import androidx.annotation.NonNull;
+import androidx.core.content.ContextCompat;
+import androidx.core.graphics.drawable.RoundedBitmapDrawable;
+import androidx.core.graphics.drawable.RoundedBitmapDrawableFactory;
+
+import org.lineageos.jelly.R;
+import org.lineageos.jelly.ui.UrlBarController;
+import org.lineageos.jelly.utils.PrefsUtils;
+import org.lineageos.jelly.utils.TabUtils;
+import org.lineageos.jelly.utils.UiUtils;
+import org.lineageos.jelly.webview.WebViewExt;
+import org.lineageos.jelly.webview.WebViewExtActivity;
+
+/**
+ * An installed web app in its own window: no address bar, its own task in
+ * recents, the manifest's colours, a start screen while the first page loads.
+ */
+public class WebAppActivity extends WebViewExtActivity {
+    public static final String EXTRA_NAVIGATE_URL = "webapp_navigate_url";
+
+    private static final int LOCATION_PERM_REQ = 424;
+    /** Never keep the start screen longer than this, even on a slow network. */
+    private static final long SPLASH_MAX_MS = 6000;
+    private static final long SPLASH_FADE_MS = 250;
+
+    private WebAppManifest mManifest;
+    private WebAppControls mControls;
+    private WebViewExt mWebView;
+    private View mSplash;
+    private View mScopeBar;
+    private TextView mScopeBarHost;
+    private Bitmap mIcon;
+    private int mPageThemeColor = Color.TRANSPARENT;
+
+    private View mCustomView;
+    private WebChromeClient.CustomViewCallback mFullScreenCallback;
+
+    private static final String STATE_GONE_URL = "webapp_gone_url";
+    private boolean mResumed;
+    private boolean mRendererGone;
+    private String mLastUrl;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        Intent intent = getIntent();
+        mManifest = WebAppStore.get(this, intent.getStringExtra(WebAppStore.EXTRA_KEY));
+        if (mManifest == null) {
+            // Record gone (app data cleared) - the shortcut still knows the URL.
+            Uri data = intent.getData();
+            if (data != null) {
+                TabUtils.openInNewTab(this, data.toString(), false);
+            }
+            finish();
+            return;
+        }
+        mIcon = WebAppStore.getIcon(this, mManifest.getKey());
+
+        setContentView(R.layout.activity_webapp);
+
+        mSplash = findViewById(R.id.splash);
+        mScopeBar = findViewById(R.id.scope_bar);
+        mScopeBarHost = findViewById(R.id.scope_bar_host);
+        findViewById(R.id.scope_bar_close).setOnClickListener(v -> returnToScope());
+        setupSplash(savedInstanceState != null);
+
+        ProgressBar progress = findViewById(R.id.load_progress);
+        progress.setProgressTintList(ColorStateList.valueOf(getAppColor()));
+
+        // The address bar of the browser has no place here, but the shared
+        // WebView code reports into one - give it views that are never shown.
+        UrlBarController urlBar = new UrlBarController(new EditText(this), new ImageView(this));
+
+        mWebView = findViewById(R.id.web_view);
+        mWebView.init(this, urlBar, progress, false);
+        mWebView.setWebAppScope(mManifest.scope);
+        mControls = new WebAppControls(this, new WebAppControls.Host() {
+            @Override
+            public void reload() {
+                mWebView.reload();
+            }
+
+            @Override
+            public void onBlockingChanged() {
+                mWebView.updateContentBlocking();
+                mWebView.reload();
+            }
+        }, mManifest.getKey(), mManifest.getTitle());
+
+        String url = inScopeOrNull(intent.getStringExtra(EXTRA_NAVIGATE_URL));
+        String goneUrl = savedInstanceState != null
+                ? savedInstanceState.getString(STATE_GONE_URL) : null;
+        if (goneUrl != null && takeHalted(goneUrl)) {
+            mWebView.loadUrl("about:blank");
+            Snackbar.make(findViewById(android.R.id.content), R.string.renderer_halted,
+                    Snackbar.LENGTH_INDEFINITE)
+                    .setAction(R.string.menu_reload, v -> mWebView.loadUrl(goneUrl))
+                    .show();
+        } else if (goneUrl != null) {
+            mWebView.loadUrl(goneUrl);
+        } else if (savedInstanceState == null
+                || mWebView.restoreState(savedInstanceState) == null) {
+            mWebView.loadUrl(url != null ? url : mManifest.startUrl);
+        }
+
+        applyColors();
+        if (WebAppManifest.DISPLAY_FULLSCREEN.equals(mManifest.display)) {
+            setImmersiveMode(true);
+        }
+    }
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        super.onNewIntent(intent);
+        // Same app opened again from the launcher or from the browser's
+        // "open in app" button: the task comes to the front, and only an
+        // explicit URL changes the page.
+        String url = inScopeOrNull(intent.getStringExtra(EXTRA_NAVIGATE_URL));
+        if (url != null && !mRendererGone) {
+            mWebView.loadUrl(url);
+        } else if (url != null) {
+            mLastUrl = url;
+        }
+    }
+
+    /** An app window only ever opens on its own pages; anything else is ignored. */
+    private String inScopeOrNull(String url) {
+        return url != null && mManifest.isInScope(url) ? url : null;
+    }
+
+    @Override
+    public void onSaveInstanceState(Bundle outState) {
+        super.onSaveInstanceState(outState);
+        if (mRendererGone) {
+            outState.putString(STATE_GONE_URL, mLastUrl);
+        } else {
+            mWebView.saveState(outState);
+        }
+    }
+
+    @Override
+    public void onPause() {
+        mResumed = false;
+        // Going into picture in picture pauses the activity - not the video.
+        if (!mRendererGone && !isInPictureInPictureMode()) {
+            mWebView.onPause();
+        }
+        super.onPause();
+    }
+
+    @Override
+    protected void onUserLeaveHint() {
+        super.onUserLeaveHint();
+        if (!mRendererGone) {
+            maybeEnterPip(mWebView, mCustomView != null);
+        }
+    }
+
+    // Forward: the system sends it for a swipe in from the right edge. Taken
+    // before the views see it - the focused WebView swallowed it unused.
+    @Override
+    public boolean dispatchKeyEvent(android.view.KeyEvent event) {
+        if (event.getKeyCode() == android.view.KeyEvent.KEYCODE_FORWARD && !mRendererGone) {
+            if (event.getAction() == android.view.KeyEvent.ACTION_UP && mWebView.canGoForward()) {
+                mWebView.goForward();
+            }
+            return true;
+        }
+        return super.dispatchKeyEvent(event);
+    }
+
+    @Override
+    protected void loadUrlHere(String url) {
+        if (url != null && !mRendererGone) {
+            mWebView.loadUrl(url);
+        }
+    }
+
+    @Override
+    public boolean isShowingFullscreen() {
+        return mCustomView != null;
+    }
+
+    @Override
+    protected boolean isRendererGone() {
+        return mRendererGone;
+    }
+
+    @Override
+    protected void onPagePipChanged(boolean pip) {
+        if (pip) {
+            mScopeBar.setVisibility(View.GONE);
+        } else {
+            updateScopeBar(mLastUrl);
+        }
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        mResumed = true;
+        if (mRendererGone) {
+            recreate();
+            return;
+        }
+        mWebView.onResume();
+        CookieManager.getInstance().setAcceptCookie(PrefsUtils.getCookie(this));
+        mControls.show(mLastUrl != null ? mLastUrl : mWebView.getUrl());
+    }
+
+    @Override
+    protected void onDestroy() {
+        // Null when onCreate gave up for lack of a stored app.
+        if (mControls != null) {
+            mControls.hide();
+        }
+        if (mWebView != null) {
+            mWebView.release(isFinishing());
+        }
+        super.onDestroy();
+    }
+
+    @Override
+    protected void onStop() {
+        mControls.hide();
+        if (stopVideoAfterPip()) {
+            mWebView.onPause();
+        }
+        CookieManager.getInstance().flush();
+        super.onStop();
+    }
+
+    @Override
+    public void onRendererGone(WebViewExt view, boolean crashed) {
+        if (mRendererGone) {
+            return;
+        }
+        mRendererGone = true;
+        String now = view.getUrl();
+        if (now != null) {
+            mLastUrl = now;
+        }
+        if (mResumed) {
+            noteRendererGone(mLastUrl);
+        }
+        view.release(false);
+        if (mResumed) {
+            recreate();
+        }
+    }
+
+    @Override
+    public void onBackPressed() {
+        if (mRendererGone) {
+            super.onBackPressed();
+        } else if (mCustomView != null) {
+            onHideCustomView();
+        } else if (mWebView.canGoBack()) {
+            mWebView.goBack();
+        } else {
+            super.onBackPressed();
+        }
+    }
+
+    private int getAppColor() {
+        if (Color.alpha(mManifest.themeColor) == 0xff) {
+            return mManifest.themeColor;
+        }
+        if (Color.alpha(mPageThemeColor) == 0xff) {
+            return mPageThemeColor;
+        }
+        return ContextCompat.getColor(this, R.color.colorPrimaryDark);
+    }
+
+    private int getSplashColor() {
+        if (Color.alpha(mManifest.backgroundColor) == 0xff) {
+            return mManifest.backgroundColor;
+        }
+        // No colour in the manifest: the system background, so a dark ROM
+        // does not flash white before the page paints.
+        boolean night = (getResources().getConfiguration().uiMode
+                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
+        return night ? 0xff303030 : Color.WHITE;
+    }
+
+    private void setupSplash(boolean restored) {
+        if (restored) {
+            mSplash.setVisibility(View.GONE);
+            return;
+        }
+        int bg = getSplashColor();
+        mSplash.setBackgroundColor(bg);
+        getWindow().getDecorView().setBackgroundColor(bg);
+        ImageView icon = findViewById(R.id.splash_icon);
+        if (mIcon != null && mManifest.iconMaskable) {
+            // Maskable icons are drawn with a bleed meant to be cut away.
+            RoundedBitmapDrawable round = RoundedBitmapDrawableFactory.create(getResources(),
+                    mIcon);
+            round.setCircular(true);
+            icon.setImageDrawable(round);
+        } else if (mIcon != null) {
+            icon.setImageBitmap(mIcon);
+        } else {
+            icon.setImageResource(R.mipmap.ic_launcher);
+        }
+        TextView name = findViewById(R.id.splash_name);
+        name.setText(mManifest.getTitle());
+        name.setTextColor(UiUtils.isColorLight(bg) ? 0xde000000 : 0xffffffff);
+        mSplash.postDelayed(this::hideSplash, SPLASH_MAX_MS);
+    }
+
+    private void hideSplash() {
+        if (mSplash.getVisibility() != View.VISIBLE || mSplash.getAlpha() < 1f) {
+            return;
+        }
+        mSplash.animate()
+                .alpha(0f)
+                .setDuration(SPLASH_FADE_MS)
+                .withEndAction(() -> mSplash.setVisibility(View.GONE))
+                .start();
+    }
+
+    private void applyColors() {
+        int color = getAppColor();
+        getWindow().setStatusBarColor(color);
+        int flags = getWindow().getDecorView().getSystemUiVisibility();
+        if (UiUtils.isColorLight(color)) {
+            flags |= View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
+        } else {
+            flags &= ~View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
+        }
+        getWindow().getDecorView().setSystemUiVisibility(flags);
+        // Recents only takes an opaque color (or none): a translucent one throws.
+        setTaskDescription(new ActivityManager.TaskDescription(mManifest.getLabel(), mIcon,
+                color == 0 ? 0 : color | 0xFF000000));
+    }
+
+    private void returnToScope() {
+        // Step back to the last page inside the app, or start over. Read from
+        // the history list: goBack() is asynchronous, getUrl() would still
+        // report the page being left.
+        WebBackForwardList history = mWebView.copyBackForwardList();
+        int current = history.getCurrentIndex();
+        for (int i = current - 1; i >= 0; i--) {
+            if (mManifest.isInScope(history.getItemAtIndex(i).getUrl())) {
+                mWebView.goBackOrForward(i - current);
+                return;
+            }
+        }
+        mWebView.loadUrl(mManifest.startUrl);
+    }
+
+    @Override
+    public void onPageStartedLoading(String url) {
+        mLastUrl = url;
+        if (mResumed) {
+            mControls.show(url);
+        }
+        updateScopeBar(url);
+    }
+
+    private void updateScopeBar(String url) {
+        boolean outside = url != null && !mManifest.isInScope(url)
+                && !url.startsWith("about:");
+        mScopeBar.setVisibility(outside ? View.VISIBLE : View.GONE);
+        if (outside) {
+            Uri u = Uri.parse(url);
+            mScopeBarHost.setText(u.getHost());
+            findViewById(R.id.scope_bar_lock).setVisibility(
+                    "https".equals(u.getScheme()) ? View.VISIBLE : View.GONE);
+        }
+    }
+
+    @Override
+    public void onLoadProgress(int progress) {
+        // The page paints long before "finished" on most sites; waiting for
+        // the last tracker to load would only make the app feel slow.
+        if (progress >= 70) {
+            hideSplash();
+        }
+    }
+
+    @Override
+    public void onPageFinishedLoading(String url) {
+        hideSplash();
+        mWebView.injectVideoWatch();
+    }
+
+    @Override
+    public void downloadFileAsk(String url, String contentDisposition, String mimeType) {
+        // Downloads, with their permission and their dialog, live in the browser.
+        TabUtils.openInNewTab(this, url, false);
+    }
+
+    @Override
+    public boolean hasLocationPermission() {
+        return checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION)
+                == PackageManager.PERMISSION_GRANTED;
+    }
+
+    @Override
+    public void requestLocationPermission() {
+        requestPermissions(new String[]{Manifest.permission.ACCESS_FINE_LOCATION},
+                LOCATION_PERM_REQ);
+    }
+
+    @Override
+    public void onRequestPermissionsResult(int requestCode, @NonNull String[] permissions,
+                                           @NonNull int[] results) {
+        if (handleMediaPermissionResult(requestCode, results)) {
+            return;
+        }
+        if (requestCode == LOCATION_PERM_REQ && hasLocationPermission()) {
+            mWebView.reload();
+        }
+    }
+
+    @Override
+    public void showSheetMenu(String url, boolean shouldAllowDownload) {
+        TabUtils.openInNewTab(this, url, false);
+    }
+
+    @Override
+    public void onThemeColorSet(int color) {
+        // The page's own <meta name="theme-color"> only counts if the
+        // manifest does not set one.
+        mPageThemeColor = color;
+        if (Color.alpha(mManifest.themeColor) != 0xff) {
+            applyColors();
+        }
+    }
+
+    @Override
+    public void onFaviconLoaded(Bitmap favicon) {
+        if (favicon != null && !favicon.isRecycled()) {
+            favicon.recycle();
+        }
+    }
+
+    @Override
+    public void onShowCustomView(View view, WebChromeClient.CustomViewCallback callback) {
+        if (mCustomView != null) {
+            callback.onCustomViewHidden();
+            return;
+        }
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        mCustomView = view;
+        mFullScreenCallback = callback;
+        setImmersiveMode(true);
+        mCustomView.setBackgroundColor(Color.BLACK);
+        addContentView(mCustomView, new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        prepareVideoPip(mWebView);
+    }
+
+    @Override
+    public void onHideCustomView() {
+        if (mCustomView == null) {
+            return;
+        }
+        unlockPageOrientation();
+        getWindow().clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        setImmersiveMode(WebAppManifest.DISPLAY_FULLSCREEN.equals(mManifest.display));
+        ((ViewGroup) mCustomView.getParent()).removeView(mCustomView);
+        mFullScreenCallback.onCustomViewHidden();
+        mFullScreenCallback = null;
+        mCustomView = null;
+    }
+
+    @Override
+    public void onWindowFocusChanged(boolean hasFocus) {
+        super.onWindowFocusChanged(hasFocus);
+        if (hasFocus) {
+            setImmersiveMode(mCustomView != null
+                    || WebAppManifest.DISPLAY_FULLSCREEN.equals(mManifest.display));
+        }
+    }
+
+    private void setImmersiveMode(boolean enable) {
+        int flags = getWindow().getDecorView().getSystemUiVisibility();
+        int immersive = View.SYSTEM_UI_FLAG_LAYOUT_STABLE
+                | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
+                | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
+                | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
+                | View.SYSTEM_UI_FLAG_FULLSCREEN
+                | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY;
+        getWindow().getDecorView().setSystemUiVisibility(
+                enable ? flags | immersive : flags & ~immersive);
+    }
+}
