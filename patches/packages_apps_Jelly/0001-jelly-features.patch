+    private void load() {
+        mTabs.clear();
+        SharedPreferences prefs = getSharedPreferences(PREFS, MODE_PRIVATE);
+        Set<String> alive = new HashSet<>();
+        for (ActivityManager.AppTask task : getSystemService(ActivityManager.class).getAppTasks()) {
+            if (!isTab(task)) {
+                continue;
+            }
+            Tab tab = new Tab();
+            tab.task = task;
+            try {
+                ActivityManager.RecentTaskInfo info = task.getTaskInfo();
+                tab.id = info.persistentId;
+                CharSequence label = info.taskDescription != null
+                        ? info.taskDescription.getLabel() : null;
+                tab.title = prefs.getString(tab.id + "|t",
+                        label != null ? label.toString() : "");
+            } catch (RuntimeException e) {
+                continue;
+            }
+            tab.incognito = prefs.getBoolean(tab.id + "|i", false);
+            if (tab.incognito || TextUtils.isEmpty(tab.title)) {
+                tab.title = getString(tab.incognito ? R.string.tabs_private
+                        : R.string.menu_new_tab);
+            }
+            if (tab.id == mCurrent) {
+                mCurrentTab = tab;
+                if (mCurrentClosed) {
+                    // Closed here already; its window only lives on under this overview.
+                    continue;
+                }
+                mCurrentIndex = mTabs.size();
+            }
+            alive.add(String.valueOf(tab.id));
+            mTabs.add(tab);
+        }
+        // Pictures of windows that are gone.
+        File[] files = dir(this).listFiles();
+        if (files != null) {
+            for (File f : files) {
+                if (!alive.contains(f.getName().replace(".jpg", ""))) {
+                    f.delete();
+                }
+            }
+        }
+        mAdapter.notifyDataSetChanged();
+        updateTitle();
+    }
+
+    private void updateTitle() {
+        setTitle(getString(R.string.tabs_title) + " (" + mTabs.size() + ")");
+    }
+
+    // The two views: a grid of small cards, or big cards side by side as in
+    // the recent apps overview.
+
+    private void applyView() {
+        int screenW = getResources().getDisplayMetrics().widthPixels;
+        int screenH = getResources().getDisplayMetrics().heightPixels;
+        if (mCards) {
+            // As big as fits: the list's height less room to swipe a card up
+            // and away, and its title above the picture.
+            int height = screenH - mActionBar - dp(24 + 48 + 120);
+            mCardWidth = Math.min(Math.round(screenW * 0.62f),
+                    Math.round((height - dp(44)) / mPageRatio));
+            int side = (screenW - mCardWidth) / 2 - dp(10);
+            mList.setPadding(side, 0, side, 0);
+            mList.setLayoutManager(new LinearLayoutManager(this,
+                    LinearLayoutManager.HORIZONTAL, false));
+            mSnap.attachToRecyclerView(mList);
+        } else {
+            // Wide cards in landscape (five across), narrower ones in portrait (four).
+            int column = dp(screenW > screenH ? 240 : 180) + dp(12);
+            int columns = Math.max(1, (screenW - dp(12)) / column);
+            mList.setPadding(dp(6), dp(6), dp(6), dp(6));
+            mSnap.attachToRecyclerView(null);
+            mList.setLayoutManager(new GridLayoutManager(this, columns));
+        }
+        mList.setAdapter(mAdapter);
+        if (mCards && !mTabs.isEmpty()) {
+            mList.scrollToPosition(Math.min(mCurrentIndex, mTabs.size() - 1));
+        }
+        invalidateOptionsMenu();
+    }
+
+    private void toggleView() {
+        mCards = !mCards;
+        getSharedPreferences(PREFS_VIEW, MODE_PRIVATE).edit().putBoolean(KEY_CARDS, mCards).apply();
+        applyView();
+    }
+
+    private final LinearSnapHelper mSnap = new LinearSnapHelper();
+
+    private final RecyclerView.Adapter<RecyclerView.ViewHolder> mAdapter =
+            new RecyclerView.Adapter<RecyclerView.ViewHolder>() {
+        @Override
+        public RecyclerView.ViewHolder onCreateViewHolder(ViewGroup parent, int viewType) {
+            FrameLayout item = new FrameLayout(TabsActivity.this);
+            return new RecyclerView.ViewHolder(item) {
+            };
+        }
+
+        @Override
+        public void onBindViewHolder(RecyclerView.ViewHolder holder, int position) {
+            FrameLayout item = (FrameLayout) holder.itemView;
+            item.removeAllViews();
+            Tab tab = mTabs.get(position);
+            if (mCards) {
+                item.setLayoutParams(new RecyclerView.LayoutParams(mCardWidth + dp(20),
+                        ViewGroup.LayoutParams.MATCH_PARENT));
+                item.setPadding(dp(10), 0, dp(10), 0);
+                item.addView(card(tab), new FrameLayout.LayoutParams(mCardWidth,
+                        ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER));
+            } else {
+                item.setLayoutParams(new RecyclerView.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT));
+                item.setPadding(dp(6), dp(6), dp(6), dp(6));
+                item.addView(card(tab), new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT));
+            }
+        }
+
+        @Override
+        public int getItemCount() {
+            return mTabs.size();
+        }
+
+        @Override
+        public long getItemId(int position) {
+            return mTabs.get(position).id;
+        }
+    };
+
+    private View card(Tab tab) {
+        LinearLayout card = new LinearLayout(this);
+        card.setOrientation(LinearLayout.VERTICAL);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setCornerRadius(dp(mCards ? 12 : 8));
+        bg.setColor(ContextCompat.getColor(this, R.color.card_background));
+        if (tab.id == mCurrent) {
+            bg.setStroke(dp(3), ContextCompat.getColor(this, R.color.colorAccent));
+        }
+        card.setBackground(bg);
+        card.setPadding(dp(3), dp(3), dp(3), dp(3));
+        card.setClipToOutline(true);
+
+        LinearLayout head = new LinearLayout(this);
+        head.setGravity(Gravity.CENTER_VERTICAL);
+        TextView title = new TextView(this);
+        title.setText(tab.title);
+        title.setSingleLine(true);
+        title.setEllipsize(TextUtils.TruncateAt.END);
+        title.setTextAppearance(android.R.style.TextAppearance_Material_Body2);
+        title.setTextColor(ContextCompat.getColor(this, R.color.inverted));
+        title.setPadding(dp(10), 0, 0, 0);
+        head.addView(title, new LinearLayout.LayoutParams(0,
+                ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+        ImageButton close = new ImageButton(this);
+        close.setImageResource(R.drawable.ic_cancel);
+        close.setContentDescription(getString(R.string.tab_close));
+        TypedValue borderless = new TypedValue();
+        getTheme().resolveAttribute(android.R.attr.selectableItemBackgroundBorderless,
+                borderless, true);
+        close.setBackgroundResource(borderless.resourceId);
+        close.setOnClickListener(v -> close(tab));
+        head.addView(close, new LinearLayout.LayoutParams(dp(44), dp(44)));
+        card.addView(head);
+
+        // The picture takes the shape of a page on this screen - wide in
+        // landscape, tall in portrait - so a page fits its card either way.
+        FrameLayout frame = new FrameLayout(this) {
+            @Override
+            protected void onMeasure(int widthSpec, int heightSpec) {
+                int w = MeasureSpec.getSize(widthSpec);
+                super.onMeasure(widthSpec, MeasureSpec.makeMeasureSpec(
+                        Math.round(w * mPageRatio), MeasureSpec.EXACTLY));
+            }
+        };
+        ImageView picture = new ImageView(this);
+        picture.setScaleType(ImageView.ScaleType.MATRIX);
+        File file = new File(dir(this), tab.id + ".jpg");
+        BitmapFactory.Options options = new BitmapFactory.Options();
+        options.inPreferredConfig = Bitmap.Config.RGB_565;
+        options.inSampleSize = mCards ? 1 : 2;
+        Bitmap bitmap = file.exists() ? BitmapFactory.decodeFile(file.getPath(), options) : null;
+        if (bitmap != null) {
+            picture.setImageBitmap(bitmap);
+            picture.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        } else {
+            picture.setImageResource(tab.incognito ? R.drawable.ic_incognito : R.drawable.ic_new_tab);
+            picture.setScaleType(ImageView.ScaleType.CENTER);
+        }
+        frame.addView(picture, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        card.addView(frame);
+        card.setOnClickListener(v -> open(tab));
+        card.setOnLongClickListener(v -> {
