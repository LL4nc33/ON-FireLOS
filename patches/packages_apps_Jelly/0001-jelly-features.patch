index 0000000..3dcd784
--- /dev/null
+++ b/app/src/main/java/org/lineageos/jelly/webview/WebNotify.java
@@ -0,0 +1,230 @@
+/*
+ * Copyright (C) 2026 ON-FireLOS
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.lineageos.jelly.webview;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.net.Uri;
+import android.util.SparseArray;
+
+import androidx.webkit.JavaScriptReplyProxy;
+
+import org.lineageos.jelly.R;
+
+import java.lang.ref.WeakReference;
+
+/**
+ * Web notifications: shown while the page that made them is open (there is
+ * no push), asked for once per site, never in private tabs.
+ */
+public final class WebNotify {
+
+    static final String GRANTED = "granted";
+    static final String DENIED = "denied";
+    static final String DEFAULT = "default";
+
+    private static final String PREFS = "site_notifications";
+    private static final String CHANNEL = "web";
+    private static final String CHANNEL_SILENT = "web_silent";
+    private static final String ACTION_CLOSE = "org.lineageos.jelly.NOTIFICATION_CLOSE";
+    private static final String ACTION_BLOCK = "org.lineageos.jelly.NOTIFICATION_BLOCK";
+    private static final String EXTRA_KEY = "notification";
+
+    private static final class Entry {
+        WeakReference<WebApis> owner;
+        JavaScriptReplyProxy frame;
+        int jsId;
+        String origin;
+        String url;
+    }
+
+    private static final SparseArray<Entry> sLive = new SparseArray<>();
+    private static int sNext = 1;
+    private static boolean sChannels;
+
+    private WebNotify() {
+    }
+
+    static String state(Context context, String origin, boolean incognito) {
+        if (incognito || !isWeb(origin)) {
+            return DENIED;
+        }
+        return prefs(context).getString(origin, DEFAULT);
+    }
+
+    static void save(Context context, String origin, String state) {
+        prefs(context).edit().putString(origin, state).apply();
+    }
+
+    static boolean isWeb(String origin) {
+        return origin != null && (origin.startsWith("https://") || origin.startsWith("http://"));
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    static int show(Context context, WebApis owner, JavaScriptReplyProxy frame, int jsId,
+                    String origin, String url, String title, String body, String tag,
+                    boolean silent, Bitmap icon) {
+        Context app = context.getApplicationContext();
+        NotificationManager manager = app.getSystemService(NotificationManager.class);
+        ensureChannels(app, manager);
+
+        // A tag replaces the site's earlier notification with the same tag.
+        int key;
+        if (!tag.isEmpty()) {
+            key = (origin + "\n" + tag).hashCode() | 0x40000000;
+            Entry old = sLive.get(key);
+            if (old != null) {
+                WebApis.post(old.frame, WebApis.event(old.jsId, "close", true));
+            }
+        } else {
+            key = sNext++;
+            if (sNext >= 0x40000000) {
+                sNext = 1;
+            }
+        }
+        Entry entry = new Entry();
+        entry.owner = new WeakReference<>(owner);
+        entry.frame = frame;
+        entry.jsId = jsId;
+        entry.origin = origin;
+        entry.url = url;
+        sLive.put(key, entry);
+
+        Uri uri = Uri.parse(origin);
+        Notification.Builder builder = new Notification.Builder(app,
+                silent ? CHANNEL_SILENT : CHANNEL)
+                .setSmallIcon(R.drawable.ic_web_notification)
+                .setContentTitle(title)
+                .setContentText(body)
+                .setStyle(new Notification.BigTextStyle().bigText(body))
+                .setSubText(uri.getHost())
+                .setShowWhen(true)
+                .setAutoCancel(true)
+                .setContentIntent(PendingIntent.getActivity(app, key,
+                        new Intent(app, TaskFrontActivity.class)
+                                .putExtra(TaskFrontActivity.EXTRA_NOTIFICATION, key)
+                                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+                        PendingIntent.FLAG_UPDATE_CURRENT))
+                .setDeleteIntent(broadcast(app, ACTION_CLOSE, key))
+                .addAction(new Notification.Action.Builder(null,
+                        app.getString(R.string.notification_block_site),
+                        broadcast(app, ACTION_BLOCK, key)).build());
+        if (icon != null) {
+            builder.setLargeIcon(icon);
+        }
+        manager.notify(origin, key, builder.build());
+        return key;
+    }
+
+    static void close(Context context, int key) {
+        Entry entry = sLive.get(key);
+        if (entry == null) {
+            return;
+        }
+        sLive.remove(key);
+        context.getSystemService(NotificationManager.class).cancel(entry.origin, key);
+        WebApis.post(entry.frame, WebApis.event(entry.jsId, "close", true));
+    }
+
+    /** The key a page's own close() means, or 0. */
+    static int find(JavaScriptReplyProxy frame, int jsId) {
+        for (int i = 0; i < sLive.size(); i++) {
+            Entry entry = sLive.valueAt(i);
+            if (entry.frame == frame && entry.jsId == jsId) {
+                return sLive.keyAt(i);
+            }
+        }
+        return 0;
+    }
+
+    /** Tapped: back to the page that sent it, or open it anew if it is gone. */
+    static void clicked(Context context, int key) {
+        Entry entry = sLive.get(key);
+        if (entry == null) {
+            return;
+        }
+        sLive.remove(key);
+        WebApis owner = entry.owner.get();
+        if (owner != null && owner.toFront()) {
+            WebApis.post(entry.frame, WebApis.event(entry.jsId, "click", false));
+            WebApis.post(entry.frame, WebApis.event(entry.jsId, "close", true));
+            return;
+        }
+        Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(entry.url))
+                .setPackage(context.getPackageName())
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        try {
+            context.startActivity(intent);
+        } catch (RuntimeException ignored) {
+        }
+    }
+
+    private static PendingIntent broadcast(Context context, String action, int key) {
+        Intent intent = new Intent(action).setClass(context, Receiver.class)
+                .putExtra(EXTRA_KEY, key);
+        return PendingIntent.getBroadcast(context, key, intent,
+                PendingIntent.FLAG_UPDATE_CURRENT);
+    }
+
+    private static void ensureChannels(Context context, NotificationManager manager) {
+        if (sChannels) {
+            return;
+        }
+        sChannels = true;
+        manager.createNotificationChannel(new NotificationChannel(CHANNEL,
+                context.getString(R.string.notification_channel_web),
+                NotificationManager.IMPORTANCE_DEFAULT));
+        manager.createNotificationChannel(new NotificationChannel(CHANNEL_SILENT,
+                context.getString(R.string.notification_channel_web_silent),
+                NotificationManager.IMPORTANCE_LOW));
+    }
+
+    /** Swiped away, or the site blocked from its own notification. */
+    public static final class Receiver extends BroadcastReceiver {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            int key = intent.getIntExtra(EXTRA_KEY, 0);
+            Entry entry = sLive.get(key);
+            if (ACTION_BLOCK.equals(intent.getAction())) {
+                String origin = entry != null ? entry.origin : null;
+                if (origin == null) {
+                    return;
+                }
+                save(context, origin, DENIED);
+                // Everything else of that site goes too.
+                for (int i = sLive.size() - 1; i >= 0; i--) {
+                    if (origin.equals(sLive.valueAt(i).origin)) {
+                        close(context, sLive.keyAt(i));
+                    }
+                }
+            } else if (ACTION_CLOSE.equals(intent.getAction()) && entry != null) {
+                sLive.remove(key);
+                WebApis.post(entry.frame, WebApis.event(entry.jsId, "close", true));
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/org/lineageos/jelly/webview/WebSpeech.java b/app/src/main/java/org/lineageos/jelly/webview/WebSpeech.java
