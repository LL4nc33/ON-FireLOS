+        String host = request.getOrigin().getHost();
+        int message = camera && microphone ? R.string.media_prompt_camera_microphone
+                : camera ? R.string.media_prompt_camera : R.string.media_prompt_microphone;
+        mMediaPrompt = new AlertDialog.Builder(mActivity)
+                .setTitle(R.string.media_prompt_title)
+                .setMessage(mActivity.getString(message, host != null ? host : origin))
+                .setPositiveButton(R.string.location_prompt_allow, (d, w) -> {
+                    if (!mIncognito) {
+                        prefs.edit().putString(key, "allow").apply();
+                    }
+                    mActivity.requestMediaPermissions(runtime, () -> request.grant(grant),
