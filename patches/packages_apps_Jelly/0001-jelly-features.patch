+/**
+ * All open browser windows as cards: tap to switch, X or a swipe to close,
+ * long press for more, + for a new one. Two views: a grid, or big cards side
+ * by side as in the recent apps overview (swipe up to close). Every tab stays
+ * the window of its own it always was - in Recents too - so a tab in the
+ * background holds no more memory than before: the card shows a small picture
+ * taken when the tab was last left, not the live page.
+ */
+public class TabsActivity extends AppCompatActivity {
+
+    public static final String EXTRA_CURRENT = "current";
+    private static final String PREFS = "tabs";
+    private static final String PREFS_VIEW = "tabs_view";
+    private static final String KEY_CARDS = "cards";
+    private static final String STATE_CURRENT_CLOSED = "current_closed";
+    // Sent by the navigation bar's slot while this overview is in front.
+    private static final String ACTION_CLOSE_ALL = "org.lineageos.jelly.action.CLOSE_ALL_TABS";
+    private static final int MENU_NEW = 1;
+    private static final int MENU_CLOSE_ALL = 2;
+    private static final int MENU_VIEW = 3;
+
+    private static final class Tab {
+        ActivityManager.AppTask task;
+        int id;
+        String title;
+        boolean incognito;
+    }
+
+    private final List<Tab> mTabs = new ArrayList<>();
+    // The tab this overview was opened from; its window holds the overview.
+    private int mCurrent;
+    private Tab mCurrentTab;
+    private int mCurrentIndex;
+    // Closed here, but its window waits until a tab is picked or the
+    // overview is left - closing it at once would close the overview too.
+    private boolean mCurrentClosed;
+    // Closed with "close all", undoable while the snackbar shows.
+    private List<Tab> mClosingAll;
+    private boolean mCards;
+    private int mCardWidth;
+    private int mActionBar;
+    private FrameLayout mContent;
+    private RecyclerView mList;
+    private float mPageRatio = 1.4f;
+
+    // Shared with the browser windows
+
+    private static File dir(Context c) {
+        File d = new File(c.getCacheDir(), "tabs");
+        d.mkdirs();
+        return d;
+    }
+
+    private static boolean isTab(ActivityManager.AppTask task) {
+        try {
+            ActivityManager.RecentTaskInfo info = task.getTaskInfo();
+            ComponentName c = info.baseIntent != null ? info.baseIntent.getComponent() : null;
+            if (c == null && info.baseActivity != null) {
+                c = info.baseActivity;
+            }
+            return c != null && c.getClassName().endsWith(".MainActivity");
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    public static int count(Context c) {
+        int n = 0;
+        for (ActivityManager.AppTask task : c.getSystemService(ActivityManager.class).getAppTasks()) {
+            if (isTab(task)) {
+                n++;
+            }
+        }
+        return n;
+    }
+
+    /** Called when a window is left: its picture and title for the card. */
+    public static void remember(AppCompatActivity activity, WebView view, boolean incognito) {
+        int id = activity.getTaskId();
+        Context app = activity.getApplicationContext();
+        String title = view.getTitle();
+        app.getSharedPreferences(PREFS, MODE_PRIVATE).edit()
+                .putString(id + "|t", incognito ? "" : (title != null ? title : ""))
+                .putBoolean(id + "|i", incognito)
+                .apply();
+        File file = new File(dir(app), id + ".jpg");
+        // A private tab leaves no picture of itself behind.
+        if (incognito || view.getWidth() == 0 || view.getHeight() == 0) {
+            file.delete();
+            return;
+        }
+        // Sharp enough for the big cards (about 60 % of the screen wide); the
+        // grid loads it at half that.
+        float scale = 0.6f;
+        Bitmap bitmap;
+        try {
+            bitmap = Bitmap.createBitmap((int) (view.getWidth() * scale),
+                    (int) (view.getHeight() * scale), Bitmap.Config.RGB_565);
+            Canvas canvas = new Canvas(bitmap);
+            canvas.scale(scale, scale);
+            canvas.translate(-view.getScrollX(), -view.getScrollY());
+            view.draw(canvas);
+        } catch (RuntimeException | OutOfMemoryError e) {
+            return;
+        }
+        AsyncTask.THREAD_POOL_EXECUTOR.execute(() -> {
+            try (FileOutputStream out = new FileOutputStream(file)) {
+                bitmap.compress(Bitmap.CompressFormat.JPEG, 80, out);
+            } catch (IOException ignored) {
+            } finally {
+                bitmap.recycle();
+            }
+        });
+    }
+
+    private static void forget(Context c, int id) {
+        new File(dir(c), id + ".jpg").delete();
+        c.getSharedPreferences(PREFS, MODE_PRIVATE).edit()
+                .remove(id + "|t").remove(id + "|i").apply();
+    }
+
+    // The overview
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        mCurrent = getIntent().getIntExtra(EXTRA_CURRENT, -1);
+        if (savedInstanceState != null) {
+            mCurrentClosed = savedInstanceState.getBoolean(STATE_CURRENT_CLOSED);
+        }
+        mCards = getSharedPreferences(PREFS_VIEW, MODE_PRIVATE).getBoolean(KEY_CARDS, false);
+
+        LinearLayout root = new LinearLayout(this);
