+
+/**
+ * Media a page plays: a notification with its controls, the lock screen,
+ * headset and Bluetooth buttons.
+ *
+ * The service runs only while something audible plays, and in the foreground
+ * then, so that Android does not end the browser for memory in the middle of
+ * a song. Paused, it stays as a plain notification for a few minutes and is
+ * gone after that.
+ */
+public class WebMedia extends Service {
+
+    private static final String CHANNEL = "web_media";
+    private static final int NOTIFICATION_ID = 0x4a6d;
+    private static final long PAUSED_KEEP_MS = 5 * 60_000;
+    private static final String ACTION = "action";
+
+    // What plays where; the service only shows it.
+    private static WebApis sOwner;
+    private static JavaScriptReplyProxy sFrame;
+    private static boolean sPlaying;
+    private static String sTitle = "";
+    private static String sArtist = "";
+    private static List<String> sActions = Collections.emptyList();
+    private static WebMedia sService;
+
+    static void update(Context context, WebApis owner, JavaScriptReplyProxy frame, boolean has,
+                       boolean playing, String title, String artist, List<String> actions) {
+        if (!has || !playing) {
+            // Only the page shown in the controls can take them away.
+            if (owner != sOwner || frame != sFrame) {
+                return;
+            }
+            if (!has) {
+                clear();
+                return;
+            }
+        }
+        sOwner = owner;
+        sFrame = frame;
+        sPlaying = playing;
+        sTitle = title;
+        sArtist = artist;
+        sActions = actions;
+        if (sService != null) {
+            sService.refresh();
+        } else if (playing) {
+            Context app = context.getApplicationContext();
+            app.startForegroundService(new Intent(app, WebMedia.class));
+        }
+    }
+
+    /** The page's window is gone. */
+    static void released(WebApis owner) {
+        if (owner == sOwner) {
+            clear();
+        }
+    }
+
+    static void open(Context context) {
+        if (sOwner != null) {
+            sOwner.toFront();
+        }
+    }
+
+    private static void clear() {
+        sOwner = null;
+        sFrame = null;
+        sPlaying = false;
+        if (sService != null) {
+            sService.stopSelf();
+        }
+    }
+
+    private static void action(String action) {
+        if (sOwner != null && sFrame != null) {
+            WebApis.post(sFrame, WebApis.media(action));
+        }
+    }
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mGiveUp = WebMedia::clear;
+    private MediaSession mSession;
+    private boolean mForeground;
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        sService = this;
+        NotificationChannel channel = new NotificationChannel(CHANNEL,
+                getString(R.string.media_channel), NotificationManager.IMPORTANCE_LOW);
+        channel.setShowBadge(false);
+        getSystemService(NotificationManager.class).createNotificationChannel(channel);
+        mSession = new MediaSession(this, "Jelly");
+        mSession.setCallback(new MediaSession.Callback() {
+            @Override
+            public void onPlay() {
+                action("play");
+            }
+
+            @Override
+            public void onPause() {
+                action("pause");
+            }
+
+            @Override
+            public void onStop() {
+                action("pause");
+            }
+
+            @Override
+            public void onSkipToNext() {
+                action("nexttrack");
+            }
+
+            @Override
+            public void onSkipToPrevious() {
+                action("previoustrack");
+            }
+
+            @Override
+            public void onFastForward() {
+                action("seekforward");
+            }
+
+            @Override
+            public void onRewind() {
+                action("seekbackward");
+            }
+        });
+        mSession.setActive(true);
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        String action = intent != null ? intent.getStringExtra(ACTION) : null;
+        if ("dismiss".equals(action)) {
+            clear();
+            action = null;
+        }
+        if (action != null) {
+            action("toggle".equals(action) ? (sPlaying ? "pause" : "play") : action);
+        }
+        refresh();
+        return START_NOT_STICKY;
+    }
+
+    private void refresh() {
+        if (sOwner == null) {
+            if (!mForeground) {
+                // Started for the foreground: it has to be granted once.
+                startForeground(NOTIFICATION_ID, build());
+                mForeground = true;
+            }
+            stopSelf();
+            return;
+        }
+        Notification notification = build();
+        if (sPlaying) {
+            mHandler.removeCallbacks(mGiveUp);
+            startForeground(NOTIFICATION_ID, notification);
+            mForeground = true;
+        } else {
+            if (!mForeground) {
+                startForeground(NOTIFICATION_ID, notification);
+            }
+            stopForeground(false);
+            mForeground = true;
+            getSystemService(NotificationManager.class).notify(NOTIFICATION_ID, notification);
+            mHandler.removeCallbacks(mGiveUp);
+            mHandler.postDelayed(mGiveUp, PAUSED_KEEP_MS);
+        }
+    }
+
+    private Notification build() {
+        String host = sOwner != null ? sOwner.host() : "";
+        boolean incognito = sOwner != null && sOwner.isIncognito();
+        // A copy (WebApis.favicon), so the WebView recycling its own cannot
+        // break the session or the notification.
+        Bitmap icon = sOwner != null && !incognito ? sOwner.favicon() : null;
+
+        long actions = PlaybackState.ACTION_PLAY | PlaybackState.ACTION_PAUSE
+                | PlaybackState.ACTION_PLAY_PAUSE | PlaybackState.ACTION_STOP;
+        if (sActions.contains("nexttrack")) {
+            actions |= PlaybackState.ACTION_SKIP_TO_NEXT;
+        }
+        if (sActions.contains("previoustrack")) {
+            actions |= PlaybackState.ACTION_SKIP_TO_PREVIOUS;
+        }
+        mSession.setPlaybackState(new PlaybackState.Builder()
+                .setActions(actions)
+                .setState(sPlaying ? PlaybackState.STATE_PLAYING : PlaybackState.STATE_PAUSED,
+                        PlaybackState.PLAYBACK_POSITION_UNKNOWN, 1f)
+                .build());
+        MediaMetadata.Builder meta = new MediaMetadata.Builder()
+                .putString(MediaMetadata.METADATA_KEY_TITLE, sTitle)
+                .putString(MediaMetadata.METADATA_KEY_ARTIST,
+                        sArtist.isEmpty() ? host : sArtist);
+        if (icon != null) {
+            meta.putBitmap(MediaMetadata.METADATA_KEY_ART, icon);
+        }
+        mSession.setMetadata(meta.build());
+
+        List<Notification.Action> buttons = new ArrayList<>();
+        List<Integer> compact = new ArrayList<>();
+        if (sActions.contains("previoustrack")) {
+            compact.add(buttons.size());
+            buttons.add(button(android.R.drawable.ic_media_previous, R.string.media_previous,
+                    "previoustrack", 1));
+        }
+        compact.add(buttons.size());
+        buttons.add(sPlaying
+                ? button(android.R.drawable.ic_media_pause, R.string.pip_pause, "toggle", 2)
+                : button(android.R.drawable.ic_media_play, R.string.pip_play, "toggle", 2));
+        if (sActions.contains("nexttrack")) {
+            compact.add(buttons.size());
+            buttons.add(button(android.R.drawable.ic_media_next, R.string.media_next,
+                    "nexttrack", 3));
+        }
+        int[] compactView = new int[compact.size()];
+        for (int i = 0; i < compactView.length; i++) {
+            compactView[i] = compact.get(i);
+        }
+
+        Notification.Builder builder = new Notification.Builder(this, CHANNEL)
+                .setSmallIcon(R.drawable.ic_web_media)
+                .setContentTitle(sTitle)
+                .setContentText(sArtist.isEmpty() ? host : sArtist)
+                .setShowWhen(false)
+                .setOngoing(sPlaying)
+                .setVisibility(incognito ? Notification.VISIBILITY_PRIVATE
+                        : Notification.VISIBILITY_PUBLIC)
+                .setContentIntent(PendingIntent.getActivity(this, 0,
+                        new Intent(this, TaskFrontActivity.class)
+                                .putExtra(TaskFrontActivity.EXTRA_MEDIA, true)
+                                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+                        PendingIntent.FLAG_UPDATE_CURRENT))
+                .setDeleteIntent(service("dismiss", 4))
+                .setStyle(new Notification.MediaStyle()
+                        .setMediaSession(mSession.getSessionToken())
+                        .setShowActionsInCompactView(compactView));
+        for (Notification.Action button : buttons) {
+            builder.addAction(button);
+        }
+        if (icon != null) {
+            builder.setLargeIcon(icon);
+        }
+        return builder.build();
+    }
+
+    private Notification.Action button(int icon, int label, String action, int code) {
+        return new Notification.Action.Builder(Icon.createWithResource(this, icon),
+                getString(label), service(action, code)).build();
+    }
+
+    private PendingIntent service(String action, int code) {
+        return PendingIntent.getService(this, code,
+                new Intent(this, WebMedia.class).putExtra(ACTION, action),
+                PendingIntent.FLAG_UPDATE_CURRENT);
+    }
+
+    @Override
+    public void onDestroy() {
+        mHandler.removeCallbacks(mGiveUp);
+        sService = null;
+        mSession.setActive(false);
+        mSession.release();
+        stopForeground(true);
+        getSystemService(NotificationManager.class).cancel(NOTIFICATION_ID);
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
