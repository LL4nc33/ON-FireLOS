+package org.lineageos.jelly.webapp;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.graphics.drawable.Icon;
+import android.net.Uri;
+
+import org.lineageos.jelly.MainActivity;
+import org.lineageos.jelly.R;
+import org.lineageos.jelly.utils.IntentUtils;
+import org.lineageos.jelly.webview.ContentBlocker;
+
+/**
+ * The browser menu for an installed web app.
+ *
+ * A web app window has no address bar and so no menu. Like Firefox does for
+ * its web apps, the controls sit in a notification while the app is in front:
+ * ad blocking for this site, reload, open in the browser. Minimum importance,
+ * so it shows only in the pulled-down shade and never in the status bar.
+ */
+final class WebAppControls {
+    private static final String CHANNEL = "webapp_controls";
+    private static final String EXTRA_WHAT = "what";
+    private static final int TOGGLE_BLOCKING = 1;
+    private static final int RELOAD = 2;
+
+    interface Host {
+        void reload();
+
+        /** Called after the blocker was switched for the current site. */
+        void onBlockingChanged();
+    }
+
+    private final Context mContext;
+    private final Host mHost;
+    private final String mTitle;
+    private final NotificationManager mManager;
+    // One per web app, the same across its windows: a window whose process
+    // died leaves its notification behind, and the next one replaces it.
+    private final int mId;
+    private final String mAction;
+    private boolean mRegistered;
+    private String mUrl;
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            switch (intent.getIntExtra(EXTRA_WHAT, 0)) {
+                case TOGGLE_BLOCKING:
+                    String host = host();
+                    if (host != null) {
+                        ContentBlocker.setBlockedOnSite(mContext, host,
+                                ContentBlocker.isAllowedSite(host));
+                        mHost.onBlockingChanged();
+                        show(mUrl);
+                    }
+                    break;
+                case RELOAD:
+                    mHost.reload();
+                    break;
+            }
+        }
+    };
+
+    WebAppControls(Context context, Host host, String key, String title) {
+        mId = key.hashCode();
+        mAction = "org.lineageos.jelly.WEBAPP_CONTROL." + mId;
+        mContext = context;
+        mHost = host;
+        mTitle = title;
+        mManager = context.getSystemService(NotificationManager.class);
+        NotificationChannel channel = new NotificationChannel(CHANNEL,
+                context.getString(R.string.webapp_controls_channel),
+                NotificationManager.IMPORTANCE_MIN);
+        channel.setShowBadge(false);
+        mManager.createNotificationChannel(channel);
+    }
+
+    private String host() {
+        return mUrl != null ? Uri.parse(mUrl).getHost() : null;
+    }
+
+    /** Shows or refreshes the controls for the page now open. */
+    void show(String url) {
+        mUrl = url;
+        String host = host();
+        if (host == null) {
+            hide();
+            return;
+        }
+        if (!mRegistered) {
+            mContext.registerReceiver(mReceiver, new IntentFilter(mAction),
+                    IntentUtils.PERMISSION_INTERNAL, null);
+            mRegistered = true;
+        }
+        boolean blocking = ContentBlocker.isEnabled() && !ContentBlocker.isAllowedSite(host);
+        Notification.Builder b = new Notification.Builder(mContext, CHANNEL)
+                .setSmallIcon(R.drawable.ic_shield)
+                .setContentTitle(mTitle)
+                .setContentText(mContext.getString(!ContentBlocker.isEnabled()
+                        ? R.string.webapp_controls_text_off_everywhere
+                        : blocking ? R.string.webapp_controls_text_blocking
+                        : R.string.webapp_controls_text_allowed, host))
+                .setOngoing(true)
+                .setOnlyAlertOnce(true)
+                .setShowWhen(false)
+                .setVisibility(Notification.VISIBILITY_SECRET);
+        if (ContentBlocker.isEnabled()) {
+            b.addAction(action(TOGGLE_BLOCKING, blocking
+                    ? R.string.webapp_action_allow_ads : R.string.webapp_action_block_ads));
+        }
+        b.addAction(action(RELOAD, R.string.menu_reload));
+        Intent open = new Intent(Intent.ACTION_VIEW, Uri.parse(url))
+                .setClass(mContext, MainActivity.class)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        b.addAction(new Notification.Action.Builder((Icon) null,
+                mContext.getString(R.string.webapp_action_open_browser),
+                PendingIntent.getActivity(mContext, mId, open,
+                        PendingIntent.FLAG_UPDATE_CURRENT)).build());
+        mManager.notify(mId, b.build());
+    }
+
+    private Notification.Action action(int what, int label) {
+        Intent i = new Intent(mAction).setPackage(mContext.getPackageName())
+                .putExtra(EXTRA_WHAT, what);
+        PendingIntent pi = PendingIntent.getBroadcast(mContext, what, i,
+                PendingIntent.FLAG_UPDATE_CURRENT);
+        return new Notification.Action.Builder((Icon) null, mContext.getString(label), pi)
+                .build();
+    }
+
+    void hide() {
+        mManager.cancel(mId);
+        if (mRegistered) {
+            mContext.unregisterReceiver(mReceiver);
+            mRegistered = false;
+        }
+    }
+}
