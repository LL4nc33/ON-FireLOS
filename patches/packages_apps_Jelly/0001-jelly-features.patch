+  function sticky() { var u = navigator.userActivation; return !u || u.hasBeenActive; }
+  function call(h, t, e) { if (typeof h === 'function') { try { h.call(t, e); } catch (x) { setTimeout(function () { throw x; }); } } }
+  function abs(u) { try { return u ? new URL(u, location.href).href : ''; } catch (e) { return ''; } }
+
+  // Speech synthesis, spoken by Android's text-to-speech engine.
+  if (!('speechSynthesis' in window)) (function () {
+    var queue = [], cur = null, curId = 0, pos = 0, paused = false, voices = [], asked = false;
+    function Voice(v) { this.voiceURI = v.n; this.name = v.n; this.lang = v.l; this.localService = !v.net; this.default = !!v.d; }
+    class SpeechSynthesisUtterance extends EventTarget {
+      constructor(text) {
+        super();
+        this.text = text === undefined ? '' : String(text);
+        this.lang = ''; this.voice = null; this.volume = 1; this.rate = 1; this.pitch = 1;
+        this.onstart = this.onend = this.onerror = this.onpause = this.onresume = this.onmark = this.onboundary = null;
+      }
+    }
+    function fire(u, type, o) {
+      var e = new Event(type);
+      e.utterance = u; e.charIndex = o && o.ci || 0; e.charLength = o && o.cl || 0; e.elapsedTime = 0; e.name = o && o.name || '';
+      if (type === 'error') e.error = o && o.err || 'synthesis-failed';
+      u.dispatchEvent(e); call(u['on' + type], u, e);
+    }
+    function next() { cur = queue.shift() || null; pos = 0; if (cur !== null) say(0, true); }
+    function say(from, first) {
+      var u = cur, lang = u.lang || (u.voice && u.voice.lang) || document.documentElement.lang || navigator.language || '';
+      var id = send({ t: 'tts.speak', text: u.text.slice(from), lang: lang, voice: u.voice ? u.voice.voiceURI : '',
+        rate: +u.rate || 1, pitch: u.pitch == null ? 1 : +u.pitch, volume: u.volume == null ? 1 : +u.volume }, function (m) {
+        if (id !== curId || u !== cur) return;
+        if (m.ev === 'start') { if (first) { first = false; fire(u, 'start'); } }
+        else if (m.ev === 'boundary') { pos = from + m.ci; fire(u, 'boundary', { ci: from + m.ci, cl: m.cl, name: 'word' }); }
