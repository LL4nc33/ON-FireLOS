+
+package org.lineageos.jelly.webview;
+
+import android.app.Activity;
+import android.os.Bundle;
+
+/**
+ * Invisible stop between a notification and the browser window it belongs
+ * to. Every page is a window of its own; only an activity started from the
+ * notification can bring exactly that one back to the front.
+ */
+public class TaskFrontActivity extends Activity {
+
+    static final String EXTRA_NOTIFICATION = "notification";
+    static final String EXTRA_MEDIA = "media";
+    static final String EXTRA_TASK = "task";
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        int key = getIntent().getIntExtra(EXTRA_NOTIFICATION, 0);
+        if (key != 0) {
+            WebNotify.clicked(this, key);
+        } else if (getIntent().getBooleanExtra(EXTRA_MEDIA, false)) {
+            WebMedia.open(this);
+        } else if (getIntent().getIntExtra(EXTRA_TASK, -1) != -1) {
+            try {
+                getSystemService(android.app.ActivityManager.class)
+                        .moveTaskToFront(getIntent().getIntExtra(EXTRA_TASK, -1), 0);
+            } catch (RuntimeException ignored) {
+            }
+        }
+        finish();
+    }
+}
