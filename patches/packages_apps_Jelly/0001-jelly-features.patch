+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.lineageos.jelly.webview;
+
+import android.Manifest;
+import android.app.ActivityManager;
+import android.app.DownloadManager;
+import android.content.ActivityNotFoundException;
+import android.content.ClipData;
+import android.content.Intent;
+import android.graphics.Bitmap;
+import android.net.Uri;
+import android.os.Environment;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+import android.util.Base64;
+import android.util.Log;
+import android.util.SparseArray;
+import android.webkit.MimeTypeMap;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.core.content.FileProvider;
+import androidx.webkit.JavaScriptReplyProxy;
+import androidx.webkit.ScriptHandler;
+import androidx.webkit.WebViewCompat;
+import androidx.webkit.WebViewFeature;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.lineageos.jelly.R;
+import org.lineageos.jelly.utils.PrefsUtils;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Web APIs the WebView of Android 9 does not have: speech synthesis,
+ * notifications, sharing, media controls, and downloads of files a page
+ * makes itself.
+ *
+ * A script (res/raw/web_apis.js) puts the missing objects in place before a
+ * page's own code runs; what they are asked to do arrives here over the
+ * browser's message channel, together with the frame that asked. Nothing is
+ * started before a page uses it.
+ */
+final class WebApis {
+
+    private static final String TAG = "WebApis";
+    private static final String FILE_PROVIDER = "org.lineageos.jelly.fileprovider";
+
+    // One thread for the file work of all windows; started on first use.
+    private static final ExecutorService IO = Executors.newSingleThreadExecutor();
+    private static String sScript;
+
+    private final WebViewExtActivity mActivity;
+    private final WebViewExt mView;
+    private final boolean mIncognito;
+    private final Handler mMain = new Handler(Looper.getMainLooper());
+    private final SparseArray<Download> mDownloads = new SparseArray<>();
+    private AlertDialog mPrompt;
+    private ScriptHandler mLightEffects;
+    private int mNextDownload;
+    private boolean mReleased;
+
+    private static final class Download {
+        File file;
+        FileOutputStream out;
+        String mime;
+        boolean failed;
+    }
+
+    WebApis(WebViewExtActivity activity, WebViewExt view, boolean incognito) {
+        mActivity = activity;
+        mView = view;
+        mIncognito = incognito;
+    }
+
+    void install() {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) {
+            return;
+        }
+        String script = script();
+        if (script.isEmpty()) {
+            return;
+        }
+        try {
+            WebViewCompat.addDocumentStartJavaScript(mView, script, Collections.singleton("*"));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot add web API script: " + e);
+        }
+    }
+
+    // Background blur (frosted glass) is the one effect this GPU cannot draw
+    // smoothly. A style sheet adopted before the page loads switches it off.
+    private static final String LIGHT_EFFECTS_JS = "(function(){try{"
+            + "var s=new CSSStyleSheet();s.replaceSync('*,*::before,*::after{"
+            + "-webkit-backdrop-filter:none!important;backdrop-filter:none!important}');"
+            + "document.adoptedStyleSheets=document.adoptedStyleSheets.concat([s]);"
+            + "}catch(e){}})()";
+
+    /** Follows the setting; applies to pages loaded from now on. */
+    void updateEffects() {
+        if (mReleased || !WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) {
+            return;
+        }
+        boolean on = PrefsUtils.getLightEffects(mActivity);
+        if (on && mLightEffects == null) {
+            try {
+                mLightEffects = WebViewCompat.addDocumentStartJavaScript(mView,
+                        LIGHT_EFFECTS_JS, Collections.singleton("*"));
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Cannot add effects script: " + e);
+            }
+        } else if (!on && mLightEffects != null) {
+            mLightEffects.remove();
+            mLightEffects = null;
+        }
+    }
+
+    private String script() {
+        if (sScript == null) {
+            try (InputStream in = mActivity.getResources().openRawResource(R.raw.web_apis)) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buffer = new byte[8192];
+                int n;
+                while ((n = in.read(buffer)) > 0) {
+                    out.write(buffer, 0, n);
+                }
+                sScript = out.toString("UTF-8");
+            } catch (IOException e) {
+                Log.w(TAG, "Cannot read web API script: " + e);
+                sScript = "";
+            }
+        }
+        return sScript;
+    }
+
+    void handle(String data, Uri sourceOrigin, boolean isMainFrame, JavaScriptReplyProxy frame) {
+        if (mReleased) {
+            return;
+        }
+        JSONObject m;
+        try {
+            m = new JSONObject(data);
+        } catch (JSONException e) {
+            return;
+        }
+        String origin = sourceOrigin != null ? sourceOrigin.toString() : "";
+        int id = m.optInt("id");
+        switch (m.optString("t")) {
+            case "tts.speak":
+                WebSpeech.get(mActivity).speak(this,
+                        (jsId, event, ci, cl, error) -> {
+                            JSONObject o = event(jsId, event,
+                                    "end".equals(event) || "error".equals(event));
+                            put(o, "ci", ci);
+                            put(o, "cl", cl);
+                            if (error != null) {
+                                put(o, "err", error);
+                            }
+                            post(frame, o);
+                        },
+                        id, m.optString("text"), m.optString("lang"), m.optString("voice"),
+                        (float) m.optDouble("rate", 1), (float) m.optDouble("pitch", 1),
+                        (float) m.optDouble("volume", 1));
+                break;
+            case "tts.stop":
+                WebSpeech.get(mActivity).stop(this);
+                break;
+            case "tts.voices":
+                WebSpeech.get(mActivity).voices(list -> {
+                    JSONObject o = event(id, "voices", true);
+                    put(o, "voices", list);
+                    post(frame, o);
+                });
+                break;
+            case "nt.state":
+                post(frame, put(event(id, "state", true), "p",
+                        WebNotify.state(mActivity, origin, mIncognito)));
+                break;
+            case "nt.ask":
+                askNotifications(origin, isMainFrame, id, frame);
+                break;
+            case "nt.show":
+                if (!WebNotify.GRANTED.equals(WebNotify.state(mActivity, origin, mIncognito))) {
+                    post(frame, event(id, "error", true));
+                    break;
+                }
+                WebNotify.show(mActivity, this, frame, id, origin,
+                        isMainFrame && mView.getUrl() != null ? mView.getUrl() : origin,
+                        limit(m.optString("title"), 200), limit(m.optString("body"), 1000),
+                        limit(m.optString("tag"), 200), m.optBoolean("silent"), favicon());
+                post(frame, event(id, "show", false));
+                break;
+            case "nt.close": {
+                int key = WebNotify.find(frame, m.optInt("k"));
+                if (key != 0) {
+                    WebNotify.close(mActivity, key);
+                }
+                break;
+            }
+            case "share":
+                if (isMainFrame) {
+                    share(m, id, frame);
+                }
+                break;
+            case "dl.start":
+                downloadStart(m, id, frame);
+                break;
+            case "dl.data":
+                downloadData(m, id, frame);
+                break;
+            case "dl.end":
+                downloadEnd(m.optInt("k"), m.optBoolean("fail"));
+                break;
+            case "media": {
+                List<String> actions = new ArrayList<>();
+                JSONArray list = m.optJSONArray("acts");
+                for (int i = 0; list != null && i < list.length(); i++) {
+                    actions.add(list.optString(i));
+                }
+                WebMedia.update(mActivity, this, frame, m.optBoolean("has"),
+                        m.optBoolean("play"), limit(m.optString("title"), 200),
+                        limit(m.optString("artist"), 200), actions);
+                // A video in the page keeps the screen on, as a fullscreen one does.
+                mView.setKeepScreenOn(m.optBoolean("video"));
+                break;
+            }
+        }
+    }
+
+    // Notifications
+
+    private void askNotifications(String origin, boolean isMainFrame, int id,
+                                  JavaScriptReplyProxy frame) {
+        String state = WebNotify.state(mActivity, origin, mIncognito);
+        if (!WebNotify.DEFAULT.equals(state) || !isMainFrame || mPrompt != null) {
+            post(frame, put(event(id, "state", true), "p", state));
+            return;
+        }
+        String host = Uri.parse(origin).getHost();
+        mPrompt = new AlertDialog.Builder(mActivity)
+                .setTitle(R.string.notification_prompt_title)
+                .setMessage(mActivity.getString(R.string.notification_prompt_message,
+                        host != null ? host : origin))
+                .setPositiveButton(R.string.location_prompt_allow,
+                        (d, w) -> answer(origin, WebNotify.GRANTED, id, frame))
+                .setNegativeButton(R.string.location_prompt_block,
+                        (d, w) -> answer(origin, WebNotify.DENIED, id, frame))
+                .setOnCancelListener(d -> answer(origin, null, id, frame))
+                .show();
+    }
+
+    private void answer(String origin, String state, int id, JavaScriptReplyProxy frame) {
+        mPrompt = null;
+        if (state != null) {
+            WebNotify.save(mActivity, origin, state);
+        }
+        post(frame, put(event(id, "state", true), "p",
+                state != null ? state : WebNotify.DEFAULT));
+    }
+
+    /** Brings this page's window to the front; false if it is gone. */
+    boolean toFront() {
+        if (mReleased || mActivity.isDestroyed()) {
+            return false;
+        }
+        mActivity.getSystemService(ActivityManager.class)
+                .moveTaskToFront(mActivity.getTaskId(), 0);
+        return true;
+    }
+
+    /** The page's icon, as a copy: the WebView may recycle its own at any time. */
+    Bitmap favicon() {
+        Bitmap icon = mReleased ? null : mView.getFavicon();
+        return icon != null && !icon.isRecycled()
+                ? icon.copy(Bitmap.Config.ARGB_8888, false) : null;
+    }
+
+    String host() {
+        String url = mReleased ? null : mView.getUrl();
+        String host = url != null ? Uri.parse(url).getHost() : null;
+        return host != null ? host : "";
+    }
+
+    boolean isIncognito() {
+        return mIncognito;
+    }
+
+    // Sharing
+
+    private void share(JSONObject m, int id, JavaScriptReplyProxy frame) {
+        String title = m.optString("title");
+        String text = m.optString("text");
+        String url = m.optString("url");
+        JSONArray files = m.optJSONArray("files");
+        IO.execute(() -> {
+            ArrayList<Uri> uris = new ArrayList<>();
+            String type = null;
+            if (files != null && files.length() > 0) {
+                File dir = new File(mActivity.getCacheDir(), "share");
+                deleteContents(dir);
+                dir.mkdirs();
+                for (int i = 0; i < files.length(); i++) {
+                    JSONObject f = files.optJSONObject(i);
+                    if (f == null) {
+                        continue;
+                    }
+                    String data = f.optString("d");
+                    File out = unique(dir, safeName(f.optString("n"), "file"));
+                    try (FileOutputStream stream = new FileOutputStream(out)) {
+                        stream.write(Base64.decode(data.substring(data.indexOf(',') + 1),
+                                Base64.DEFAULT));
+                    } catch (IOException | IllegalArgumentException e) {
+                        continue;
+                    }
+                    uris.add(FileProvider.getUriForFile(mActivity, FILE_PROVIDER, out));
+                    String fileType = f.optString("ty");
+                    if (fileType.isEmpty()) {
+                        fileType = "application/octet-stream";
+                    }
+                    type = type == null || type.equals(fileType) ? fileType : "*/*";
+                }
+            }
+            final String streamType = type;
+            mMain.post(() -> {
+                if (mReleased) {
+                    return;
+                }
+                StringBuilder body = new StringBuilder(text);
+                if (!url.isEmpty()) {
+                    if (body.length() > 0) {
+                        body.append('\n');
+                    }
+                    body.append(url);
+                }
+                Intent intent = new Intent(uris.size() > 1
+                        ? Intent.ACTION_SEND_MULTIPLE : Intent.ACTION_SEND);
+                intent.setType(streamType != null ? streamType : "text/plain");
+                if (body.length() > 0) {
+                    intent.putExtra(Intent.EXTRA_TEXT, body.toString());
+                }
+                if (!title.isEmpty()) {
+                    intent.putExtra(Intent.EXTRA_SUBJECT, title);
+                }
+                if (uris.size() == 1) {
+                    intent.putExtra(Intent.EXTRA_STREAM, uris.get(0));
+                } else if (uris.size() > 1) {
+                    intent.putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris);
+                }
+                if (!uris.isEmpty()) {
+                    ClipData clip = ClipData.newRawUri(null, uris.get(0));
+                    for (int i = 1; i < uris.size(); i++) {
+                        clip.addItem(new ClipData.Item(uris.get(i)));
+                    }
+                    intent.setClipData(clip);
+                    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+                }
+                boolean ok = true;
+                try {
+                    mActivity.startActivity(Intent.createChooser(intent, null));
+                } catch (ActivityNotFoundException e) {
+                    ok = false;
+                }
+                post(frame, put(event(id, "share", true), "ok", ok));
+            });
+        });
+    }
+
+    // Downloads of blob: and data: links
+
+    private void downloadStart(JSONObject m, int id, JavaScriptReplyProxy frame) {
+        String mime = m.optString("type");
+        String name = m.optString("name");
+        if (name.isEmpty()) {
+            String ext = MimeTypeMap.getSingleton().getExtensionFromMimeType(mime);
+            name = "download" + (ext != null ? "." + ext : "");
+        }
+        final String fileName = safeName(name, "download");
+        if (mPrompt != null) {
+            post(frame, event(id, "no", true));
+            return;
+        }
+        mPrompt = new AlertDialog.Builder(mActivity)
+                .setTitle(R.string.download_title)
+                .setMessage(mActivity.getString(R.string.download_message, fileName))
+                .setPositiveButton(R.string.download_positive, (d, w) -> {
+                    mPrompt = null;
+                    mActivity.requestMediaPermissions(
+                            new String[]{Manifest.permission.WRITE_EXTERNAL_STORAGE},
+                            () -> downloadOpen(fileName, mime, id, frame),
+                            () -> post(frame, event(id, "no", true)));
+                })
+                .setNegativeButton(R.string.dismiss, (d, w) -> {
+                    mPrompt = null;
+                    post(frame, event(id, "no", true));
+                })
+                .setOnCancelListener(d -> {
+                    mPrompt = null;
+                    post(frame, event(id, "no", true));
+                })
+                .show();
+    }
+
+    private void downloadOpen(String name, String mime, int id, JavaScriptReplyProxy frame) {
+        IO.execute(() -> {
+            Download download = new Download();
+            File dir = Environment.getExternalStoragePublicDirectory(
+                    Environment.DIRECTORY_DOWNLOADS);
+            dir.mkdirs();
+            download.file = unique(dir, name);
+            download.mime = mime;
+            try {
+                download.out = new FileOutputStream(download.file);
+            } catch (IOException e) {
+                download.out = null;
+            }
+            mMain.post(() -> {
+                if (download.out == null || mReleased) {
+                    discard(download);
+                    if (!mReleased) {
+                        Toast.makeText(mActivity, R.string.download_failed,
+                                Toast.LENGTH_SHORT).show();
+                    }
+                    post(frame, event(id, "no", true));
+                    return;
+                }
+                int key = ++mNextDownload;
+                mDownloads.put(key, download);
+                post(frame, put(event(id, "go", true), "k", key));
+            });
+        });
+    }
+
+    private void downloadData(JSONObject m, int id, JavaScriptReplyProxy frame) {
+        Download download = mDownloads.get(m.optInt("k"));
+        if (download == null) {
+            post(frame, put(event(id, "data", true), "ok", false));
+            return;
+        }
+        String data = m.optString("d");
+        IO.execute(() -> {
+            if (!download.failed) {
+                try {
+                    download.out.write(Base64.decode(data, Base64.DEFAULT));
+                } catch (IOException | IllegalArgumentException e) {
+                    download.failed = true;
+                }
+            }
+            boolean ok = !download.failed;
+            mMain.post(() -> post(frame, put(event(id, "data", true), "ok", ok)));
+        });
+    }
+
+    private void downloadEnd(int key, boolean failed) {
+        Download download = mDownloads.get(key);
+        if (download == null) {
+            return;
+        }
+        mDownloads.remove(key);
+        download.failed |= failed;
+        String host = host();
+        IO.execute(() -> {
+            try {
+                download.out.close();
+            } catch (IOException e) {
+                download.failed = true;
+            }
+            if (download.failed) {
+                download.file.delete();
+                mMain.post(() -> Toast.makeText(mActivity.getApplicationContext(),
+                        R.string.download_failed, Toast.LENGTH_SHORT).show());
+                return;
+            }
+            String mime = download.mime;
+            if (TextUtils.isEmpty(mime)) {
+                String ext = MimeTypeMap.getFileExtensionFromUrl(
+                        Uri.fromFile(download.file).toString());
+                mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext);
+            }
+            if (TextUtils.isEmpty(mime)) {
+                mime = "application/octet-stream";
+            }
+            // In the Downloads app and its notification, like any other download.
+            mActivity.getSystemService(DownloadManager.class).addCompletedDownload(
+                    download.file.getName(), host.isEmpty() ? download.file.getName() : host,
+                    true, mime, download.file.getAbsolutePath(), download.file.length(), true);
+        });
+    }
+
+    private void discard(Download download) {
+        IO.execute(() -> {
+            if (download.out != null) {
+                try {
+                    download.out.close();
+                } catch (IOException ignored) {
+                }
+            }
+            if (download.file != null) {
+                download.file.delete();
+            }
+        });
+    }
+
+    /** A blob: or data: download the page started some other way than a link. */
+    void saveUrl(String url) {
+        mView.evaluateJavascript("window.__jellySave&&window.__jellySave("
+                + JSONObject.quote(url) + ",'')", null);
+    }
+
+    void release() {
+        if (mReleased) {
+            return;
+        }
+        mReleased = true;
+        if (mPrompt != null && mPrompt.isShowing()) {
+            mPrompt.dismiss();
+        }
+        mPrompt = null;
+        WebSpeech.get(mActivity).stop(this);
+        WebMedia.released(this);
+        for (int i = 0; i < mDownloads.size(); i++) {
+            discard(mDownloads.valueAt(i));
+        }
+        mDownloads.clear();
+    }
+
+    // Helpers
+
+    static void post(JavaScriptReplyProxy frame, JSONObject message) {
+        if (frame == null) {
+            return;
+        }
+        try {
+            frame.postMessage(message.toString());
+        } catch (RuntimeException e) {
+            // The frame is gone.
+        }
+    }
+
+    static JSONObject event(int id, String event, boolean last) {
+        JSONObject o = new JSONObject();
+        put(o, "id", id);
+        put(o, "ev", event);
+        if (last) {
+            put(o, "last", true);
+        }
+        return o;
+    }
+
+    static JSONObject media(String action) {
+        JSONObject o = new JSONObject();
+        put(o, "ev", "media");
+        put(o, "a", action);
+        return o;
+    }
+
+    private static JSONObject put(JSONObject o, String key, Object value) {
+        try {
+            o.put(key, value);
+        } catch (JSONException ignored) {
+        }
+        return o;
+    }
+
+    private static String limit(String s, int max) {
+        return s.length() > max ? s.substring(0, max) : s;
+    }
+
+    private static String safeName(String name, String fallback) {
+        String clean = name.replaceAll("[\\\\/:*?\"<>|\\p{Cntrl}]", "_").trim();
+        while (clean.startsWith(".")) {
+            clean = clean.substring(1);
+        }
+        if (clean.length() > 120) {
+            int dot = clean.lastIndexOf('.');
+            String ext = dot > 0 && clean.length() - dot <= 10 ? clean.substring(dot) : "";
+            clean = clean.substring(0, 120 - ext.length()) + ext;
+        }
+        return clean.isEmpty() ? fallback : clean;
+    }
+
+    private static File unique(File dir, String name) {
+        File file = new File(dir, name);
+        if (!file.exists()) {
+            return file;
+        }
+        int dot = name.lastIndexOf('.');
+        String base = dot > 0 ? name.substring(0, dot) : name;
+        String ext = dot > 0 ? name.substring(dot) : "";
+        for (int i = 1; ; i++) {
+            file = new File(dir, base + " (" + i + ")" + ext);
+            if (!file.exists()) {
+                return file;
+            }
+        }
+    }
+
+    private static void deleteContents(File dir) {
+        File[] files = dir.listFiles();
+        if (files != null) {
+            for (File f : files) {
+                f.delete();
+            }
+        }
+    }
+}
