+++ b/app/src/main/java/org/lineageos/jelly/webview/WebSpeech.java
@@ -0,0 +1,372 @@
+/*
+ * Copyright (C) 2026 ON-FireLOS
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.lineageos.jelly.webview;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.speech.tts.TextToSpeech;
+import android.speech.tts.UtteranceProgressListener;
+import android.speech.tts.Voice;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.function.Consumer;
+
+/**
+ * speechSynthesis for web pages, spoken by Android's text-to-speech engine.
+ *
+ * One engine connection for the whole browser, opened on the first word a
+ * page wants spoken and closed again a minute after the last one: the engine
+ * is a process of its own and costs memory while bound.
+ */
+final class WebSpeech extends UtteranceProgressListener implements TextToSpeech.OnInitListener {
+
+    interface Listener {
+        void onEvent(int id, String event, int charIndex, int charLength, String error);
+    }
+
+    private static final long IDLE_MS = 60_000;
+    private static WebSpeech sInstance;
+
+    static WebSpeech get(Context context) {
+        if (sInstance == null) {
+            sInstance = new WebSpeech(context.getApplicationContext());
+        }
+        return sInstance;
+    }
+
+    private final Context mContext;
+    private final Handler mMain = new Handler(Looper.getMainLooper());
+    private final ArrayList<Runnable> mWaiting = new ArrayList<>();
+    private final Runnable mRelease = this::release;
+
+    private TextToSpeech mTts;
+    private boolean mStarting;
+    private boolean mReady;
+
+    // The utterance being spoken: whose it is and where each piece starts.
+    private Object mOwner;
+    private Listener mListener;
+    private int mId;
+    private int mSerial;
+    private int[] mOffsets;
+
+    private WebSpeech(Context context) {
+        mContext = context;
+    }
+
+    private void whenReady(Runnable task) {
+        mMain.removeCallbacks(mRelease);
+        if (mReady) {
+            task.run();
+            return;
+        }
+        mWaiting.add(task);
+        if (mTts == null) {
+            mStarting = true;
+            mTts = new TextToSpeech(mContext, this, engine());
+            mTts.setOnUtteranceProgressListener(this);
+        }
+    }
+
+    /**
+     * The engine chosen in Settings, else the first one installed. Without a
+     * choice made in Settings, Android 9 tries only engines that came with
+     * the system - and finds none on a ROM without one, even with an engine
+     * from the store installed.
+     */
+    private String engine() {
+        String chosen = Settings.Secure.getString(mContext.getContentResolver(),
+                Settings.Secure.TTS_DEFAULT_SYNTH);
+        List<ResolveInfo> services = mContext.getPackageManager().queryIntentServices(
+                new Intent(TextToSpeech.Engine.INTENT_ACTION_TTS_SERVICE),
+                PackageManager.MATCH_DEFAULT_ONLY);
+        String first = null;
+        for (ResolveInfo service : services) {
+            String name = service.serviceInfo.packageName;
+            if (name.equals(chosen)) {
+                return name;
+            }
+            if (first == null) {
+                first = name;
+            }
+        }
+        return first;
+    }
+
+    @Override
+    public void onInit(int status) {
+        mMain.post(() -> {
+            mStarting = false;
+            mReady = status == TextToSpeech.SUCCESS && mTts != null;
+            ArrayList<Runnable> waiting = new ArrayList<>(mWaiting);
+            mWaiting.clear();
+            for (Runnable task : waiting) {
+                task.run();
+            }
+            if (!mReady) {
+                release();
+            }
+        });
+    }
+
+    void speak(Object owner, Listener listener, int id, String text, String lang, String voice,
+               float rate, float pitch, float volume) {
+        whenReady(() -> {
+            if (!mReady) {
+                listener.onEvent(id, "error", 0, 0, "synthesis-unavailable");
+                return;
+            }
+            interrupt();
+            if (text.trim().isEmpty()) {
+                listener.onEvent(id, "start", 0, 0, null);
+                listener.onEvent(id, "end", 0, 0, null);
+                scheduleRelease();
+                return;
+            }
+            mOwner = owner;
+            mListener = listener;
+            mId = id;
+            mSerial++;
+            if (!applyVoice(voice) && !lang.isEmpty()) {
+                mTts.setLanguage(Locale.forLanguageTag(lang));
+            }
+            mTts.setSpeechRate(clamp(rate, 0.1f, 10f));
+            mTts.setPitch(clamp(pitch, 0.1f, 2f));
+            Bundle params = new Bundle();
+            params.putFloat(TextToSpeech.Engine.KEY_PARAM_VOLUME, clamp(volume, 0f, 1f));
+
+            // The engine takes only so much at once: long texts go in pieces,
+            // cut where a sentence or at least a word ends.
+            int max = Math.max(100, TextToSpeech.getMaxSpeechInputLength() - 1);
+            ArrayList<Integer> starts = new ArrayList<>();
+            int start = 0;
+            while (start < text.length()) {
+                int end = Math.min(text.length(), start + max);
+                if (end < text.length()) {
+                    int cut = lastBreak(text, start, end);
+                    if (cut > start) {
+                        end = cut;
+                    }
+                }
+                starts.add(start);
+                start = end;
+            }
+            mOffsets = new int[starts.size() + 1];
+            for (int i = 0; i < starts.size(); i++) {
+                mOffsets[i] = starts.get(i);
+            }
+            mOffsets[starts.size()] = text.length();
+            for (int i = 0; i < starts.size(); i++) {
+                mTts.speak(text.substring(mOffsets[i], mOffsets[i + 1]),
+                        i == 0 ? TextToSpeech.QUEUE_FLUSH : TextToSpeech.QUEUE_ADD,
+                        params, mSerial + ":" + i);
+            }
+        });
+    }
+
+    void stop(Object owner) {
+        if (mOwner != owner || mTts == null) {
+            return;
+        }
+        mOwner = null;
+        mListener = null;
+        mSerial++;
+        mTts.stop();
+        scheduleRelease();
+    }
+
+    void voices(Consumer<JSONArray> result) {
+        whenReady(() -> {
+            JSONArray list = new JSONArray();
+            Set<Voice> voices = mReady ? mTts.getVoices() : null;
+            if (voices != null) {
+                Voice preferred = mTts.getDefaultVoice();
+                for (Voice voice : voices) {
+                    Set<String> features = voice.getFeatures();
+                    if (features != null && features.contains(
+                            TextToSpeech.Engine.KEY_FEATURE_NOT_INSTALLED)) {
+                        continue;
+                    }
+                    try {
+                        list.put(new JSONObject()
+                                .put("n", voice.getName())
+                                .put("l", voice.getLocale().toLanguageTag())
+                                .put("net", voice.isNetworkConnectionRequired())
+                                .put("d", voice.equals(preferred)));
+                    } catch (JSONException ignored) {
+                    }
+                }
+            }
+            result.accept(list);
+            if (mOwner == null) {
+                scheduleRelease();
+            }
+        });
+    }
+
+    private boolean applyVoice(String name) {
+        if (name.isEmpty()) {
+            return false;
+        }
+        Set<Voice> voices = mTts.getVoices();
+        if (voices != null) {
+            for (Voice voice : voices) {
+                if (voice.getName().equals(name)) {
+                    return mTts.setVoice(voice) == TextToSpeech.SUCCESS;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** Another page takes over: the one cut off hears that it was. */
+    private void interrupt() {
+        if (mListener != null) {
+            Listener listener = mListener;
+            int id = mId;
+            mListener = null;
+            mOwner = null;
+            listener.onEvent(id, "error", 0, 0, "interrupted");
+        }
+    }
+
+    private static int lastBreak(String text, int start, int end) {
+        for (int i = end - 1; i > start + (end - start) / 2; i--) {
+            char c = text.charAt(i);
+            if (c == '.' || c == '!' || c == '?' || c == '\n') {
+                return i + 1;
+            }
+        }
+        for (int i = end - 1; i > start; i--) {
+            if (Character.isWhitespace(text.charAt(i))) {
+                return i + 1;
+            }
+        }
+        return -1;
+    }
+
+    private static float clamp(float value, float min, float max) {
+        if (Float.isNaN(value)) {
+            return 1f;
+        }
+        return Math.max(min, Math.min(max, value));
+    }
+
+    private void scheduleRelease() {
+        mMain.removeCallbacks(mRelease);
+        mMain.postDelayed(mRelease, IDLE_MS);
+    }
+
+    private void release() {
+        if (mOwner != null || !mWaiting.isEmpty()) {
+            return;
+        }
+        if (mTts != null) {
+            mTts.shutdown();
+            mTts = null;
+        }
+        mReady = false;
+        mStarting = false;
+    }
+
+    // Progress arrives on a binder thread; utterance ids carry the serial so
+    // that a stopped utterance's late events go nowhere.
+    private void event(String utteranceId, String event, int charIndex, int charLength) {
+        mMain.post(() -> {
+            int colon = utteranceId.indexOf(':');
