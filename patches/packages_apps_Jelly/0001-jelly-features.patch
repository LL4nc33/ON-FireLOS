+// ON-FireLOS: web APIs the WebView of Android 9 does not have.
+// Runs before the page's own scripts in every frame. Each part only fills in
+// what is missing and does nothing until a page uses it.
+(function () {
+  'use strict';
+  var B = window.JellyBridge;
+  if (!B || window.__jellyWebApis) return;
+  try { Object.defineProperty(window, '__jellyWebApis', { value: true }); } catch (e) { return; }
+
+  var isTop = window.top === window, seq = 0, cbs = {}, evh = {};
+  B.addEventListener('message', function (e) {
+    var d = e.data, m;
+    if (typeof d !== 'string' || d.charAt(0) !== '{') return;
+    try { m = JSON.parse(d); } catch (x) { return; }
+    if (m.id != null) {
+      var f = cbs[m.id];
+      if (f) { if (m.last) delete cbs[m.id]; f(m); }
+    } else if (m.ev && evh[m.ev]) {
+      evh[m.ev](m);
+    }
+  });
+  function send(o, f) { o.id = ++seq; if (f) cbs[o.id] = f; B.postMessage(JSON.stringify(o)); return o.id; }
