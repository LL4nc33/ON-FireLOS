+            menu.getMenu().add(0, 1, 0, R.string.tab_close);
+            if (mTabs.size() > 1) {
+                menu.getMenu().add(0, 2, 1, R.string.tabs_close_others);
+            }
+            menu.setOnMenuItemClickListener(item -> {
+                if (item.getItemId() == 1) {
