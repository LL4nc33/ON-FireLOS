+    }
+
+    /**
+     * Swiping a card away closes its tab, as in other browsers: sideways in
+     * the grid, upwards in the big cards - there sideways scrolls the list, as
+     * in the recent apps overview.
+     */
+    private final class SwipeToClose implements View.OnTouchListener {
+        private final View mCard;
+        private final Tab mTab;
+        private final boolean mUp;
+        private final int mSlop;
+        private float mDownX;
+        private float mDownY;
+        private boolean mSwiping;
+        private VelocityTracker mVelocity;
+
+        SwipeToClose(View card, Tab tab, boolean up) {
+            mCard = card;
+            mTab = tab;
+            mUp = up;
+            mSlop = ViewConfiguration.get(TabsActivity.this).getScaledTouchSlop();
+        }
+
+        // How far along the swipe is, in its own direction (up is negative).
+        private float along(MotionEvent e) {
+            return mUp ? Math.min(0, e.getRawY() - mDownY) : e.getRawX() - mDownX;
+        }
+
+        private float across(MotionEvent e) {
+            return mUp ? e.getRawX() - mDownX : e.getRawY() - mDownY;
+        }
+
+        private float size() {
+            return mUp ? mCard.getHeight() : mCard.getWidth();
+        }
+
+        @Override
+        public boolean onTouch(View v, MotionEvent e) {
+            switch (e.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    mDownX = e.getRawX();
+                    mDownY = e.getRawY();
+                    mSwiping = false;
+                    mVelocity = VelocityTracker.obtain();
+                    mVelocity.addMovement(e);
+                    return false;
+                case MotionEvent.ACTION_MOVE: {
+                    if (mVelocity != null) {
+                        mVelocity.addMovement(e);
+                    }
+                    float d = along(e);
+                    if (!mSwiping && Math.abs(d) > mSlop
+                            && Math.abs(d) > Math.abs(across(e)) * 1.5f) {
+                        mSwiping = true;
+                        mCard.cancelLongPress();
+                        mCard.setPressed(false);
+                        mCard.getParent().requestDisallowInterceptTouchEvent(true);
+                        mList.requestDisallowInterceptTouchEvent(true);
+                    }
+                    if (mSwiping) {
+                        if (mUp) {
+                            mCard.setTranslationY(d);
+                        } else {
+                            mCard.setTranslationX(d);
+                        }
+                        mCard.setAlpha(Math.max(0.2f, 1 - Math.abs(d) / size()));
+                        return true;
+                    }
+                    return false;
+                }
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL: {
+                    boolean swiping = mSwiping;
+                    mSwiping = false;
+                    float d = along(e);
+                    float speed = 0;
+                    if (mVelocity != null) {
+                        mVelocity.addMovement(e);
+                        mVelocity.computeCurrentVelocity(1000);
+                        speed = mUp ? mVelocity.getYVelocity() : mVelocity.getXVelocity();
+                        mVelocity.recycle();
+                        mVelocity = null;
+                    }
+                    if (!swiping) {
+                        return false;
+                    }
+                    boolean fling = Math.abs(speed) > dp(800) && Math.signum(speed) == Math.signum(d);
+                    if (e.getActionMasked() == MotionEvent.ACTION_UP
+                            && (Math.abs(d) > size() / (mUp ? 4f : 3f) || fling)) {
+                        float out = Math.signum(d) * size() * 1.2f;
+                        (mUp ? mCard.animate().translationY(out) : mCard.animate().translationX(out))
+                                .alpha(0)
+                                .setDuration(150)
+                                .withEndAction(() -> close(mTab))
+                                .start();
+                    } else {
+                        mCard.animate().translationX(0).translationY(0).alpha(1)
+                                .setDuration(150).start();
+                    }
+                    return true;
+                }
+            }
+            return false;
+        }
+    }
+
+    private void open(Tab tab) {
+        if (tab.id != mCurrent) {
+            try {
+                tab.task.moveToFront();
+            } catch (RuntimeException ignored) {
+            }
+            if (mCurrentClosed && mCurrentTab != null) {
+                // The window this overview was opened from was closed here:
+                // it goes now, and this overview with it.
+                finishTask(mCurrentTab);
+                return;
+            }
+        }
+        finish();
+    }
+
+    private void finishTask(Tab tab) {
+        try {
+            tab.task.finishAndRemoveTask();
+        } catch (RuntimeException ignored) {
+        }
+    }
+
+    private void close(Tab tab) {
+        int position = mTabs.indexOf(tab);
+        if (position < 0) {
+            return;
+        }
+        forget(this, tab.id);
+        mTabs.remove(position);
+        if (tab.id == mCurrent) {
+            // This overview lives in that tab's window: it stays open, and the
+            // window goes once a tab is picked or the overview is left.
+            mCurrentClosed = true;
+            mCurrentIndex = position;
+        } else {
+            finishTask(tab);
+            if (position < mCurrentIndex) {
+                mCurrentIndex--;
+            }
+        }
+        mAdapter.notifyItemRemoved(position);
+        updateTitle();
+        if (mTabs.isEmpty()) {
+            // The last one: an empty tab to come back to, as other browsers do.
+            TabUtils.openInNewTab(this, null, false);
+            if (mCurrentTab != null) {
+                finishTask(mCurrentTab);
+            }
+            finish();
+        }
+    }
+
+    private void closeOthers(Tab keep) {
+        if (keep.id != mCurrent) {
+            // The window behind this overview goes too: bring the kept one forward first.
+            try {
+                keep.task.moveToFront();
+            } catch (RuntimeException ignored) {
+            }
+        }
+        for (Tab t : new ArrayList<>(mTabs)) {
+            if (t.id == keep.id) {
+                continue;
+            }
+            forget(this, t.id);
+            finishTask(t);
+        }
+        if (mCurrentClosed && mCurrentTab != null && keep.id != mCurrent) {
+            finishTask(mCurrentTab);
+        }
+        finish();
+    }
+
+    /** Closes every tab, with a few seconds to undo it. */
+    private void closeAll() {
+        if (mTabs.isEmpty() || mClosingAll != null) {
+            return;
+        }
+        mClosingAll = new ArrayList<>(mTabs);
+        int n = mTabs.size();
+        mTabs.clear();
+        mAdapter.notifyItemRangeRemoved(0, n);
+        updateTitle();
+        Snackbar.make(mContent, getString(R.string.tabs_all_closed, n), Snackbar.LENGTH_LONG)
+                .setAction(R.string.history_snackbar_item_deleted_message, v -> {
+                    List<Tab> back = mClosingAll;
+                    mClosingAll = null;
+                    if (back != null) {
+                        mTabs.addAll(back);
+                        mAdapter.notifyItemRangeInserted(0, back.size());
+                        updateTitle();
+                    }
+                })
+                .addCallback(new Snackbar.Callback() {
+                    @Override
+                    public void onDismissed(Snackbar bar, int event) {
+                        if (event != DISMISS_EVENT_ACTION && mClosingAll != null) {
+                            commitCloseAll(true);
+                        }
+                    }
+                })
+                .show();
+    }
+
+    private void commitCloseAll(boolean newTab) {
+        List<Tab> all = mClosingAll;
+        mClosingAll = null;
+        if (all == null) {
+            return;
+        }
+        if (newTab) {
+            // One empty tab to come back to, as other browsers do.
+            TabUtils.openInNewTab(this, null, false);
+        }
+        Tab current = mCurrentTab;
+        for (Tab t : all) {
+            forget(this, t.id);
+            if (t != current) {
+                finishTask(t);
+            }
+        }
+        // The window this overview lives in goes last, and the overview with it.
+        if (current != null) {
+            forget(this, current.id);
+            finishTask(current);
+        }
+        finish();
+    }
+
+    @Override
+    public boolean onCreateOptionsMenu(Menu menu) {
+        menu.add(0, MENU_VIEW, 0, R.string.tabs_change_view)
+                .setIcon(mCards ? R.drawable.ic_view_grid : R.drawable.ic_view_cards)
+                .setShowAsAction(MenuItem.SHOW_AS_ACTION_ALWAYS);
+        menu.add(0, MENU_NEW, 1, R.string.menu_new_tab)
+                .setIcon(R.drawable.ic_new_tab)
+                .setShowAsAction(MenuItem.SHOW_AS_ACTION_ALWAYS);
+        menu.add(0, MENU_CLOSE_ALL, 2, R.string.tabs_close_all)
+                .setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER);
+        return true;
+    }
+
+    @Override
+    public boolean onOptionsItemSelected(MenuItem item) {
+        if (item.getItemId() == MENU_VIEW) {
+            toggleView();
+            return true;
+        } else if (item.getItemId() == MENU_NEW) {
+            TabUtils.openInNewTab(this, null, false);
+            if (mCurrentClosed && mCurrentTab != null) {
+                finishTask(mCurrentTab);
+            }
+            finish();
+            return true;
+        } else if (item.getItemId() == MENU_CLOSE_ALL) {
+            closeAll();
+            return true;
+        }
+        return super.onOptionsItemSelected(item);
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                getResources().getDisplayMetrics());
+    }
+}
