+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.lineageos.jelly.webapp;
+
+import android.graphics.Color;
+import android.net.Uri;
+import android.text.TextUtils;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.net.MalformedURLException;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.UUID;
+
+/**
+ * The parts of a Web App Manifest that matter for installing a site as an app.
+ * Field names and defaults follow https://www.w3.org/TR/appmanifest/.
+ */
+public final class WebAppManifest {
+    public static final String DISPLAY_FULLSCREEN = "fullscreen";
+    public static final String DISPLAY_STANDALONE = "standalone";
+    public static final String DISPLAY_MINIMAL_UI = "minimal-ui";
+    public static final String DISPLAY_BROWSER = "browser";
+
+    public String id;
+    public String manifestUrl;
+    public String name;
+    public String shortName;
+    public String startUrl;
+    public String scope;
+    public String display = DISPLAY_BROWSER;
+    public int themeColor = Color.TRANSPARENT;
+    public int backgroundColor = Color.TRANSPARENT;
+    public final List<IconInfo> icons = new ArrayList<>();
+    /** Whether the stored icon is a maskable one, i.e. drawn with a bleed. */
+    public boolean iconMaskable;
+    /** ON-FireLOS: made from the page itself, the site has no usable manifest. */
+    public boolean fromPage;
+    /** ON-FireLOS: the full site's icons have been added (WebAppDetector). */
+    public boolean siblingIconsAdded;
+
+    public static final class IconInfo {
+        public String src;
+        public int size;
+        public boolean maskable;
+        public boolean any;
+    }
+
+    /** Stable key, used for the shortcut id, the stored record and the icon file. */
+    public String getKey() {
+        return UUID.nameUUIDFromBytes(id.getBytes()).toString();
+    }
+
+    public String getLabel() {
+        return !TextUtils.isEmpty(shortName) ? shortName : name;
+    }
+
+    public String getTitle() {
+        return !TextUtils.isEmpty(name) ? name : shortName;
+    }
+
+    /**
+     * What Chrome, Edge and Samsung Internet ask for before offering installation:
+     * a name, a secure origin and a display mode that is not plain "browser".
+     */
+    public boolean isInstallable() {
+        return !TextUtils.isEmpty(getTitle())
+                && startUrl != null
+                && isSecure(startUrl)
+                && !DISPLAY_BROWSER.equals(display);
+    }
+
+    public boolean isInScope(String url) {
+        return isInScope(scope, url);
+    }
+
+    public static boolean isInScope(String scope, String url) {
+        if (url == null || scope == null) {
+            return false;
+        }
+        // Origin first, exactly, then the path. A plain prefix test let a scope
+        // without a path, "https://example.com", take in
+        // "https://example.com.evil.net/" - and hide the bar that tells the
+        // user they left the app.
+        Uri u = Uri.parse(url);
+        Uri s = Uri.parse(scope);
+        if (u.getScheme() == null || !u.getScheme().equalsIgnoreCase(s.getScheme())
+                || u.getEncodedAuthority() == null
+                || !u.getEncodedAuthority().equalsIgnoreCase(s.getEncodedAuthority())) {
+            return false;
+        }
+        String path = u.getEncodedPath() == null ? "/" : u.getEncodedPath();
+        String scopePath = TextUtils.isEmpty(s.getEncodedPath()) ? "/" : s.getEncodedPath();
+        return path.startsWith(scopePath);
+    }
+
+    /** Raster icons, best first: maskable before any, larger before smaller. */
+    public List<IconInfo> getIconCandidates() {
+        List<IconInfo> result = new ArrayList<>();
+        for (IconInfo icon : icons) {
+            if (icon.maskable || icon.any) {
+                result.add(icon);
+            }
+        }
+        Collections.sort(result, (a, b) -> {
+            if (a.maskable != b.maskable) {
+                return a.maskable ? -1 : 1;
+            }
+            return Integer.compare(b.size, a.size);
+        });
+        return result;
+    }
+
+    static WebAppManifest parse(String json, String manifestUrl, String documentUrl)
+            throws JSONException {
+        JSONObject o = new JSONObject(json);
+        WebAppManifest m = new WebAppManifest();
+        m.manifestUrl = manifestUrl;
+        m.name = o.optString("name", "").trim();
+        m.shortName = o.optString("short_name", "").trim();
+
+        // start_url must be same-origin with the document, otherwise the
+        // document URL is used (spec, "processing the start_url member").
+        String start = resolve(manifestUrl, o.optString("start_url", ""));
+        m.startUrl = start != null && sameOrigin(start, documentUrl) ? start : documentUrl;
+
+        // Default scope: the start_url with everything after the last "/" removed.
+        String scope = resolve(manifestUrl, o.optString("scope", ""));
+        if (scope == null || !sameOrigin(scope, m.startUrl) || !m.startUrl.startsWith(scope)) {
+            String path = Uri.parse(m.startUrl).getPath();
+            int slash = path != null ? path.lastIndexOf('/') : -1;
+            Uri u = Uri.parse(m.startUrl);
+            scope = u.getScheme() + "://" + u.getEncodedAuthority()
+                    + (slash >= 0 ? path.substring(0, slash + 1) : "/");
+        }
+        m.scope = scope;
+
+        String id = resolve(m.startUrl, o.optString("id", ""));
+        m.id = id != null && sameOrigin(id, m.startUrl) ? stripFragment(id)
+                : stripFragment(m.startUrl);
+
+        String display = o.optString("display", DISPLAY_BROWSER).trim().toLowerCase(Locale.ROOT);
+        JSONArray override = o.optJSONArray("display_override");
+        if (override != null && override.length() > 0) {
+            // "window-controls-overlay" and "tabbed" have no meaning on a tablet
+            // without window chrome; take the first one we can honour.
+            for (int i = 0; i < override.length(); i++) {
+                String d = override.optString(i, "").toLowerCase(Locale.ROOT);
+                if (DISPLAY_FULLSCREEN.equals(d) || DISPLAY_STANDALONE.equals(d)
+                        || DISPLAY_MINIMAL_UI.equals(d)) {
+                    display = d;
+                    break;
+                }
+            }
+        }
+        if (!DISPLAY_FULLSCREEN.equals(display) && !DISPLAY_STANDALONE.equals(display)
+                && !DISPLAY_MINIMAL_UI.equals(display)) {
+            display = DISPLAY_BROWSER;
+        }
+        m.display = display;
+
+        m.themeColor = parseCssColor(o.optString("theme_color", null));
+        m.backgroundColor = parseCssColor(o.optString("background_color", null));
+
+        JSONArray icons = o.optJSONArray("icons");
+        if (icons != null) {
+            for (int i = 0; i < icons.length(); i++) {
+                JSONObject icon = icons.optJSONObject(i);
+                if (icon == null) {
+                    continue;
+                }
+                String src = resolve(manifestUrl, icon.optString("src", ""));
+                String type = icon.optString("type", "").toLowerCase(Locale.ROOT);
+                if (src == null || type.contains("svg")
+                        || src.toLowerCase(Locale.ROOT).contains(".svg")) {
+                    // No SVG decoder on this platform.
+                    continue;
+                }
+                IconInfo info = new IconInfo();
+                info.src = src;
+                info.size = largestSize(icon.optString("sizes", ""));
+                String purpose = icon.optString("purpose", "any").toLowerCase(Locale.ROOT);
+                info.maskable = purpose.contains("maskable");
+                info.any = purpose.contains("any") || purpose.trim().isEmpty();
+                m.icons.add(info);
+            }
+        }
+        return m;
+    }
+
+    private static int largestSize(String sizes) {
+        int best = 0;
+        for (String s : sizes.toLowerCase(Locale.ROOT).split("\\s+")) {
+            int x = s.indexOf('x');
+            if (x <= 0) {
+                continue;
+            }
+            try {
+                best = Math.max(best, Integer.parseInt(s.substring(0, x)));
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return best;
+    }
+
+    static String resolve(String base, String relative) {
+        if (TextUtils.isEmpty(relative)) {
+            return null;
+        }
+        String r = relative.trim();
+        if (r.regionMatches(true, 0, "data:", 0, 5)) {
+            // java.net.URL knows no data: scheme; it is absolute anyway.
+            return r;
+        }
+        try {
+            return new URL(new URL(base), relative.trim()).toString();
+        } catch (MalformedURLException e) {
+            return null;
+        }
+    }
+
+    private static String stripFragment(String url) {
+        int hash = url.indexOf('#');
+        return hash >= 0 ? url.substring(0, hash) : url;
+    }
+
+    static boolean sameOrigin(String a, String b) {
+        if (a == null || b == null) {
+            return false;
+        }
+        Uri ua = Uri.parse(a);
+        Uri ub = Uri.parse(b);
+        return TextUtils.equals(ua.getScheme(), ub.getScheme())
+                && TextUtils.equals(ua.getEncodedAuthority(), ub.getEncodedAuthority());
+    }
+
+    static boolean isSecure(String url) {
+        Uri u = Uri.parse(url);
+        return "https".equals(u.getScheme())
+                || ("http".equals(u.getScheme()) && "localhost".equals(u.getHost()));
+    }
+
+    /** #rgb, #rgba, #rrggbb, #rrggbbaa (CSS order), rgb()/rgba() and named colours. */
+    static int parseCssColor(String value) {
+        if (value == null) {
+            return Color.TRANSPARENT;
+        }
+        String v = value.trim().toLowerCase(Locale.ROOT);
+        try {
+            if (v.startsWith("#")) {
+                String h = v.substring(1);
+                if (h.length() == 3 || h.length() == 4) {
+                    StringBuilder sb = new StringBuilder();
+                    for (char c : h.toCharArray()) {
+                        sb.append(c).append(c);
+                    }
+                    h = sb.toString();
+                }
+                if (h.length() == 6) {
+                    return 0xff000000 | (int) Long.parseLong(h, 16);
+                }
+                if (h.length() == 8) {
+                    long rgba = Long.parseLong(h, 16);
+                    int alpha = (int) (rgba & 0xff);
+                    return (alpha << 24) | (int) (rgba >>> 8);
+                }
+                return Color.TRANSPARENT;
+            }
+            if (v.startsWith("rgb")) {
+                String inner = v.substring(v.indexOf('(') + 1, v.lastIndexOf(')'));
+                String[] p = inner.split("[,\\s/]+");
+                int r = Integer.parseInt(p[0].trim());
+                int g = Integer.parseInt(p[1].trim());
+                int b = Integer.parseInt(p[2].trim());
+                return Color.rgb(r, g, b);
+            }
+            return Color.parseColor(v);
+        } catch (RuntimeException e) {
+            return Color.TRANSPARENT;
+        }
+    }
+
+    /**
+     * ON-FireLOS: an app made from the page, for a site without a usable manifest. Its
+     * name from the page's metadata or the site part of its title, its icons from the
+     * page's links, start and scope the site's root, standalone.
+     */
+    static WebAppManifest fromPage(JSONObject page, String documentUrl) {
+        Uri u = Uri.parse(documentUrl);
+        String origin = u.getScheme() + "://" + u.getEncodedAuthority();
+        WebAppManifest m = new WebAppManifest();
+        m.fromPage = true;
+        m.manifestUrl = "";
+        m.startUrl = origin + "/";
+        m.scope = m.startUrl;
+        m.id = m.startUrl;
+        m.display = DISPLAY_STANDALONE;
+        m.name = page.optString("name", "").trim();
+        if (m.name.isEmpty()) {
+            m.name = siteFromTitle(page.optString("title", ""));
+        }
+        if (m.name.isEmpty()) {
+            m.name = u.getHost();
+        }
+        if (m.name.length() > 100) {
+            m.name = m.name.substring(0, 100).trim();
+        }
+        m.themeColor = parseCssColor(page.optString("theme", null));
+        JSONArray icons = page.optJSONArray("icons");
+        if (icons != null) {
+            for (int i = 0; i < icons.length(); i++) {
+                JSONObject icon = icons.optJSONObject(i);
+                if (icon == null) {
+                    continue;
+                }
+                String src = resolve(documentUrl, icon.optString("src", ""));
+                String type = icon.optString("type", "").toLowerCase(Locale.ROOT);
+                if (src == null || type.contains("svg")
+                        || src.toLowerCase(Locale.ROOT).contains(".svg")) {
+                    continue;
+                }
+                int size = largestSize(icon.optString("sizes", ""));
+                // Apple's touch icons are 180 px unless they say otherwise.
+                addIcon(m, src, size > 0 ? size : icon.optBoolean("touch") ? 180 : 32);
+                if (m.icons.size() >= 8) {
+                    break;
+                }
+            }
+        }
+        // Many sites answer this without linking it.
+        addIcon(m, origin + "/apple-touch-icon.png", 180);
+        return m;
+    }
+
+    private static void addIcon(WebAppManifest m, String src, int size) {
+        for (IconInfo known : m.icons) {
+            if (known.src.equals(src)) {
+                return;
+            }
+        }
+        IconInfo info = new IconInfo();
+        info.src = src;
+        info.size = size;
+        info.any = true;
+        m.icons.add(info);
+    }
+
+    /** "Video title - YouTube" gives "YouTube": the site's name usually comes last. */
+    static String siteFromTitle(String title) {
+        String t = title == null ? "" : title.trim();
+        String[] parts = t.split("\\s+[-|\u2013\u2014\u00b7]\\s+");
+        if (parts.length > 1) {
+            String last = parts[parts.length - 1].trim();
+            if (!last.isEmpty() && last.length() <= 30) {
+                return last;
+            }
+        }
+        return t.length() > 40 ? t.substring(0, 40).trim() : t;
+    }
+
+    /** The full site beside a mobile one: m.example.com gives https://www.example.com/. */
+    static String desktopSibling(String url) {
+        Uri u = Uri.parse(url);
+        String host = u.getHost();
+        if (host == null || !"https".equals(u.getScheme())) {
+            return null;
+        }
+        for (String prefix : new String[] {"m.", "mobile.", "touch."}) {
+            if (host.startsWith(prefix) && host.indexOf('.', prefix.length()) > 0) {
+                return "https://www." + host.substring(prefix.length()) + "/";
+            }
+        }
+        return null;
+    }
+
+    JSONObject toJson() throws JSONException {
+        JSONObject o = new JSONObject();
+        o.put("id", id);
+        o.put("manifest_url", manifestUrl);
+        o.put("name", name);
+        o.put("short_name", shortName);
+        o.put("start_url", startUrl);
+        o.put("scope", scope);
+        o.put("display", display);
+        o.put("theme_color", themeColor);
+        o.put("background_color", backgroundColor);
+        o.put("icon_maskable", iconMaskable);
+        return o;
+    }
+
+    static WebAppManifest fromJson(JSONObject o) {
+        WebAppManifest m = new WebAppManifest();
+        m.id = o.optString("id");
+        m.manifestUrl = o.optString("manifest_url");
+        m.name = o.optString("name");
+        m.shortName = o.optString("short_name");
+        m.startUrl = o.optString("start_url");
+        m.scope = o.optString("scope");
+        m.display = o.optString("display", DISPLAY_STANDALONE);
+        m.themeColor = o.optInt("theme_color", Color.TRANSPARENT);
+        m.backgroundColor = o.optInt("background_color", Color.TRANSPARENT);
+        m.iconMaskable = o.optBoolean("icon_maskable", false);
+        return m;
+    }
+}
