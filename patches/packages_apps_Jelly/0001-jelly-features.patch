+
+package org.lineageos.jelly.webview;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.drawable.Icon;
+import android.media.AudioAttributes;
+import android.media.AudioFormat;
+import android.media.AudioTrack;
+import android.media.MediaMetadata;
+import android.media.session.MediaSession;
+import android.media.session.PlaybackState;
+import android.net.Uri;
+import android.os.IBinder;
+import android.widget.Toast;
+
+import org.lineageos.jelly.R;
+
+/**
+ * Reads an article aloud with the text-to-speech engine, also with the
+ * screen off: a foreground service with the controls in the notification,
+ * on the lock screen and on headset buttons, like any player.
+ */
+public class ReadAloud extends Service {
+
+    public interface Listener {
+        void onReadAloudChanged();
+    }
+
+    private static final String CHANNEL = "read_aloud";
+    private static final int NOTIFICATION_ID = 0x5241;
+    private static final String ACTION = "action";
+
+    private static ReadAloud sService;
+    private static Listener sListener;
+    private static String sTitle = "";
+    private static String sHost = "";
+    private static String sText = "";
+    private static String sLang = "";
+    private static int sTask = -1;
+    private static int sOffset;
+    private static int sSpokenTo;
+    private static boolean sActive;
+    private static boolean sPaused;
+    private static int sSerial;
+
+    public static boolean isActive() {
+        return sActive;
+    }
+
+    public static boolean isPaused() {
+        return sPaused;
+    }
+
+    public static void setListener(Listener listener) {
+        sListener = listener;
+    }
+
+    public static void start(Context context, Reader.Article a, int taskId) {
+        stop(context);
+        sTitle = a.title != null ? a.title : "";
+        String host = a.url != null ? Uri.parse(a.url).getHost() : null;
+        sHost = host != null ? host : "";
+        sText = (sTitle.isEmpty() ? "" : sTitle + ". ") + a.text;
+        sLang = a.lang != null ? a.lang : "";
+        sTask = taskId;
+        sOffset = 0;
+        sActive = true;
+        sPaused = false;
+        Context app = context.getApplicationContext();
+        app.startForegroundService(new Intent(app, ReadAloud.class));
+        speak(app);
+        silence(true);
+        changed();
+    }
+
+    public static void toggle(Context context) {
+        if (!sActive) {
+            return;
+        }
+        if (sPaused) {
+            sPaused = false;
+            speak(context.getApplicationContext());
+            silence(true);
+        } else {
+            sPaused = true;
+            silence(false);
+            sOffset = sSpokenTo;
+            sSerial++;
+            WebSpeech.get(context).stop(ReadAloud.class);
+        }
+        if (sService != null) {
+            sService.refresh();
+        }
+        changed();
+    }
+
+    public static void stop(Context context) {
+        if (!sActive) {
+            return;
+        }
+        sActive = false;
+        sPaused = false;
+        sSerial++;
+        silence(false);
+        WebSpeech.get(context).stop(ReadAloud.class);
+        if (sService != null) {
+            sService.stopSelf();
+        }
+        changed();
+    }
+
+    // Android hands headset and Bluetooth buttons to the app that played
+    // sound last. The speech comes from the engine's own process, so without
+    // this the buttons went to the music app instead. A silent 8 kHz mono
+    // track, written only while speaking, makes the browser that app.
+    private static AudioTrack sSilence;
+
+    private static void silence(boolean on) {
+        if (on && sSilence == null) {
+            int rate = 8000;
+            int size = Math.max(1024, AudioTrack.getMinBufferSize(rate,
+                    AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT));
+            AudioTrack track;
+            try {
+                track = new AudioTrack.Builder()
+                        .setAudioAttributes(new AudioAttributes.Builder()
+                                .setUsage(AudioAttributes.USAGE_MEDIA)
+                                .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+                                .build())
+                        .setAudioFormat(new AudioFormat.Builder()
+                                .setSampleRate(rate)
+                                .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+                                .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                                .build())
+                        .setBufferSizeInBytes(size)
+                        .setTransferMode(AudioTrack.MODE_STREAM)
+                        .build();
+                track.play();
+            } catch (RuntimeException e) {
+                return;
+            }
+            sSilence = track;
+            final AudioTrack t = track;
+            new Thread(() -> {
+                byte[] zeros = new byte[size];
+                // write() blocks at the playback rate: no busy loop.
+                while (sSilence == t && t.write(zeros, 0, zeros.length) > 0) {
+                }
+            }, "ReadAloudSilence").start();
+        } else if (!on && sSilence != null) {
+            AudioTrack t = sSilence;
+            sSilence = null;
+            try {
+                t.pause();
+                t.flush();
+                t.release();
+            } catch (RuntimeException ignored) {
+            }
+        }
+    }
+
+    private static void changed() {
+        if (sListener != null) {
+            sListener.onReadAloudChanged();
+        }
+    }
+
+    private static void speak(Context app) {
+        final int serial = ++sSerial;
+        final int from = sOffset;
+        sSpokenTo = from;
+        WebSpeech.get(app).speak(ReadAloud.class, (id, event, ci, cl, error) -> {
+            if (serial != sSerial) {
+                return;
+            }
+            switch (event) {
+                case "boundary":
+                    sSpokenTo = from + ci;
+                    break;
+                case "end":
+                    stop(app);
+                    break;
+                case "error":
+                    if (!"interrupted".equals(error)) {
+                        Toast.makeText(app, R.string.read_aloud_unavailable,
+                                Toast.LENGTH_SHORT).show();
+                    }
+                    stop(app);
+                    break;
+            }
+        }, 0, sText.substring(Math.min(from, sText.length())), sLang, "", 1f, 1f, 1f);
+    }
+
+    private MediaSession mSession;
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        sService = this;
+        NotificationChannel channel = new NotificationChannel(CHANNEL,
+                getString(R.string.menu_read_aloud), NotificationManager.IMPORTANCE_LOW);
+        channel.setShowBadge(false);
+        getSystemService(NotificationManager.class).createNotificationChannel(channel);
+        mSession = new MediaSession(this, "JellyReadAloud");
+        mSession.setCallback(new MediaSession.Callback() {
+            @Override
+            public void onPlay() {
+                if (sPaused) {
+                    toggle(ReadAloud.this);
+                }
+            }
+
+            @Override
+            public void onPause() {
+                if (!sPaused) {
+                    toggle(ReadAloud.this);
+                }
+            }
+
+            @Override
+            public void onStop() {
+                stop(ReadAloud.this);
+            }
+        });
+        mSession.setActive(true);
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        String action = intent != null ? intent.getStringExtra(ACTION) : null;
+        if ("toggle".equals(action)) {
+            toggle(this);
+        } else if ("stop".equals(action)) {
+            stop(this);
+        }
+        refresh();
+        return START_NOT_STICKY;
+    }
+
+    private void refresh() {
+        Notification n = build();
+        startForeground(NOTIFICATION_ID, n);
+        if (!sActive) {
+            stopSelf();
+        }
+    }
+
+    private Notification build() {
+        mSession.setPlaybackState(new PlaybackState.Builder()
+                .setActions(PlaybackState.ACTION_PLAY | PlaybackState.ACTION_PAUSE
+                        | PlaybackState.ACTION_PLAY_PAUSE | PlaybackState.ACTION_STOP)
+                .setState(sPaused ? PlaybackState.STATE_PAUSED : PlaybackState.STATE_PLAYING,
+                        PlaybackState.PLAYBACK_POSITION_UNKNOWN, 1f)
+                .build());
+        mSession.setMetadata(new MediaMetadata.Builder()
+                .putString(MediaMetadata.METADATA_KEY_TITLE, sTitle)
+                .putString(MediaMetadata.METADATA_KEY_ARTIST, sHost)
+                .build());
+        Intent open = new Intent(this, TaskFrontActivity.class)
+                .putExtra(TaskFrontActivity.EXTRA_TASK, sTask)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        return new Notification.Builder(this, CHANNEL)
+                .setSmallIcon(R.drawable.ic_read_aloud)
+                .setContentTitle(sTitle)
+                .setContentText(sHost)
+                .setShowWhen(false)
+                .setOngoing(!sPaused)
+                .setVisibility(Notification.VISIBILITY_PUBLIC)
+                .setContentIntent(PendingIntent.getActivity(this, 1, open,
+                        PendingIntent.FLAG_UPDATE_CURRENT))
+                .setDeleteIntent(command("stop", 3))
+                .addAction(new Notification.Action.Builder(Icon.createWithResource(this,
+                        sPaused ? android.R.drawable.ic_media_play
+                                : android.R.drawable.ic_media_pause),
+                        getString(sPaused ? R.string.pip_play : R.string.pip_pause),
+                        command("toggle", 2)).build())
+                .addAction(new Notification.Action.Builder(Icon.createWithResource(this,
+                        R.drawable.ic_cancel), getString(R.string.read_aloud_stop_short),
+                        command("stop", 3)).build())
+                .setStyle(new Notification.MediaStyle()
+                        .setMediaSession(mSession.getSessionToken())
+                        .setShowActionsInCompactView(0, 1))
+                .build();
+    }
+
+    private PendingIntent command(String action, int code) {
+        return PendingIntent.getService(this, code,
+                new Intent(this, ReadAloud.class).putExtra(ACTION, action),
+                PendingIntent.FLAG_UPDATE_CURRENT);
+    }
+
+    @Override
+    public void onDestroy() {
+        sService = null;
+        mSession.setActive(false);
+        mSession.release();
+        stopForeground(true);
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
