new file mode 100644
index 0000000..474758e
--- /dev/null
+++ b/app/src/main/java/org/lineageos/jelly/webview/ContentBlocker.java
@@ -0,0 +1,293 @@
+/*
+ * Copyright (C) 2026 The ON-FireLOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.lineageos.jelly.webview;
+
+import android.content.Context;
+import android.preference.PreferenceManager;
+import android.util.Log;
+import android.webkit.WebResourceResponse;
+
+import java.io.BufferedReader;
+import java.io.ByteArrayInputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Blocks requests to advertising, tracking and malware hosts.
+ *
+ * On a device with 2 GB of RAM and a mid-2010s CPU, what a page does not load
+ * is the cheapest speed-up there is: no ad scripts to parse, no trackers to
+ * run, no third-party frames to lay out.
+ *
+ * The list is StevenBlack's unified hosts file (MIT licence), about 80,000
+ * hosts. It is kept as a sorted array of 64-bit hashes - roughly 640 kB -
+ * instead of a set of strings, which would take over ten times that in a
+ * process that also holds every open tab. A hash collision would block one
+ * unrelated host; at 80,000 entries in a 64-bit space that is not a practical
+ * concern.
+ *
+ * Only subresources are blocked. A page the user opens on purpose always
+ * loads.
+ */
+public final class ContentBlocker {
+    private static final String TAG = "ContentBlocker";
+
+    private static final String LIST_URL =
+            "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts";
+    private static final String CACHE_FILE = "blocklist.bin";
+    private static final int CACHE_MAGIC = 0x4a424c31; // "JBL1"
+    private static final long MAX_AGE_MS = TimeUnit.DAYS.toMillis(7);
+    private static final int MAX_LIST_BYTES = 16 * 1024 * 1024;
+
+    /** Until the first download: the largest ad and tracking networks. */
+    private static final String[] BUILTIN = {
+            "doubleclick.net", "googlesyndication.com", "googleadservices.com",
+            "google-analytics.com", "googletagmanager.com", "googletagservices.com",
+            "adservice.google.com", "pagead2.googlesyndication.com",
+            "amazon-adsystem.com", "adnxs.com", "adsrvr.org", "advertising.com",
+            "criteo.com", "criteo.net", "outbrain.com", "taboola.com",
+            "scorecardresearch.com", "quantserve.com", "moatads.com",
+            "rubiconproject.com", "pubmatic.com", "openx.net", "casalemedia.com",
+            "smartadserver.com", "yieldlab.net", "adform.net", "media.net",
+            "hotjar.com", "mixpanel.com", "segment.io", "connect.facebook.net",
+            "ads.yahoo.com", "bat.bing.com", "ads.linkedin.com", "adcolony.com",
+            "applovin.com", "unityads.unity3d.com", "chartbeat.com",
+            "newrelic.com", "nr-data.net", "taboolasyndication.com",
+    };
+
+    private static volatile long[] sHashes = hashAll(BUILTIN);
+    private static volatile boolean sEnabled = true;
+
+    // Sites the user switched blocking off for, from the menu. Some sites
+    // refuse to work with their ad scripts missing.
+    private static final String PREF_ALLOWED_SITES = "content_blocker_allowed_sites";
+    private static volatile Set<String> sAllowedSites = Collections.emptySet();
+
+    public static boolean isAllowedSite(String host) {
+        return host != null && sAllowedSites.contains(host.toLowerCase(Locale.ROOT));
+    }
+
+    /** Hosts with blocking switched off, for the site settings. */
+    public static Set<String> allowedSites() {
+        return sAllowedSites;
+    }
+
+    public static void setBlockedOnSite(Context context, String host, boolean blocked) {
+        if (host == null) {
+            return;
+        }
+        Set<String> sites = new HashSet<>(sAllowedSites);
+        if (blocked) {
+            sites.remove(host.toLowerCase(Locale.ROOT));
+        } else {
+            sites.add(host.toLowerCase(Locale.ROOT));
+        }
+        sAllowedSites = Collections.unmodifiableSet(sites);
+        PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .putStringSet(PREF_ALLOWED_SITES, sites).apply();
+    }
+
+    private ContentBlocker() {
+    }
+
+    public static void setEnabled(boolean enabled) {
+        sEnabled = enabled;
+    }
+
+    public static boolean isEnabled() {
+        return sEnabled;
+    }
+
+    /** Loads the cached list and refreshes it if it is older than a week. */
+    public static void init(Context context) {
+        sAllowedSites = Collections.unmodifiableSet(new HashSet<>(
+                PreferenceManager.getDefaultSharedPreferences(context)
+                        .getStringSet(PREF_ALLOWED_SITES, Collections.emptySet())));
+        final File cache = new File(context.getFilesDir(), CACHE_FILE);
+        Thread t = new Thread(() -> {
+            long[] loaded = readCache(cache);
+            if (loaded != null) {
+                sHashes = loaded;
+            }
+            if (loaded == null || System.currentTimeMillis() - cache.lastModified() > MAX_AGE_MS) {
+                long[] fresh = download();
+                if (fresh != null) {
+                    sHashes = fresh;
+                    writeCache(cache, fresh);
+                }
+            }
+        }, TAG);
+        t.setPriority(Thread.MIN_PRIORITY);
+        t.start();
+    }
+
+    /** True for the host itself or any parent domain on the list. */
+    public static boolean isBlocked(String host) {
+        if (!sEnabled || host == null || host.isEmpty()) {
+            return false;
+        }
+        final long[] hashes = sHashes;
+        String h = host.toLowerCase(Locale.ROOT);
+        while (true) {
+            if (Arrays.binarySearch(hashes, hash(h)) >= 0) {
+                return true;
+            }
+            int dot = h.indexOf('.');
+            // Stop at the last two labels: "co.uk" or "com" alone are never listed.
+            if (dot < 0 || h.indexOf('.', dot + 1) < 0) {
+                return false;
+            }
+            h = h.substring(dot + 1);
+        }
+    }
+
+    /** An empty answer: the request "succeeds" with nothing in it. */
+    static WebResourceResponse emptyResponse() {
+        return new WebResourceResponse("text/plain", "utf-8",
+                new ByteArrayInputStream(new byte[0]));
+    }
+
+    /** FNV-1a, 64 bit. */
+    private static long hash(String s) {
+        long h = 0xcbf29ce484222325L;
+        for (int i = 0; i < s.length(); i++) {
+            h ^= s.charAt(i);
+            h *= 0x100000001b3L;
+        }
+        return h;
+    }
+
+    private static long[] hashAll(String[] hosts) {
+        long[] out = new long[hosts.length];
+        for (int i = 0; i < hosts.length; i++) {
+            out[i] = hash(hosts[i]);
+        }
+        Arrays.sort(out);
+        return out;
+    }
+
+    private static long[] download() {
+        HttpURLConnection conn = null;
+        try {
+            conn = (HttpURLConnection) new URL(LIST_URL).openConnection();
+            conn.setConnectTimeout(15000);
+            conn.setReadTimeout(30000);
+            if (conn.getResponseCode() != 200) {
+                return null;
+            }
+            long[] buf = new long[131072];
+            int n = 0;
+            int bytes = 0;
+            try (BufferedReader in = new BufferedReader(
+                    new InputStreamReader(conn.getInputStream(), "UTF-8"))) {
+                String line;
+                while ((line = in.readLine()) != null) {
+                    bytes += line.length() + 1;
+                    if (bytes > MAX_LIST_BYTES) {
+                        return null;
+                    }
+                    // "0.0.0.0 host # comment"
+                    if (!line.startsWith("0.0.0.0 ")) {
+                        continue;
+                    }
+                    int end = line.indexOf('#');
+                    String host = (end >= 0 ? line.substring(8, end) : line.substring(8)).trim();
+                    if (host.isEmpty() || host.equals("0.0.0.0") || host.indexOf(' ') >= 0) {
+                        continue;
+                    }
+                    if (n == buf.length) {
+                        buf = Arrays.copyOf(buf, n * 2);
+                    }
+                    buf[n++] = hash(host.toLowerCase(Locale.ROOT));
+                }
+            }
+            if (n < 1000) {
+                // Not the list we expect - keep what we have.
+                return null;
+            }
+            for (String host : BUILTIN) {
+                if (n == buf.length) {
+                    buf = Arrays.copyOf(buf, n * 2);
+                }
+                buf[n++] = hash(host);
+            }
+            long[] out = Arrays.copyOf(buf, n);
+            Arrays.sort(out);
+            Log.i(TAG, "Block list loaded: " + n + " hosts");
+            return out;
+        } catch (IOException e) {
+            Log.i(TAG, "Block list download failed: " + e);
+            return null;
+        } finally {
+            if (conn != null) {
+                conn.disconnect();
+            }
+        }
+    }
+
+    private static long[] readCache(File file) {
+        if (!file.exists()) {
+            return null;
+        }
+        try (DataInputStream in = new DataInputStream(new java.io.BufferedInputStream(
+                new FileInputStream(file)))) {
+            if (in.readInt() != CACHE_MAGIC) {
+                return null;
+            }
+            int n = in.readInt();
+            if (n <= 0 || n > 4_000_000) {
+                return null;
+            }
+            long[] out = new long[n];
+            for (int i = 0; i < n; i++) {
+                out[i] = in.readLong();
+            }
+            return out;
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    private static void writeCache(File file, long[] hashes) {
+        File tmp = new File(file.getPath() + ".tmp");
+        try (DataOutputStream out = new DataOutputStream(new java.io.BufferedOutputStream(
+                new FileOutputStream(tmp)))) {
+            out.writeInt(CACHE_MAGIC);
+            out.writeInt(hashes.length);
+            for (long h : hashes) {
+                out.writeLong(h);
+            }
+        } catch (IOException e) {
+            Log.i(TAG, "Cannot write block list: " + e);
+            return;
+        }
+        //noinspection ResultOfMethodCallIgnored
+        tmp.renameTo(file);
+    }
+}
