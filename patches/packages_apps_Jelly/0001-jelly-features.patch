+                })
+                .setNegativeButton(R.string.location_prompt_block, (d, w) -> {
+                    if (!mIncognito) {
+                        prefs.edit().putString(key, "block").apply();
+                    }
+                    request.deny();
+                })
+                .setOnCancelListener(d -> request.deny())
+                .show();
+    }
+
+    @Override
+    public void onPermissionRequestCanceled(PermissionRequest request) {
+        if (mMediaPrompt != null && mMediaPrompt.isShowing()) {
+            mMediaPrompt.dismiss();
         }
+        mMediaPrompt = null;
     }
 
