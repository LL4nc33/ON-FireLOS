--- /dev/null
+++ b/app/src/main/java/org/lineageos/jelly/webview/SiteSettings.java
@@ -0,0 +1,198 @@
+/*
+ * Copyright (C) 2026 ON-FireLOS
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.lineageos.jelly.webview;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.webkit.CookieManager;
+import android.webkit.GeolocationPermissions;
+import android.webkit.WebStorage;
+
+import java.util.Locale;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.function.Consumer;
+
+/**
+ * What a site may do, in one place: the answers given to its camera,
+ * microphone, location and notification requests, ad blocking for it, and
+ * its stored data. Each was kept somewhere else before and could not be
+ * looked at or taken back.
+ */
+public final class SiteSettings {
+
+    public static final int ASK = 0;
+    public static final int ALLOW = 1;
+    public static final int BLOCK = 2;
+
+    private static final String MEDIA = "site_media";
+    private static final String NOTIFICATIONS = "site_notifications";
+
+    private SiteSettings() {
+    }
+
+    private static SharedPreferences media(Context c) {
+        return c.getSharedPreferences(MEDIA, Context.MODE_PRIVATE);
+    }
+
+    private static SharedPreferences notifications(Context c) {
+        return c.getSharedPreferences(NOTIFICATIONS, Context.MODE_PRIVATE);
+    }
+
+    // The camera/microphone prompt keys its answers by the request's origin,
+    // which ends in a slash ("https://host/|camera").
+    private static String mediaKey(String origin) {
+        return origin.endsWith("/") ? origin : origin + "/";
+    }
+
+    /** kind: "camera" or "microphone". A combined answer counts for both. */
+    public static int media(Context c, String origin, String kind) {
+        SharedPreferences p = media(c);
+        origin = mediaKey(origin);
+        String v = p.getString(origin + "|" + kind, null);
+        if (v == null) {
+            v = p.getString(origin + "|camera|microphone", null);
+        }
+        return "allow".equals(v) ? ALLOW : "block".equals(v) ? BLOCK : ASK;
+    }
+
+    public static void setMedia(Context c, String origin, String kind, int state) {
+        SharedPreferences p = media(c);
+        origin = mediaKey(origin);
+        SharedPreferences.Editor e = p.edit();
+        String other = "camera".equals(kind) ? "microphone" : "camera";
+        // Split a combined answer, so that changing one leaves the other.
+        String both = p.getString(origin + "|camera|microphone", null);
+        if (both != null) {
+            e.remove(origin + "|camera|microphone");
+            if (!p.contains(origin + "|" + other)) {
+                e.putString(origin + "|" + other, both);
+            }
+        }
+        if (state == ASK) {
+            e.remove(origin + "|" + kind);
+        } else {
+            e.putString(origin + "|" + kind, state == ALLOW ? "allow" : "block");
+        }
+        e.apply();
+    }
+
+    public static int notification(Context c, String origin) {
+        String v = notifications(c).getString(origin, null);
+        return WebNotify.GRANTED.equals(v) ? ALLOW : WebNotify.DENIED.equals(v) ? BLOCK : ASK;
+    }
+
+    public static void setNotification(Context c, String origin, int state) {
+        if (state == ASK) {
+            notifications(c).edit().remove(origin).apply();
+        } else {
+            notifications(c).edit().putString(origin,
+                    state == ALLOW ? WebNotify.GRANTED : WebNotify.DENIED).apply();
+        }
+    }
+
+    /** The WebView keeps the location answer itself; "block" there means "ask". */
+    public static void location(String origin, Consumer<Integer> result) {
+        GeolocationPermissions.getInstance().getAllowed(origin,
+                allowed -> result.accept(Boolean.TRUE.equals(allowed) ? ALLOW : ASK));
+    }
+
+    public static void setLocation(String origin, int state) {
+        if (state == ALLOW) {
+            GeolocationPermissions.getInstance().allow(origin);
+        } else {
+            GeolocationPermissions.getInstance().clear(origin);
+        }
+    }
+
+    public static boolean adsBlocked(String origin) {
+        return !ContentBlocker.isAllowedSite(Uri.parse(origin).getHost());
+    }
+
+    public static void setAdsBlocked(Context c, String origin, boolean blocked) {
+        ContentBlocker.setBlockedOnSite(c, Uri.parse(origin).getHost(), blocked);
+    }
+
+    public static void resetPermissions(Context c, String origin) {
+        SharedPreferences p = media(c);
+        SharedPreferences.Editor e = p.edit();
+        for (String key : p.getAll().keySet()) {
+            if (key.startsWith(mediaKey(origin) + "|") || key.startsWith(origin + "|")) {
+                e.remove(key);
+            }
+        }
+        e.apply();
+        notifications(c).edit().remove(origin).apply();
+        GeolocationPermissions.getInstance().clear(origin);
+        setAdsBlocked(c, origin, true);
+    }
+
+    /** Cookies and storage of the site; the user is signed out of it. */
+    public static void clearData(String origin) {
+        WebStorage.getInstance().deleteOrigin(origin);
+        CookieManager cookies = CookieManager.getInstance();
+        String host = Uri.parse(origin).getHost();
+        String all = cookies.getCookie(origin);
+        if (all != null && host != null) {
+            for (String part : all.split(";")) {
+                int eq = part.indexOf('=');
+                String name = (eq > 0 ? part.substring(0, eq) : part).trim();
+                if (name.isEmpty()) {
+                    continue;
+                }
+                String expired = name + "=; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT";
+                cookies.setCookie(origin, expired + "; Path=/");
+                cookies.setCookie(origin, expired + "; Path=/; Domain=" + host);
+                int dot = host.indexOf('.');
+                if (dot > 0 && host.indexOf('.', dot + 1) > 0) {
+                    cookies.setCookie(origin, expired + "; Path=/; Domain=" + host.substring(dot));
+                }
+            }
+            cookies.flush();
+        }
+    }
+
+    /** Every site with something stored about it, sorted by host. */
+    public static void sites(Context c, Consumer<Set<String>> result) {
+        TreeSet<String> sites = new TreeSet<>((a, b) -> host(a).compareTo(host(b)) != 0
+                ? host(a).compareTo(host(b)) : a.compareTo(b));
+        for (String key : media(c).getAll().keySet()) {
+            int bar = key.indexOf('|');
+            if (bar > 0) {
+                sites.add(key.substring(0, bar).replaceAll("/$", ""));
+            }
+        }
+        sites.addAll(notifications(c).getAll().keySet());
+        for (String host : ContentBlocker.allowedSites()) {
+            sites.add("https://" + host);
+        }
+        GeolocationPermissions.getInstance().getOrigins(origins -> {
+            if (origins != null) {
+                for (Object o : origins) {
+                    sites.add(String.valueOf(o).replaceAll("/$", ""));
+                }
+            }
+            result.accept(sites);
+        });
+    }
+
+    public static String host(String origin) {
+        String host = Uri.parse(origin).getHost();
+        return host != null ? host.toLowerCase(Locale.ROOT) : origin;
+    }
+}
diff --git a/app/src/main/java/org/lineageos/jelly/webview/SiteSheet.java b/app/src/main/java/org/lineageos/jelly/webview/SiteSheet.java
