+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.lineageos.jelly.webview;
+
+import android.app.Activity;
+import android.content.res.TypedArray;
+import android.util.TypedValue;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.core.content.ContextCompat;
+
+import com.google.android.material.bottomsheet.BottomSheetDialog;
+
+import org.lineageos.jelly.R;
+
+/**
+ * A site at a glance: tap the lock in the address bar, or a site in
+ * Settings > Site settings. Every permission it asked for, ad blocking,
+ * its stored data - each changeable right there.
+ */
+public final class SiteSheet {
+
+    private final Activity mActivity;
+    private final String mOrigin;
+    private final Runnable mCertificate;
+    private final Runnable mChanged;
+    private final LinearLayout mRows;
+    private boolean mDirty;
+
+    /**
+     * certificate: shows the certificate, or null where there is none to show.
+     * changed: runs when the sheet closes after something was changed.
+     */
+    public static void show(Activity activity, String origin, Runnable certificate,
+                            Runnable changed) {
+        new SiteSheet(activity, origin, certificate, changed).open();
+    }
+
+    private SiteSheet(Activity activity, String origin, Runnable certificate, Runnable changed) {
+        mActivity = activity;
+        mOrigin = origin;
+        mCertificate = certificate;
+        mChanged = changed;
+        mRows = new LinearLayout(activity);
+        mRows.setOrientation(LinearLayout.VERTICAL);
+    }
+
+    private void open() {
+        int pad = dp(24);
+        LinearLayout root = new LinearLayout(mActivity);
+        root.setOrientation(LinearLayout.VERTICAL);
+
+        TextView title = new TextView(mActivity);
+        title.setTextAppearance(android.R.style.TextAppearance_Material_Title);
+        title.setText(SiteSettings.host(mOrigin));
+        title.setPadding(pad, 0, pad, dp(4));
+        root.addView(title);
+
+        if (mCertificate != null) {
+            TextView secure = new TextView(mActivity);
+            secure.setTextAppearance(android.R.style.TextAppearance_Material_Body1);
+            secure.setText(R.string.site_connection_secure);
+            secure.setCompoundDrawablesRelativeWithIntrinsicBounds(R.drawable.ic_lock, 0, 0, 0);
+            secure.setCompoundDrawablePadding(dp(8));
+            secure.setPadding(pad, dp(4), pad, dp(8));
+            root.addView(secure);
+        }
+        root.addView(mRows);
+
+        ScrollView scroll = new ScrollView(mActivity);
+        // As Jelly's other sheet: the sheet's own background stays white in
+        // the dark theme, under light text.
+        scroll.setBackgroundColor(ContextCompat.getColor(mActivity, R.color.colorPrimaryDark));
+        scroll.addView(root);
+        // The sheet's window covers the whole screen, the navigation bar
+        // included, and no insets reach it: keep the last rows above the bar.
+        int bar = mActivity.getResources().getIdentifier(
+                "navigation_bar_height", "dimen", "android");
+        root.setPadding(0, dp(16), 0, dp(8)
+                + (bar != 0 ? mActivity.getResources().getDimensionPixelSize(bar) : 0));
+        BottomSheetDialog sheet = new BottomSheetDialog(mActivity);
+        sheet.setContentView(scroll);
+        sheet.setOnDismissListener(d -> {
+            if (mDirty && mChanged != null) {
+                mChanged.run();
+            }
+        });
+        fill();
+        sheet.show();
+    }
+
+    private void fill() {
+        mRows.removeAllViews();
+        permission(R.string.site_camera, SiteSettings.media(mActivity, mOrigin, "camera"),
+                false, s -> SiteSettings.setMedia(mActivity, mOrigin, "camera", s));
+        permission(R.string.site_microphone,
+                SiteSettings.media(mActivity, mOrigin, "microphone"), false,
+                s -> SiteSettings.setMedia(mActivity, mOrigin, "microphone", s));
+        TextView location = permission(R.string.site_location, SiteSettings.ASK, true,
+                s -> SiteSettings.setLocation(mOrigin, s));
+        SiteSettings.location(mOrigin, s -> {
+            location.setText(state(s));
+            location.setTag(s);
+        });
+        permission(R.string.site_notifications, SiteSettings.notification(mActivity, mOrigin),
+                false, s -> SiteSettings.setNotification(mActivity, mOrigin, s));
+        if (ContentBlocker.isEnabled()) {
+            boolean blocked = SiteSettings.adsBlocked(mOrigin);
+            row(R.string.site_ads, mActivity.getString(blocked ? R.string.site_state_on
+                    : R.string.site_state_off), v -> {
+                SiteSettings.setAdsBlocked(mActivity, mOrigin, !blocked);
+                mDirty = true;
+                fill();
+            });
+        }
+        if (mCertificate != null) {
+            row(R.string.site_certificate, null, v -> mCertificate.run());
+        }
+        row(R.string.site_clear_data, null, v -> new AlertDialog.Builder(mActivity)
+                .setTitle(R.string.site_clear_data)
+                .setMessage(mActivity.getString(R.string.site_clear_data_message,
+                        SiteSettings.host(mOrigin)))
+                .setPositiveButton(R.string.site_clear_data_confirm, (d, w) -> {
+                    SiteSettings.clearData(mOrigin);
+                    mDirty = true;
+                    Toast.makeText(mActivity, R.string.site_data_cleared,
+                            Toast.LENGTH_SHORT).show();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show());
+        row(R.string.site_reset_permissions, null, v -> {
+            SiteSettings.resetPermissions(mActivity, mOrigin);
+            mDirty = true;
+            fill();
+        });
+    }
+
+    interface Setter {
+        void set(int state);
+    }
+
+    /** A permission row; tapping it offers Ask / Allow / Block. */
+    private TextView permission(int title, int current, boolean noBlock, Setter setter) {
+        TextView[] value = new TextView[1];
+        value[0] = row(title, state(current), v -> {
+            int now = value[0].getTag() instanceof Integer ? (Integer) value[0].getTag() : current;
+            String[] items = noBlock
+                    ? new String[]{mActivity.getString(R.string.site_state_ask),
+                            mActivity.getString(R.string.location_prompt_allow)}
+                    : new String[]{mActivity.getString(R.string.site_state_ask),
+                            mActivity.getString(R.string.location_prompt_allow),
+                            mActivity.getString(R.string.location_prompt_block)};
+            new AlertDialog.Builder(mActivity)
+                    .setTitle(title)
+                    .setSingleChoiceItems(items, Math.min(now, items.length - 1), (d, w) -> {
+                        setter.set(w);
+                        mDirty = true;
+                        d.dismiss();
+                        fill();
+                    })
+                    .show();
+        });
+        value[0].setTag(current);
+        return value[0];
+    }
+
+    private String state(int s) {
+        return mActivity.getString(s == SiteSettings.ALLOW ? R.string.location_prompt_allow
+                : s == SiteSettings.BLOCK ? R.string.location_prompt_block
+                : R.string.site_state_ask);
+    }
+
+    /** Returns the row's second line. */
+    private TextView row(int title, String value, View.OnClickListener click) {
+        View v = LayoutInflater.from(mActivity).inflate(android.R.layout.simple_list_item_2,
+                mRows, false);
+        TextView t1 = v.findViewById(android.R.id.text1);
+        TextView t2 = v.findViewById(android.R.id.text2);
+        t1.setText(title);
+        if (value != null) {
+            t2.setText(value);
+        } else {
+            t2.setVisibility(View.GONE);
+        }
+        v.setPadding(dp(24), dp(10), dp(24), dp(10));
+        TypedArray a = mActivity.obtainStyledAttributes(
+                new int[]{android.R.attr.selectableItemBackground});
+        v.setBackground(a.getDrawable(0));
+        a.recycle();
+        v.setOnClickListener(click);
+        mRows.addView(v);
+        return t2;
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                mActivity.getResources().getDisplayMetrics());
+    }
+}
