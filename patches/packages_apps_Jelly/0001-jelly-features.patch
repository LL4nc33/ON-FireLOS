+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.lineageos.jelly.webview;
+
+import android.content.Context;
+import android.content.res.Configuration;
+import android.text.Html;
+import android.text.TextUtils;
+import android.webkit.WebView;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.lineageos.jelly.R;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.function.Consumer;
+
+/**
+ * Reader view and the text for reading aloud, from Mozilla's Readability -
+ * the library behind Firefox's reader view. The small "is this an article"
+ * test runs once a page has loaded; the library itself (84 kB) only when the
+ * reader or read-aloud button is used.
+ */
+public final class Reader {
+
+    /** Marks the reader view's history entry; back returns to the page. */
+    public static final String MARK = "#jelly-reader";
+
+    public static final class Article {
+        public String title;
+        public String byline;
+        public String html;
+        public String text;
+        public String lang;
+        public String url;
+    }
+
+    private static String sReaderable;
+    private static String sReadability;
+
+    private Reader() {
+    }
+
+    private static String raw(Context c, int id) {
+        try (InputStream in = c.getResources().openRawResource(id)) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buffer = new byte[16384];
+            int n;
+            while ((n = in.read(buffer)) > 0) {
+                out.write(buffer, 0, n);
+            }
+            return out.toString("UTF-8");
+        } catch (IOException e) {
+            return "";
+        }
+    }
+
+    public static boolean isReaderUrl(String url) {
+        return url != null && url.endsWith(MARK);
+    }
+
+    /** Whether the page looks like an article; false on any doubt. */
+    public static void check(Context c, WebView view, Consumer<Boolean> result) {
+        if (sReaderable == null) {
+            sReaderable = raw(c, R.raw.readability_readerable);
+        }
+        if (sReaderable.isEmpty() || isReaderUrl(view.getUrl())) {
+            result.accept(false);
+            return;
+        }
+        view.evaluateJavascript("(function(){try{" + sReaderable
+                // Collapsed sections (mobile Wikipedia) count; what the page
+                // itself hides does not.
+                + "\n;return isProbablyReaderable(document,{visibilityChecker:function(n){"
+                + "return !(n.style&&n.style.display=='none')&&!n.hasAttribute('hidden');}});"
+                + "}catch(e){return false;}})()",
+                value -> result.accept("true".equals(value)));
+    }
+
+    /** The article of the page, or null. */
+    public static void extract(Context c, WebView view, Consumer<Article> result) {
+        if (sReadability == null) {
+            sReadability = raw(c, R.raw.readability);
+        }
+        final String url = view.getUrl();
+        view.evaluateJavascript("(function(){try{" + sReadability
+                + "\n;var a=new Readability(document.cloneNode(true)).parse();"
+                + "if(!a)return null;return JSON.stringify({t:a.title||document.title,"
+                + "b:a.byline||'',c:a.content||'',x:a.textContent||'',"
+                + "l:document.documentElement.lang||''});}catch(e){return null;}})()",
+                value -> {
+                    Article a = null;
+                    try {
+                        if (value != null && !"null".equals(value)) {
+                            // A JSON string holding the JSON object.
+                            JSONObject o = new JSONObject(
+                                    new org.json.JSONTokener(value).nextValue().toString());
+                            a = new Article();
+                            a.title = o.optString("t");
+                            a.byline = o.optString("b");
+                            a.html = o.optString("c");
+                            a.text = o.optString("x").replaceAll("\\s+", " ").trim();
+                            a.lang = o.optString("l");
+                            a.url = url;
+                            if (a.text.length() < 200) {
+                                a = null;
+                            }
+                        }
+                    } catch (JSONException | RuntimeException e) {
+                        a = null;
+                    }
+                    result.accept(a);
+                });
+    }
+
+    /** The article as a calm page of its own, in the browser's history. */
+    public static void show(WebView view, Article a) {
+        Context c = view.getContext();
+        boolean dark = (c.getResources().getConfiguration().uiMode
+                & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
+        String fg = dark ? "#e6e6e6" : "#1f1f1f";
+        String bg = dark ? "#202020" : "#fbfaf7";
+        String muted = dark ? "#a0a0a0" : "#6b6b6b";
+        String link = dark ? "#a9c48a" : "#2e521d";
+        String html = "<!DOCTYPE html><html lang=\"" + Html.escapeHtml(a.lang) + "\"><head>"
+                + "<meta charset=\"utf-8\"><meta name=\"viewport\" "
+                + "content=\"width=device-width,initial-scale=1\">"
+                + "<title>" + Html.escapeHtml(a.title) + "</title><style>"
+                + "html{background:" + bg + ";color-scheme:" + (dark ? "dark" : "light") + "}"
+                + "body{max-width:42em;margin:0 auto;padding:24px 28px 64px;color:" + fg + ";"
+                + "font:20px/1.65 'Noto Serif',Georgia,serif;word-wrap:break-word}"
+                + "h1{font:600 1.6em/1.25 sans-serif;margin:.4em 0 .2em}"
+                + ".by{color:" + muted + ";font:0.8em sans-serif;margin-bottom:1.6em}"
+                + "a{color:" + link + "}img,video,figure{max-width:100%;height:auto}"
+                + "figure{margin:1em 0}figcaption{color:" + muted + ";font-size:.8em}"
+                + "pre,code{white-space:pre-wrap;font-size:.85em}"
+                + "blockquote{margin:1em 0;padding-left:1em;border-left:3px solid " + muted + "}"
+                + "table{border-collapse:collapse;display:block;overflow-x:auto}"
+                + "</style></head><body><h1>" + Html.escapeHtml(a.title) + "</h1>"
+                + (TextUtils.isEmpty(a.byline) ? ""
+                        : "<div class=\"by\">" + Html.escapeHtml(a.byline) + "</div>")
+                + a.html + "</body></html>";
+        String base = a.url;
+        int hash = base.indexOf('#');
+        if (hash >= 0) {
+            base = base.substring(0, hash);
+        }
+        view.loadDataWithBaseURL(base + MARK, html, "text/html", "UTF-8", base + MARK);
+    }
+}
diff --git a/app/src/main/java/org/lineageos/jelly/webview/Scriptlets.java b/app/src/main/java/org/lineageos/jelly/webview/Scriptlets.java
new file mode 100644
index 0000000..b9cc2de
--- /dev/null
+++ b/app/src/main/java/org/lineageos/jelly/webview/Scriptlets.java
@@ -0,0 +1,174 @@
+/*
+ * Copyright (C) 2026 The ON-FireLOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.lineageos.jelly.webview;
+
+import android.util.Log;
+import android.webkit.WebView;
+
+import androidx.webkit.ScriptHandler;
+import androidx.webkit.WebViewCompat;
+import androidx.webkit.WebViewFeature;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Ad blocking that a host list cannot do.
+ *
+ * YouTube serves its video ads from the same hosts as the videos. What the
+ * player plays is decided by fields in the data it receives - the page's
+ * initial player response and every later answer from its API. These scripts
+ * run before any of the page's own code and take the ad fields out of that
+ * data, so the player never learns there was an ad to show. The same idea as
+ * the "json-prune" filters of desktop blockers, written for this browser.
+ *
+ * Only for the listed origins, and only while the content blocker is on and
+ * the site is not let through from the menu.
+ */
+final class Scriptlets {
+    private static final String TAG = "Scriptlets";
+
+    private static final String[] YOUTUBE_HOSTS = {
+            "m.youtube.com", "www.youtube.com", "music.youtube.com", "youtube.com",
+    };
+
+    private static final String YOUTUBE_JS = "(function(){'use strict';"
+            // Fields that carry ads in YouTube's player data.
+            + "var K=['adPlacements','adSlots','playerAds','adBreakHeartbeatParams'];"
+            + "function prune(o){if(!o||typeof o!=='object')return o;try{"
+            + "for(var i=0;i<K.length;i++)if(K[i] in o)delete o[K[i]];"
+            + "if(o.playerResponse)prune(o.playerResponse);"
+            + "if(Array.isArray(o))for(var j=0;j<o.length;j++)"
+            + "if(o[j]&&o[j].playerResponse)prune(o[j].playerResponse);"
+            + "}catch(e){}return o;}"
+            // Answers parsed from text, and answers read with fetch().json().
+            + "var p=JSON.parse;JSON.parse=function(){return prune(p.apply(this,arguments));};"
+            + "var rj=Response.prototype.json;"
+            + "Response.prototype.json=function(){return rj.apply(this,arguments).then(prune);};"
+            // The first player response is assigned by an inline script.
+            + "var v;try{Object.defineProperty(window,'ytInitialPlayerResponse',"
+            + "{configurable:true,get:function(){return v;},set:function(x){v=prune(x);}});}"
+            + "catch(e){}"
+            // Ad cards in feeds and search results, and the ad slots beside a video.
+            + "var css='ytm-promoted-sparkles-web-renderer,ytm-promoted-video-renderer,"
+            + "ytm-companion-ad-renderer,ad-slot-renderer,ytm-ad-slot-renderer,"
+            + "ytd-ad-slot-renderer,ytd-in-feed-ad-layout-renderer,ytd-promoted-sparkles-web-renderer,"
+            + "ytm-rich-item-renderer:has(ad-slot-renderer),ytd-rich-item-renderer:has(ytd-ad-slot-renderer),"
+            + "panel-ad-header-image-lockup-view-model,#player-ads,.ytp-ad-overlay-container"
+            + "{display:none!important}';"
+            + "function addCss(){var s=document.createElement('style');s.textContent=css;"
+            + "(document.head||document.documentElement).appendChild(s);}"
+            + "if(document.documentElement)addCss();"
+            + "else document.addEventListener('readystatechange',addCss,{once:true});"
+            + "})();";
+
+    // Where YouTube's player runs, embeds included.
+    private static final String[] YOUTUBE_PLAYER_HOSTS = {
+            "m.youtube.com", "www.youtube.com", "music.youtube.com", "youtube.com",
+            "www.youtube-nocookie.com", "youtube-nocookie.com",
+    };
+
+    // VP9 and AV1 reported as unplayable, so YouTube serves H.264, which the
+    // hardware decodes without dropping frames (VP9 drops from 720p on).
+    private static final String H264_JS = "(function(){'use strict';"
+            + "function no(t){return /vp0?9|av01/i.test(String(t||''));}"
+            + "if(window.MediaSource){var i=MediaSource.isTypeSupported.bind(MediaSource);"
+            + "MediaSource.isTypeSupported=function(t){return no(t)?false:i(t);};}"
+            + "var c=HTMLMediaElement.prototype.canPlayType;"
+            + "HTMLMediaElement.prototype.canPlayType=function(t){return no(t)?'':c.call(this,t);};"
+            + "var m=navigator.mediaCapabilities;"
+            + "if(m&&m.decodingInfo){var d=m.decodingInfo.bind(m);"
+            + "m.decodingInfo=function(x){return x&&x.video&&no(x.video.contentType)"
+            + "?Promise.resolve({supported:false,smooth:false,powerEfficient:false}):d(x);};}"
+            + "})();";
+
+    // No AV1 decoder in this hardware: on every site AV1 is reported as
+    // unplayable, so pages pick a format that is decoded in hardware. VP9 above
+    // 480p counts as not smooth, so players that ask prefer H.264 or HEVC.
+    private static final String NO_AV1_JS = "(function(){'use strict';"
+            + "function no(t){return /av01/i.test(String(t||''));}"
+            + "if(window.MediaSource){var i=MediaSource.isTypeSupported.bind(MediaSource);"
+            + "MediaSource.isTypeSupported=function(t){return no(t)?false:i(t);};}"
+            + "var c=HTMLMediaElement.prototype.canPlayType;"
+            + "HTMLMediaElement.prototype.canPlayType=function(t){return no(t)?'':c.call(this,t);};"
+            + "var m=navigator.mediaCapabilities;"
+            + "if(m&&m.decodingInfo){var d=m.decodingInfo.bind(m);"
+            + "m.decodingInfo=function(x){if(x&&x.video&&no(x.video.contentType))"
+            + "return Promise.resolve({supported:false,smooth:false,powerEfficient:false});"
+            // VP9 above 480p: playable, but not the format to prefer.
+            + "var v=x&&x.video,vp9=v&&/vp0?9/i.test(String(v.contentType||''))&&(v.height||0)>480;"
+            + "return d(x).then(function(r){if(!vp9||!r||!r.supported)return r;"
+            + "try{r.smooth=false;r.powerEfficient=false;}catch(e){"
+            + "r={supported:true,smooth:false,powerEfficient:false,configuration:r.configuration};}"
+            + "return r;});};}"
+            + "})();";
+
+    private final WebView mWebView;
+    private final List<ScriptHandler> mHandlers = new ArrayList<>();
+
+    Scriptlets(WebView webView) {
+        mWebView = webView;
+    }
+
+    static boolean isSupported() {
+        return WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT);
+    }
+
+    /** Installs or removes the scripts to match the blocker's settings. */
+    void update() {
+        for (ScriptHandler h : mHandlers) {
+            h.remove();
+        }
+        mHandlers.clear();
+        if (!isSupported()) {
+            return;
+        }
+        Set<String> players = new HashSet<>();
+        for (String host : YOUTUBE_PLAYER_HOSTS) {
+            players.add("https://" + host);
+        }
+        try {
+            mHandlers.add(WebViewCompat.addDocumentStartJavaScript(mWebView, NO_AV1_JS,
+                    Collections.singleton("*")));
+            mHandlers.add(WebViewCompat.addDocumentStartJavaScript(mWebView, H264_JS, players));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Cannot add the codec script: " + e);
+        }
+        if (!ContentBlocker.isEnabled()) {
+            return;
+        }
+        Set<String> origins = new HashSet<>();
+        for (String host : YOUTUBE_HOSTS) {
+            if (!ContentBlocker.isAllowedSite(host)) {
+                origins.add("https://" + host);
+            }
+        }
+        if (origins.isEmpty()) {
+            return;
+        }
+        try {
+            mHandlers.add(WebViewCompat.addDocumentStartJavaScript(mWebView, YOUTUBE_JS, origins));
+        } catch (RuntimeException e) {
+            // A WebView that refuses the script still browses; it only shows ads.
+            Log.w(TAG, "Cannot add document start script: " + e);
+        }
+        Log.i(TAG, "Installed for " + Arrays.toString(origins.toArray()));
+    }
+}
diff --git a/app/src/main/java/org/lineageos/jelly/webview/SiteSettings.java b/app/src/main/java/org/lineageos/jelly/webview/SiteSettings.java
