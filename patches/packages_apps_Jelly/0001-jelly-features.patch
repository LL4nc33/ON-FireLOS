+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.lineageos.jelly.webapp;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.text.TextUtils;
+import android.util.Log;
+import android.util.LruCache;
+import android.webkit.WebView;
+
+import org.json.JSONException;
+import org.json.JSONTokener;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Finds the manifest of the page in a WebView and loads it, off the UI thread.
+ *
+ * The manifest is fetched here rather than with fetch() inside the page: a
+ * manifest on a CDN is cross-origin, and the page's CORS rules would block the
+ * read. Browsers fetch it without credentials, and so does this.
+ */
+public final class WebAppDetector {
+    private static final String TAG = "WebAppDetector";
+
+    private static final String FIND_MANIFEST_JS = "(function(){"
+            + "var l=document.querySelector('link[rel~=\"manifest\"]');"
+            + "return l?l.href:'';})()";
+
+    // ON-FireLOS: what a page without a manifest says about itself (fromPage).
+    private static final String PAGE_INFO_JS = "(function(){"
+            + "function c(s){var e=document.querySelector(s);return e&&e.content?e.content:'';}"
+            + "var i=[];document.querySelectorAll('link[rel~=\"icon\"],"
+            + "link[rel~=\"apple-touch-icon\"],link[rel~=\"apple-touch-icon-precomposed\"]')"
+            + ".forEach(function(l){i.push({src:l.href,sizes:l.getAttribute('sizes')||'',"
+            + "type:l.type||'',touch:/apple-touch/.test(l.rel)});});"
+            + "return JSON.stringify({name:c('meta[name=\"application-name\"]')"
+            + "||c('meta[name=\"apple-mobile-web-app-title\"]')"
+            + "||c('meta[property=\"og:site_name\"]'),"
+            + "title:document.title,theme:c('meta[name=\"theme-color\"]'),icons:i});})()";
+    private static final int MAX_PAGE_BYTES = 3 * 1024 * 1024;
+    private static final java.util.regex.Pattern MANIFEST_LINK = java.util.regex.Pattern.compile(
+            "<link[^>]*rel=[\"']?manifest[\"']?[^>]*>", java.util.regex.Pattern.CASE_INSENSITIVE);
+    private static final java.util.regex.Pattern HREF = java.util.regex.Pattern.compile(
+            "href=[\"']([^\"']+)[\"']", java.util.regex.Pattern.CASE_INSENSITIVE);
+
+    private static final int TIMEOUT_MS = 8000;
+    // For a whole download: the timeouts above are per read, and a server
+    // trickling a byte at a time would hold the one worker thread for ever.
+    private static final long DEADLINE_MS = 20000;
+    private static final int MAX_REDIRECTS = 3;
+    private static final int MAX_MANIFEST_BYTES = 512 * 1024;
+    private static final int MAX_ICON_BYTES = 4 * 1024 * 1024;
+    /** Largest icon kept in memory; the launcher scales down anyway. */
+    private static final int MAX_ICON_PX = 512;
+
+    // One worker is plenty: a manifest per page load, an icon per install.
+    private static final ExecutorService sExecutor = Executors.newSingleThreadExecutor();
+    private static final Handler sMainHandler = new Handler(Looper.getMainLooper());
+    private static final LruCache<String, WebAppManifest> sCache = new LruCache<>(16);
+
+    public interface Callback<T> {
+        void onResult(T result);
+    }
+
+    private WebAppDetector() {
+    }
+
+    /** Calls back on the UI thread with the manifest, or null if there is none. */
+    public static void detect(WebView webView, String userAgent,
+                              Callback<WebAppManifest> callback) {
+        final String documentUrl = webView.getUrl();
+        if (documentUrl == null || !WebAppManifest.isSecure(documentUrl)) {
+            callback.onResult(null);
+            return;
+        }
+        webView.evaluateJavascript(FIND_MANIFEST_JS, value -> {
+            String href = null;
+            try {
+                Object parsed = new JSONTokener(value).nextValue();
+                if (parsed instanceof String) {
+                    href = (String) parsed;
+                }
+            } catch (JSONException | NullPointerException ignored) {
+            }
+            if (TextUtils.isEmpty(href)) {
+                callback.onResult(null);
+                return;
+            }
+            final String manifestUrl = href;
+            WebAppManifest cached = sCache.get(manifestUrl + "|" + documentUrl);
+            if (cached != null) {
+                callback.onResult(cached);
+                return;
+            }
+            sExecutor.execute(() -> {
+                WebAppManifest manifest = null;
+                try {
+                    byte[] data = download(manifestUrl, userAgent,
+                            "application/manifest+json, application/json", MAX_MANIFEST_BYTES);
+                    manifest = WebAppManifest.parse(new String(data, "UTF-8"),
+                            manifestUrl, documentUrl);
+                    sCache.put(manifestUrl + "|" + documentUrl, manifest);
+                } catch (IOException | JSONException | RuntimeException e) {
+                    // RuntimeException too: this thread belongs to the browser,
+                    // and an uncaught exception here would take it down.
+                    Log.i(TAG, "No usable manifest: " + e.getClass().getSimpleName());
+                }
+                final WebAppManifest result = manifest;
+                sMainHandler.post(() -> callback.onResult(result));
+            });
+        });
+    }
+
+    /**
+     * ON-FireLOS: an app made from the page in a WebView, for a site without a usable
+     * manifest - or null, for a page that is not secure. Calls back on the UI thread.
+     */
+    public static void fromPage(WebView webView, Callback<WebAppManifest> callback) {
+        final String documentUrl = webView.getUrl();
+        if (documentUrl == null || !WebAppManifest.isSecure(documentUrl)
+                || !"https".equals(android.net.Uri.parse(documentUrl).getScheme())) {
+            callback.onResult(null);
+            return;
+        }
+        webView.evaluateJavascript(PAGE_INFO_JS, value -> {
+            WebAppManifest manifest = null;
+            try {
+                Object parsed = new JSONTokener(value).nextValue();
+                if (parsed instanceof String) {
+                    manifest = WebAppManifest.fromPage(
+                            new org.json.JSONObject((String) parsed), documentUrl);
+                }
+            } catch (JSONException | RuntimeException e) {
+                Log.i(TAG, "No page info: " + e.getClass().getSimpleName());
+            }
+            callback.onResult(manifest);
+        });
+    }
+
+    /**
+     * ON-FireLOS: the icons of the full site's manifest, put first, for an app made from
+     * a mobile site (m.youtube.com has a 16 px favicon, www.youtube.com a manifest).
+     * Runs on the worker; a failure leaves the page's own icons.
+     */
+    private static void addSiblingIcons(WebAppManifest manifest, String userAgent) {
+        if (manifest.siblingIconsAdded) {
+            return;
+        }
+        manifest.siblingIconsAdded = true;
+        String sibling = WebAppManifest.desktopSibling(manifest.startUrl);
+        if (sibling == null) {
+            return;
+        }
+        // The full site sends a mobile browser back to the mobile one.
+        String desktop = userAgent == null ? null : userAgent
+                .replaceFirst("\\([^)]*Android[^)]*\\)", "(X11; Linux x86_64)")
+                .replace(" Mobile", "");
+        try {
+            String html = new String(download(sibling, desktop, "text/html", MAX_PAGE_BYTES),
+                    "UTF-8");
+            java.util.regex.Matcher link = MANIFEST_LINK.matcher(html);
+            if (!link.find()) {
+                return;
+            }
+            java.util.regex.Matcher href = HREF.matcher(link.group());
+            if (!href.find()) {
+                return;
+            }
+            String manifestUrl = WebAppManifest.resolve(sibling,
+                    href.group(1).replace("&amp;", "&"));
+            if (manifestUrl == null) {
+                return;
+            }
+            byte[] data = download(manifestUrl, desktop,
+                    "application/manifest+json, application/json", MAX_MANIFEST_BYTES);
+            WebAppManifest full = WebAppManifest.parse(new String(data, "UTF-8"),
+                    manifestUrl, sibling);
+            manifest.icons.addAll(0, full.icons);
+        } catch (IOException | JSONException | RuntimeException e) {
+            Log.i(TAG, "No sibling icons: " + e.getClass().getSimpleName());
+        }
+    }
+
+    /** Downloads the best icon the manifest offers; null if none decodes. */
+    public static void loadIcon(WebAppManifest manifest, String userAgent,
+                                Callback<IconResult> callback) {
+        sExecutor.execute(() -> {
+            if (manifest.fromPage) {
+                addSiblingIcons(manifest, userAgent);
+            }
+            IconResult result = null;
+            for (WebAppManifest.IconInfo icon : manifest.getIconCandidates()) {
+                try {
+                    byte[] data = download(icon.src, userAgent, "image/*", MAX_ICON_BYTES);
+                    Bitmap bitmap = decodeScaled(data);
+                    if (bitmap != null) {
+                        result = new IconResult(bitmap, icon.maskable);
+                        break;
+                    }
+                } catch (IOException | RuntimeException e) {
+                    Log.i(TAG, "Icon failed: " + e.getClass().getSimpleName());
+                }
+            }
+            final IconResult r = result;
+            sMainHandler.post(() -> callback.onResult(r));
+        });
+    }
+
+    public static final class IconResult {
+        public final Bitmap bitmap;
+        public final boolean maskable;
+
+        IconResult(Bitmap bitmap, boolean maskable) {
+            this.bitmap = bitmap;
+            this.maskable = maskable;
+        }
+    }
+
+    /** data:[<type>][;base64],<payload> - sites inline small manifests and icons. */
+    private static byte[] decodeDataUrl(String url, int limit) throws IOException {
+        int comma = url.indexOf(',');
+        if (comma < 0 || url.length() - comma > limit * 2) {
+            throw new IOException("bad data url");
+        }
+        String meta = url.substring(5, comma);
+        String payload = url.substring(comma + 1);
+        try {
+            if (meta.endsWith(";base64")) {
+                return android.util.Base64.decode(payload, android.util.Base64.DEFAULT);
+            }
+            return java.net.URLDecoder.decode(payload, "UTF-8").getBytes("UTF-8");
+        } catch (IllegalArgumentException e) {
+            throw new IOException("bad data url", e);
+        }
+    }
+
+    private static Bitmap decodeScaled(byte[] data) {
+        BitmapFactory.Options bounds = new BitmapFactory.Options();
+        bounds.inJustDecodeBounds = true;
+        BitmapFactory.decodeByteArray(data, 0, data.length, bounds);
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) {
+            return null;
+        }
+        BitmapFactory.Options opts = new BitmapFactory.Options();
+        int sample = 1;
+        while (Math.max(bounds.outWidth, bounds.outHeight) / (sample * 2) >= MAX_ICON_PX) {
+            sample *= 2;
+        }
+        opts.inSampleSize = sample;
+        return BitmapFactory.decodeByteArray(data, 0, data.length, opts);
+    }
+
+    private static byte[] download(String url, String userAgent, String accept, int limit)
+            throws IOException {
+        if (url.regionMatches(true, 0, "data:", 0, 5)) {
+            return decodeDataUrl(url, limit);
+        }
+        // The URL comes from the page, and this request is made by the app,
+        // outside the page's own rules. Anything but https - file:, ftp:, jar:
+        // - would hand back a connection of another type or read local files;
+        // plain http would let an https page reach, say, a router on the local
+        // network, which mixed content blocking stops the page itself from
+        // doing. Only secure pages are installable anyway. Redirects are
+        // followed by hand so that every hop is held to the same rule.
+        final long deadline = SystemClock.elapsedRealtime() + DEADLINE_MS;
+        URL target = new URL(url);
+        HttpURLConnection conn = null;
+        for (int hop = 0; ; hop++) {
+            if (!"https".equalsIgnoreCase(target.getProtocol())) {
+                throw new IOException("not https");
+            }
+            if (SystemClock.elapsedRealtime() > deadline) {
+                throw new IOException("too slow");
+            }
+            conn = (HttpURLConnection) target.openConnection();
+            conn.setConnectTimeout(TIMEOUT_MS);
+            conn.setReadTimeout(TIMEOUT_MS);
+            conn.setInstanceFollowRedirects(false);
+            conn.setUseCaches(true);
+            if (userAgent != null) {
+                conn.setRequestProperty("User-Agent", userAgent);
+            }
+            conn.setRequestProperty("Accept", accept);
+            int code;
+            String location;
+            try {
+                code = conn.getResponseCode();
+                location = conn.getHeaderField("Location");
+            } catch (IOException e) {
+                conn.disconnect();
+                throw e;
+            }
+            if (code < 300 || code >= 400 || location == null) {
+                break;
+            }
+            conn.disconnect();
+            if (hop == MAX_REDIRECTS) {
+                throw new IOException("too many redirects");
+            }
+            target = new URL(target, location);
+        }
+        try {
+            int code = conn.getResponseCode();
+            if (code < 200 || code >= 300) {
+                throw new IOException("HTTP " + code);
+            }
+            try (InputStream in = conn.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buf = new byte[8192];
+                int n;
+                while ((n = in.read(buf)) > 0) {
+                    out.write(buf, 0, n);
+                    if (out.size() > limit) {
+                        throw new IOException("too large");
+                    }
+                    if (SystemClock.elapsedRealtime() > deadline) {
+                        throw new IOException("too slow");
+                    }
+                }
+                return out.toByteArray();
+            }
+        } finally {
+            conn.disconnect();
+        }
+    }
+}
