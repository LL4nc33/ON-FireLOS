+<?xml version="1.0" encoding="utf-8"?>
+<!-- Copyright (C) 2026 ON-FireLOS, Apache-2.0. The design tokens of
+     docs/DESIGN.md for the recorder, dark. -->
+<resources>
+    <color name="onfirelos_background">#1A1C18</color>
+    <color name="onfirelos_surface">#24271F</color>
+    <color name="onfirelos_text">#E4E6DD</color>
+    <!-- 60 % of the text colour: the level bubbles while recording sound. -->
+    <color name="onfirelos_text_quiet">#99E4E6DD</color>
+    <!-- The record buttons, and the icon on them. -->
+    <color name="onfirelos_accent">#8AA366</color>
+    <color name="onfirelos_on_accent">#1A1C18</color>
+    <!-- Dark status and navigation bar icons on the light background. -->
+    <bool name="onfirelos_light_bars">false</bool>
+</resources>
