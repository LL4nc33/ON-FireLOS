+/* ON-FireLOS: the device's answer to the kernel's GET_REPORT; a NULL report
+ * (handshake only) is passed on as the error the kernel waits for. */
+void bta_hh_co_get_rpt_rsp(uint8_t dev_handle, uint8_t status, uint8_t* p_rpt,
+                           uint16_t len) {
+  btif_hh_device_t* p_dev = btif_hh_find_connected_dev_by_handle(dev_handle);
+  if (p_dev == NULL || p_dev->fd < 0 || !p_dev->get_rpt_pending) return;
+  p_dev->get_rpt_pending = false;
+
+  struct uhid_event ev;
+  memset(&ev, 0, sizeof(ev));
+  ev.type = UHID_GET_REPORT_REPLY;
+  ev.u.get_report_reply.id = p_dev->get_rpt_id;
+  ev.u.get_report_reply.err = (p_rpt == NULL && status == 0) ? 1 : status;
+  if (p_rpt != NULL) {
+    if (len > UHID_DATA_MAX) len = UHID_DATA_MAX;
+    ev.u.get_report_reply.size = len;
+    memcpy(ev.u.get_report_reply.data, p_rpt, len);
+  }
+  uhid_write(p_dev->fd, &ev);
+}
