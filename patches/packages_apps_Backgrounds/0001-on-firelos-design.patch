@@ -17,10 +17,14 @@ package org.lineageos.backgrounds.factory;
 
 import android.app.WallpaperManager;
 import android.content.res.Resources;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.drawable.BitmapDrawable;
 import android.graphics.drawable.Drawable;
 
 import androidx.annotation.DrawableRes;
 import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
 
 import org.lineageos.backgrounds.R;
 import org.lineageos.backgrounds.bundle.WallpaperBundle;
@@ -31,17 +35,81 @@ public final class BuiltInWallpaperFactory {
     private BuiltInWallpaperFactory() {
     }
 
+    // ON-FireLOS: the list shows thumbnails at least this wide (a tile is at most a quarter of
+    // 1920 px); the preview loads the picture itself, at full size.
+    private static final int THUMBNAIL_WIDTH = 480;
+
     public static WallpaperBundle build(@NonNull final String name,
                                         @NonNull final Resources res,
                                         @DrawableRes final int drawableRes) {
-        Drawable drawable = res.getDrawable(drawableRes, res.newTheme());
+        Drawable drawable = thumbnail(res, drawableRes);
+        if (drawable == null) {
+            drawable = res.getDrawable(drawableRes, res.newTheme());
+        }
         return new WallpaperBundle(name, drawable, drawableRes, WallpaperType.BUILT_IN);
     }
 
+    // A bitmap resource decoded at a power-of-two fraction; null for anything else.
+    private static Drawable thumbnail(@NonNull final Resources res,
+                                      @DrawableRes final int drawableRes) {
+        BitmapFactory.Options options = new BitmapFactory.Options();
+        options.inJustDecodeBounds = true;
+        BitmapFactory.decodeResource(res, drawableRes, options);
+        if (options.outWidth <= 0) {
+            return null;
+        }
+        int sample = 1;
+        while (options.outWidth / (sample * 2) >= THUMBNAIL_WIDTH) {
+            sample *= 2;
+        }
+        options.inJustDecodeBounds = false;
+        options.inSampleSize = sample;
+        Bitmap bitmap = BitmapFactory.decodeResource(res, drawableRes, options);
+        return bitmap == null ? null : new BitmapDrawable(res, bitmap);
+    }
+
+    // The system's own wallpaper at thumbnail size, decoded so; else scaled from the full one.
+    private static Drawable builtInThumbnail(@NonNull final Resources res,
+                                             @NonNull final WallpaperManager manager) {
+        final Resources system = Resources.getSystem();
+        final int id = system.getIdentifier("default_wallpaper", "drawable", "android");
+        if (id != 0) {
+            BitmapFactory.Options options = new BitmapFactory.Options();
+            options.inJustDecodeBounds = true;
+            options.inScaled = false;
+            BitmapFactory.decodeResource(system, id, options);
+            if (options.outWidth > THUMBNAIL_WIDTH && options.outHeight > 0) {
+                Drawable small = manager.getBuiltInDrawable(THUMBNAIL_WIDTH,
+                        Math.max(1, options.outHeight * THUMBNAIL_WIDTH / options.outWidth),
+                        true, 0.5f, 0.5f);
+                if (small != null) {
+                    return small;
+                }
+            }
+        }
+        return thumbnail(res, manager.getBuiltInDrawable());
+    }
+
+    // The system's own wallpaper comes as a full bitmap; the list keeps a scaled copy.
+    private static Drawable thumbnail(@NonNull final Resources res,
+                                      @Nullable final Drawable drawable) {
+        if (!(drawable instanceof BitmapDrawable)) {
+            return drawable;
+        }
+        Bitmap full = ((BitmapDrawable) drawable).getBitmap();
+        if (full == null || full.getWidth() <= THUMBNAIL_WIDTH) {
+            return drawable;
+        }
+        int height = Math.max(1, full.getHeight() * THUMBNAIL_WIDTH / full.getWidth());
+        Bitmap small = Bitmap.createScaledBitmap(full, THUMBNAIL_WIDTH, height, true);
+        full.recycle();
+        return new BitmapDrawable(res, small);
+    }
+
     public static WallpaperBundle buildDefault(@NonNull Resources res,
                                                @NonNull WallpaperManager manager) {
         final String name = res.getString(R.string.wallpaper_built_in_system);
-        final Drawable drawable = manager.getBuiltInDrawable();
+        final Drawable drawable = builtInThumbnail(res, manager);
 
         return new WallpaperBundle(name, drawable,
                 WallpaperBundle.DESCRIPTOR_EMPTY, WallpaperType.DEFAULT);
