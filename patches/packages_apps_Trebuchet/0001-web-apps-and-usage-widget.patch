+/**
+ * The home screen's view of CPU, memory, GPU and storage use.
+ *
+ * A custom widget: a plain view inside the launcher, not an app widget in
+ * another process. It samples only while it is on screen - the launcher's
+ * window hides it as soon as an app is in front - so it costs nothing the
+ * rest of the time.
+ */
+public class SystemMonitorView extends View {
+    private static final long INTERVAL_MS = 2000;
+    // Storage changes slowly; every 30 s is enough.
+    private static final int STORAGE_EVERY = 15;
+
+    private static final int CPU = 0;
+    private static final int RAM = 1;
+    private static final int GPU = 2;
+    private static final int STORAGE = 3;
+
+    private final String[] mLabels;
+    private final float[] mLoad = { -1, -1, -1, -1 };
+    private final String[] mDetail = new String[4];
+
+    private final Paint mBackground = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mTrack = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mText = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mValue = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mRect = new RectF();
+    private final int mAccent;
+    private final byte[] mBuffer = new byte[4096];
+
+    private long mLastBusy = -1;
+    private long mLastTotal = -1;
+    private int mTicks;
+
+    private final Runnable mSample = new Runnable() {
+        @Override
+        public void run() {
+            sample();
+            invalidate();
+            postDelayed(this, INTERVAL_MS);
+        }
+    };
+
+    public SystemMonitorView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mLabels = new String[] {
+                context.getString(R.string.system_monitor_cpu),
+                context.getString(R.string.system_monitor_ram),
+                context.getString(R.string.system_monitor_gpu),
+                context.getString(R.string.system_monitor_storage) };
+        mBackground.setColor(0x73000000);
+        mTrack.setColor(0x33FFFFFF);
+        mText.setColor(0xFFFFFFFF);
+        mValue.setColor(0xB3FFFFFF);
+        mValue.setTextAlign(Paint.Align.RIGHT);
+        // The system accent of the dark theme: the widget's own background is
+        // dark whatever the launcher's theme, and the light theme's accent is
+        // made for white.
+        mAccent = Themes.getColorAccent(
+                new ContextThemeWrapper(context, android.R.style.Theme_DeviceDefault));
+    }
+
+    // --- Running only while visible.
+
+    /**
+     * Called on attach and detach, and whenever the window or a parent is
+     * shown or hidden - the launcher's window hides as soon as an app is in
+     * front.
+     */
+    @Override
+    public void onVisibilityAggregated(boolean visible) {
+        super.onVisibilityAggregated(visible);
+        removeCallbacks(mSample);
+        if (visible) {
+            // A fresh start: the CPU needs two readings for a value.
+            mLastTotal = -1;
+            mLoad[CPU] = -1;
+            mTicks = 0;
+            mSample.run();
+        }
+    }
+
+    // --- Sampling.
+
+    private void sample() {
+        try {
+            sampleCpu();
+            sampleRam();
+        } catch (RuntimeException e) {
+            // The kernel's format, not ours: show nothing rather than fail.
+            mLoad[CPU] = -1;
+            mLoad[RAM] = -1;
+        }
+        sampleGpu();
+        if (mTicks++ % STORAGE_EVERY == 0) {
+            sampleStorage();
+        }
+    }
+
+    /** Share of time not idle across all cores since the last reading. */
+    private void sampleCpu() {
+        String stat = read("/proc/stat");
+        if (stat == null || !stat.startsWith("cpu ")) {
+            mLoad[CPU] = -1;
+            return;
+        }
+        String[] f = stat.substring(4, stat.indexOf('\n')).trim().split("\\s+");
+        long total = 0;
+        for (String v : f) {
+            total += Long.parseLong(v);
+        }
+        // idle + iowait
+        long busy = total - Long.parseLong(f[3]) - Long.parseLong(f[4]);
+        if (mLastTotal >= 0 && total > mLastTotal) {
+            mLoad[CPU] = (float) (busy - mLastBusy) / (total - mLastTotal);
+        }
+        mLastBusy = busy;
+        mLastTotal = total;
+    }
+
+    private void sampleRam() {
+        String info = read("/proc/meminfo");
+        long total = field(info, "MemTotal:");
+        long available = field(info, "MemAvailable:");
+        if (total <= 0 || available < 0) {
+            mLoad[RAM] = -1;
+            return;
+        }
+        mLoad[RAM] = (float) (total - available) / total;
+        mDetail[RAM] = gigabytes((total - available) * 1024, total * 1024);
+    }
+
+    /** The PowerVR driver's own load figure, in percent. */
+    private void sampleGpu() {
+        String load = read("/sys/module/pvrsrvkm/parameters/gpu_loading");
+        try {
+            mLoad[GPU] = load == null ? -1 : Integer.parseInt(load.trim()) / 100f;
+        } catch (NumberFormatException e) {
+            mLoad[GPU] = -1;
+        }
+    }
+
+    private void sampleStorage() {
+        StatFs fs = new StatFs(Environment.getDataDirectory().getPath());
+        long total = fs.getTotalBytes();
+        long used = total - fs.getAvailableBytes();
+        mLoad[STORAGE] = total > 0 ? (float) used / total : -1;
+        mDetail[STORAGE] = gigabytes(used, total);
+    }
+
+    private String read(String path) {
+        try (FileInputStream in = new FileInputStream(path)) {
+            int n = in.read(mBuffer);
+            return n > 0 ? new String(mBuffer, 0, n) : null;
+        } catch (IOException | SecurityException e) {
+            return null;
+        }
+    }
+
+    /** A value in kB from /proc/meminfo, -1 if absent. */
+    private static long field(String text, String name) {
+        int at = text == null ? -1 : text.indexOf(name);
+        if (at < 0) {
+            return -1;
+        }
+        int end = text.indexOf(" kB", at);
+        return Long.parseLong(text.substring(at + name.length(), end).trim());
+    }
+
+    private static String gigabytes(long used, long total) {
+        return String.format("%.1f / %.1f GB", used / 1e9, total / 1e9);
+    }
+
+    // --- Drawing.
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        float density = getResources().getDisplayMetrics().density;
+        float pad = 12 * density;
+        float w = getWidth();
+        float h = getHeight();
+        mRect.set(0, 0, w, h);
+        canvas.drawRoundRect(mRect, 16 * density, 16 * density, mBackground);
+
+        float row = (h - 2 * pad) / mLabels.length;
+        float textSize = Math.min(row * 0.36f, 15 * density);
+        mText.setTextSize(textSize);
+        mValue.setTextSize(textSize * 0.9f);
+        float bar = Math.max(3 * density, Math.min(row * 0.14f, 6 * density));
+
+        for (int i = 0; i < mLabels.length; i++) {
+            float top = pad + i * row;
+            float baseline = top + row * 0.5f;
+            canvas.drawText(mLabels[i], pad, baseline, mText);
+            float load = mLoad[i];
+            String value = load < 0 ? "–" : Math.round(load * 100) + " %";
+            if (mDetail[i] != null && load >= 0 && w > 260 * density) {
+                value = mDetail[i] + "   " + value;
+            }
+            canvas.drawText(value, w - pad, baseline, mValue);
+
+            float barTop = baseline + row * 0.14f;
+            mRect.set(pad, barTop, w - pad, barTop + bar);
+            canvas.drawRoundRect(mRect, bar / 2, bar / 2, mTrack);
+            if (load > 0) {
+                mFill.setColor(load > 0.9f ? 0xFFEF5350 : load > 0.75f ? 0xFFFFB74D : mAccent);
+                mRect.right = pad + (w - 2 * pad) * Math.min(1f, load);
+                canvas.drawRoundRect(mRect, bar / 2, bar / 2, mFill);
+            }
+        }
+    }
+}
