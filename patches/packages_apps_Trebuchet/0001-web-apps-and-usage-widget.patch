+package com.android.launcher3;
+
+import android.content.Intent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextClock;
+
+/**
+ * ON-FireLOS: tells SystemUI whether the home screen shows the time itself - a widget on the
+ * page in view with a clock - so the status bar leaves its own out (SystemUI's Clock). Only
+ * while the home screen is in front, at rest and nothing lies over it.
+ */
+public class HomeClockReporter implements LauncherStateManager.StateListener {
+    public static final String ACTION = "org.onfirelos.action.HOME_SHOWS_CLOCK";
+    public static final String EXTRA = "shows_clock";
+
+    private final Launcher mLauncher;
+    private Boolean mReported;
+    private boolean mPosted;
+
+    private final Runnable mCheck = new Runnable() {
+        @Override
+        public void run() {
+            mPosted = false;
+            report(showsClock());
+        }
+    };
+
+    public HomeClockReporter(Launcher launcher) {
+        mLauncher = launcher;
+    }
+
+    /** Looks again once things have settled (after this frame's layout). */
+    public void check() {
+        final Workspace workspace = mLauncher.getWorkspace();
+        if (workspace != null && !mPosted) {
+            mPosted = true;
+            workspace.post(mCheck);
+        }
+    }
+
+    /** Says so, if it is news. */
+    public void report(boolean showsClock) {
+        if (mReported != null && mReported == showsClock) {
+            return;
+        }
+        mReported = showsClock;
+        mLauncher.sendBroadcast(new Intent(ACTION).setPackage("com.android.systemui")
+                .putExtra(EXTRA, showsClock));
+    }
+
+    private boolean showsClock() {
+        final Workspace workspace = mLauncher.getWorkspace();
+        if (workspace == null || !mLauncher.hasBeenResumed()
+                || !mLauncher.isInState(LauncherState.NORMAL)
+                || AbstractFloatingView.getTopOpenView(mLauncher) != null) {
+            return false;
+        }
+        final View page = workspace.getPageAt(workspace.getCurrentPage());
+        return page instanceof CellLayout
+                && showsTime(((CellLayout) page).getShortcutsAndWidgets());
+    }
+
+    /** A clock shown in the view: a TextClock whose format has the hour. */
+    private static boolean showsTime(View view) {
+        if (view.getVisibility() != View.VISIBLE) {
+            return false;
+        }
+        if (view instanceof TextClock) {
+            final TextClock clock = (TextClock) view;
+            final CharSequence format = clock.is24HourModeEnabled()
+                    ? clock.getFormat24Hour() : clock.getFormat12Hour();
+            // Without a format of its own, a TextClock shows the time.
+            return format == null || hasHour(format);
+        }
+        if (view instanceof ViewGroup) {
+            final ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) {
+                if (showsTime(group.getChildAt(i))) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    // An hour letter outside quoted text ("EEEE" has none, "H:mm" and "h:mm a" do).
+    private static boolean hasHour(CharSequence format) {
+        boolean quoted = false;
+        for (int i = 0; i < format.length(); i++) {
+            final char c = format.charAt(i);
+            if (c == '\'') {
+                quoted = !quoted;
+            } else if (!quoted && (c == 'H' || c == 'h' || c == 'k' || c == 'K')) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Override
+    public void onStateSetImmediately(LauncherState state) {
+        check();
+    }
+
+    @Override
+    public void onStateTransitionStart(LauncherState toState) {
+        // Only where it ends: a swipe let go early goes back to the home screen at rest
+        // without a transition of its own to report.
+    }
+
+    @Override
+    public void onStateTransitionComplete(LauncherState finalState) {
+        check();
+    }
+}
