+package com.android.launcher3;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.os.Handler;
+import android.os.UserHandle;
+
+import com.android.launcher3.graphics.LauncherIcons;
+import com.android.launcher3.shortcuts.DeepShortcutManager;
+import com.android.launcher3.shortcuts.ShortcutInfoCompat;
+import com.android.launcher3.shortcuts.ShortcutKey;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * A web app installed from the browser (Jelly), shown in all apps like an app.
+ *
+ * Jelly installs a web app as a pinned shortcut. To the platform that is a
+ * shortcut of Jelly, not an app: the launcher would badge it with Jelly's icon
+ * and keep it out of all apps, and dropping it on "uninstall" would aim at
+ * Jelly itself. Chrome avoids all of this with WebAPKs, real packages minted on
+ * Google's servers. Here the launcher simply knows Jelly's web app shortcuts
+ * and treats them as apps:
+ *
+ *  - no badge (LauncherIcons),
+ *  - listed in all apps (LoaderTask, ShortcutsChangedTask),
+ *  - removing the home screen icon does not uninstall (BgDataModel, LoaderTask),
+ *  - "uninstall" unpins the shortcut instead of removing Jelly
+ *    (SecondaryDropTarget).
+ */
+public class WebAppInfo extends AppInfo {
+    public static final String PACKAGE = "org.lineageos.jelly";
+    private static final String ID_PREFIX = "webapp-";
+
+    private final ShortcutInfoCompat mShortcut;
+    private final Context mContext;
+
+    public static boolean isWebApp(String packageName, String id) {
+        return PACKAGE.equals(packageName) && id != null && id.startsWith(ID_PREFIX);
+    }
+
+    public static boolean isWebApp(ShortcutInfoCompat shortcut) {
+        return isWebApp(shortcut.getPackage(), shortcut.getId());
+    }
+
+    public static boolean isWebApp(ShortcutKey key) {
+        return isWebApp(key.componentName.getPackageName(), key.getId());
+    }
+
+    /** A web app in all apps, or its icon on the home screen. */
+    public static boolean isWebApp(ItemInfo info) {
+        if (info instanceof WebAppInfo) {
+            return true;
+        }
+        if (info instanceof ShortcutInfo
+                && info.itemType == LauncherSettings.Favorites.ITEM_TYPE_DEEP_SHORTCUT
+                && info.getIntent() != null) {
+            return isWebApp(info.getIntent().getPackage(),
+                    ((ShortcutInfo) info).getDeepShortcutId());
+        }
+        return false;
+    }
+
+    public static ShortcutKey keyOf(ItemInfo info) {
+        if (info instanceof WebAppInfo) {
+            return ShortcutKey.fromInfo(((WebAppInfo) info).mShortcut);
+        }
+        return ShortcutKey.fromItemInfo(info);
+    }
+
+    public WebAppInfo(Context context, ShortcutInfoCompat shortcut) {
+        mContext = context.getApplicationContext();
+        mShortcut = shortcut;
+        user = shortcut.getUserHandle();
+        // Never resolves to an activity; it only has to be unique per app,
+        // because all apps tells its entries apart by component.
+        componentName = new ComponentName(shortcut.getPackage(), shortcut.getId());
+        intent = shortcut.makeIntent();
+        title = Utilities.trim(shortcut.getShortLabel());
+        contentDescription = title;
+        // Offers "uninstall" - which is handled here, not by the package manager.
+        runtimeStatusFlags |= FLAG_SYSTEM_NO;
+        LauncherIcons li = LauncherIcons.obtain(context);
+        li.createShortcutIcon(shortcut, false).applyTo(this);
+        li.recycle();
+    }
+
+    public String getShortcutId() {
+        return mShortcut.getId();
+    }
+
+    /** Dragged from all apps onto the home screen: a pinned shortcut item. */
+    @Override
+    public ShortcutInfo makeShortcut() {
+        ShortcutInfo si = new ShortcutInfo(mShortcut, mContext);
+        si.iconBitmap = iconBitmap;
+        si.iconColor = iconColor;
+        return si;
+    }
+
+    /**
+     * The installed web apps of a user, or null if the system could not be asked - a
+     * failed query returns an empty list, which must not read as "all of them
+     * were uninstalled".
+     */
+    public static List<WebAppInfo> query(Context context, UserHandle user) {
+        List<WebAppInfo> result = new ArrayList<>();
+        DeepShortcutManager sm = DeepShortcutManager.getInstance(context);
+        List<ShortcutInfoCompat> pinned = sm.queryForPinnedShortcuts(PACKAGE, user);
+        if (!sm.wasLastCallSuccess()) {
+            return null;
+        }
+        for (ShortcutInfoCompat s : pinned) {
+            if (isWebApp(s) && s.isEnabled()) {
+                result.add(new WebAppInfo(context, s));
+            }
+        }
+        return result;
+    }
+
+    /** Uninstall: the pin is the installation. */
+    public static void uninstall(Context context, ItemInfo info) {
+        // Two binder calls into the shortcut service: not on the UI thread.
+        final ShortcutKey key = keyOf(info);
+        final Context app = context.getApplicationContext();
+        new Handler(LauncherModel.getWorkerLooper()).post(
+                () -> DeepShortcutManager.getInstance(app).unpinShortcut(key));
+    }
+}
