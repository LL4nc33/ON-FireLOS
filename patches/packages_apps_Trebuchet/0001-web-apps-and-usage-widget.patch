+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.quickstep.views;
+
+import static com.android.launcher3.LauncherState.OVERVIEW;
+
+import android.Manifest;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+
+import com.android.launcher3.Launcher;
+import com.android.launcher3.LauncherState;
+import com.android.launcher3.LauncherStateManager;
+
+/**
+ * ON-FireLOS: "Clear all" sits at the far end of the recent apps list. While
+ * the overview is open and holds at least one app, this tells the navigation
+ * bar, which then offers clear all in its slot on the right; a tap there comes
+ * back here and clears the list as the button at its end would.
+ * Both directions need the STATUS_BAR permission, which only the system holds.
+ */
+final class NavBarClearAll implements LauncherStateManager.StateListener {
+    private static final String SYSTEMUI = "com.android.systemui";
+    private static final String ACTION_STATE = "org.lineageos.trebuchet.action.OVERVIEW_STATE";
+    private static final String EXTRA_CLEAR_ALL = "clear_all";
+    private static final String ACTION_CLEAR_ALL = "org.lineageos.trebuchet.action.CLEAR_ALL";
+
+    private final Launcher mLauncher;
+    private final RecentsView mRecents;
+    private boolean mInOverview;
+    private Boolean mReported;
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (mInOverview && mRecents.getTaskViewCount() > 0) {
+                mRecents.clearAllTasks();
+            }
+        }
+    };
+
+    NavBarClearAll(Launcher launcher, RecentsView recents) {
+        mLauncher = launcher;
+        mRecents = recents;
+    }
+
+    void attach() {
+        mLauncher.registerReceiver(mReceiver, new IntentFilter(ACTION_CLEAR_ALL),
+                Manifest.permission.STATUS_BAR, null);
+        mLauncher.getStateManager().addStateListener(this);
+        mInOverview = mLauncher.isInState(OVERVIEW);
+        report();
+    }
+
+    void detach() {
+        mLauncher.getStateManager().removeStateListener(this);
+        mLauncher.unregisterReceiver(mReceiver);
+        mInOverview = false;
+        report();
+    }
+
+    /** The number of apps in the list changed. */
+    void onTaskCountChanged() {
+        report();
+    }
+
+    @Override
+    public void onStateSetImmediately(LauncherState state) {
+        mInOverview = state == OVERVIEW;
+        report();
+    }
+
+    @Override
+    public void onStateTransitionStart(LauncherState toState) {
+        // Leaving: the button goes at once, not after the animation.
+        if (toState != OVERVIEW) {
+            mInOverview = false;
+            report();
+        }
+    }
+
+    @Override
+    public void onStateTransitionComplete(LauncherState finalState) {
+        mInOverview = finalState == OVERVIEW;
+        report();
+    }
+
+    private void report() {
+        boolean show = mInOverview && mRecents.getTaskViewCount() > 0;
+        if (mReported != null && mReported == show) {
+            return;
+        }
+        mReported = show;
+        mLauncher.sendBroadcast(new Intent(ACTION_STATE).setPackage(SYSTEMUI)
+                .putExtra(EXTRA_CLEAR_ALL, show), Manifest.permission.STATUS_BAR);
+    }
+}
