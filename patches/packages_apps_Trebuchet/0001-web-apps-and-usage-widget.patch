+package com.android.launcher3;
+
+import android.app.ActionBar;
+import android.app.Activity;
+import android.content.Context;
+import android.content.res.Configuration;
+import android.content.res.TypedArray;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.ColorDrawable;
+import android.text.SpannableString;
+import android.text.Spanned;
+import android.text.style.ForegroundColorSpan;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.AbsListView;
+import android.widget.ListView;
+import android.widget.TextView;
+
+/**
+ * ON-FireLOS: the launcher's settings open as Settings' pages do (docs/DESIGN.md) - a slim bar
+ * in the page's colour with the back arrow, the page's name as a large title above the list
+ * that scrolls away, and the bar's small title once it has gone.
+ */
+final class SettingsPageTitle {
+
+    private SettingsPageTitle() {
+    }
+
+    /** The bar: the page's colour, no shadow, the back arrow; the status bar the same. */
+    static void styleBar(Activity activity) {
+        final ActionBar bar = activity.getActionBar();
+        if (bar == null) {
+            return;
+        }
+        final TypedArray a = activity.obtainStyledAttributes(new int[] {
+                android.R.attr.colorBackground, android.R.attr.textColorPrimary });
+        final int background = a.getColor(0, Color.WHITE);
+        final int text = a.getColor(1, Color.BLACK);
+        a.recycle();
+        bar.setDisplayHomeAsUpEnabled(true);
+        // The back arrow in the text colour, as in Settings (the theme gives it the accent).
+        final TypedArray up = activity.getTheme().obtainStyledAttributes(
+                new int[] { android.R.attr.homeAsUpIndicator });
+        final android.graphics.drawable.Drawable arrow = up.getDrawable(0);
+        up.recycle();
+        if (arrow != null) {
+            arrow.mutate().setTint(text);
+            bar.setHomeAsUpIndicator(arrow);
+        }
+        bar.setElevation(0);
+        bar.setBackgroundDrawable(new ColorDrawable(background));
+        final SpannableString title = new SpannableString(activity.getTitle());
+        title.setSpan(new ForegroundColorSpan(text), 0, title.length(),
+                Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        bar.setTitle(title);
+        bar.setDisplayShowTitleEnabled(false);
+        activity.getWindow().setStatusBarColor(background);
+        final View decor = activity.getWindow().getDecorView();
+        final int flags = decor.getSystemUiVisibility();
+        decor.setSystemUiVisibility(Color.luminance(background) > 0.5f
+                ? flags | View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR
+                : flags & ~View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR);
+    }
+
+    /** The large title as the list's first row; the bar's title once it has scrolled away. */
+    static void attach(Activity activity, ListView list) {
+        if (list == null || list.getHeaderViewsCount() > 0) {
+            return;
+        }
+        final float density = activity.getResources().getDisplayMetrics().density;
+        final boolean landscape = activity.getResources().getConfiguration().orientation
+                == Configuration.ORIENTATION_LANDSCAPE;
+        final TypedArray a = activity.obtainStyledAttributes(new int[] {
+                android.R.attr.textColorPrimary });
+        final int text = a.getColor(0, Color.BLACK);
+        a.recycle();
+        final TextView title = new TextView(activity);
+        title.setText(activity.getTitle());
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 34);
+        title.setTypeface(Typeface.create("sans-serif", Typeface.NORMAL));
+        title.setTextColor(text);
+        title.setSingleLine(true);
+        title.setGravity(Gravity.BOTTOM | Gravity.START);
+        title.setPaddingRelative(Math.round(4 * density), 0, 0, Math.round(20 * density));
+        title.setMinHeight(Math.round((landscape ? 64 : 112) * density));
+        title.setLayoutParams(new AbsListView.LayoutParams(
+                AbsListView.LayoutParams.MATCH_PARENT, AbsListView.LayoutParams.WRAP_CONTENT));
+        list.addHeaderView(title, null, false);
+        final ActionBar bar = activity.getActionBar();
+        list.setOnScrollListener(new AbsListView.OnScrollListener() {
+            @Override
+            public void onScrollStateChanged(AbsListView view, int state) {
+            }
+
+            @Override
+            public void onScroll(AbsListView view, int first, int visible, int total) {
+                // How much of the large title is still to be seen.
+                final float shown = first > 0 || title.getHeight() == 0 ? 0
+                        : Math.max(0, Math.min(1, title.getBottom() / (float) title.getHeight()));
+                title.setAlpha(Math.max(0, (shown - 0.3f) / 0.7f));
+                if (bar != null) {
+                    bar.setDisplayShowTitleEnabled(shown < 0.4f);
+                }
+            }
+        });
+    }
+
+    /** A setting's current value, in the accent as Settings shows values. */
+    static CharSequence value(Context context, CharSequence value) {
+        if (context == null || value == null) {
+            return value;
+        }
+        final TypedArray a = context.obtainStyledAttributes(new int[] {
+                android.R.attr.colorAccent });
+        final int accent = a.getColor(0, Color.BLACK);
+        a.recycle();
+        final SpannableString s = new SpannableString(value);
+        s.setSpan(new ForegroundColorSpan(accent), 0, s.length(),
+                Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        return s;
+    }
+}
