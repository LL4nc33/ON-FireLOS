diff --git a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/gl_init.c b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/gl_init.c
index d8ddddba..668563a4 100644
--- a/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/gl_init.c
+++ b/drivers/misc/mediatek/connectivity/wlan/gen3/os/linux/gl_init.c
@@ -2217,6 +2217,16 @@ VOID wlanUpdateChannelTable(P_GLUE_INFO_T prGlueInfo)
 				if (mtk_5ghz_channels[j].hw_value == aucChannelList[i].ucChannelNum) {
 					mtk_5ghz_channels[j].flags &= ~IEEE80211_CHAN_DISABLED;
 					mtk_5ghz_channels[j].orig_flags &= ~IEEE80211_CHAN_DISABLED;
+					/* ON-FireLOS: radar channels only after hearing an access point */
+					if (mtk_5ghz_channels[j].hw_value >= 52 && mtk_5ghz_channels[j].hw_value <= 144) {
+						mtk_5ghz_channels[j].flags |= IEEE80211_CHAN_RADAR | IEEE80211_CHAN_NO_IR;
+						mtk_5ghz_channels[j].orig_flags |= IEEE80211_CHAN_RADAR | IEEE80211_CHAN_NO_IR;
+					}
+					/* the SRD band (149-165): low power, no network of our own */
+					if (mtk_5ghz_channels[j].hw_value >= 149) {
+						mtk_5ghz_channels[j].flags |= IEEE80211_CHAN_NO_IR;
+						mtk_5ghz_channels[j].orig_flags |= IEEE80211_CHAN_NO_IR;
+					}
 					break;
 				}
 			}
