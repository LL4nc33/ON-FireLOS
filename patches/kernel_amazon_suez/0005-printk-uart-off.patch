diff --git a/kernel/printk/printk.c b/kernel/printk/printk.c
index 75c19c37..36a59588 100644
--- a/kernel/printk/printk.c
+++ b/kernel/printk/printk.c
@@ -330,6 +330,32 @@ void mt_enable_uart(void)
 	}
 }
 
+/*
+ * ON-FireLOS: serial output off.
+ *
+ * The bootloader appends printk.disable_uart=0 to the command line,
+ * after everything that comes from the boot.img - so it cannot be
+ * overridden via BOARD_KERNEL_CMDLINE, because for module
+ * parameters the last assignment wins.
+ *
+ * Otherwise every message goes out synchronously, with interrupts
+ * disabled, over the debug UART, even with no cable attached. At
+ * 921600 baud the core stalls for about a millisecond per line.
+ *
+ * core_initcall runs after parse_args() and thus after the
+ * command line, but still before device initialisation - so before
+ * the actual flood.
+ *
+ * Can be switched back on at runtime for debugging:
+ *   echo 0 > /sys/module/printk/parameters/disable_uart
+ */
+static int __init onfirelos_printk_uart_off(void)
+{
+	printk_disable_uart = 1;
+	return 0;
+}
+core_initcall(onfirelos_printk_uart_off);
+
 #endif
 
 bool is_logbuf_lock(raw_spinlock_t *lock)
