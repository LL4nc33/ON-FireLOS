+
+#
+# ON-FireLOS: performance
+#
+# CPUSETS was missing. Consequence: /dev/cpuset cannot be mounted, and in
+# Android 9 the entire foreground/background separation depends on it -
+# system/core/libcutils/sched_policy.cpp writes SP_BACKGROUND to
+# /dev/cpuset/background/tasks and nowhere else. A replacement under
+# /dev/cpuctl no longer exists in Pie.
+#
+# Measured on the device without CPUSETS (threads per core, cpu2/3 = big A72):
+#   com.google.android.gms   12 on cpu2, 8 on cpu3
+#   com.android.vending      12 on cpu2, 8 on cpu3
+#   com.android.systemui      7 on cpu2, 3 on cpu3
+# The background services occupied the fast cores more than the UI did.
+# With only two big cores that takes CPU time directly away from the
+# UI thread.
+#
+# The masks for this are in init.mt8173.rc; without them AOSP only copies
+# the full set into every group and nothing changes.
+CONFIG_CPUSETS=y
+CONFIG_PROC_PID_CPUSET=y
+
+# DEBUG_PREEMPT runs every smp_processor_id() and every preempt change
+# through a check routine. Those are the hottest paths in the kernel.
+# A debugging feature, it does not belong in a release build.
+# CONFIG_DEBUG_PREEMPT is not set
+
+# Extra checks and /proc/sched_debug in the scheduler.
+# CONFIG_SCHED_DEBUG is not set
