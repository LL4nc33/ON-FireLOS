<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light here, dark in values-night: the rest is shared. -->
    <style name="Base.Theme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Base.Theme.Common" parent="Base.Theme">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:textColorPrimary">@color/on_background</item>
        <item name="android:textColorSecondary">@color/on_background_quiet</item>
        <item name="android:textColorHint">@color/on_background_quiet</item>
    </style>

    <!-- A settings page: flat bars on the page's own background. -->
    <style name="Theme.Page" parent="Base.Theme.Common">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <!-- The sheet: floats over what is open, which dims a little. -->
    <style name="Theme.Sheet" parent="Base.Theme.Common">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowAnimationStyle">@style/SheetAnimation</item>
    </style>

    <style name="SheetAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/sheet_in</item>
        <item name="android:activityCloseExitAnimation">@anim/sheet_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/sheet_in</item>
        <item name="android:taskCloseExitAnimation">@anim/sheet_out</item>
    </style>

    <style name="Pill" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/pill_accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Pill.Tonal">
        <item name="android:background">@drawable/pill_tonal</item>
        <item name="android:textColor">@color/on_background</item>
    </style>
</resources>
