# Pin line endings.
#
# Reason: a build.sh written on Windows reached the build container with CRLF
# and failed with
#     /usr/bin/env: 'bash\r': No such file or directory
# Shell scripts, Python and patches run on Linux - they need LF, whatever
# system they were edited on.

*.sh     text eol=lf
*.py     text eol=lf
*.patch  text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.xml    text eol=lf
*.mk     text eol=lf
*.rc     text eol=lf
*.bp     text eol=lf

# Never touch binary files
*.so     binary
*.img    binary
*.bin    binary
*.zip    binary
*.apk    binary
*.jpg    binary
*.png    binary

# The device tree's camera profiles have CRLF; their patch must keep it or it
# no longer applies.
patches/device_amazon_suez/0002-camera-video-profiles.patch -text
