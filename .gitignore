# No foreign binaries here. The camera, Wi-Fi, GPU and audio drivers belong to
# Amazon and MediaTek; scripts/extract-blobs.sh pulls them from your own
# device, the one they are licensed on.
*.so
*.img
*.bin
*.zip
*.apk

# Build output
out/

# Python bytecode
__pycache__/
*.pyc

# Platform tools are platform-specific binaries, not our code
tools/platform-tools/

# Signing keys never belong in the repository.
keys/
*.pk8
*.x509.pem

# Logs of scripts/verify-camera.sh (device log, test photos)
findings/camera-verify/

# ON-FireAI: the wake word and speech models and their library, fetched by
# scripts/fetch-onfireai-kws.sh (not ours to redistribute here)
onfireai/jni/arm64-v8a/
onfireai/assets/kws/
onfireai/assets/asr/
